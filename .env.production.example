# Inventário de produção. Não crie um arquivo .env.production no servidor.
# Configure os valores reais somente em Render > Environment.
NODE_ENV=production
PORT=
APP_URL=
ALLOWED_ORIGINS=
TZ=America/Sao_Paulo
WEB_CONCURRENCY=1

CONNECTIONSTRING=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
AVALIACAO_AUDIT_SALT=

STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLATFORM_USER_ID=
MERCADO_PAGO_PIX_PAYER_EMAIL=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
PLANO_MENSAL=39.90
PLATFORM_PIX_FEE_ENABLED=false
PLATFORM_PIX_FEE_PERCENT=1.5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_SERVICE_NAME=ComandaFacil
ALERT_ENVIRONMENT=production

# Flags perigosas nunca ficam permanentemente habilitadas em produção.
ALLOW_INDEX_MIGRATION=false
ALLOW_MP_DIAGNOSTIC=false
ALLOW_OPERATIONAL_ALERT_TEST=false
ALLOW_READONLY_AUDIT=false
RATE_LIMIT_STORE=mongo

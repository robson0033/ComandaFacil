"use strict";

const assert = require("node:assert/strict");
const fs = require("node:fs");
const path = require("node:path");
const test = require("node:test");

function source(rel) {
  return fs.readFileSync(path.resolve(__dirname, "..", rel), "utf8");
}

test("cliente apenas solicita troca; cancelamento depende de funcionário autorizado", () => {
  const routes = source("route.js");
  const publicStart = routes.indexOf("/mesa/:token/pedidos/:pedidoId/remover");
  assert.ok(publicStart >= 0);
  const publicBlock = routes.slice(Math.max(0, publicStart - 60), publicStart + 500);
  assert.match(publicBlock, /anonymousSameOriginProtection/);
  assert.match(publicBlock, /admin\.solicitarRemocaoPedidoMesa/);
  assert.doesNotMatch(publicBlock, /admin\.removerPedidoMesa/);

  const controller = source("src/controllers/adminRealController.js");
  assert.match(controller, /exports\.solicitarRemocaoPedidoMesa = async/);
  assert.match(controller, /remocaoSolicitacaoStatus: "pendente"/);
  const publicFnStart = controller.indexOf("exports.solicitarRemocaoPedidoMesa = async");
  const publicFnEnd = controller.indexOf("exports.aprovarRemocaoPedidoMesa = async", publicFnStart);
  const publicFn = controller.slice(publicFnStart, publicFnEnd);
  assert.doesNotMatch(publicFn, /status: "cancelado"/);
  assert.doesNotMatch(publicFn, /PrintJob\.updateMany/);
});

test("aprovar e recusar exigem pedidos + permissão crítica de troca de mesa", () => {
  const routes = source("route.js");
  for (const action of ["aprovar", "recusar"]) {
    const start = routes.indexOf(`/solicitacao-remocao/${action}`);
    assert.ok(start >= 0, action);
    const block = routes.slice(Math.max(0, start - 120), start + 520);
    assert.match(block, /permissao\('pedidos'\)/);
    assert.match(block, /permissao\('autorizar_troca_mesa'\)/);
  }

  const permissions = source("src/config/permissions.js");
  assert.match(permissions, /AUTORIZAR_TROCA_MESA: "autorizar_troca_mesa"/);
  assert.match(permissions, /PERMISSIONS\.AUTORIZAR_TROCA_MESA/);
});

test("aprovação só cancela solicitação pendente de pedido de mesa ainda não pago", () => {
  const controller = source("src/controllers/adminRealController.js");
  const start = controller.indexOf("exports.aprovarRemocaoPedidoMesa = async");
  const end = controller.indexOf("exports.recusarRemocaoPedidoMesa = async", start);
  const block = controller.slice(start, end);
  assert.match(block, /canal: "mesa"/);
  assert.match(block, /pagamentoStatus: "pendente"/);
  assert.match(block, /remocaoSolicitacaoStatus: "pendente"/);
  assert.match(block, /status: "cancelado"/);
  assert.match(block, /pagamentoStatus: "cancelado"/);
  assert.match(block, /remocaoSolicitacaoStatus: "aprovada"/);
  assert.match(block, /PrintJob\.updateMany/);
  assert.match(block, /status: \{ \$in: \["pendente", "aguardando_retry"\] \}/);
  assert.match(block, /registrarAuditoria/);
});

test("cancelamento manual de pedido de mesa também exige a nova permissão", () => {
  const controller = source("src/controllers/adminRealController.js");
  assert.match(controller, /Somente funcionários autorizados podem cancelar pedidos de mesa/);
  assert.match(controller, /req\.permissoesAtuais\.includes\("autorizar_troca_mesa"\)/);
});

test("cardápio mostra solicitação e acompanha decisão sem recarregar", () => {
  const view = source("src/views/mesa-publica.ejs");
  assert.match(view, /Solicitar troca\/remover/);
  assert.match(view, /data-removal-request-pending/);
  assert.match(view, /Aguardando autorização/);
  assert.match(view, /mesaRemovalApprovalTimer/);
  assert.match(view, /atualizarPedidosMesaSemReload/);
  const start = view.indexOf("let mesaRemovalApprovalTimer");
  const end = view.indexOf("let pedidoIdempotencyKeyAtual", start);
  assert.ok(start >= 0 && end > start);
  assert.doesNotMatch(view.slice(start, end), /window\.location\.reload\(\)/);
});

test("painel mostra pedido solicitado e só autorizado recebe Aprovar/Recusar", () => {
  const view = source("src/views/admin-real.ejs");
  assert.match(view, /pode\('autorizar_troca_mesa'\)/);
  assert.match(view, /Cliente solicitou troca\/remoção deste pedido/);
  assert.match(view, /data-removal-decision="aprovar"/);
  assert.match(view, /data-removal-decision="recusar"/);
  assert.match(view, /podeAutorizarTrocaMesa/);
  assert.match(view, /atualizarComandaMesaSemReload\(mesaId\)/);
});

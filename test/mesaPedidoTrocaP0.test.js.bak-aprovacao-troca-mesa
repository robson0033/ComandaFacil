"use strict";

const assert = require("node:assert/strict");
const fs = require("node:fs");
const path = require("node:path");
const test = require("node:test");

function source(rel) {
  return fs.readFileSync(path.resolve(__dirname, "..", rel), "utf8");
}

test("mesa possui rota pública protegida para remover somente pedido pendente", () => {
  const routes = source("route.js");
  const routeStart = routes.indexOf("/mesa/:token/pedidos/:pedidoId/remover");
  assert.ok(routeStart >= 0);
  const routeBlock = routes.slice(Math.max(0, routeStart - 50), routeStart + 450);
  assert.match(routeBlock, /respostaPedidoSemCache/);
  assert.match(routeBlock, /limitePedidoMesa/);
  assert.match(routeBlock, /anonymousSameOriginProtection/);
  assert.match(routeBlock, /admin.removerPedidoMesa/);

  const controller = source("src/controllers/adminRealController.js");
  assert.match(controller, /exports\.removerPedidoMesa = async/);
  assert.match(controller, /pagamentoStatus:\s*"pendente"/);
  assert.match(controller, /status:\s*\{ \$nin: \["cancelado", "finalizado"\] \}/);
  assert.match(controller, /estabelecimentoId:\s*mesa\.estabelecimentoId/);
  assert.match(controller, /mesaId:\s*mesa\._id/);
  assert.match(controller, /canal:\s*"mesa"/);
  assert.match(controller, /PrintJob\.updateMany/);
  assert.match(controller, /status:\s*\{ \$in: \["pendente", "aguardando_retry"\] \}/);
});

test("cardápio permite remover e atualiza lista/total sem reload", () => {
  const view = source("src/views/mesa-publica.ejs");
  assert.match(view, /data-remove-mesa-order/);
  assert.match(view, /Remover pedido/);
  assert.match(view, /async function atualizarPedidosMesaSemReload/);
  assert.match(view, /DOMParser/);
  assert.match(view, /pedidos\/\$\{encodeURIComponent\(pedidoId\)\}\/remover/);
  assert.match(view, /await atualizarPedidosMesaSemReload\(\);/);
});

test("painel atualiza a comanda da mesa por HTML parcial sem window.location.reload", () => {
  const view = source("src/views/admin-real.ejs");
  assert.match(view, /async function atualizarComandaMesaSemReload/);
  assert.match(view, /const mesasParaAtualizar = new Set\(\)/);
  assert.match(view, /atualizarComandaMesaSemReload\(mesaId\)/);

  const start = view.indexOf("async function verificarNovosPedidos()");
  const end = view.indexOf("if (menuPedidos)", start);
  assert.ok(start >= 0 && end > start);
  const polling = view.slice(start, end);
  assert.doesNotMatch(polling, /window\.location\.reload\(\)/);
});

{
  "name": "comandafacil",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestão para lanchonetes, hamburguerias e pizzarias",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --ignore public/uploads",
    "test": "node --test test/*.test.js",
    "test:syntax": "node scripts/check-syntax.js",
    "test:production": "npm run test:syntax && npm test",
    "indexes:dry-run": "node scripts/create-mercado-pago-indexes.js --dry-run",
    "indexes:apply": "node scripts/create-mercado-pago-indexes.js --apply",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:secrets": "node scripts/auditar-segredos.js",
    "ci:production": "npm ci && npm run test:production && npm run audit:production"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "mongoose": "^9.7.4",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11 <13"
  }
}

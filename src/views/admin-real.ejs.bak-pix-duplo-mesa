const atualizacoesComandaMesa = new Map();

async function atualizarComandaMesaSemReload(mesaId) {
  const id = String(mesaId || '').trim();
  if (!id) return null;
  if (atualizacoesComandaMesa.has(id)) {
    return atualizacoesComandaMesa.get(id);
  }

  const promise = (async () => {
    try {
      const response = await adminFetch(
        `${window.location.pathname}${window.location.search}`,
        {
          skipAdminLoading: true,
          headers: { Accept: 'text/html' },
        }
      );
      if (!response.ok) return null;

      const html = await response.text();
      const pagina = new DOMParser().parseFromString(html, 'text/html');
      const selector = `[data-mesa-open-card="${CSS.escape(id)}"]`;
      const atual = document.querySelector(selector);
      const novo = pagina.querySelector(selector);

      if (novo) {
        const cardNovo = document.importNode(novo, true);
        if (atual) {
          atual.replaceWith(cardNovo);
        } else if (ordersGrid) {
          document.querySelector('#ordersEmptyState')?.remove();
          ordersGrid.prepend(cardNovo);
        }
      } else if (atual) {
        atual.remove();
      }

      applyOrdersFilters();
      if (typeof atualizarResumoMesas === 'function') {
        await atualizarResumoMesas({ force: true });
      }
      return novo;
    } catch (error) {
      if (!sessionRedirectInProgress) {
        console.error('Não foi possível atualizar a comanda da mesa:', error);
      }
      return null;
    }
  })().finally(() => atualizacoesComandaMesa.delete(id));

  atualizacoesComandaMesa.set(id, promise);
  return promise;
}


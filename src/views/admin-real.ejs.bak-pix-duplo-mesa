                        name="taxaAbaixoMinimo"
                        inputmode="decimal"
                        maxlength="6"
                        value="<%= (Number(cidade.taxaAbaixoMinimoCentavos || 0) / 100).toFixed(2).replace('.', ',') %>"
                        placeholder="Ex.: 20,00"
                      >
                    </div>

                    <div class="field" style="align-self:end">
                      <button type="submit" class="mini-button edit">Salvar alterações</button>
                    </div>
                  </form>

                  <div class="delivery-city-actions">

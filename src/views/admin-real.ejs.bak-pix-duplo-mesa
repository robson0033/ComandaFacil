            %>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <div class="panel-title">
              <h2>Categorias do catálogo</h2>

              <p>
                Separe produtos por hambúrgueres, pizzas,
                bebidas e outras categorias.
              </p>
            </div>
          </div>

          <form
            action="/admin/categorias"
            method="POST"
            class="form-grid category-create-form"
            data-categoria-catalogo-form
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="tipo" value="catalogo">

            <div class="field">
              <label for="categoriaCatalogoNome">Nome da categoria</label>
              <input
                id="categoriaCatalogoNome"
                name="nome"
                placeholder="Ex.: Pizzas grandes"
                maxlength="120"
                required
              >
            </div>

            <div class="field">
              <label for="categoriaCatalogoTipoProduto">Tipo de produto</label>
              <select
                id="categoriaCatalogoTipoProduto"
                name="tipoProduto"
                data-categoria-tipo-produto
              >
                <option value="normal">Categoria normal</option>
                <option value="pizza">Pizzas</option>
              </select>
            </div>

            <button type="submit" class="button">
              Cadastrar categoria
            </button>

            <div
              class="category-create-pizza-options category-variation-settings"
              data-categoria-variacoes-settings
            >
              <label class="category-compact-checkbox">
                <input
                  type="checkbox"
                  name="variacoesHabilitadas"
                  value="on"
                  data-categoria-variacoes-toggle
                >
                Usar opções de tamanho, volume ou porção
              </label>

              <div class="pizza-size-manager hidden" data-categoria-variacoes-manager>
                <strong>Opções da categoria</strong>
                <small style="display:block;color:var(--cinza-500);margin-top:4px;">
                  Exemplos: 300ml, 500ml e 1L; Pequena, Média e Grande; Meia porção e Porção inteira. Depois, informe o preço de cada opção em cada produto.
                </small>
                <div class="pizza-size-list" data-variation-list></div>
                <button type="button" class="mini-button edit" data-add-variation style="margin-top:9px;">
                  + Adicionar opção
                </button>
              </div>
            </div>

            <div
              class="category-create-pizza-options category-pizza-settings hidden"
              data-categoria-pizza-settings
            >
              <label class="category-compact-checkbox">
                <input type="checkbox" name="permiteMeioAMeio" value="on">
                Permitir pizza com mais de um sabor
              </label>

              <div class="field">
                <label>Categorias que podem combinar nos sabores</label>
                <small style="display:block;color:var(--cinza-500);margin:4px 0 8px;">
                  Marque outras categorias de pizza cujos sabores poderão ser combinados nesta pizza.
                </small>
                <% const categoriasPizzaParaCriacao = listaCategoriasCatalogo.filter(item => item.tipoProduto === 'pizza'); %>
                <% if (categoriasPizzaParaCriacao.length) { %>
                  <div style="display:grid;gap:7px;">
                    <% categoriasPizzaParaCriacao.forEach(categoriaCompativel => { %>
                      <label class="category-compact-checkbox">
                        <input
                          type="checkbox"
                          name="categoriasMeioAMeio"
                          value="<%= categoriaCompativel._id %>"
                        >
                        <%= categoriaCompativel.nome %>
                      </label>
                    <% }) %>
                  </div>
                <% } else { %>
                  <small style="color:var(--cinza-500);">Cadastre outra categoria de pizza para poder combiná-la.</small>
                <% } %>
              </div>

              <div class="field">
                <label for="categoriaCatalogoRegraPizza">
                  Regra de cobrança
                </label>
                <select
                  id="categoriaCatalogoRegraPizza"
                  name="regraPrecoMeioAMeio"
                >
                  <option value="maior_sabor_escolhido">
                    Maior preço entre os sabores escolhidos
                  </option>
                  <option value="maior_preco_categoria">
                    Maior preço das pizzas das categorias permitidas
                  </option>
                </select>
              </div>

              <div class="pizza-size-manager">
                <strong>Tamanhos de pizza</strong>
                <small style="display:block;color:var(--cinza-500);margin-top:4px;">
                  Cadastre os tamanhos e escolha quantos sabores cada um permite. Depois, informe o preço de cada tamanho ao cadastrar ou editar cada pizza.
                </small>
                <div class="pizza-size-list" data-pizza-size-list></div>
                <button type="button" class="mini-button edit" data-add-pizza-size style="margin-top:9px;">
                  + Adicionar tamanho
                </button>
              </div>
            </div>
          </form>

          <% if (!listaCategoriasCatalogo.length) { %>
            <div class="category-empty">
              Nenhuma categoria cadastrada.
            </div>
          <% } %>

          <div class="category-config-list">
            <% listaCategoriasCatalogo.forEach(categoria => {
              const categoriaPizza = categoria.tipoProduto === 'pizza';
              const variacoesCategoria = !categoriaPizza
                && categoria.configuracaoVariacoes?.habilitado === true;
              const permiteMeioAMeio = categoriaPizza
                && categoria.configuracaoPizza?.permiteMeioAMeio === true;
              const regraPizza =
                categoria.configuracaoPizza?.regraPrecoMeioAMeio
                || 'maior_sabor_escolhido';
              const regraPizzaTexto =
                regraPizza === 'maior_preco_categoria'
                  ? 'Maior preço das categorias permitidas'
                  : 'Maior preço entre os sabores';
              const categoriasMeioAMeioIds = new Set(
                (categoria.configuracaoPizza?.categoriasMeioAMeio || [])
                  .map(item => String(item?._id || item || ''))
              );
            %>
              <details class="category-config-item">
                <summary>
                  <div class="category-summary-main">
                    <strong><%= categoria.nome %></strong>

                    <span class="category-badge <%= categoriaPizza ? 'pizza' : '' %>">
                      <%= categoriaPizza ? 'Pizza' : 'Normal' %>
                    </span>

                    <% if (permiteMeioAMeio) { %>
                      <span class="category-badge enabled">
                        Multi-sabor
                      </span>
                    <% } %>

                    <% if (variacoesCategoria) { %>
                      <span class="category-badge enabled">
                        Opções
                      </span>
                    <% } %>

                    <% if (variacoesCategoria && categoria.configuracaoVariacoes?.opcoes?.length) { %>
                      <span class="category-summary-rule">
                        <%= categoria.configuracaoVariacoes.opcoes.filter(opcao => opcao.ativo !== false).map(opcao => opcao.nome).join(' • ') %>
                      </span>
                    <% } %>

                    <% if (categoriaPizza && categoria.configuracaoPizza?.tamanhos?.length) { %>
                      <span class="category-summary-rule">
                        <%= categoria.configuracaoPizza.tamanhos.filter(t => t.ativo !== false).map(t => t.nome).join(' • ') %>
                      </span>
                    <% } %>

                    <% if (categoriaPizza) { %>
                      <span class="category-summary-rule">
                        <%= regraPizzaTexto %>
                      </span>
                    <% } %>
                  </div>

                  <span class="category-summary-action">
                    Editar
                    <span class="category-summary-chevron" aria-hidden="true">⌄</span>
                  </span>
                </summary>

                <div class="category-editor">
                  <div class="category-edit-layout">
                    <form
                      action="/admin/categorias"
                      method="POST"
                      class="category-edit-form"
                      data-categoria-catalogo-form
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="tipo" value="catalogo">
                      <input
                        type="hidden"
                        name="categoriaId"
                        value="<%= categoria._id %>"
                      >

                      <div class="field">
                        <label for="categoriaNome-<%= categoria._id %>">
                          Nome
                        </label>
                        <input
                          id="categoriaNome-<%= categoria._id %>"
                          name="nome"
                          value="<%= categoria.nome %>"
                          maxlength="120"
                          required
                        >
                      </div>

                      <div class="field">
                        <label for="categoriaTipo-<%= categoria._id %>">
                          Tipo
                        </label>
                        <select
                          id="categoriaTipo-<%= categoria._id %>"
                          name="tipoProduto"
                          data-categoria-tipo-produto
                        >
                          <option
                            value="normal"
                            <%= !categoriaPizza ? 'selected' : '' %>
                          >
                            Categoria normal
                          </option>
                          <option
                            value="pizza"
                            <%= categoriaPizza ? 'selected' : '' %>
                          >
                            Pizzas
                          </option>
                        </select>
                      </div>

                      <div
                        class="category-pizza-inline category-variation-settings <%= categoriaPizza ? 'hidden' : '' %>"
                        data-categoria-variacoes-settings
                      >
                        <label class="category-compact-checkbox">
                          <input
                            type="checkbox"
                            name="variacoesHabilitadas"
                            value="on"
                            data-categoria-variacoes-toggle
                            <%= variacoesCategoria ? 'checked' : '' %>
                          >
                          Usar opções de tamanho, volume ou porção
                        </label>

                        <div class="pizza-size-manager <%= variacoesCategoria ? '' : 'hidden' %>" data-categoria-variacoes-manager>
                          <strong>Opções da categoria</strong>
                          <small style="display:block;color:var(--cinza-500);margin-top:4px;">
                            Essas opções valem para todos os produtos da categoria. Cada produto pode ter um preço diferente em cada opção.
                          </small>
                          <div class="pizza-size-list" data-variation-list>
                            <% (categoria.configuracaoVariacoes?.opcoes || [])
                              .filter(opcao => opcao.ativo !== false)
                              .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
                              .forEach(opcao => { %>
                              <div class="pizza-size-row">
                                <input type="hidden" name="categoriaVariacaoId[]" value="<%= opcao._id %>">
                                <input
                                  name="categoriaVariacaoNome[]"
                                  value="<%= opcao.nome %>"
                                  maxlength="50"
                                  placeholder="Ex.: Grande"
                                  required
                                >
                                <button type="button" class="pizza-size-remove" data-remove-variation title="Remover opção">×</button>
                              </div>
                            <% }) %>
                          </div>
                          <button type="button" class="mini-button edit" data-add-variation style="margin-top:9px;">
                            + Adicionar opção
                          </button>
                        </div>
                      </div>

                      <div
                        class="category-pizza-inline category-pizza-settings <%= categoriaPizza ? '' : 'hidden' %>"
                        data-categoria-pizza-settings
                      >
                        <label class="category-compact-checkbox">
                          <input
                            type="checkbox"
                            name="permiteMeioAMeio"
                            value="on"
                            <%= permiteMeioAMeio ? 'checked' : '' %>
                          >
                          Permitir pizza com mais de um sabor
                        </label>

                        <div class="field">
                          <label>Categorias que podem combinar nos sabores</label>
                          <small style="display:block;color:var(--cinza-500);margin:4px 0 8px;">
                            O primeiro sabor continua nesta categoria; os demais poderão vir das categorias marcadas abaixo.
                          </small>
                          <% const outrasCategoriasPizza = listaCategoriasCatalogo.filter(item =>
                            item.tipoProduto === 'pizza' && String(item._id) !== String(categoria._id)
                          ); %>
                          <% if (outrasCategoriasPizza.length) { %>
                            <div style="display:grid;gap:7px;">
                              <% outrasCategoriasPizza.forEach(categoriaCompativel => { %>
                                <label class="category-compact-checkbox">
                                  <input
                                    type="checkbox"
                                    name="categoriasMeioAMeio"
                                    value="<%= categoriaCompativel._id %>"
                                    <%= categoriasMeioAMeioIds.has(String(categoriaCompativel._id)) ? 'checked' : '' %>
                                  >
                                  <%= categoriaCompativel.nome %>
                                </label>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <small style="color:var(--cinza-500);">Não há outra categoria de pizza cadastrada.</small>
                          <% } %>
                        </div>

                        <div class="field">
                          <label for="categoriaRegra-<%= categoria._id %>">
                            Regra de cobrança
                          </label>
                          <select
                            id="categoriaRegra-<%= categoria._id %>"
                            name="regraPrecoMeioAMeio"
                          >
                            <option
                              value="maior_sabor_escolhido"
                              <%= regraPizza === 'maior_sabor_escolhido'
                                ? 'selected'
                                : ''
                              %>
                            >
                              Maior preço entre os sabores escolhidos
                            </option>
                            <option
                              value="maior_preco_categoria"
                              <%= regraPizza === 'maior_preco_categoria'
                                ? 'selected'
                                : ''
                              %>
                            >
                              Maior preço das pizzas das categorias permitidas
                            </option>
                          </select>
                        </div>

                        <div class="pizza-size-manager">
                          <strong>Tamanhos de pizza</strong>
                          <small style="display:block;color:var(--cinza-500);margin-top:4px;">
                            Os clientes escolherão um destes tamanhos. Defina se cada tamanho aceita 1, 2 ou até 3 sabores. Se adicionar um tamanho novo, edite as pizzas desta categoria e informe o preço dele.
                          </small>
                          <div class="pizza-size-list" data-pizza-size-list>
                            <% (categoria.configuracaoPizza?.tamanhos || [])
                              .filter(tamanho => tamanho.ativo !== false)
                              .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
                              .forEach(tamanho => { %>
                              <div class="pizza-size-row pizza-size-row-flavors">
                                <input type="hidden" name="categoriaPizzaTamanhoId[]" value="<%= tamanho._id %>">
                                <input
                                  name="categoriaPizzaTamanhoNome[]"
                                  value="<%= tamanho.nome %>"
                                  maxlength="50"
                                  placeholder="Ex.: Grande"
                                  required
                                >
                                <select name="categoriaPizzaTamanhoMaxSabores[]" aria-label="Máximo de sabores para <%= tamanho.nome %>">
                                  <% const maxSaboresTamanho = Math.max(1, Math.min(3, Number(tamanho.maxSabores || 2))); %>
                                  <option value="1" <%= maxSaboresTamanho === 1 ? 'selected' : '' %>>1 sabor</option>
                                  <option value="2" <%= maxSaboresTamanho === 2 ? 'selected' : '' %>>Até 2 sabores</option>
                                  <option value="3" <%= maxSaboresTamanho === 3 ? 'selected' : '' %>>Até 3 sabores</option>
                                </select>
                                <button type="button" class="pizza-size-remove" data-remove-pizza-size title="Remover tamanho">×</button>
                              </div>
                            <% }) %>
                          </div>
                          <button type="button" class="mini-button edit" data-add-pizza-size style="margin-top:9px;">
                            + Adicionar tamanho
                          </button>
                        </div>
                      </div>

                      <button type="submit" class="mini-button edit">
                        Salvar
                      </button>
                    </form>

                    <form
                      action="/admin/categorias/<%= categoria._id %>/excluir"
                      method="POST"
                      class="category-delete-form confirmar-exclusao"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="mini-button delete">
                        Excluir
                      </button>
                    </form>
                  </div>
                </div>
              </details>
            <% }) %>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <div class="panel-title">
              <h2>Produtos</h2>

              <p>
                Produtos exibidos no catálogo e nas mesas.
              </p>
            </div>

            <button
              type="button"
              class="button open-modal"
              data-modal="modalProduto"
            >
              + Novo produto
            </button>
          </div>

          <div class="catalog-grid">
            <% if (!listaProdutos.length) { %>
              <div class="empty">
                Nenhum produto cadastrado.
              </div>
            <% } %>

            <% listaProdutos.forEach(produto => { %>
              <article
                class="product-card"
                data-product-card="<%= produto._id %>"
              >
                <div class="product-cover">
                  <% if (produto.imagem) { %>
                    <img
                      src="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                      alt="<%= produto.nome %>"
                    >
                  <% } else { %>
                    🍽️
                  <% } %>
                </div>

                <div class="product-body">
                  <span class="product-category">
                    <%= produto.categoriaId?.nome ||
                        'Sem categoria'
                    %>
                  </span>

                  <h3><%= produto.nome %></h3>

                  <p>
                    <%= produto.descricao ||
                        'Produto sem descrição.'
                    %>
                  </p>

                  <div class="product-meta">
                    <strong>
                      <% if (produto.categoriaId?.tipoProduto === 'pizza' && produto.precosPizza?.length) { %>
                        A partir de <%= formatarMoeda(Math.min(...produto.precosPizza.map(item => Number(item.preco || 0)))) %>
                      <% } else if (produto.categoriaId?.configuracaoVariacoes?.habilitado === true && produto.precosVariacoes?.length) { %>
                        A partir de <%= formatarMoeda(Math.min(...produto.precosVariacoes.map(item => Number(item.preco || 0)))) %>
                      <% } else { %>
                        <%= formatarMoeda(produto.preco) %>
                      <% } %>
                    </strong>

                    <span
                      class="status <%= produto.ativo
                        ? 'ativo'
                        : 'inativo'
                      %>"
                    >
                      <%= produto.ativo
                        ? 'Ativo'
                        : 'Inativo'
                      %>
                    </span>
                  </div>

                  <% if (produto.adicionais?.length) { %>
                    <div class="product-additionals-admin">
                      <% produto.adicionais.forEach(adicional => { %>
                        <span class="product-additional-chip">
                          + <%= adicional.nome %>
                          (<%= formatarMoeda(adicional.preco) %>)
                        </span>
                      <% }) %>
                    </div>
                  <% } %>

                  <% if (produto.categoriaId?.tipoProduto === 'pizza' && produto.precosPizza?.length) { %>
                    <div class="product-pizza-prices-admin">
                      <% produto.precosPizza.forEach(item => {
                        const tamanhoAtual = (produto.categoriaId?.configuracaoPizza?.tamanhos || [])
                          .find(tamanho => String(tamanho._id) === String(item.tamanhoId));
                        const nomeTamanhoAtual = tamanhoAtual?.nome || item.tamanhoNome;
                      %>
                        <span>🍕 <%= nomeTamanhoAtual %>: <%= formatarMoeda(item.preco) %></span>
                      <% }) %>
                    </div>
                  <% } %>
                  <% if (produto.categoriaId?.tipoProduto !== 'pizza' && produto.categoriaId?.configuracaoVariacoes?.habilitado === true && produto.precosVariacoes?.length) { %>
                    <div class="product-pizza-prices-admin">
                      <% produto.precosVariacoes.forEach(item => {
                        const opcaoAtual = (produto.categoriaId?.configuracaoVariacoes?.opcoes || [])
                          .find(opcao => String(opcao._id) === String(item.variacaoId));
                        const nomeOpcaoAtual = opcaoAtual?.nome || item.variacaoNome;
                      %>
                        <span>📏 <%= nomeOpcaoAtual %>: <%= formatarMoeda(item.preco) %></span>
                      <% }) %>
                    </div>
                  <% } %>

                  <div class="employee-actions">
                    <button
                      type="button"
                      class="mini-button edit open-modal"
                      data-modal="modalEditarProduto-<%= produto._id %>"
                    >
                      Editar produto
                    </button>

                    <button
                      type="button"
                      class="mini-button delete btn-excluir-produto"
                      data-produto-id="<%= produto._id %>"
                      data-produto-nome="<%= produto.nome %>"
                    >
                      Excluir produto
                    </button>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      </section>
      <% } %>

      <% if (pode('mesas')) { %>
      <!-- MESAS -->
      <section class="page" id="page-mesas">
        <section class="panel">
          <div class="panel-header">
            <div class="panel-title">
              <h2>Mesas</h2>

              <p>
                Conta, status, pedidos, links e QR Codes.
              </p>
            </div>

            <button
              type="button"
              class="button open-modal"
              data-modal="modalMesa"
            >
              + Nova mesa
            </button>
          </div>

          <div class="tables-grid">
            <% if (!listaMesas.length) { %>
              <div class="empty">
                Nenhuma mesa cadastrada.
              </div>
            <% } %>

            <% listaMesas.forEach(mesa => { %>
              <article
                class="table-card <%= mesa.status %>"
                data-mesa-card="<%= mesa._id %>"
                data-mesa-numero="<%= mesa.numero %>"
              >
                <div class="table-number">
                  <%= mesa.numero %>
                </div>

                <h3>Mesa <%= mesa.numero %></h3>

                <p>
                  <%= mesa.capacidade %> lugares •
                  <%= mesa.setor %>
                </p>

                <div style="margin-top: 10px;">
                  <span
                    class="status <%= mesa.status %>"
                    data-mesa-status
                  >
                    <%= String(mesa.status || '')
                      .replaceAll('_', ' ')
                    %>
                  </span>
                </div>

                <div class="mesa-conta">
                  <small>Conta atual</small>

                  <strong data-mesa-total>
                    <%= formatarMoeda(
                      mesa.totalConta
                    ) %>
                  </strong>

                  <span data-mesa-pedidos>
                    <%= mesa.quantidadePedidos || 0 %>
                    pedido(s) em aberto
                  </span>
                </div>

                <% if (mesa.qrCode) { %>
                  <img
                    class="qr"
                    src="<%= safePublicUrl(mesa.qrCode, { allowDataImage: true }) %>"
                    alt="QR Code da mesa <%= mesa.numero %>"
                  >
                <% } %>

                <% if (mesa.link) { %>
                  <div class="link-box">
                    <%= mesa.link %>
                  </div>
                <% } %>

                <div class="mesa-actions">
                  <% if (mesa.caminhoPublico) { %>
                    <a
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mini-button"
                      href="<%= safePublicUrl(mesa.caminhoPublico) %>"
                    >
                      Abrir cardápio da mesa
                    </a>
                  <% } %>

                  <% if (pode('imprimir_pedidos')) { %>
                    <button
                      type="button"
                      class="mini-button mesa-print-all"
                      data-print-mesa="<%= mesa._id %>"
                      data-mesa-pedidos="<%= mesa.quantidadePedidos || 0 %>"
                      <%= Number(mesa.quantidadePedidos || 0) > 0 ? '' : 'disabled' %>
                    >
                      🖨 Imprimir todos os pedidos
                    </button>
                  <% } %>

                  <form
                    action="/admin/mesas/<%= mesa._id %>/solicitar-conta"
                    method="POST"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button
                      type="submit"
                      class="mini-button edit"
                    >
                      Marcar aguardando pagamento
                    </button>
                  </form>

                  <form
                    action="/admin/mesas/<%= mesa._id %>/pagar"
                    method="POST"
                    class="pagamento-form"
                    data-total-centavos="<%= Math.round(Number(mesa.totalConta || 0) * 100) %>"
                  >
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select
                      name="formaPagamento"
                      aria-label="Forma de pagamento"
                      data-forma-pagamento-mesa
                    >
                      <option value="dinheiro">
                        Dinheiro

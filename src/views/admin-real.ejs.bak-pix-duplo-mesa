                        name="ativo"
                        value="<%= cidade.ativo === false ? 'true' : 'false' %>"
                      >
                      <button
                        type="submit"
                        class="mini-button <%= cidade.ativo === false ? 'success' : 'delete' %>"
                      >
                        <%= cidade.ativo === false ? 'Reativar cidade' : 'Desativar cidade' %>
                      </button>
                    </form>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>


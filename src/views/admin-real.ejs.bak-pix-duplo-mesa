<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <meta name="csrf-token" content="<%= csrfToken %>">

  <title>ComandaFacíl | Painel Administrativo</title>
  <link rel="stylesheet" href="/assets/css/admin-loading.css">

  <style nonce="<%= cspNonce %>">
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --vermelho-900: #651111;
      --vermelho-800: #821717;
      --vermelho-700: #a51f1f;
      --vermelho-600: #c62828;
      --laranja-600: #e96b13;
      --laranja-500: #f58618;
      --amarelo-500: #f6b817;
      --verde-700: #177544;
      --verde-600: #218c55;
      --azul-600: #2768c7;
      --cinza-950: #171717;
      --cinza-900: #222222;
      --cinza-800: #323232;
      --cinza-700: #4c4c4c;
      --cinza-600: #666666;
      --cinza-500: #818181;
      --cinza-400: #a7a7a7;
      --cinza-300: #d4d4d4;
      --cinza-200: #e8e8e8;
      --cinza-100: #f5f5f5;
      --cinza-50: #fafafa;
      --branco: #ffffff;
      --fundo: #f7f4f1;
      --borda: #eadfd7;
      --sombra: 0 12px 32px rgba(63, 30, 13, 0.08);
      --sidebar: 280px;
    }

    .orders-filter-panel {
  margin-bottom: 18px;
  padding: 16px;
  border: 1px solid var(--cinza-200);
  border-radius: 18px;
  background: #fff;
}

.orders-quick-filters {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 14px;
}

.order-quick-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 39px;
  padding: 0 14px;
  border: 1px solid var(--cinza-200);
  border-radius: 999px;
  background: #fff;
  color: var(--cinza-700);
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
  transition: 0.2s;
}

.order-quick-filter:hover {
  border-color: var(--laranja-500);
  transform: translateY(-1px);
}

.order-quick-filter.active {
  border-color: transparent;
  background: linear-gradient(
    135deg,
    var(--vermelho-600),
    var(--laranja-500)
  );
  color: #fff;
  box-shadow: 0 8px 20px
    rgba(224, 74, 22, 0.2);
}


.orders-search-box {
  margin-bottom: 14px;
}
.orders-search-box input {
  width: 100%;
  min-height: 46px;
  padding: 0 14px;
  border: 1px solid var(--cinza-200);
  border-radius: 13px;
  background: #fff;
}

.orders-filter-form {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(150px, 1fr))
    repeat(2, minmax(150px, 1fr))
    auto;
  gap: 11px;
  align-items: end;
}

.orders-filter-field {
  display: grid;
  gap: 6px;
}

.orders-filter-field label {
  color: var(--cinza-700);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.orders-filter-field input,
.orders-filter-field select {
  width: 100%;
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid var(--cinza-200);
  border-radius: 12px;
  background: #fff;
  color: var(--cinza-800);
  outline: none;
}

.orders-filter-field input:focus,
.orders-filter-field select:focus {
  border-color: var(--laranja-500);
  box-shadow: 0 0 0 3px
    rgba(239, 108, 20, 0.1);
}

.orders-filter-actions {
  display: flex;
  gap: 8px;
}

.orders-filter-button {
  min-height: 43px;
  padding: 0 15px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(
    135deg,
    var(--vermelho-600),
    var(--laranja-500)
  );
  color: #fff;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.orders-clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 43px;
  padding: 0 15px;
  border: 1px solid var(--cinza-200);
  border-radius: 12px;
  background: #fff;
  color: var(--cinza-700);
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.orders-filter-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 14px;
  padding-top: 13px;
  border-top: 1px solid var(--cinza-200);
  color: var(--cinza-500);
  font-size: 13px;
}

.orders-filter-result strong {
  color: var(--cinza-800);
}

.orders-scroll-container {
  max-height: 680px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 9px;
  scroll-behavior: smooth;
}

/* Barra de rolagem para Chrome, Edge e Safari */
.orders-scroll-container::-webkit-scrollbar {
  width: 9px;
}

.orders-scroll-container::-webkit-scrollbar-track {
  border-radius: 999px;
  background: #f2ece8;
}

.orders-scroll-container::-webkit-scrollbar-thumb {
  border: 2px solid #f2ece8;
  border-radius: 999px;
  background: linear-gradient(
    180deg,
    var(--vermelho-600),
    var(--laranja-500)
  );
}

.orders-scroll-container::-webkit-scrollbar-thumb:hover {
  background: var(--vermelho-600);
}

/* Barra de rolagem para Firefox */
.orders-scroll-container {
  scrollbar-width: thin;
  scrollbar-color:
    var(--laranja-500)
    #f2ece8;
}

.order-card.order-filter-hidden {
  display: none !important;
}

.orders-no-results {
  display: none;
  padding: 50px 20px;
  border: 1px dashed var(--cinza-300);
  border-radius: 18px;
  background: #fff;
  color: var(--cinza-500);
  text-align: center;
}

.orders-no-results.visible {
  display: block;
}

@media (max-width: 1050px) {
  .orders-filter-form {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .orders-filter-actions {
    grid-column: 1 / -1;
  }
}

@media (max-width: 600px) {
  .orders-filter-form {
    grid-template-columns: 1fr;
  }

  .orders-filter-actions {
    grid-column: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .orders-filter-button,
  .orders-clear-button {
    width: 100%;
  }

  .orders-scroll-container {
    max-height: 620px;
    padding-right: 5px;
  }

  .orders-filter-result {
    align-items: flex-start;
    flex-direction: column;
  }
}

    .orders-notification-badge {
  min-width: 24px;
  height: 24px;
  margin-left: auto;
  padding: 0 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #fff;
  border-radius: 999px;
  background: #ef3038;
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  line-height: 1;
  box-shadow:
    0 6px 16px
    rgba(239, 48, 56, 0.4);
  animation:
    pedidoBadgePulse 1.5s
    infinite;
}

.orders-notification-badge[hidden] {
  display: none;
}

@keyframes pedidoBadgePulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.12);
  }
}

.new-order-card {
  animation:
    newOrderEntry 0.45s ease;
  border-color:
    rgba(242, 118, 19, 0.55);
  box-shadow:
    0 16px 38px
    rgba(242, 118, 19, 0.14);
}

@keyframes newOrderEntry {
  from {
    opacity: 0;
    transform:
      translateY(-18px)
      scale(0.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

.order-toast-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 9999;
  width: min(
    380px,
    calc(100% - 30px)
  );
  display: grid;
  gap: 10px;
}

.order-toast {
  display: grid;
  grid-template-columns:
    48px
    minmax(0, 1fr)
    auto;
  gap: 12px;
  align-items: center;
  padding: 14px;
  border: 1px solid
    rgba(255, 255, 255, 0.12);
  border-radius: 17px;
  background:
    linear-gradient(
      135deg,
      #381510,
      #5b1a11
    );
  color: #fff;
  box-shadow:
    0 20px 50px
    rgba(28, 10, 6, 0.28);
  animation:
    orderToastEntry 0.35s ease;
}

.order-toast-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background:
    linear-gradient(
      135deg,
      var(--vermelho-600),
      var(--laranja-500)
    );
  font-size: 23px;
}

.order-toast-text strong {
  display: block;
  font-size: 14px;
}

.order-toast-text span {
  display: block;
  margin-top: 5px;
  color: #f0d7cb;
  font-size: 12px;
}

.order-toast-close {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background:
    rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 19px;
  cursor: pointer;
}

@keyframes orderToastEntry {
  from {
    opacity: 0;
    transform:
      translateX(30px);
  }

  to {
    opacity: 1;
    transform:
      translateX(0);
  }
}

@media (max-width: 600px) {
  .order-toast-container {
    top: 12px;
    right: 12px;
    left: 12px;
    width: auto;
  }
}

    .week-days {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.week-day {
  position: relative;
  cursor: pointer;
}

.week-day input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.week-day span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 15px;
  border: 1px solid var(--cinza-200);
  border-radius: 999px;
  background: #fff;
  color: var(--cinza-700);
  font-size: 13px;
  font-weight: 800;
  transition: 0.2s;
}

.week-day input:checked + span {
  border-color: transparent;
  background: linear-gradient(
    135deg,
    var(--vermelho-600),
    var(--laranja-500)
  );
  color: #fff;
  box-shadow: 0 8px 18px
    rgba(220, 60, 20, 0.2);
}

    .orders-grid {
  display: grid;
  gap: 16px;
}

.order-card {
  padding: 18px;
  border: 1px solid var(--borda);
  border-radius: 18px;
  background: #fff;
  box-shadow: var(--sombra);
}

.order-card.table-tab-card {
  border-width: 2px;
  border-color: #cdddf5;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
}

.table-tab-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  align-items: center;
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #eef5ff;
  color: #274f80;
  font-size: 12px;
  font-weight: 800;
}

.table-tab-orders {
  display: grid;
  gap: 12px;
  margin-top: 14px;
}

.table-tab-order {
  padding: 12px;
  border: 1px solid var(--cinza-200);
  border-radius: 14px;
  background: #fff;
}

.table-tab-order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.table-tab-order-title {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
  align-items: center;
}

.table-tab-order-title strong {
  font-size: 13px;
}

.table-tab-order-title small {
  color: var(--cinza-500);
}

.table-tab-order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  align-items: center;
}

.table-tab-order-actions .order-status-form select {
  min-width: 120px;
}

.table-tab-payment {
  display: grid;
  gap: 9px;
  min-width: min(100%, 420px);
}

.table-tab-payment > select {
  min-width: 180px;
}

.table-tab-note {
  margin-top: 8px;
  color: var(--cinza-500);
  font-size: 11px;
}

@media (max-width: 700px) {
  .table-tab-order-actions,
  .table-tab-order-actions .order-status-form,
  .table-tab-payment {
    width: 100%;
  }

  .table-tab-order-actions .order-status-form {
    display: grid;
    grid-template-columns: 1fr;
  }

  .table-tab-order-actions .mini-button,
  .table-tab-payment .mini-button,
  .table-tab-payment > select {
    width: 100%;
  }
}

.order-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--cinza-200);
}

.order-number {
  display: flex;
  align-items: center;
  gap: 12px;
}

.order-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 14px;
  background: linear-gradient(
    135deg,
    var(--vermelho-600),
    var(--laranja-500)
  );
  color: #fff;
  font-size: 22px;
}

.order-number h3 {
  margin: 0;
  font-size: 17px;
}

.order-number p {
  margin-top: 5px;
  color: var(--cinza-500);
  font-size: 12px;
}

.order-origin {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 8px;
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 900;
}

.order-origin.mesa {
  background: #e8f1ff;
  color: #245eaa;
}

.order-origin.delivery {
  background: #fff0cf;
  color: #946200;
}

.order-origin.retirada {
  background: #dcf6e8;
  color: #177544;
}

.order-items {
  display: grid;
  gap: 10px;
  margin-top: 15px;
}

.order-item {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 10px;
  align-items: start;
  padding: 11px;
  border-radius: 12px;
  background: #faf8f6;
}

.order-item-quantity {
  min-width: 32px;
  color: var(--vermelho-600);
  font-weight: 900;
}

.order-item-name {
  font-weight: 800;
}

.order-item-note {
  display: block;
  margin-top: 4px;
  color: var(--cinza-500);
  font-size: 12px;
}

.order-item-price {
  font-weight: 900;
  white-space: nowrap;
}

.order-observation {
  margin-top: 14px;
  padding: 12px;
  border-radius: 12px;
  background: #fff8e8;
  color: #765219;
  font-size: 13px;
  line-height: 1.5;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-top: 16px;
  padding-top: 15px;
  border-top: 1px solid var(--cinza-200);
}

.order-total span {
  display: block;
  color: var(--cinza-500);
  font-size: 12px;
}

.order-total strong {
  display: block;
  margin-top: 3px;
  color: var(--verde-600);
  font-size: 22px;
}

.order-total-breakdown {
  display: grid;
  gap: 3px;
  margin-bottom: 8px;
}

.order-total-breakdown span {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--cinza-600);
  font-size: 12px;
}

.order-total-breakdown b {
  color: var(--cinza-800);
}

.order-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.order-status-form {
  display: flex;
  gap: 7px;
}

.order-status-form select {
  min-width: 135px;
}

.order-payment-method-form {
  flex: 1 1 100%;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 2px;
}

.order-payment-method-form .order-payment-split {
  flex: 1 1 100%;
  width: 100%;
  order: 4;
}

.order-payment-method-form > .mini-button {
  order: 3;
}

.order-payment-method-form label {
  color: var(--cinza-600);
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.order-payment-method-form select {
  min-width: 150px;
}

.order-payment-method-form .mini-button {
  white-space: nowrap;
}

@media (max-width: 700px) {
  .order-card-header,
  .order-footer {
    flex-direction: column;
  }

  .order-actions,
  .order-status-form,
  .order-payment-method-form {
    width: 100%;
  }

  .order-status-form,
  .order-payment-method-form {
    display: grid;
    grid-template-columns: 1fr;
  }

  .order-payment-method-form label {
    white-space: normal;
  }

  .order-payment-method-form select {
    width: 100%;
    min-width: 0;
  }

  .order-actions .mini-button,
  .order-status-form .mini-button,
  .order-payment-method-form .mini-button {
    width: 100%;
  }
}

    .employee-avatar {
  overflow: hidden;
}

.employee-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.employee-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.employee-actions form {
  margin: 0;
}

.employee-data-row {
  display: grid;
  grid-template-columns: 95px minmax(0, 1fr);
  gap: 8px;
  line-height: 1.45;
}

.employee-data-row strong {
  color: var(--cinza-700);
}

.employee-address {
  word-break: break-word;
}

.employee-salary {
  color: var(--verde-600);
  font-weight: 900;
}

.employee-photo-preview {
  width: 90px;
  height: 90px;
  overflow: hidden;
  border: 3px solid #f2ddd1;
  border-radius: 50%;
  background: var(--cinza-100);
}

.employee-photo-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

    .report-filter-panel {
  margin-bottom: 20px;
  padding: 18px;
  border: 1px solid var(--borda);
  border-radius: 18px;
  background: #fff;
  box-shadow: var(--sombra);
}

.report-filters {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.report-filter-form {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(170px, 1fr))
    auto;
  gap: 12px;
  align-items: end;
}

.report-filter-field {
  display: grid;
  gap: 7px;
}

.report-filter-field label {
  color: var(--cinza-700);
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.report-filter-field input,
.report-filter-field select {
  width: 100%;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid var(--cinza-300);
  border-radius: 11px;
  background: #fff;
  color: var(--cinza-900);
}

.report-filter-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.report-filter-actions .button {
  white-space: nowrap;
}

.report-filter-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 15px;
  padding-top: 14px;
  border-top: 1px solid var(--cinza-200);
  color: var(--cinza-500);
  font-size: 13px;
}

.report-filter-summary strong {
  color: var(--cinza-800);
}

@media (max-width: 1050px) {
  .report-filter-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .report-filter-actions {
    grid-column: 1 / -1;
  }
}

@media (max-width: 650px) {
  .report-filter-form {
    grid-template-columns: 1fr;
  }

  .report-filter-actions {
    grid-column: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .report-filter-actions .button {
    width: 100%;
  }

  .report-filter-summary {
    align-items: flex-start;
    flex-direction: column;
  }
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid var(--cinza-200);
  background: #fff;
  color: var(--cinza-700);
  font-size: 13px;
  font-weight: 800;
  transition: 0.2s;
}

.filter-chip:hover {
  transform: translateY(-1px);
  border-color: var(--laranja-500);
}

.filter-chip.ativo {
  background: linear-gradient(
    135deg,
    var(--vermelho-600),
    var(--laranja-600)
  );
  color: #fff;
  border-color: transparent;
  box-shadow: 0 10px 24px rgba(198, 40, 40, 0.18);
}

.report-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.report-icon {
  display: grid;
  place-items: center;
  width: 52px;

                      >
                    </div>

                    <div class="field">
                      <label>Pedido mínimo para delivery</label>
                      <input
                        name="pedidoMinimo"
                        inputmode="decimal"
                        maxlength="9"
                        value="<%= (Number(cidade.pedidoMinimoCentavos || 0) / 100).toFixed(2).replace('.', ',') %>"

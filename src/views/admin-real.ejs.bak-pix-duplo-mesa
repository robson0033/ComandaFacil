    .permissions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .permissions label {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 8px;
      border: 1px solid var(--cinza-200);
      border-radius: 9px;
      background: var(--cinza-50);
      font-size: 12px;
    }

    .permissions input {
      width: auto;
      min-height: auto;
    }

    .modal {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(20, 10, 8, 0.68);
      z-index: 3000;
    }

    .modal.ativo {
      display: flex;
    }

    .modal-card {
      width: min(720px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 22px;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 25px 65px rgba(0,0,0,0.28);
    }

    .modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }

    .modal-header h2 {
      font-size: 22px;
    }

    .modal-header p {
      margin-top: 5px;
      color: var(--cinza-500);
      font-size: 13px;
    }

    .close-modal {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--cinza-100);
      color: var(--cinza-700);
      font-size: 24px;
      cursor: pointer;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 18px;
    }

    .overlay {
      display: none;
    }

    @media (max-width: 1180px) {
      .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 980px) {
      .app {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        width: min(86vw, 300px);
        transform: translateX(-105%);
        transition: transform 0.25s ease;
      }

      .profile-name {
        display: none;
      }

      .sidebar.ativo {
        transform: translateX(0);
      }

      .overlay.ativo {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(20,10,8,0.55);
        z-index: 900;
      }

      .main {
        padding: 18px;
      }

      .mobile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        padding: 12px 14px;
        border-radius: 15px;
        background: #fff;
        box-shadow: var(--sombra);
      }

      .mobile-topbar button {
        width: 43px;
        height: 43px;
        border-radius: 11px;
        background: var(--cinza-950);
        color: #fff;
        font-size: 22px;
        cursor: pointer;
      }
    }

    @media (max-width: 720px) {
      .main {
        padding: 12px;
      }

      .topbar {
        align-items: flex-start;
      }

      .profile-name {
        display: none;
      }

      .profile-name strong {
        display: none;
      }

      .stats,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .panel {
        padding: 15px;
      }

      .panel-header {
        flex-direction: column;
      }

      .panel-header .button {
        width: 100%;
      }

      .field.full {
        grid-column: auto;
      }

      .table-wrap {
        overflow-x: hidden;
      }

      table,
      thead,
      tbody,
      tr,
      th,
      td {
        display: block;
        width: 100%;
      }

      table {
        min-width: 0;
      }

      thead {
        display: none;
      }

      tr {
        margin-bottom: 12px;
        padding: 13px;
        border: 1px solid var(--cinza-200);
        border-radius: 13px;
        background: #fff;
      }

      td {
        display: grid;
        grid-template-columns: 115px minmax(0, 1fr);
        gap: 10px;
        padding: 8px 0;
        border-bottom: 0;
      }

      td::before {
        content: attr(data-label);
        color: var(--cinza-500);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
      }

      .pagamento-form,
      .status-form,
      .pagamento-combinado-linha {
        grid-template-columns: 1fr;
      }

      .permissions {
        grid-template-columns: 1fr;
      }

      .modal-footer {
        flex-direction: column-reverse;
      }

      .modal-footer .button {
        width: 100%;
      }
    }
  

                <strong>Termos aceitos em:</strong>
                <%= config.mercadoPago.termsAcceptedAt ? formatarDataHoraEstabelecimento(config.mercadoPago.termsAcceptedAt) : 'Aceite anterior não registrado' %><br>
                <strong>Versão:</strong> <%= config.mercadoPago.termsVersion || 'legada' %>

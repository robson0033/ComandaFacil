    function renderizarPrecosProduto(form) {
      const select = form.querySelector('[data-product-category]');
      const categoria = categoriasCatalogoPizzaAdminMap.get(String(select?.value || ''));
      const tamanhosPizza = categoria?.tipoProduto === 'pizza'
        ? (categoria.tamanhos || [])
        : [];
      const variacoes = categoria?.tipoProduto !== 'pizza' && categoria?.variacoesHabilitadas
        ? (categoria.variacoes || [])
        : [];
      const painelPizza = form.querySelector('[data-product-pizza-prices]');
      const listaPizza = form.querySelector('[data-product-pizza-price-list]');
      const painelVariacoes = form.querySelector('[data-product-variation-prices]');
      const listaVariacoes = form.querySelector('[data-product-variation-price-list]');
      const campoBase = form.querySelector('[data-base-price-field]');
      const inputBase = form.querySelector('[data-base-price]');
      if (!painelPizza || !listaPizza || !painelVariacoes || !listaVariacoes || !campoBase || !inputBase) return;

      const usaPizza = tamanhosPizza.length > 0;
      const usaVariacoes = variacoes.length > 0;
      const usaPrecosPorOpcao = usaPizza || usaVariacoes;
      painelPizza.classList.toggle('hidden', !usaPizza);
      painelVariacoes.classList.toggle('hidden', !usaVariacoes);
      campoBase.classList.toggle('hidden', usaPrecosPorOpcao);
      inputBase.disabled = usaPrecosPorOpcao;
      inputBase.required = !usaPrecosPorOpcao;

      const precosPizzaExistentes = precosPizzaExistentesDoForm(form);
      const valoresPizzaAtuais = new Map(
        [...listaPizza.querySelectorAll('[data-pizza-product-price]')].map(input => [
          String(input.dataset.opcaoId || ''),
          input.value,
        ]),
      );
      listaPizza.replaceChildren();

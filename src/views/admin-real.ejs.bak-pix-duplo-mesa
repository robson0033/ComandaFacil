                              : 'Abra o agente e atualize a lista'
                            %>
                          </option>
                        </select>
                      </div>

                      <div class="field">
                        <label>Conexão</label>
                        <input
                          value="Impressora instalada no Windows"
                          disabled
                        >
                      </div>

                      <div class="printer-tools">
                        <button
                          type="button"
                          class="printer-tool-button"
                          data-refresh-usb
                          data-agent-required
                          disabled
                        >
                          ↻ Atualizar lista USB
                        </button>

                        <button
                          type="button"
                          class="printer-tool-button test"
                          data-test-printer
                          data-agent-required
                          disabled
                        >
                          🖨 Imprimir teste
                        </button>
                      </div>
                    </div>

                    <div
                      class="connection-panel <%= impressora.tipoConexao === 'rede'
                        ? 'active'
                        : ''
                      %>"
                      data-connection-panel="rede"
                    >

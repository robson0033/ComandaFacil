    .payment-breakdown-panel {
      margin-top: 18px;
    }

    .payment-breakdown-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .payment-breakdown-card {
      position: relative;
      overflow: hidden;
      display: grid;
      gap: 6px;
      min-height: 118px;
      padding: 18px;
      border: 1px solid var(--borda);

                      { valor: 0, nome: 'Domingo' }, { valor: 1, nome: 'Segunda' },
                      { valor: 2, nome: 'Terça' }, { valor: 3, nome: 'Quarta' },
                      { valor: 4, nome: 'Quinta' }, { valor: 5, nome: 'Sexta' },
                      { valor: 6, nome: 'Sábado' }

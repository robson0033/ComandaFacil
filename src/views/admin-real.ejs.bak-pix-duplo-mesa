                        <label>Endereço IP</label>
                        <input
                          name="impressoras[<%= indice %>][ip]"
                          value="<%= impressora.ip || '' %>"
                          placeholder="192.168.0.120"
                          inputmode="decimal"
                        >
                      </div>

                      <div class="field">
                        <label>Porta</label>
                        <input
                          type="number"
                          min="1"
                          max="65535"
                          name="impressoras[<%= indice %>][porta]"
                          value="<%= impressora.porta || 9100 %>"
                        >
                      </div>

                      <div class="printer-tools">
                        <button
                          type="button"
                          class="printer-tool-button"
                          data-scan-network
                          data-agent-required
                          disabled
                        >
                          🔍 Procurar na rede
                        </button>

                        <button
                          type="button"
                          class="printer-tool-button test"
                          data-test-printer
                          data-agent-required
                          disabled
                        >
                          🧪 Testar conexão e impressão
                        </button>
                      </div>
                    </div>

                    <div
                      class="printer-result"
                      data-printer-result
                    ></div>


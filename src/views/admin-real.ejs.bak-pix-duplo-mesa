></div>

  <%- include('includes/admin-loading') %>
  <script src="/js/adminLoading.js" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    const mutatingAdminMethods = new Set(['POST', 'PUT', 'PATCH', 'DELETE']);
    const secoesPainelPermitidas = new Set([
      'dashboard',
      'pedidos',
      'pedidos-arquivados',
      'relatorios',
      'estoque',
      'catalogo',
      'mesas',
      'funcionarios',
      'configuracoes',
    ]);
    let sessionRedirectInProgress = false;
    let pollingPedidosAtivo = true;
    let pedidosPollAbortController = null;
    let pedidosStream = null;
    let printAgentStatusStream = null;

    function obterCsrfTokenAtual() {
      return (
        document.querySelector('meta[name="csrf-token"]')?.content ||
        document.querySelector('input[name="_csrf"]')?.value ||
        ''
      ).trim();
    }

    function recarregarSecaoPainel(secaoPreferida) {
      const secaoAtual = String(window.location.hash || '').replace(/^#/, '');
      const secao = secoesPainelPermitidas.has(String(secaoPreferida || ''))
        ? String(secaoPreferida)
        : secoesPainelPermitidas.has(secaoAtual)
          ? secaoAtual
          : 'dashboard';
      window.location.hash = `#${secao}`;
      window.location.reload();
    }

    function pararPollings() {
      pollingPedidosAtivo = false;
      pedidosPollAbortController?.abort();
      pedidosPollAbortController = null;
    }

    function fecharSse() {
      pedidosStream?.close();
      pedidosStream = null;
      printAgentStatusStream?.close();
      printAgentStatusStream = null;
    }

    function handleSessionExpired() {
      if (sessionRedirectInProgress) return;
      sessionRedirectInProgress = true;
      pararPollings();
      fecharSse();
      window.location.assign('/login');
    }

    document.querySelector('form[data-admin-logout]')?.addEventListener(
      'submit',
      () => {
        // O logout é navegação nativa. Interrompa antes as consultas passivas
        // para que nenhuma requisição de novos pedidos dispute com a destruição
        // da sessão e gere SESSION_INVALID no servidor.
        sessionRedirectInProgress = true;
        pararPollings();
        fecharSse();
      },
    );

    function mostrarErroAdministrativo({ message, code, correlationId } = {}) {
      const container = document.querySelector('#orderToastContainer');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'order-toast';
      const icon = document.createElement('div');
      icon.className = 'order-toast-icon';
      icon.textContent = '!';
      const text = document.createElement('div');
      text.className = 'order-toast-text';
      const title = document.createElement('strong');
      title.textContent = code === 'PERMISSION_DENIED'
        ? 'Permissão insuficiente'
        : 'Não foi possível concluir';
      const detail = document.createElement('span');
      detail.textContent = correlationId
        ? `${message || 'Tente novamente.'} Código: ${correlationId}`
        : (message || 'Tente novamente.');
      text.append(title, detail);
      toast.append(icon, text);
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 6000);
    }

    async function adminFetch(resource, options = {}, loadingOptions = {}) {
      const { skipAdminLoading = false, ...fetchOptions } = options;
      const method = String(fetchOptions.method || 'GET').toUpperCase();
      const target = new URL(String(resource), window.location.href);
      const sameAdminOrigin =
        target.origin === window.location.origin &&
        target.pathname.startsWith('/admin');
      const headers = new Headers(fetchOptions.headers || {});
      if (sameAdminOrigin && mutatingAdminMethods.has(method)) {
        const csrfToken = obterCsrfTokenAtual();
        if (!csrfToken) {
          const error = new Error('A página expirou. Atualize e tente novamente.');
          error.code = 'CSRF_TOKEN_AUSENTE_NO_FRONTEND';
          throw error;
        }
        headers.set('X-CSRF-Token', csrfToken);
        if (fetchOptions.body instanceof FormData) {
          fetchOptions.body.set('_csrf', csrfToken);
        }
      }
      if (sameAdminOrigin && !headers.has('Accept')) {
        headers.set('Accept', 'application/json');
      }
      const request = () => window.fetch(resource, {
        ...fetchOptions,
        credentials: 'same-origin',
        headers
      });
      const action = loadingOptions.action || (
        /pagamento|payment/i.test(target.pathname) ? 'payment' :
        method === 'DELETE' || /excluir|arquivar|remover/i.test(target.pathname) ? 'delete' :
        /cancelar|desconectar/i.test(target.pathname) ? 'cancel' :
        fetchOptions.body instanceof FormData ? 'upload' :
        method === 'POST' ? 'save' : 'update'
      );
      const shouldShowLoading = sameAdminOrigin
        && mutatingAdminMethods.has(method)
        && !skipAdminLoading;
      const response = shouldShowLoading
        ? await window.AdminLoading.run(
          request,
          window.AdminLoading.messages[action] || window.AdminLoading.messages.default
        )
        : await request();
      if (response.status === 401) {
        const payload = await response.clone().json().catch(() => ({}));
        mostrarErroAdministrativo(payload);
        handleSessionExpired();
        return response;
      }
      if (response.status === 403) {
        const payload = await response.clone().json().catch(() => ({
          code: 'PERMISSION_DENIED',
          message: 'Você não possui permissão para esta ação.',
        }));
        mostrarErroAdministrativo(payload);
      }
      return response;
    }

    document.addEventListener('submit', event => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const method = String(form.method || 'GET').toUpperCase();
      const target = new URL(form.action || window.location.href);
      if (
        !mutatingAdminMethods.has(method) ||
        target.origin !== window.location.origin ||
        !target.pathname.startsWith('/admin')
      ) return;
      let input = form.querySelector('input[name="_csrf"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        form.appendChild(input);
      }
      const csrfToken = obterCsrfTokenAtual();
      if (!csrfToken) {
        event.preventDefault();
        mostrarErroAdministrativo({
          code: 'CSRF_TOKEN_AUSENTE_NO_FRONTEND',
          message: 'A página expirou. Atualize e tente novamente.',
        });
        return;
      }
      input.value = csrfToken;
    }, true);

    const mercadoPagoTermsDialog = document.querySelector('#mercadoPagoTermsDialog');
    const platformFeeTermsCheckbox = document.querySelector('#platformFeeTermsCheckbox');
    const confirmPlatformFeeTerms = document.querySelector('#confirmPlatformFeeTerms');
    let pendingMercadoPagoConnectForm = null;
    let platformFeeTermsMode = 'connect';
    platformFeeTermsCheckbox?.addEventListener('change', () => {
      confirmPlatformFeeTerms.disabled = !platformFeeTermsCheckbox.checked;
    });
    document.querySelector('#cancelPlatformFeeTerms')?.addEventListener('click', () => {
      pendingMercadoPagoConnectForm = null;
      platformFeeTermsMode = 'connect';
      platformFeeTermsCheckbox.checked = false;
      confirmPlatformFeeTerms.disabled = true;
      mercadoPagoTermsDialog.close();
    });
    confirmPlatformFeeTerms?.addEventListener('click', async () => {
      if (!platformFeeTermsCheckbox.checked) return;
      if (platformFeeTermsMode === 'connect' && !pendingMercadoPagoConnectForm) return;
      confirmPlatformFeeTerms.disabled = true;
      try {
        const response = await adminFetch('/admin/mercado-pago/termos/aceitar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ accepted: true })
        });
        const payload = await response.clone().json().catch(() => ({}));
        if (!response.ok || !payload.ok) throw new Error(payload.message || 'Não foi possível registrar o aceite.');
        mercadoPagoTermsDialog.close();
        if (platformFeeTermsMode === 'accept-only') {
          platformFeeTermsMode = 'connect';
          window.location.reload();
          return;
        }
        const form = pendingMercadoPagoConnectForm;
        pendingMercadoPagoConnectForm = null;
        form.dataset.termsConfirmed = 'true';
        form.requestSubmit();
      } catch (error) {
        confirmPlatformFeeTerms.disabled = false;
        mostrarErroAdministrativo({ message: error.message });
      }
    });

    document.querySelector('[data-mercado-pago-accept-terms]')?.addEventListener('click', () => {
      pendingMercadoPagoConnectForm = null;
      platformFeeTermsMode = 'accept-only';
      platformFeeTermsCheckbox.checked = false;
      confirmPlatformFeeTerms.disabled = true;
      confirmPlatformFeeTerms.textContent = 'Aceitar termos';
      mercadoPagoTermsDialog.showModal();
    });

    document.addEventListener('submit', async event => {
      const form = event.target.closest?.('[data-mercado-pago-connect]');
      if (!form) return;
      event.preventDefault();
      if (form.dataset.termsConfirmed !== 'true') {
        pendingMercadoPagoConnectForm = form;
        platformFeeTermsMode = 'connect';
        confirmPlatformFeeTerms.textContent = 'Continuar e conectar';
        mercadoPagoTermsDialog.showModal();
        return;
      }
      delete form.dataset.termsConfirmed;
      if (form.dataset.submitting === 'true') return;

      const button = form.querySelector('button[type="submit"]');
      const originalText = button?.textContent || '';
      form.dataset.submitting = 'true';
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Abrindo Mercado Pago...';
      }

      try {
        const response = await adminFetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        });
        const payload = await response.clone().json().catch(() => ({}));
        if (!response.ok || !payload.authorizationUrl) {
          const error = new Error(payload.message || 'Não foi possível iniciar a conexão com o Mercado Pago.');
          error.code = payload.code || 'MERCADO_PAGO_OAUTH_FAILED';
          error.correlationId = payload.correlationId;
          throw error;
        }
        const target = new URL(payload.authorizationUrl);
        if (target.protocol !== 'https:' || !['auth.mercadopago.com', 'www.mercadopago.com.br', 'www.mercadopago.com'].includes(target.hostname)) {
          throw new Error('O servidor retornou um endereço de autorização inválido.');
        }
        window.location.assign(target.toString());
      } catch (error) {
        delete form.dataset.submitting;
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.textContent = originalText;
        }
        mostrarErroAdministrativo({
          code: error.code || 'MERCADO_PAGO_OAUTH_FAILED',
          message: error.message,
          correlationId: error.correlationId,
        });
      }
    });

    const pageInfo = {
      dashboard: [
        'Visão geral',
        'Acompanhe os dados do seu estabelecimento.'
      ],

      pedidos: [
        'Pedidos',
        'Acompanhe pedidos de mesas, delivery e retirada no local.'
      ],

      relatorios: [
        'Relatórios',
        'Resultados calculados a partir dos pedidos.'
      ],

      estoque: [
        'Estoque',
        'Controle categorias, insumos e níveis mínimos.'
      ],

      catalogo: [
        'Catálogo',
        'Gerencie os produtos exibidos aos clientes.'
      ],

      mesas: [
        'Mesas',
        'Controle contas, pedidos, status, links e QR Codes.'
      ],

      funcionarios: [
        'Funcionários',
        'Cadastre a equipe e defina permissões.'
      ],

      whatsapp: [
        'WhatsApp API',
        'Automatize respostas, menus, status de pedidos e atendimento humano.'
      ],

      configuracoes: [
        'Configurações',
        'Perfil, catálogo e impressora do estabelecimento.'
      ]
    };

    const links = document.querySelectorAll(
      '.menu-link'
    );

    const pages = document.querySelectorAll(
      '.page'
    );

    const pageTitle = document.querySelector(
      '#pageTitle'
    );

    const pageSubtitle = document.querySelector(
      '#pageSubtitle'
    );

    const sidebar = document.querySelector(
      '#sidebar'
    );

    const overlay = document.querySelector(
      '#overlay'
    );

    function showPage(pageName) {
      const targetPage = document.querySelector(
        `#page-${pageName}`
      );

      if (!targetPage) {
        return;
      }


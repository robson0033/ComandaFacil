async function verificarNovosPedidos() {
  if (!pollingPedidosAtivo || sessionRedirectInProgress || verificandoPedidos) {
    return;
  }

  verificandoPedidos = true;
  const pollController = new AbortController();
  pedidosPollAbortController = pollController;

  try {
    const url =
      `/admin/api/pedidos/novos?de=${encodeURIComponent(
        ultimaVerificacaoPedidos
      )}`;

    const response =
      await adminFetch(url, {
        signal: pollController.signal,
        headers: {
          Accept:
            'application/json',
        },
      });

    if (!response.ok) {
      return;
    }

    const result =
      await response.json();

    if (!result.success) {
      return;
    }

    ultimaVerificacaoPedidos =
      result.agora ||
      new Date().toISOString();

    const mesasParaAtualizar = new Set();

    result.pedidos.forEach(
      pedido => {
        const existing = document.querySelector(
          `[data-order-id="${CSS.escape(pedido.id)}"]`
        );

        if (existing) {
          const estaDentroDeComanda = Boolean(existing.closest('[data-mesa-open-card]'));
          const deixouDeEstarAberto =
            pedido.pagamentoStatus !== 'pendente' ||
            pedido.status === 'cancelado';

          if (estaDentroDeComanda && pedido.canal === 'mesa') {
            const cardMesa = existing.closest('[data-mesa-open-card]');
            const mesaId = pedido.mesaId || cardMesa?.dataset?.mesaOpenCard || '';
            if (mesaId) mesasParaAtualizar.add(String(mesaId));
            return;
          }

          const badge = existing.querySelector('[data-payment-status-badge]');
          if (badge) {
            badge.className = `status ${pedido.pagamentoStatus || 'pendente'}`;
            badge.textContent = pedido.pagamentoStatus === 'expirado'
              ? 'Pagamento expirado'
              : pedido.pagamentoStatus === 'expiracao_pendente'
                ? 'Expiração pendente'
                : String(pedido.pagamentoStatus || 'pendente').replaceAll('_', ' ');
          }
          const statusText = existing.querySelector('[data-payment-status-text]');
          if (statusText) statusText.innerHTML = `<strong>Status do pagamento:</strong> ${escaparHtml(pedido.pagamentoStatus === 'expirado' ? 'Pagamento expirado' : (pedido.pagamentoStatus === 'expiracao_pendente' ? 'Expiração pendente' : String(pedido.pagamentoStatus || 'pendente').replaceAll('_', ' ')))}`;
          const methodText = existing.querySelector('[data-payment-method-text]');
          if (methodText) methodText.innerHTML = `<strong>Forma de pagamento:</strong> ${escaparHtml(textoFormaPagamentoPedido(pedido))}`;
          const dateText = existing.querySelector('[data-payment-date-text]');
          if (dateText) dateText.innerHTML = `<strong>Data/hora do pagamento:</strong> ${pedido.pagoEm ? escaparHtml(formatarDataPedido(pedido.pagoEm)) : 'Ainda não confirmado'}`;
          return;
        }

        const novoPedidoMesaAberto =
          pedido.canal === 'mesa' &&
          Boolean(pedido.mesaId) &&
          pedido.pagamentoStatus === 'pendente' &&
          pedido.status !== 'cancelado';

        const canceladoPorTrocaComComandaAindaAberta =
          pedido.canal === 'mesa' &&
          Boolean(pedido.mesaId) &&
          pedido.remocaoSolicitacaoStatus === 'aprovada' &&
          (
            pedido.status === 'cancelado' ||
            pedido.pagamentoStatus === 'cancelado'
          ) &&
          Boolean(document.querySelector(
            `[data-mesa-open-card="${CSS.escape(String(pedido.mesaId))}"]`
          ));

        if (novoPedidoMesaAberto) {
          if (pedido.mesaId) mesasParaAtualizar.add(String(pedido.mesaId));
        } else if (canceladoPorTrocaComComandaAindaAberta) {
          // O item cancelado por troca já saiu da comanda aberta.
          // Não crie um segundo card "cancelado" enquanto a mesa ainda
          // possuir outros pedidos pendentes.
          mesasParaAtualizar.add(String(pedido.mesaId));
        } else {
          if (ordersEmptyState) {
            ordersEmptyState.remove();
          }

          if (ordersGrid) {
            const card = criarCardPedido(pedido);
            ordersGrid.prepend(card);
            applyOrdersFilters();
          }
        }

        quantidadeNaoVisualizada += 1;
        mostrarToastPedido(pedido);
        tocarSomNovoPedido();
        mostrarNotificacaoDoSistema(pedido);

        if (document.hidden || !document.hasFocus()) {
          destacarTituloNovoPedido();
        }
      }
    );

    atualizarBadgePedidos();

    if (mesasParaAtualizar.size) {
      await Promise.all(
        [...mesasParaAtualizar].map(mesaId => atualizarComandaMesaSemReload(mesaId))
      );
    }
  } catch (error) {
    if (error?.name !== 'AbortError' && !sessionRedirectInProgress) {
      console.error(
        'Erro ao verificar pedidos:',
        error
      );
    }
  } finally {
    if (pedidosPollAbortController === pollController) {
      pedidosPollAbortController = null;
    }
    verificandoPedidos = false;
  }
}


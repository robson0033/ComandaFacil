function normalizeOrderSearch(value = '') {
  return String(value)
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9@.]+/g, ' ')
    .trim();
}

function buildOrderSearchText(pedido = {}) {
  return normalizeOrderSearch([
    pedido.numero,
    pedido.codigoPublico,
    pedido.id,
    pedido.cliente,
    pedido.telefone,
    pedido.telefoneCliente,
    pedido.email,
    pedido.emailCliente,
    pedido.rua,
    pedido.ruaEntrega,
    pedido.endereco,
    pedido.enderecoEntrega,
    pedido.numeroEndereco,
    pedido.numeroEntrega,
    pedido.bairro,
    pedido.bairroEntrega,
    pedido.referencia,
    pedido.referenciaEntrega,
    pedido.cidadeEntrega,
    pedido.cidadeEntregaUf,
    pedido.origem?.texto,
    pedido.canal,
  ].filter(Boolean).join(' '));
}

function filterOrdersByText() {
  const searchInput = document.querySelector('#ordersTextSearch');
  if (!searchInput) return;

  const query = normalizeOrderSearch(searchInput.value);
  const terms = query.split(/\s+/).filter(Boolean);
  const orderCards = [...document.querySelectorAll('#ordersGrid .order-card')];
  const visibleCount = document.querySelector('#ordersVisibleCount');
  const noResults = document.querySelector('#ordersSearchNoResults');
  let visible = 0;

  orderCards.forEach(card => {
    const indexedText = card.dataset?.orderSearch || '';
    const renderedText = card.textContent || '';
    const searchable = normalizeOrderSearch(`${indexedText} ${renderedText}`);
    const matches = terms.every(term => searchable.includes(term));

    card.classList.toggle('order-filter-hidden', !matches);
    if (matches) visible += 1;
  });

  if (visibleCount) {
    visibleCount.textContent = String(visible);
  }

  if (noResults) {
    noResults.classList.toggle(
      'visible',
      orderCards.length > 0 && visible === 0
    );
  }
}

function initializeOrdersTextSearch() {
  const searchInput = document.querySelector('#ordersTextSearch');
  if (!searchInput) return;

  if (searchInput.dataset.ordersSearchReady !== 'true') {
    searchInput.dataset.ordersSearchReady = 'true';
    searchInput.addEventListener('input', filterOrdersByText);
    searchInput.addEventListener('search', filterOrdersByText);
  }

  filterOrdersByText();
}

function applyOrdersFilters() {
  // Os filtros de período, canal e status são aplicados pelo servidor.
  // A pesquisa textual continua sendo aplicada no navegador, inclusive
  // quando um novo pedido entra em tempo real.
  filterOrdersByText();
}


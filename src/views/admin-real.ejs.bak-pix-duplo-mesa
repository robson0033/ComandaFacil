            <% }) %>
          </div>
        </section>

        <section class="panel">
          <div class="panel-header">
            <div class="panel-title">
              <h2>Itens de estoque</h2>

              <p>
                Dados reais de quantidade, mínimo e custo.
              </p>
            </div>

            <button
              type="button"
              class="button open-modal"
              data-modal="modalEstoque"
            >
              + Novo item
            </button>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Categoria</th>
                  <th>Cadastrado</th>
                  <th>Restante</th>
                  <th>Consumido</th>
                  <th>Mínimo</th>
                  <th>Custo unitário</th>
                  <th>Status</th>
                  <th>Ações</th>
                </tr>
              </thead>

              <tbody>
                <% if (!listaEstoque.length) { %>
                  <tr>
                    <td colspan="9" class="empty">
                      Nenhum item cadastrado.
                    </td>
                  </tr>
                <% } %>

                <% listaEstoque.forEach(item => { %>
                  <tr>
                    <td data-label="Item">
                      <strong><%= item.nome %></strong>
                    </td>

                    <td data-label="Categoria">
                      <%= item.categoriaId?.nome || '-' %>
                    </td>

                    <%
                      const numeroSeguro = valor => {
                        const numero = Number(valor);
                        return Number.isFinite(numero) ? numero : 0;
                      };
                      const formatarQuantidade = valor =>
                        numeroSeguro(valor).toLocaleString('pt-BR', {
                          maximumFractionDigits: 3
                        });
                      const quantidadeRestante = numeroSeguro(item.quantidade);
                      const possuiAcumuladores =
                        item.totalEntradas !== undefined &&
                        item.totalConsumido !== undefined;
                      const quantidadeCadastrada = possuiAcumuladores
                        ? numeroSeguro(item.totalEntradas)
                        : null;
                      const quantidadeConsumida = possuiAcumuladores
                        ? Math.max(0, numeroSeguro(item.totalConsumido))
                        : null;
                      const percentualRestante = quantidadeCadastrada > 0
                        ? Math.max(0, Math.min(100, (quantidadeRestante / quantidadeCadastrada) * 100))
                        : 0;
                    %>

                    <td data-label="Cadastrado">
                      <strong>
                        <%= quantidadeCadastrada === null ? 'Revisar' : formatarQuantidade(quantidadeCadastrada) %>
                        <%= quantidadeCadastrada === null ? '' : item.unidade %>
                      </strong>
                    </td>

                    <td data-label="Restante">
                      <strong><%= formatarQuantidade(quantidadeRestante) %> <%= item.unidade %></strong>
                      <div style="margin-top:6px;height:7px;background:#eee;border-radius:999px;overflow:hidden;min-width:110px;">
                        <div style="height:100%;width:<%= percentualRestante.toFixed(1) %>%;background:<%= percentualRestante <= 20 ? '#dc2626' : percentualRestante <= 40 ? '#f59e0b' : '#16a34a' %>;border-radius:999px;"></div>
                      </div>
                      <small><%= percentualRestante.toFixed(1).replace('.', ',') %>% restante</small>
                    </td>

                    <td data-label="Consumido">
                      <%= quantidadeConsumida === null ? 'Revisar' : formatarQuantidade(quantidadeConsumida) %>
                      <%= quantidadeConsumida === null ? '' : item.unidade %>
                    </td>

                    <td data-label="Mínimo">
                      <%= item.minimo %>
                    </td>

                    <td data-label="Custo">
                      <%= formatarMoeda(
                        item.custoUnitario
                      ) %>
                    </td>

                    <td data-label="Status">
                      <span
                        class="status <%= Number(item.quantidade) <= Number(item.minimo)
                          ? 'baixo'
                          : 'disponivel'
                        %>"
                      >
                        <%= Number(item.quantidade) <= Number(item.minimo)
                          ? 'Estoque baixo'
                          : 'Disponível'
                        %>
                      </span>
                    </td>

                    <td data-label="Ações">
                      <form
                        action="/admin/estoque/<%= item._id %>/excluir"
                        method="POST"
                        data-delete-stock
                      >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button
                          type="submit"
                          class="mini-button delete"
                        >
                          Excluir
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </section>
      <% } %>


    function unidadeNormalizada(unidade) {
      const valor = String(unidade || '').toLowerCase();
      if (['kg', 'quilo', 'quilos'].includes(valor)) return 'kg';
      if (['g', 'grama', 'gramas'].includes(valor)) return 'g';
      if (['l', 'litro', 'litros'].includes(valor)) return 'l';
      if (['ml', 'mililitro', 'mililitros'].includes(valor)) return 'ml';
      return 'un';
    }

    function unidadesPermitidas(unidadeEstoque) {
      const unidade = unidadeNormalizada(unidadeEstoque);
      if (['kg', 'g'].includes(unidade)) return ['g', 'kg'];
      if (['l', 'ml'].includes(unidade)) return ['ml', 'l'];
      return ['un'];
    }

    function converterParaUnidadeEstoque(quantidade, unidadeConsumo, unidadeEstoque) {
      const origem = unidadeNormalizada(unidadeConsumo);
      const destino = unidadeNormalizada(unidadeEstoque);
      if (origem === destino) return quantidade;
      if (origem === 'g' && destino === 'kg') return quantidade / 1000;
      if (origem === 'kg' && destino === 'g') return quantidade * 1000;
      if (origem === 'ml' && destino === 'l') return quantidade / 1000;
      if (origem === 'l' && destino === 'ml') return quantidade * 1000;
      return quantidade;
    }

    function formatarQuantidadeEstoque(valor) {
      const numero = Number(valor);
      if (!Number.isFinite(numero)) return '0';
      return numero.toLocaleString('pt-BR', {
        minimumFractionDigits: 0,
        maximumFractionDigits: 3,
      });
    }


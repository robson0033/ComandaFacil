    function atualizarCardMesa(
      resumo
    ) {
      const mesaId =
        String(resumo?.id || '');

      if (!mesaId) {
        return;
      }

      resumoMesasPorId.set(
        mesaId,
        resumo
      );

      const card =
        document.querySelector(
          `[data-mesa-card="${CSS.escape(mesaId)}"]`
        );

      if (!card) {
        return;
      }

      const status =
        String(
          resumo.status || 'livre'
        );

      [
        'livre',
        'ocupada',
        'aguardando_pagamento',
        'paga',
        'reservada',
        'inativa'
      ].forEach(nomeStatus => {
        card.classList.remove(
          nomeStatus
        );
      });

      card.classList.add(status);

      const statusBadge =
        card.querySelector(
          '[data-mesa-status]'
        );

      if (statusBadge) {
        statusBadge.className =
          `status ${status}`;
        statusBadge.textContent =
          statusMesaTexto(status);
      }

      const total =
        card.querySelector(
          '[data-mesa-total]'
        );

      if (total) {
        total.textContent =
          formatarTotalMesa(
            resumo.totalCentavos
          );
      }

      const quantidade =
        Math.max(
          0,
          Number(
            resumo.quantidadePedidos ||
            0
          )
        );

      const quantidadeElemento =
        card.querySelector(
          '[data-mesa-pedidos]'
        );

      if (quantidadeElemento) {
        quantidadeElemento.textContent =
          `${quantidade} pedido(s) em aberto`;
      }

      const pagamentoForm =
        card.querySelector(
          '.pagamento-form'
        );

      if (pagamentoForm) {
        pagamentoForm.dataset.totalCentavos =
          String(
            Math.max(
              0,
              Number(
                resumo.totalCentavos ||
                0
              )
            )
          );

        const formaPagamento =
          pagamentoForm.querySelector(
            '[data-forma-pagamento-mesa]'
          );

        if (
          formaPagamento?.value ===
          'combinado'
        ) {
          formaPagamento.dispatchEvent(
            new Event(
              'change',
              { bubbles: true }
            )
          );
        }
      }

      const statusSelect =
        card.querySelector(
          '.status-form select[name="status"]'
        );

      if (
        statusSelect &&
        [...statusSelect.options].some(
          option =>
            option.value === status
        )
      ) {
        statusSelect.value =
          status;
      }

      const imprimirButton =
        card.querySelector(
          '[data-print-mesa]'
        );

      if (imprimirButton) {
        imprimirButton.dataset.mesaPedidos =
          String(quantidade);

        const ocupado =
          imprimirButton.dataset.printBusy ===
          'true';

        imprimirButton.disabled =
          !printAgentConectado ||
          ocupado ||
          quantidade <= 0;
      }
    }

    async function atualizarResumoMesas({
      force = false
    } = {}) {
      if (
        document.hidden ||
        (
          !force &&
          !paginaMesasAtiva()
        )
      ) {
        return null;
      }

      if (
        atualizacaoResumoMesasPromise
      ) {
        return atualizacaoResumoMesasPromise;
      }

      atualizacaoResumoMesasPromise =
        (async () => {
          try {
            const response =
              await adminFetch(
                '/admin/api/mesas/resumo',
                {
                  skipAdminLoading: true,
                  headers: {
                    Accept:
                      'application/json'
                  }
                }
              );

            if (!response.ok) {
              return null;
            }

            const result =
              await response.json();

            if (
              !result.success ||
              !Array.isArray(result.mesas)
            ) {
              return null;
            }

            result.mesas.forEach(
              atualizarCardMesa
            );

            return result;
          } catch (error) {
            console.error(
              'Não foi possível atualizar as mesas:',
              error
            );
            return null;
          }
        })();

      try {
        return await atualizacaoResumoMesasPromise;
      } finally {
        atualizacaoResumoMesasPromise =
          null;
      }
    }

    async function imprimirPedidosDaMesa(
      button
    ) {
      const mesaId =
        String(
          button?.dataset?.printMesa ||
          ''
        );

      if (
        !mesaId ||
        button.dataset.printBusy ===
          'true'
      ) {
        return;
      }

      await atualizarResumoMesas({
        force: true
      });

      const resumo =
        resumoMesasPorId.get(
          mesaId
        );

      const quantidade = Number(
        resumo?.quantidadePedidos || 0
      );

      if (quantidade <= 0) {
        window.alert(
          'Esta mesa não possui pedidos em aberto para imprimir.'
        );
        atualizarCardMesa({
          ...(resumo || {}),
          id: mesaId,
          quantidadePedidos: 0,
          totalCentavos:
            resumo?.totalCentavos || 0,
          pedidoIds: []
        });
        return;
      }

      const numeroMesa =
        resumo?.numero ||
        button
          .closest(
            '[data-mesa-card], [data-mesa-open-card]'
          )
          ?.dataset.mesaNumero ||
        '';

      const totalCentavos = Math.max(
        0,
        Number(resumo?.totalCentavos || 0)
      );
      const totalTexto =
        (totalCentavos / 100)
          .toLocaleString('pt-BR', {
            style: 'currency',
            currency: 'BRL'
          });

      const confirmado =
        window.confirm(
          `Imprimir UMA ÚNICA comanda da Mesa ${numeroMesa} com ${quantidade} pedido(s)?`
          + `\nTotal da comanda: ${totalTexto}`
          + '\n\nTodos os itens sairão juntos no mesmo papel em cada impressora de Mesa configurada.'
        );

      if (!confirmado) {
        return;
      }

      const textoOriginal =
        button.textContent;

      button.dataset.printBusy =
        'true';
      button.disabled = true;
      button.textContent =
        'Enfileirando comanda...';

      try {
        const pedidoReferenciaId =
          Array.isArray(resumo?.pedidoIds)
            ? resumo.pedidoIds
                .map(item => String(item || '').trim())
                .find(Boolean)
            : '';

        if (!pedidoReferenciaId) {
          throw new Error(
            'Não foi possível identificar um pedido aberto desta mesa. Atualize a página e tente novamente.'
          );
        }

        const response = await adminFetch(
          `/admin/agente/pedidos/${encodeURIComponent(pedidoReferenciaId)}/imprimir`,
          {
            method: 'POST',
            skipAdminLoading: true,
            headers: {
              'Content-Type':
                'application/json'
            },
            body: JSON.stringify({
              confirmReprint: true,
              scope: 'mesa_comanda'
            })
          }
        );

        const contentType = String(
          response.headers.get('content-type') || ''
        ).toLowerCase();

        let result = {};
        if (contentType.includes('application/json')) {
          result = await response.json();
        } else {
          await response.text().catch(() => '');
          const mensagem = response.status === 404
            ? 'A rota de impressão não está disponível nesta versão do servidor. Faça o deploy do backend atualizado e tente novamente.'
            : `O servidor devolveu uma resposta inválida ao imprimir a comanda (HTTP ${response.status}). Atualize a página e tente novamente.`;
          const erroResposta = new Error(mensagem);
          erroResposta.code = 'PRINT_NON_JSON_RESPONSE';
          throw erroResposta;
        }

        if (!response.ok) {
          throw new Error(
            result.message ||
            'Não foi possível imprimir a comanda da mesa.'
          );
        }

        button.textContent =
          result.status === 'aguardando_agente'
            ? '🖨 Comanda aguardando agente'
            : '🖨 Comanda na fila';

        window.setTimeout(
          () => {
            if (
              button.dataset.printBusy !==
              'true'
            ) {
              button.textContent =
                textoOriginal;
            }
          },
          3000
        );
      } catch (error) {
        window.alert(
          error?.message ||
          'Não foi possível imprimir a comanda da mesa.'
        );
        button.textContent =
          textoOriginal;
      } finally {
        delete button.dataset.printBusy;

        const quantidadeAtual =
          Number(
            resumoMesasPorId
              .get(mesaId)
              ?.quantidadePedidos ||
            quantidade
          );

        button.disabled =
          !printAgentConectado ||
          quantidadeAtual <= 0;
      }
    }

    document.addEventListener(
      'click',
      event => {
        const button =
          event.target.closest(
            '[data-print-mesa]'
          );

        if (!button) {
          return;
        }

        void imprimirPedidosDaMesa(
          button
        );
      }
    );

    document
      .querySelector(
        '.menu-link[data-page="mesas"]'
      )
      ?.addEventListener(
        'click',
        () => {
          window.setTimeout(
            () => {
              void atualizarResumoMesas({
                force: true
              });
            },
            0
          );
        }
      );

    document.addEventListener(
      'visibilitychange',
      () => {
        if (
          !document.hidden &&
          paginaMesasAtiva()
        ) {
          void atualizarResumoMesas({
            force: true
          });
        }
      }
    );

    window.setInterval(
      () => {
        void atualizarResumoMesas();
      },
      4000
    );

    if (paginaMesasAtiva()) {
      void atualizarResumoMesas({
        force: true
      });
    }


  </script>

</body>
</html>
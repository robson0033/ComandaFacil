async function acompanharJobsImpressao(jobIds, button) {
  const ids = Array.isArray(jobIds) ? jobIds : [jobIds];
  const consultar = async jobId => {
    const response = await adminFetch(
      `${printAgentUrl}/jobs/${encodeURIComponent(jobId)}`
    );
    return response.ok ? response.json() : null;
  };
  const aguardar = ms => new Promise(resolve => setTimeout(resolve, ms));

  const mostrarModal = async result => {
    const modal = document.querySelector('#modalStatusImpressao');
    const detalhe = document.querySelector('#detalheStatusImpressao');
    const metadados = document.querySelector('#metadadosStatusImpressao');
    const consultarButton = document.querySelector('#consultarStatusImpressao');
    const retryButton = document.querySelector('#retryStatusImpressao');
    const confirmarButton = document.querySelector('#confirmarStatusImpressao');
    const cancelarButton = document.querySelector('#cancelarConciliacaoImpressao');
    if (!modal || !detalhe || !metadados) return;

    const jobId = result.job.jobId;
    const render = current => {
      const job = current?.job || result.job;
      const mensagens = {
        aguardando_agente: 'O agente está offline. O trabalho será entregue quando ele reconectar.',
        recebido: 'O agente recebeu o trabalho.',
        processando: 'O trabalho está sendo processado.',
        enviado: 'Os bytes foram aceitos pelo spooler ou pela rede; aguardando confirmação final.',
        concluido: 'A impressão foi concluída pelo agente.',
        falhou: job.erro || 'A impressão falhou antes da conclusão.',
        resultado_desconhecido: 'O agente não conseguiu confirmar se os bytes resultaram em impressão.'
      };
      detalhe.textContent = mensagens[job.status] || 'Trabalho aguardando processamento.';
      metadados.textContent =
        `Job ${String(job.jobId).slice(0, 8)} · ${job.tentativas || 0} tentativa(s)`
        + (job.erro ? ` · ${job.erro}` : '');
      const unknown = job.status === 'resultado_desconhecido';
      retryButton.hidden = !unknown;
      confirmarButton.hidden = !unknown;
      cancelarButton.hidden = !unknown;
      return job;
    };

    render(result);
    modal.classList.add('ativo');
    consultarButton.onclick = async () => {
      consultarButton.disabled = true;
      detalhe.textContent = 'Consultando o estado persistido no agente...';
      try {
        const current = await consultar(jobId);
        const job = render(current);
        if (job?.status === 'concluido') button.textContent = 'Concluído';
      } finally {
        consultarButton.disabled = false;
      }
    };
    cancelarButton.onclick = () => modal.classList.remove('ativo');
    const reconciliar = async action => {
      const response = await adminFetch(
        `${printAgentUrl}/jobs/${encodeURIComponent(jobId)}/reconcile`,
        {
          method: 'POST',
          skipAdminLoading: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        }
      );
      const body = await response.json();
      if (!response.ok) throw new Error(body.message || 'Não foi possível conciliar a impressão.');
      button.textContent = body.status === 'concluido' ? 'Concluído' : 'Na fila';
      modal.classList.remove('ativo');
    };
    confirmarButton.onclick = () => reconciliar('confirmar_concluido').catch(error => {
      detalhe.textContent = error.message;
    });
    retryButton.onclick = () => reconciliar('liberar_retry').catch(error => {
      detalhe.textContent = error.message;
    });
  };

  for (let tentativa = 0; tentativa < 40; tentativa += 1) {
    await aguardar(1500);
    const respostas = await Promise.all(ids.map(consultar));
    const statuses = respostas
      .map(result => result?.job?.status)
      .filter(Boolean);
    if (
      statuses.length === ids.length &&
      statuses.every(status => status === 'concluido')
    ) {
      button.textContent = 'Concluído';
      return;
    }
    if (statuses.some(status =>
      status === 'falhou' || status === 'cancelado'
    )) {
      button.textContent = 'Falhou';
      return;
    }
    const desconhecido = respostas.find(result =>
      result?.job?.status === 'resultado_desconhecido'
    );
    if (desconhecido) {
      const jobId = desconhecido.job.jobId;
      let atual = desconhecido;
      for (const espera of [0, 2000, 5000, 10000]) {
        if (espera) await aguardar(espera);
        atual = await consultar(jobId) || atual;
        if (atual?.job?.status !== 'resultado_desconhecido') break;
      }
      if (atual?.job?.status === 'concluido') {
        button.textContent = 'Concluído';
        return;
      }
      if (atual?.job?.status === 'resultado_desconhecido') {
        button.textContent = 'Verificar impressão';
        await mostrarModal(atual);
        return;
      }
      continue;
    }
    if (statuses.some(status => status === 'enviado')) {
      button.textContent = 'Aguardando confirmação';
    } else if (statuses.some(status => status === 'processando' || status === 'recebido')) {
      button.textContent = 'Processando';
    } else if (statuses.some(status => status === 'aguardando_agente')) {
      button.textContent = 'Agente offline';
    } else {
      button.textContent = 'Na fila';
    }
  }
  button.textContent = 'Na fila';
}


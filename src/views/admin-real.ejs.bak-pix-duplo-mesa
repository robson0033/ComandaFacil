}

.chart-title {
  margin-bottom: 20px;
  text-align: center;
}

.chart-title h3 {
  font-size: 20px;
  line-height: 1.4;
}

.chart-wrapper {
  display: grid;
  grid-template-columns: 70px minmax(0, 1fr);
  gap: 14px;
  align-items: end;
}

.chart-y {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 280px;
  padding-bottom: 30px;
  color: var(--cinza-600);
  font-size: 12px;
  font-weight: 700;
}

.chart-area {
  position: relative;
  min-width: 0;
  height: 280px;
  border-left: 2px solid #d9d9d9;
  border-bottom: 2px solid #d9d9d9;
  padding: 0 8px 0 18px;
  overflow-x: auto;
}

.chart-bars {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(52px, 1fr));
  gap: 18px;
  align-items: end;
  height: 100%;
}

.chart-bars.hourly {
  grid-template-columns: repeat(24, minmax(48px, 1fr));
  min-width: 1240px;
}

.chart-bar-item {
  display: flex;
  flex-direction: column;
  justify-content: end;
  align-items: center;
  height: 100%;
  min-width: 0;
}

.chart-bar {
  width: 100%;
  max-width: 58px;
  border-radius: 0;
  background: #07124f;
  transition: 0.2s;
}

.chart-bar:hover {
  opacity: 0.85;
  transform: translateY(-2px);
}

.chart-bar-value {
  margin-bottom: 8px;
  color: var(--cinza-700);
  font-size: 11px;
  font-weight: 800;
  text-align: center;
}

.chart-label {
  margin-top: 10px;
  color: var(--cinza-800);
  font-size: 13px;
  font-weight: 800;
  text-align: center;
}

.category-sales-panel {
  margin-top: 20px;
}

.category-sales-scroll {
  max-height: 340px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  border: 1px solid var(--cinza-200);
  border-radius: 14px;
  background: #fff;
}

.category-sales-head,
.category-sales-row {
  display: grid;
  grid-template-columns: minmax(150px, 0.9fr) minmax(220px, 2fr) minmax(110px, 0.55fr);
  align-items: center;
  gap: 14px;
}

.category-sales-head {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 11px 14px;
  border-bottom: 1px solid var(--cinza-200);
  background: #fffaf7;
  color: var(--cinza-700);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.category-sales-row {
  min-height: 52px;
  padding: 9px 14px;
  border-bottom: 1px solid var(--cinza-100);
}

.category-sales-row:last-child {
  border-bottom: 0;
}

.category-sales-row:hover {
  background: #fffaf7;
}

.category-sales-category {
  min-width: 0;
}

.category-sales-category span {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  padding: 6px 9px;
  overflow: hidden;
  border: 1px solid #ffd8c5;
  border-radius: 999px;
  background: #fff1e9;
  color: #a63f13;
  font-size: 12px;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-sales-product {
  min-width: 0;
  color: var(--cinza-900);
  font-size: 13px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.category-sales-product.muted {
  color: var(--cinza-500);
  font-weight: 700;
}

.category-sales-qty {
  justify-self: end;
  min-width: 64px;
  padding: 7px 10px;
  border-radius: 999px;
  background: #dcf6e8;
  color: #177544;
  text-align: center;
  font-size: 13px;
  font-weight: 950;
}

.category-sales-qty.zero {
  background: #f2f3f5;
  color: var(--cinza-500);
}

/* Resumo consolidado por categoria: usa os mesmos dados filtrados da lista de produtos. */
.category-summary-panel {
  margin-top: 16px;
}

.category-summary-scroll {
  max-height: 260px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  border: 1px solid var(--cinza-200);
  border-radius: 14px;
  background: #fff;
}

.category-summary-head,
.category-summary-row {
  display: grid;
  grid-template-columns: minmax(180px, 1.5fr) minmax(110px, .65fr) minmax(130px, .8fr);
  align-items: center;
  gap: 14px;
}

.category-summary-head {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 11px 14px;
  border-bottom: 1px solid var(--cinza-200);
  background: #fffaf7;
  color: var(--cinza-700);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.category-summary-row {
  min-height: 50px;
  padding: 9px 14px;
  border-bottom: 1px solid var(--cinza-100);
}

.category-summary-row:last-child {
  border-bottom: 0;
}

.category-summary-row:hover {
  background: #fffaf7;
}

.category-summary-name {
  min-width: 0;
  color: var(--cinza-900);
  font-size: 13px;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.category-summary-qty {
  justify-self: end;
  min-width: 64px;
  padding: 7px 10px;
  border-radius: 999px;
  background: #dcf6e8;
  color: #177544;
  text-align: center;
  font-size: 13px;
  font-weight: 950;
}

.category-summary-qty.zero {
  background: #f2f3f5;
  color: var(--cinza-500);
}

.category-summary-value {
  justify-self: end;
  color: var(--cinza-900);
  font-size: 13px;
  font-weight: 950;
  text-align: right;
}

.category-summary-value.zero {
  color: var(--cinza-500);
}

.category-summary-total {
  display: flex;
  justify-content: flex-end;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid #ffe0cf;
  border-radius: 12px;
  background: #fff8f3;
}

.category-summary-total span {
  color: var(--cinza-600);
  font-size: 12px;
  font-weight: 800;
}

.category-summary-total strong {
  margin-left: 6px;
  color: var(--cinza-950);
  font-size: 14px;
}

@media (max-width: 900px) {
  .chart-wrapper {
    grid-template-columns: 1fr;
  }

  .chart-y {
    display: none;
  }

  .category-sales-scroll {
    max-height: 310px;
  }

  .category-sales-head,
  .category-sales-row {
    grid-template-columns: minmax(92px, .8fr) minmax(130px, 1.5fr) 72px;
    gap: 8px;
  }

  .category-sales-head {
    padding: 9px 10px;
    font-size: 9px;
  }

  .category-sales-row {
    padding: 8px 10px;
  }

  .category-sales-category span,
  .category-sales-product,
  .category-sales-qty {
    font-size: 11px;
  }

  .category-summary-scroll {
    max-height: 230px;
  }

  .category-summary-head,
  .category-summary-row {
    grid-template-columns: minmax(100px, 1fr) 70px minmax(92px, .8fr);
    gap: 8px;
  }

  .category-summary-head {
    padding: 9px 10px;
    font-size: 9px;
  }

  .category-summary-row {
    padding: 8px 10px;
  }

  .category-summary-name,
  .category-summary-qty,
  .category-summary-value {
    font-size: 11px;
  }

  .category-summary-total {
    justify-content: space-between;
    gap: 8px 12px;
  }
}


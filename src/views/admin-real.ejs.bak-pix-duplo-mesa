    .payment-breakdown-card.pix::after {
      background: rgba(39, 104, 199, 0.1);
    }

    .payment-breakdown-card.cartao::after {
      background: rgba(101, 17, 17, 0.09);
    }

    .payment-breakdown-card.nao-informado::after {
      background: rgba(129, 129, 129, 0.1);
    }

    .payment-breakdown-card span {
      position: relative;
      z-index: 1;
      color: var(--cinza-600);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    .payment-breakdown-card strong {
      position: relative;
      z-index: 1;
      color: var(--cinza-950);
      font-size: clamp(22px, 2vw, 30px);

    document.addEventListener('submit', event => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return;
      if (form.matches('[data-admin-loading-skip]')) return;
      const method = String(form.method || 'GET').toUpperCase();
      const target = new URL(form.action || window.location.href, window.location.href);
      if (!mutatingAdminMethods.has(method) || target.origin !== window.location.origin || !target.pathname.startsWith('/admin')) return;
      if (!form.checkValidity()) return;
      if (form.dataset.submitting === 'true') {
        event.preventDefault();
        return;
      }

      const submitter = event.submitter;
      if (submitter?.name) {
        const mirror = document.createElement('input');
        mirror.type = 'hidden';
        mirror.name = submitter.name;
        mirror.value = submitter.value;
        mirror.dataset.adminLoadingSubmitter = 'true';
        form.appendChild(mirror);
      }
      form.dataset.submitting = 'true';
      const action = form.dataset.loadingAction || (
        form.enctype === 'multipart/form-data' ? 'upload' :
        /pagamento/i.test(target.pathname) ? 'payment' :
        /excluir|arquivar|remover/i.test(target.pathname) ? 'delete' :
        /cancelar|desconectar/i.test(target.pathname) ? 'cancel' : 'save'
      );
      const options = {
        ...(window.AdminLoading.messages[action] || window.AdminLoading.messages.default),
        ...(form.dataset.loadingTitle ? { title: form.dataset.loadingTitle } : {}),
        ...(form.dataset.loadingMessage ? { message: form.dataset.loadingMessage } : {}),
      };
      if (submitter?.dataset.loadingTitle) options.title = submitter.dataset.loadingTitle;
      if (submitter?.dataset.loadingMessage) options.message = submitter.dataset.loadingMessage;
      window.AdminLoading.show(options);
      if (submitter) {
        submitter.disabled = true;
        submitter.setAttribute('aria-disabled', 'true');
      }
    });


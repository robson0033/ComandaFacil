            <% } else { %>
              <div class="link-box" style="margin-bottom:14px">Conta ainda não conectada.</div>
              <form action="/admin/mercado-pago/conectar" method="POST" data-mercado-pago-connect>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="button">Conectar minha conta Mercado Pago</button>
              </form>
            <% } %>
          </section>


            </div>
          </article>
        </template>
        <script nonce="<%= cspNonce %>">
          (() => {
            const list = document.getElementById('whatsappMenuOptions');
            const add = document.getElementById('whatsappAddMenuOption');
            const template = document.getElementById('whatsappMenuOptionTemplate');
            if (!list || !add || !template) return;
            const renumber = () => {
              list.querySelectorAll('[data-wa-option]').forEach((card, index) => {
                const title = card.querySelector('.wa-option-title');
                if (title) title.textContent = `Opção ${index + 1}`;
              });
              add.disabled = list.querySelectorAll('[data-wa-option]').length >= 10;
            };
            add.addEventListener('click', () => {
              if (list.querySelectorAll('[data-wa-option]').length >= 10) return;
              const fragment = template.content.cloneNode(true);
              const hiddenId = fragment.querySelector('input[name="menuOpcaoId"]');
              if (hiddenId) hiddenId.value = `op_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
              list.appendChild(fragment);
              renumber();
            });
            list.addEventListener('click', event => {
              const button = event.target.closest('[data-wa-remove]');
              if (!button) return;
              button.closest('[data-wa-option]')?.remove();
              renumber();
            });
            renumber();
          })();
        </script>

    function centavosDeEntradaMonetaria(valor) {
      const texto = String(valor || '').trim().replace(/\s+/g, '').replace(/^R\$/i, '');
      if (!texto) return null;
      let normalizado = '';
      if (/^\d{1,3}(?:\.\d{3})*(?:,\d{1,2})?$/.test(texto)) {
        normalizado = texto.replaceAll('.', '').replace(',', '.');
      } else if (/^\d+(?:,\d{1,2})?$/.test(texto)) {
        normalizado = texto.replace(',', '.');
      } else if (/^\d+(?:\.\d{1,2})?$/.test(texto)) {
        normalizado = texto;
      } else {
        return null;
      }
      const numero = Number(normalizado);
      if (!Number.isFinite(numero) || numero < 0) return null;
      return Math.round(numero * 100);
    }

    function formatarCentavosPagamento(centavos) {
      return (Number(centavos || 0) / 100).toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function atualizarCorrecaoPagamentoCombinado(form) {
      if (!form) return { valido: false, resumo: '' };

      const modo = form.querySelector('[data-correcao-forma-pagamento]');
      const painel = form.querySelector('[data-correcao-pagamento-combinado]');
      const forma1 = form.querySelector('[data-correcao-forma-1]');
      const forma2 = form.querySelector('[data-correcao-forma-2]');
      const valor1 = form.querySelector('[data-correcao-valor-1]');
      const valor2 = form.querySelector('[data-correcao-valor-2]');
      const resumo = form.querySelector('[data-correcao-resumo]');
      const combinado = modo?.value === 'combinado';
      const campos = [forma1, forma2, valor1, valor2].filter(Boolean);

      if (painel) painel.hidden = !combinado;
      campos.forEach(campo => {
        campo.disabled = !combinado;
      });

      if (!combinado) {
        if (valor2) valor2.value = '';
        return { valido: Boolean(modo?.value), resumo: '' };
      }

      if (forma1 && forma2 && forma1.value === forma2.value) {
        const alternativa = [...forma2.options].find(option => option.value !== forma1.value);
        if (alternativa) forma2.value = alternativa.value;
      }

      const totalCentavos = Math.max(0, Number(form.dataset.totalCentavos || 0));
      const primeiroCentavos = centavosDeEntradaMonetaria(valor1?.value);
      const nomes = { dinheiro: 'Dinheiro', pix: 'Pix', cartao: 'Cartão' };

      if (primeiroCentavos === null || primeiroCentavos <= 0 || primeiroCentavos >= totalCentavos) {
        if (valor2) valor2.value = '';
        if (resumo) {
          resumo.textContent = totalCentavos > 1
            ? `Informe um valor entre R$ 0,01 e R$ ${formatarCentavosPagamento(totalCentavos - 1)}.`
            : 'Este pedido não possui valor suficiente para dividir o pagamento.';
        }
        return { valido: false, resumo: '' };
      }

      const segundoCentavos = totalCentavos - primeiroCentavos;
      if (valor2) valor2.value = formatarCentavosPagamento(segundoCentavos);
      const textoResumo = `${nomes[forma1?.value] || '1ª forma'}: R$ ${formatarCentavosPagamento(primeiroCentavos)} + ${nomes[forma2?.value] || '2ª forma'}: R$ ${formatarCentavosPagamento(segundoCentavos)}`;
      if (resumo) resumo.textContent = `${textoResumo} = R$ ${formatarCentavosPagamento(totalCentavos)}.`;

      return {
        valido: Boolean(forma1?.value && forma2?.value && forma1.value !== forma2.value),
        resumo: textoResumo,
      };
    }

    document.addEventListener('change', event => {
      const form = event.target.closest?.('[data-change-payment-method]');
      if (!form) return;
      if (event.target.matches?.('[data-correcao-forma-pagamento], [data-correcao-forma-1], [data-correcao-forma-2]')) {
        atualizarCorrecaoPagamentoCombinado(form);
      }
    });

    document.addEventListener('input', event => {
      const form = event.target.closest?.('[data-change-payment-method]');
      if (!form || !event.target.matches?.('[data-correcao-valor-1]')) return;
      atualizarCorrecaoPagamentoCombinado(form);
    });

    document.querySelectorAll('[data-change-payment-method]').forEach(form => {
      atualizarCorrecaoPagamentoCombinado(form);
    });

    document.addEventListener('submit', event => {
      const form = event.target.closest?.('[data-change-payment-method]');
      if (!form) return;

      const select = form.querySelector('select[name="formaPagamento"]');
      const nomes = {
        dinheiro: 'Dinheiro',
        pix: 'Pix',
        cartao: 'Cartão',
        combinado: '2 formas de pagamento',
      };
      const novaForma = select?.value || '';
      if (!novaForma) {
        event.preventDefault();
        select?.focus();
        return;
      }

      let descricao = nomes[novaForma] || novaForma;
      if (novaForma === 'combinado') {
        const resultado = atualizarCorrecaoPagamentoCombinado(form);
        if (!resultado.valido) {
          event.preventDefault();
          form.querySelector('[data-correcao-valor-1]')?.focus();
          return;
        }
        descricao = resultado.resumo;
      }

      const card = form.closest('.order-card');
      const statusPago = card?.querySelector('[data-payment-status-badge]')?.textContent
        ?.trim()
        .toLowerCase() === 'pago';
      const complemento = statusPago
        ? ' Como este pedido já está pago, o Dashboard e os Relatórios passarão a contabilizar os valores nas formas escolhidas.'
        : ' O status continuará pendente até o pagamento ser confirmado.';
      if (!window.confirm(`Alterar o pagamento para ${descricao}?${complemento}`)) {
        event.preventDefault();
      }
    });

    const pixMesaUi = {
      mesaId: '',
      form: null,
      timer: null,
      busy: false,
      finalizado: false,
    };

    function formatarValorPixMesa(valor) {
      return Number(valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function elementosPixMesa() {
      return {
        modal: document.querySelector('#modalPixMesa'),
        status: document.querySelector('#statusPixMesa'),
        detalhe: document.querySelector('#detalhePixMesa'),
        valor: document.querySelector('#valorPixMesa'),
        erro: document.querySelector('#erroPixMesa'),
        cancelar: document.querySelector('#cancelarPixMesa'),
        fechar: document.querySelector('#fecharPixMesa'),
        fecharRodape: document.querySelector('#fecharPixMesaRodape'),
      };
    }

    function mesaIdDoFormularioPagamento(form) {
      const match = /\/admin\/mesas\/([^/]+)\/pagar(?:$|[?#])/.exec(String(form?.action || ''));
      return match ? decodeURIComponent(match[1]) : '';
    }

    function pararPollingPixMesa() {
      if (pixMesaUi.timer) window.clearTimeout(pixMesaUi.timer);
      pixMesaUi.timer = null;
    }

    function atualizarModalPixMesa(data = {}) {
      const ui = elementosPixMesa();
      if (!ui.modal) return;
      const paymentStatus = String(data.paymentStatus || '').toLowerCase();
      const printStatus = String(data.printStatus || '').toLowerCase();
      ui.valor.textContent = data.valor ? `Valor da conta: ${formatarValorPixMesa(data.valor)}` : '';
      ui.erro.textContent = String(data.printError || '');
      ui.cancelar.disabled = pixMesaUi.busy || paymentStatus === 'approved' || Boolean(data.mesaLiberada);

      if (data.reconciliationRequired) {
        ui.status.textContent = 'Confirmando a situação do Pix...';
        ui.detalhe.textContent = 'Não escolha outra forma de pagamento até o Mercado Pago confirmar o cancelamento ou o pagamento.';
        ui.cancelar.disabled = true;
        return;
      }
      if (data.mesaLiberada || paymentStatus === 'approved') {
        ui.status.textContent = 'Pagamento aprovado. Mesa liberada.';
        ui.detalhe.textContent = 'A confirmação financeira foi recebida do Mercado Pago.';
        ui.erro.textContent = '';
        ui.cancelar.disabled = true;
        return;
      }
      if (['cancelled', 'canceled', 'rejected', 'expired'].includes(paymentStatus)) {
        ui.status.textContent = 'Pix encerrado.';
        ui.detalhe.textContent = 'Agora é possível escolher outra forma de pagamento.';
        return;
      }
      if (printStatus === 'concluido') {
        ui.status.textContent = 'QR Code impresso. Aguardando o pagamento...';
        ui.detalhe.textContent = 'A mesa só será liberada depois que o Mercado Pago confirmar o Pix como aprovado.';
        ui.erro.textContent = '';
        return;
      }
      if (printStatus === 'falhou') {
        ui.status.textContent = 'Não foi possível confirmar a impressão do QR Code.';
        ui.detalhe.textContent = 'O Pix continua ativo. Cancele-o com segurança antes de escolher outra forma de pagamento.';
        return;
      }
      ui.status.textContent = 'Imprimindo o QR Code Pix...';
      ui.detalhe.textContent = 'Aguarde a confirmação do agente de impressão.';
    }

    async function consultarPixMesa() {
      if (!pixMesaUi.mesaId || pixMesaUi.finalizado) return;
      try {
        const response = await adminFetch(
          `/admin/mesas/${encodeURIComponent(pixMesaUi.mesaId)}/pix/status`,
          { skipAdminLoading: true, headers: { Accept: 'application/json' } }
        );
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'Não foi possível consultar o Pix da mesa.');
        atualizarModalPixMesa(data);
        if (data.mesaLiberada || String(data.paymentStatus || '').toLowerCase() === 'approved') {
          pixMesaUi.finalizado = true;
          pararPollingPixMesa();
          await atualizarComandaMesaSemReload(pixMesaUi.mesaId);
          if (typeof atualizarResumoMesas === 'function') await atualizarResumoMesas({ force: true });
          window.setTimeout(() => elementosPixMesa().modal?.classList.remove('ativo'), 1800);
          return;
        }
        if (['cancelled', 'canceled', 'rejected', 'expired'].includes(String(data.paymentStatus || '').toLowerCase())) {
          pararPollingPixMesa();
          return;
        }
      } catch (error) {
        const ui = elementosPixMesa();
        ui.erro.textContent = String(error?.message || 'Falha temporária ao consultar o pagamento.');
      }
      pixMesaUi.timer = window.setTimeout(consultarPixMesa, 2000);
    }

    async function iniciarPixMesa(form) {
      if (pixMesaUi.busy) return;
      const mesaId = mesaIdDoFormularioPagamento(form);
      if (!mesaId) return window.alert('Não foi possível identificar a mesa.');
      const ui = elementosPixMesa();
      pixMesaUi.mesaId = mesaId;
      pixMesaUi.form = form;
      pixMesaUi.finalizado = false;
      pixMesaUi.busy = true;
      pararPollingPixMesa();
      ui.modal?.classList.add('ativo');
      ui.status.textContent = 'Gerando pagamento Pix...';
      ui.detalhe.textContent = 'Aguarde enquanto o QR Code é criado e enviado para a impressora.';
      ui.valor.textContent = '';
      ui.erro.textContent = '';
      ui.cancelar.disabled = true;
      const submit = form.querySelector('button[type="submit"]');
      if (submit) submit.disabled = true;
      try {
        const response = await adminFetch(
          `/admin/mesas/${encodeURIComponent(mesaId)}/pix`,
          {
            method: 'POST',
            skipAdminLoading: true,
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: '{}',
          }
        );
        const data = await response.json();
        if (!response.ok || !data.success) {
          const error = new Error(data.message || 'Não foi possível gerar o Pix da mesa.');
          error.pixActive = Boolean(data.pixActive);
          error.reconciliationRequired = Boolean(data.reconciliationRequired);
          throw error;
        }
        atualizarModalPixMesa(data);
        pixMesaUi.busy = false;
        ui.cancelar.disabled = false;
        void consultarPixMesa();
      } catch (error) {
        pixMesaUi.busy = false;
        ui.status.textContent = error?.reconciliationRequired
          ? 'Confirmando se o Pix foi criado...'
          : error?.pixActive
            ? 'Pix criado, aguardando os dados para impressão...'
            : 'Não foi possível iniciar o pagamento Pix.';
        ui.detalhe.textContent = error?.pixActive
          ? 'Não escolha outra forma de pagamento enquanto esta tentativa estiver ativa. O sistema continuará verificando o Mercado Pago.'
          : 'Confira a integração Mercado Pago e o agente de impressão.';
        ui.erro.textContent = String(error?.message || 'Erro ao gerar o Pix.');
        ui.cancelar.disabled = Boolean(error?.reconciliationRequired) || !error?.pixActive;
        if (submit && !error?.pixActive) submit.disabled = false;
        if (error?.pixActive) void consultarPixMesa();
      }
    }

    document.addEventListener('submit', event => {
      const form = event.target.closest?.('.pagamento-form');
      if (!form) return;
      const modo = form.querySelector('[data-forma-pagamento-mesa]');
      if (String(modo?.value || '') !== 'pix') return;
      event.preventDefault();
      event.stopPropagation();
      void iniciarPixMesa(form);
    }, true);

    function fecharAcompanhamentoPixMesa() {
      pararPollingPixMesa();
      elementosPixMesa().modal?.classList.remove('ativo');
      // Fechar o modal NÃO cancela o Pix. O backend continua protegendo a mesa
      // contra outra forma de pagamento enquanto houver uma tentativa ativa.
      const submit = pixMesaUi.form?.querySelector('button[type="submit"]');
      if (submit && !pixMesaUi.busy && !pixMesaUi.finalizado) submit.disabled = false;
    }

    document.querySelector('#fecharPixMesa')?.addEventListener('click', fecharAcompanhamentoPixMesa);
    document.querySelector('#fecharPixMesaRodape')?.addEventListener('click', fecharAcompanhamentoPixMesa);

    document.querySelector('#cancelarPixMesa')?.addEventListener('click', async () => {
      if (!pixMesaUi.mesaId || pixMesaUi.busy || pixMesaUi.finalizado) return;
      if (!window.confirm('Cancelar este Pix e voltar para a escolha de outra forma de pagamento?')) return;
      const ui = elementosPixMesa();
      pixMesaUi.busy = true;
      ui.cancelar.disabled = true;
      ui.status.textContent = 'Confirmando o cancelamento do Pix...';
      ui.detalhe.textContent = 'Não escolha outra forma até a confirmação do Mercado Pago.';
      try {
        const response = await adminFetch(
          `/admin/mesas/${encodeURIComponent(pixMesaUi.mesaId)}/pix/cancelar`,
          {
            method: 'POST',
            skipAdminLoading: true,
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: '{}',
          }
        );
        const data = await response.json();
        if (!response.ok || !data.success) {
          if (data.approved) {
            pixMesaUi.busy = false;
            await consultarPixMesa();
            return;
          }
          if (data.reconciliationRequired) {
            pixMesaUi.busy = false;
            atualizarModalPixMesa({ reconciliationRequired: true });
            void consultarPixMesa();
            return;
          }
          throw new Error(data.message || 'Não foi possível cancelar o Pix.');
        }
        pararPollingPixMesa();
        pixMesaUi.busy = false;
        const form = pixMesaUi.form;
        const select = form?.querySelector('[data-forma-pagamento-mesa]');
        if (select) {
          select.value = 'dinheiro';
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
        form?.querySelector('button[type="submit"]')?.removeAttribute('disabled');
        ui.modal?.classList.remove('ativo');
        await atualizarComandaMesaSemReload(pixMesaUi.mesaId);
        if (typeof atualizarResumoMesas === 'function') await atualizarResumoMesas({ force: true });
      } catch (error) {
        pixMesaUi.busy = false;
        ui.erro.textContent = String(error?.message || 'Não foi possível cancelar o Pix.');
        ui.cancelar.disabled = false;
      }
    });

    document.querySelectorAll('.pagamento-form').forEach(form => {
      const modo = form.querySelector('[data-forma-pagamento-mesa]');
      const painel = form.querySelector('[data-pagamento-combinado]');
      const forma1 = form.querySelector('[data-forma-pagamento-1]');
      const forma2 = form.querySelector('[data-forma-pagamento-2]');
      const valor1 = form.querySelector('[data-valor-pagamento-1]');
      const valor2 = form.querySelector('[data-valor-pagamento-2]');
      const resumo = form.querySelector('[data-resumo-pagamento-combinado]');
      const obterTotalCentavos = () =>
        Math.max(
          0,
          Number(form.dataset.totalCentavos || 0),
        );
      const camposCombinados = [forma1, forma2, valor1, valor2].filter(Boolean);
      const nomesPagamentoMesa = {
        dinheiro: 'Dinheiro',
        pix: 'Pix',
        cartao: 'Cartão'
      };

      function garantirFormasDiferentes() {
        if (!forma1 || !forma2 || forma1.value !== forma2.value) return;
        const alternativa = [...forma2.options].find(option => option.value !== forma1.value);
        if (alternativa) forma2.value = alternativa.value;
      }

      function atualizarSegundoValor() {
        if (!valor1 || !valor2 || !resumo) return;
        const totalCentavos = obterTotalCentavos();
        const primeiroCentavos = centavosDeEntradaMonetaria(valor1.value);
        if (primeiroCentavos === null || primeiroCentavos <= 0 || primeiroCentavos >= totalCentavos) {
          valor2.value = '';
          resumo.textContent = totalCentavos > 0
            ? `Informe um valor entre R$ 0,01 e ${formatarCentavosPagamento(totalCentavos - 1)}.`
            : 'Não há valor pendente nesta mesa.';
          return;
        }
        const segundoCentavos = totalCentavos - primeiroCentavos;
        valor2.value = formatarCentavosPagamento(segundoCentavos);
        resumo.textContent = `${nomesPagamentoMesa[forma1?.value] || '1º meio'}: R$ ${formatarCentavosPagamento(primeiroCentavos)} + ${nomesPagamentoMesa[forma2?.value] || '2º meio'}: R$ ${formatarCentavosPagamento(segundoCentavos)} = R$ ${formatarCentavosPagamento(totalCentavos)}.`;
      }

      function atualizarModoPagamento() {
        const combinado = modo?.value === 'combinado';
        if (painel) painel.hidden = !combinado;
        camposCombinados.forEach(campo => {
          campo.disabled = !combinado;
        });
        if (combinado) {
          garantirFormasDiferentes();
          atualizarSegundoValor();
        }
      }

      modo?.addEventListener('change', atualizarModoPagamento);
      forma1?.addEventListener('change', () => {
        garantirFormasDiferentes();
        atualizarSegundoValor();
      });
      forma2?.addEventListener('change', () => {
        garantirFormasDiferentes();
        atualizarSegundoValor();
      });
      valor1?.addEventListener('input', atualizarSegundoValor);

      form.addEventListener('submit', event => {
        if (modo?.value !== 'combinado') return;
        garantirFormasDiferentes();
        const totalCentavos = obterTotalCentavos();
        const primeiroCentavos = centavosDeEntradaMonetaria(valor1?.value);
        const segundoCentavos = centavosDeEntradaMonetaria(valor2?.value);
        const valido = forma1?.value !== forma2?.value
          && Number.isSafeInteger(primeiroCentavos)
          && Number.isSafeInteger(segundoCentavos)
          && primeiroCentavos > 0
          && segundoCentavos > 0
          && primeiroCentavos + segundoCentavos === totalCentavos;
        if (!valido) {
          event.preventDefault();
          window.alert('Confira os dois meios e os valores. A soma precisa ser igual ao total da conta.');
          valor1?.focus();
        }
      });

      atualizarModoPagamento();
    });

    document
      .querySelectorAll('.confirmar-exclusao')
      .forEach(form => {
        form.addEventListener('submit', event => {
          const confirmar = window.confirm(
            'Tem certeza que deseja excluir este registro?'

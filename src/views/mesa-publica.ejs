    <section class="products" id="products">
      <% if (!produtos.length) { %>
        <div class="empty">
          Nenhum produto disponível no momento.
        </div>
      <% } %>

      <% produtos.forEach((produto, index) => { %>
        <% const avaliacao =
          avaliacoesPorProduto?.[String(produto._id)] ||
          { media: 0, quantidade: 0 };
        %>

        <article
          class="product"
          data-name="<%= produto.nome.toLowerCase() %>"
          data-category="<%= produto.categoriaId?.nome || '' %>"
        >
          <div class="product-image">

            <% if (index === 0) { %>
              <span class="product-badge">
                Mais pedido
              </span>
            <% } else if (index === 1) { %>
              <span class="product-badge">
                Destaque
              </span>
            <% } %>

            <% if (produto.imagem) { %>
              <img
                src="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                alt="<%= produto.nome %>"
              >
            <% } else { %>
              🍽️
            <% } %>
          </div>

          <div class="product-body">
            <span class="product-category">
              <%= produto.categoriaId?.nome || 'Especial' %>
            </span>

            <h3><%= produto.nome %></h3>

            <p class="product-description">
              <%= produto.descricao ||
                  'Produto preparado especialmente para você.'
              %>
            </p>

            <div class="rating-row">
              <span class="rating-star">★</span>

              <% if (avaliacao.quantidade) { %>
                <strong>
                  <%= Number(avaliacao.media).toLocaleString(
                    'pt-BR',
                    {
                      minimumFractionDigits: 1,
                      maximumFractionDigits: 1
                    }
                  ) %>
                </strong>

                <span>
                  (<%= avaliacao.quantidade %>
                  avaliação<%= avaliacao.quantidade === 1 ? '' : 'ões' %>)
                </span>
              <% } else { %>
                <span>Ainda sem avaliações</span>
              <% } %>
            </div>

            <div class="product-footer">
              <strong class="price">
                <%= Number(produto.preco).toLocaleString(
                  'pt-BR',
                  {
                    style: 'currency',
                    currency: 'BRL'
                  }
                ) %>
              </strong>

              <div class="product-actions">
                <button
                  class="rate-button"
                  data-rate-product="<%= produto._id %>"
                  data-rate-name="<%= produto.nome %>"
                  data-rate-order="<%= pedidoAvaliavelPorProduto?.[String(produto._id)] || '' %>"
                  <%= pedidoAvaliavelPorProduto?.[String(produto._id)]
                    ? ''
                    : 'disabled'
                  %>
                  title="<%= pedidoAvaliavelPorProduto?.[String(produto._id)]
                    ? 'Avaliar produto pedido nesta mesa'
                    : 'Faça um pedido deste produto para poder avaliar'
                  %>"
                >
                  ★ Avaliar
                </button>

                <button
                  class="add-button"
                  data-id="<%= produto._id %>"
                  data-name="<%= produto.nome %>"
                  data-price="<%= produto.preco %>"
                  data-image="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                  data-additionals='<%= safeJsonForHtml(
                    (produto.adicionais || [])
                      .filter(adicional => adicional.ativo !== false)
                      .map(adicional => ({
                        _id: String(adicional._id),
                        nome: adicional.nome,
                        preco: adicional.preco
                      }))
                  ) %>'
                >
                  + Adicionar
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>

    <section class="pending-orders">
      <div class="section-head">
        <div>
          <h2>Pedidos desta mesa</h2>
          <p>
            Estes itens permanecem pendentes até o pagamento da conta.

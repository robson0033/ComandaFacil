        ▦ Todos
      </button>

      <% const categorias = [
        ...new Set(
          produtos
            .map(produto => produto.categoriaId?.nome)
            .filter(Boolean)
        )
      ]; %>

      <% categorias.forEach(categoria => { %>
        <button
          class="category-button"
          data-category="<%= categoria %>"
        >

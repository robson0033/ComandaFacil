  <div class="success-toast" id="successToast"></div>

  <script nonce="<%= cspNonce %>">
    const cart = [];
    let lojaDisponivelPublica =
      <%- safeJsonForHtml(lojaDisponivel !== false) %>;

    const cartElement =
      document.querySelector('#cart');

    const cartOverlay =
      document.querySelector('#cartOverlay');

    const cartItems =
      document.querySelector('#cartItems');

    const cartCount =
      document.querySelector('#cartCount');

    const cartTotal =
      document.querySelector('#cartTotal');

    const cartTotalButton =
      document.querySelector('#cartTotalButton');

    const ratingModal =
      document.querySelector('#ratingModal');

    const ratingProducts =
      document.querySelector('#ratingProducts');

    const ratingOrderNumber =
      document.querySelector('#ratingOrderNumber');

    let currentPedidoId = null;
    let currentRatingItems = [];

    function escaparHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function urlImagemSegura(value) {
      const text = String(value ?? '').trim();
      if (/[\u0000-\u001F\u007F]/.test(text)) return '';
      if (text.startsWith('/') && !text.startsWith('//')) return text;
      if (/^data:image\/(?:png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=\s]+$/i.test(text)) {
        return text;
      }
      try {
        const url = new URL(text);
        return url.protocol === 'https:' ? url.href : '';
      } catch {
        return '';
      }
    }

    function money(value) {
      return Number(value || 0).toLocaleString(
        'pt-BR',
        {
          style: 'currency',
          currency: 'BRL'
        }
      );
    }

    function showToast(message) {
      const toast =
        document.querySelector('#successToast');

      toast.textContent = message;
      toast.classList.add('show');

      window.setTimeout(() => {
        toast.classList.remove('show');
      }, 3500);
    }

    function openCart() {
      cartElement.classList.add('open');
      cartOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeCart() {
      cartElement.classList.remove('open');
      cartOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    document
      .querySelector('#openCart')
      .addEventListener('click', openCart);

    document
      .querySelector('#closeCart')
      .addEventListener('click', closeCart);

    cartOverlay.addEventListener('click', closeCart);

    const addonModal =
      document.querySelector('#addonModal');

    const addonOptions =
      document.querySelector('#addonOptions');

    let pendingProductToAdd = null;

    function addProductToCart(product, additionals = []) {
      const additionsKey =
        additionals
          .map(additional => additional._id)
          .sort()
          .join(',');

      const existing = cart.find(
        item =>
          item.produtoId === product.produtoId &&
          item.additionsKey === additionsKey
      );

      if (existing) {
        existing.quantidade += 1;
      } else {
        cart.push({
          ...product,
          adicionais: additionals,
          additionsKey,
          quantidade: 1,
          observacao: '',
        });
      }

      renderCart();
      openCart();
    }

    function closeAddonModal() {
      addonModal.classList.remove('open');
      pendingProductToAdd = null;
      document.body.style.overflow = '';
    }

    document
      .querySelectorAll('.add-button')
      .forEach(button => {
        button.addEventListener('click', () => {
          const product = {
            produtoId: button.dataset.id,
            nome: button.dataset.name,
            preco: Number(button.dataset.price),
            imagem: button.dataset.image,
          };

          const additionals = JSON.parse(
            button.dataset.additionals || '[]'
          );

          if (!additionals.length) {
            addProductToCart(product, []);
            return;
          }

          pendingProductToAdd = {
            product,
            additionals,
          };

          document.querySelector(
            '#addonProductName'
          ).textContent =
            `Adicionais de ${product.nome}`;

          addonOptions.replaceChildren();
          additionals.forEach(adicional => {
            const option = document.createElement('div');
            option.className = 'addon-option';
            const label = document.createElement('label');
            const input = document.createElement('input');
            input.type = 'checkbox';
            input.value = String(adicional._id || '');
            label.append(input, document.createTextNode(
              ` ${String(adicional.nome || '')}`
            ));
            const price = document.createElement('strong');
            price.textContent = `+ ${money(adicional.preco)}`;
            option.append(label, price);
            addonOptions.appendChild(option);
          });

          addonModal.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });

    document
      .querySelector('#closeAddonModal')
      .addEventListener('click', closeAddonModal);

    document
      .querySelector('#cancelAddon')
      .addEventListener('click', closeAddonModal);

    document
      .querySelector('#confirmAddon')
      .addEventListener('click', () => {
        if (!pendingProductToAdd) {
          return;
        }

        const selectedIds = Array.from(
          addonOptions.querySelectorAll(
            'input:checked'
          )
        ).map(input => input.value);

        const selected = pendingProductToAdd
          .additionals
          .filter(adicional =>
            selectedIds.includes(adicional._id)
          );

        addProductToCart(
          pendingProductToAdd.product,
          selected
        );

        closeAddonModal();
      });

    function changeQuantity(index, value) {
      cart[index].quantidade += value;

      if (cart[index].quantidade <= 0) {
        cart.splice(index, 1);
      }

      renderCart();
    }

    function renderCart() {
      cartItems.replaceChildren();

      if (!cart.length) {
        const empty = document.createElement('div');
        empty.className = 'empty';
        empty.textContent = 'Seu carrinho está vazio.';
        cartItems.appendChild(empty);
      }

      cart.forEach((item, index) => {
        const element =
          document.createElement('div');

        element.className = 'cart-item';

        element.innerHTML = '<div class="cart-item-image"></div><div><div class="cart-item-top"><div><strong class="cart-item-name"></strong><small class="cart-item-addons" style="display:block;margin-top:4px;color:#756a65"></small></div><strong class="cart-item-price"></strong></div><div class="quantity"><button type="button" data-action="minus">−</button><span></span><button type="button" data-action="plus">+</button></div><input class="item-note" placeholder="Observação deste item" maxlength="250"></div>';
        const imageBox = element.querySelector('.cart-item-image');
        const imageUrl = urlImagemSegura(item.imagem);
        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = String(item.nome || '');
          imageBox.appendChild(image);
        } else {
          imageBox.textContent = '🍽️';
        }
        element.querySelector('.cart-item-name').textContent =
          String(item.nome || '');
        const addons = element.querySelector('.cart-item-addons');
        addons.textContent = (item.adicionais || [])
          .map(adicional => `+ ${adicional.nome} (${money(adicional.preco)})`)
          .join('\n');
        element.querySelector('.cart-item-price').textContent = money(
          (
            Number(item.preco || 0) +
            (item.adicionais || []).reduce(
              (sum, adicional) => sum + Number(adicional.preco || 0),
              0
            )
          ) * Number(item.quantidade || 0)
        );
        element.querySelector('.quantity span').textContent =
          String(item.quantidade);
        element.querySelector('.item-note').value =
          String(item.observacao || '');

        element
          .querySelector('[data-action="minus"]')
          .addEventListener('click', () => {
            changeQuantity(index, -1);
          });

        element
          .querySelector('[data-action="plus"]')
          .addEventListener('click', () => {
            changeQuantity(index, 1);
          });

        element
          .querySelector('.item-note')
          .addEventListener(
            'input',
            event => {
              item.observacao =
                event.target.value;
            }
          );

        cartItems.appendChild(element);
      });

      const total = cart.reduce(
        (sum, item) =>
          sum +
          (
            item.preco +
            (item.adicionais || []).reduce(
              (subtotal, adicional) =>
                subtotal + Number(adicional.preco || 0),
              0
            )
          ) *
          item.quantidade,
        0
      );

      const count = cart.reduce(
        (sum, item) =>
          sum + item.quantidade,
        0
      );

      cartCount.textContent = count;
      cartTotal.textContent = money(total);
      cartTotalButton.textContent =
        money(total);
    }

    document
      .querySelectorAll('[data-rate-product]')
      .forEach(button => {
        button.addEventListener('click', () => {
          const pedidoId =
            button.dataset.rateOrder;

          if (!pedidoId) {
            return;
          }

          currentPedidoId = pedidoId;

          currentRatingItems = [{
            produtoId:
              button.dataset.rateProduct,
            nome:
              button.dataset.rateName,
            nota: 0,
            comentario: ''
          }];

          ratingOrderNumber.textContent =
            `Avalie ${button.dataset.rateName}`;

          renderRatingProducts();
          ratingModal.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });

    function openRating(result) {
      currentPedidoId = result.pedidoId;

      currentRatingItems =
        (result.itens || []).map(item => ({
          produtoId: item.produtoId,
          nome: item.nome,
          nota: 0,
          comentario: ''
        }));

      ratingOrderNumber.textContent =
        `Pedido #${result.numeroPedido || ''} enviado. Avalie os itens abaixo.`;

      renderRatingProducts();
      ratingModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeRating() {
      ratingModal.classList.remove('open');
      document.body.style.overflow = '';
      window.location.reload();
    }

    function renderRatingProducts() {
      ratingProducts.replaceChildren();

      currentRatingItems.forEach(
        (item, itemIndex) => {
          const wrapper =
            document.createElement('div');

          wrapper.className =
            'rating-product';

          const title = document.createElement('strong');
          title.textContent = String(item.nome || '');
          const stars = document.createElement('div');
          stars.className = 'stars';
          [1, 2, 3, 4, 5].forEach(value => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `star-button ${value <= item.nota ? 'active' : ''}`;
            button.dataset.value = String(value);
            button.textContent = '★';
            stars.appendChild(button);
          });
          const comment = document.createElement('textarea');
          comment.className = 'rating-comment';
          comment.placeholder = 'Conte o que achou (opcional)';
          comment.maxLength = 500;
          comment.value = String(item.comentario || '');
          wrapper.append(title, stars, comment);

          wrapper
            .querySelectorAll('.star-button')
            .forEach(button => {
              button.addEventListener(
                'click',
                () => {
                  item.nota = Number(
                    button.dataset.value
                  );

                  renderRatingProducts();
                }
              );
            });

          wrapper
            .querySelector('.rating-comment')
            .addEventListener(
              'input',
              event => {
                currentRatingItems[
                  itemIndex
                ].comentario =
                  event.target.value;
              }
            );

          ratingProducts.appendChild(
            wrapper
          );
        }
      );
    }

    document
      .querySelector('#finishOrder')
      .addEventListener(
        'click',
        async () => {
          if (!lojaDisponivelPublica) {
            alert('Esta loja está temporariamente indisponível para novos pedidos.');
            return;
          }
          if (!cart.length) {
            alert(
              'Adicione produtos ao carrinho.'
            );
            return;
          }

          const button =
            document.querySelector(
              '#finishOrder'
            );

          button.disabled = true;
          button.textContent =
            'Enviando pedido...';

          try {
            const response = await fetch(
              '/mesa/<%= mesa.token %>/pedidos',
              {
                method: 'POST',
                headers: {
                  'Content-Type':
                    'application/json',
                },
                body: JSON.stringify({
                  cliente:
                    document.querySelector(
                      '#clientName'
                    ).value,
                  observacao:
                    document.querySelector(
                      '#orderNote'
                    ).value,
                  itens: cart,
                }),
              }
            );

            const result =
              await response.json();

            if (!response.ok) {
              if (result.code === 'LOJA_INDISPONIVEL') {
                lojaDisponivelPublica = false;
                button.disabled = true;
                button.textContent = 'Loja indisponível';
              }
              throw new Error(
                result.message
              );
            }

            cart.splice(0, cart.length);
            renderCart();
            closeCart();
            showToast(result.message);
            openRating(result);
          } catch (error) {
            alert(
              error.message ||
              'Não foi possível enviar o pedido.'
            );
          } finally {
            if (lojaDisponivelPublica) {
              button.disabled = false;
              button.textContent =
                'Finalizar pedido';
            }
          }
        }
      );

    document
      .querySelector('#sendRating')
      .addEventListener(
        'click',
        async () => {
          const avaliacoes =
            currentRatingItems.filter(
              item => item.nota >= 1
            );

          if (!avaliacoes.length) {
            alert(
              'Selecione pelo menos uma nota.'
            );
            return;
          }

          const button =
            document.querySelector(
              '#sendRating'
            );

          button.disabled = true;
          button.textContent =
            'Salvando...';

          try {
            const response = await fetch(
              `/mesa/<%= mesa.token %>/pedidos/${currentPedidoId}/avaliacoes`,
              {
                method: 'POST',
                headers: {
                  'Content-Type':
                    'application/json',
                },
                body: JSON.stringify({
                  avaliacoes
                }),
              }
            );

            const result =
              await response.json();

            if (!response.ok) {
              throw new Error(
                result.message
              );
            }

            showToast(result.message);
            closeRating();
          } catch (error) {
            alert(
              error.message ||
              'Não foi possível salvar a avaliação.'
            );
          } finally {
            button.disabled = false;
            button.textContent =
              'Enviar avaliação';
          }
        }
      );

    document
      .querySelector('#closeRating')
      .addEventListener(
        'click',
        closeRating
      );

    document
      .querySelector('#skipRating')
      .addEventListener(
        'click',
        closeRating
      );

    const search =
      document.querySelector('#search');

    let currentCategory = 'todos';

    function filterProducts() {
      const term =
        search.value
          .trim()
          .toLowerCase();

      document
        .querySelectorAll('.product')
        .forEach(product => {
          const matchName =
            product.dataset.name
              .includes(term);

          const matchCategory =
            currentCategory === 'todos' ||
            product.dataset.category ===
              currentCategory;

          product.style.display =
            matchName &&
            matchCategory
              ? ''
              : 'none';
        });
    }

    search.addEventListener(
      'input',
      filterProducts
    );

    document
      .querySelectorAll(
        '.category-button'
      )
      .forEach(button => {
        button.addEventListener(
          'click',
          () => {
            document
              .querySelectorAll(
                '.category-button'
              )
              .forEach(item => {
                item.classList.remove(
                  'active'
                );
              });

            button.classList.add(
              'active'
            );

            currentCategory =
              button.dataset.category;

            filterProducts();
          }
        );
      });


    renderCart();
  </script>
</body>
</html>

                      <option
                        value="ocupada"
                        <%= mesa.status === 'ocupada'
                          ? 'selected'
                          : ''
                        %>
                      >
                        Ocupada
                      </option>

                      <option
                        value="aguardando_pagamento"
                        <%= mesa.status === 'aguardando_pagamento'
                          ? 'selected'
                          : ''
                        %>
                      >
                        Aguardando pagamento
                      </option>

                      <option
                        value="paga"
                        <%= mesa.status === 'paga'
                          ? 'selected'
                          : ''
                        %>
                      >
                        Paga
                      </option>

                      <option
                        value="reservada"
                        <%= mesa.status === 'reservada'
                          ? 'selected'
                          : ''

async function imprimirPedido(
  pedidoId,
  modo = 'manual'
) {
  const response = await adminFetch(`/admin/agente/pedidos/${encodeURIComponent(pedidoId)}/imprimir`, {
    method: 'POST', skipAdminLoading: true, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ modo })

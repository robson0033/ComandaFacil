    const itensEstoqueFicha = <%- safeJsonForHtml((estoque || []).map(item => ({
      id: String(item._id),
      nome: item.nome,
      quantidade: Number(item.quantidade || 0),
      unidade: item.unidade || 'unidade',
      custoUnitario: Number(item.custoUnitario || 0),
    }))) %>;

    function unidadeNormalizada(unidade) {
      const valor = String(unidade || '').toLowerCase();
      if (['kg', 'quilo', 'quilos'].includes(valor)) return 'kg';
      if (['g', 'grama', 'gramas'].includes(valor)) return 'g';
      if (['l', 'litro', 'litros'].includes(valor)) return 'l';
      if (['ml', 'mililitro', 'mililitros'].includes(valor)) return 'ml';
      return 'un';
    }

    function unidadesPermitidas(unidadeEstoque) {
      const unidade = unidadeNormalizada(unidadeEstoque);
      if (['kg', 'g'].includes(unidade)) return ['g', 'kg'];
      if (['l', 'ml'].includes(unidade)) return ['ml', 'l'];
      return ['un'];
    }

    function converterParaUnidadeEstoque(quantidade, unidadeConsumo, unidadeEstoque) {
      const origem = unidadeNormalizada(unidadeConsumo);
      const destino = unidadeNormalizada(unidadeEstoque);
      if (origem === destino) return quantidade;
      if (origem === 'g' && destino === 'kg') return quantidade / 1000;
      if (origem === 'kg' && destino === 'g') return quantidade * 1000;
      if (origem === 'ml' && destino === 'l') return quantidade / 1000;
      if (origem === 'l' && destino === 'ml') return quantidade * 1000;
      return quantidade;
    }

    function opcoesEstoqueHtml() {
      return itensEstoqueFicha.map(item => `
        <option value="${escaparHtml(item.id)}" data-unidade="${escaparHtml(item.unidade)}" data-custo="${Number(item.custoUnitario) || 0}">
          ${escaparHtml(item.nome)} — ${Number(item.quantidade) || 0} ${escaparHtml(item.unidade)} em estoque
        </option>
      `).join('');
    }

    function criarLinhaTecnica() {
      const row = document.createElement('div');
      row.className = 'technical-row';
      row.innerHTML = `
        <select name="fichaEstoqueId[]" class="technical-stock" required>
          <option value="">Selecione o ingrediente</option>
          ${opcoesEstoqueHtml()}
        </select>
        <input type="number" name="fichaQuantidade[]" class="technical-quantity" min="0.0001" step="0.0001" placeholder="Quantidade" required>
        <select name="fichaUnidade[]" class="technical-unit" required>
          <option value="un">un</option>
        </select>
        <button type="button" class="remove-technical" title="Remover ingrediente">×</button>
      `;
      return row;
    }

    function atualizarUnidadesLinha(row) {
      const estoqueSelect = row.querySelector('.technical-stock');
      const unidadeSelect = row.querySelector('.technical-unit');
      const item = itensEstoqueFicha.find(i => i.id === estoqueSelect.value);
      if (
        !item &&
        estoqueSelect.selectedOptions[0]?.dataset.desativado === 'true'
      ) {
        atualizarCustoFormulario(row.closest('form'));
        return;
      }
      const unidadeAnterior = unidadeSelect.value;
      const permitidas = unidadesPermitidas(item?.unidade || 'un');
      unidadeSelect.innerHTML = permitidas.map(unidade =>
        `<option value="${escaparHtml(unidade)}">${escaparHtml(unidade)}</option>`
      ).join('');
      if (permitidas.includes(unidadeAnterior)) unidadeSelect.value = unidadeAnterior;
      atualizarCustoFormulario(row.closest('form'));
    }

    function atualizarCustoFormulario(form) {
      if (!form) return;
      let custo = 0;
      form.querySelectorAll('.technical-row').forEach(row => {
        const item = itensEstoqueFicha.find(i => i.id === row.querySelector('.technical-stock')?.value);
        const quantidade = Number(row.querySelector('.technical-quantity')?.value || 0);
        const unidade = row.querySelector('.technical-unit')?.value || 'un';
        if (!item || quantidade <= 0) return;
        const naUnidadeEstoque = converterParaUnidadeEstoque(quantidade, unidade, item.unidade);
        custo += naUnidadeEstoque * item.custoUnitario;
      });
      const box = form.querySelector('[data-technical-cost]');
      if (box) box.textContent = `Custo atual calculado: ${custo.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}`;

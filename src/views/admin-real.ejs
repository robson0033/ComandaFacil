async function verificarNovosPedidos() {
  if (!pollingPedidosAtivo || sessionRedirectInProgress || verificandoPedidos) {
    return;
  }

  verificandoPedidos = true;

  try {
    const url =
      `/admin/api/pedidos/novos?de=${encodeURIComponent(
        ultimaVerificacaoPedidos
      )}`;

    const response =
      await adminFetch(url, {
        headers: {
          Accept:
            'application/json',
        },
      });

    if (!response.ok) {
      return;
    }

    const result =
      await response.json();

    if (!result.success) {
      return;
    }

    ultimaVerificacaoPedidos =
      result.agora ||
      new Date().toISOString();

    result.pedidos.forEach(
      pedido => {
        if (
          document.querySelector(
            `[data-order-id="${CSS.escape(pedido.id)}"]`
          )
        ) {
          const existing = document.querySelector(`[data-order-id="${CSS.escape(pedido.id)}"]`);
          const badge = existing.querySelector('[data-payment-status-badge]');
          if (badge) {
            badge.className = `status ${pedido.pagamentoStatus || 'pendente'}`;
            badge.textContent = String(pedido.pagamentoStatus || 'pendente').replaceAll('_', ' ');
          }
          const statusText = existing.querySelector('[data-payment-status-text]');
          if (statusText) statusText.textContent = `Status do pagamento: ${String(pedido.pagamentoStatus || 'pendente').replaceAll('_', ' ')}`;
          const dateText = existing.querySelector('[data-payment-date-text]');
          if (dateText) dateText.textContent = `Data/hora do pagamento: ${pedido.pagoEm ? formatarDataPedido(pedido.pagoEm) : 'Ainda não confirmado'}`;
          return;
        }

        if (ordersEmptyState) {
          ordersEmptyState.remove();
        }

        if (ordersGrid) {
          const card =
            criarCardPedido(
              pedido
            );

          ordersGrid.prepend(card);

      applyOrdersFilters();
        }

        quantidadeNaoVisualizada += 1;

        mostrarToastPedido(
          pedido
        );

        tocarSomNovoPedido();
        mostrarNotificacaoDoSistema(pedido);

        if (document.hidden || !document.hasFocus()) {
          destacarTituloNovoPedido();
        }

      }
    );

    atualizarBadgePedidos();
  } catch (error) {
    console.error(
      'Erro ao verificar pedidos:',
      error
    );
  } finally {
    verificandoPedidos = false;
  }
}


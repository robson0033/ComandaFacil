          <% if (pode('configurar_impressoras')) { %>
          <section class="panel">
            <div class="panel-header">
              <div class="panel-title">
                <h2>Impressoras USB e de rede</h2>
                <p>
                  Configure até duas impressoras para cozinha, caixa ou balcão.
                </p>
              </div>

              <div class="printer-tools" style="margin-top:0">
                <span class="print-agent-status" id="printAgentStatus">
                  Agente desconectado
                </span>

                <a
                  href="https://github.com/robson0033/ComandaFacil/releases/latest/download/agente.zip"
                  class="download-agent-button"
                  data-staged-agent-version="1.2.0"
                >
                  ⬇ Baixar agente
                </a>

                <button
                  type="button"
                  class="printer-tool-button"
                  id="generateAgentCode"
                >
                  Vincular novo agente
                </button>

                <strong
                  id="agentPairCode"
                  style="font-size:22px"
                ></strong>
              </div>
            </div>

            <form
              action="/admin/configuracoes/impressora"
              method="POST"
              class="printer-grid"
            >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% for (let indice = 0; indice < 2; indice += 1) { %>
                <% const impressora =
                  config.impressoras?.[indice] || {
                    nome: `Impressora ${indice + 1}`,
                    tipoConexao: 'usb',
                    deviceName: '',
                    ip: '',
                    porta: 9100,
                    papel: indice === 0 ? '80mm' : '58mm',
                    modo: 'desativada',
                    copias: 1,
                    fontePx: 13,
                    espacamentoLinhaPx: 4,
                    espacamentoLetrasPx: 0,
                    margemSuperiorMm: 2,
                    margemInferiorMm: 5,
                    margemEsquerdaMm: 2,
                    margemDireitaMm: 2,
                    alturaMaximaMm: 500,
                    imprimirLogo: true,
                    imprimirValores: true,
                    imprimirEndereco: true,
                    imprimirCpfCnpj: false,
                    imprimirObservacoes: true,
                    corteAutomatico: true
                  };
                %>

                <article
                  class="printer-card"
                  data-printer-card="<%= indice %>"
                >
                  <h3>Impressora <%= indice + 1 %></h3>

                  <div class="connection-tabs">
                    <label class="connection-option">
                      <input
                        type="radio"
                        name="impressoras[<%= indice %>][tipoConexao]"
                        value="usb"
                        data-connection-type="usb"
                        <%= impressora.tipoConexao !== 'rede'
                          ? 'checked'
                          : ''
                        %>
                      >
                      <span>🔌 USB</span>
                    </label>

                    <label class="connection-option">
                      <input
                        type="radio"
                        name="impressoras[<%= indice %>][tipoConexao]"
                        value="rede"
                        data-connection-type="rede"
                        <%= impressora.tipoConexao === 'rede'
                          ? 'checked'
                          : ''
                        %>
                      >
                      <span>🌐 Rede</span>
                    </label>
                  </div>

                  <div class="printer-config-grid">
                    <div class="field">
                      <label>Apelido</label>
                      <input
                        name="impressoras[<%= indice %>][nome]"
                        value="<%= impressora.nome %>"
                        placeholder="Cozinha, Caixa..."
                      >
                    </div>

                    <div class="field">
                      <label>Papel</label>
                      <select name="impressoras[<%= indice %>][papel]">
                        <option
                          value="58mm"
                          <%= impressora.papel === '58mm'
                            ? 'selected'
                            : ''
                          %>
                        >
                          58 mm
                        </option>

                        <option
                          value="80mm"
                          <%= impressora.papel === '80mm'
                            ? 'selected'
                            : ''
                          %>
                        >
                          80 mm
                        </option>
                      </select>
                    </div>

                    <div class="field">
                      <label>Modo</label>
                      <select name="impressoras[<%= indice %>][modo]">
                        <% [
                          ['desativada', 'Desativada'],
                          ['manual', 'Somente manual'],
                          ['automatica', 'Somente automática'],
                          ['manual_automatica', 'Manual e automática']
                        ].forEach(opcao => { %>
                          <option
                            value="<%= opcao[0] %>"
                            <%= impressora.modo === opcao[0]
                              ? 'selected'
                              : ''
                            %>
                          >
                            <%= opcao[1] %>
                          </option>
                        <% }) %>
                      </select>
                    </div>

                    <div class="field">
                      <label>Cópias</label>
                      <input
                        type="number"
                        min="1"
                        max="5"
                        name="impressoras[<%= indice %>][copias]"
                        value="<%= impressora.copias || 1 %>"
                      >
                    </div>

                    <div
                      class="connection-panel <%= impressora.tipoConexao === 'rede'
                        ? ''
                        : 'active'
                      %>"
                      data-connection-panel="usb"
                    >
                      <div class="field">
                        <label>Nome da impressora no Windows</label>

                        <select
                          name="impressoras[<%= indice %>][deviceName]"
                          data-usb-printer-select
                        >
                          <option value="<%= impressora.deviceName || '' %>">
                            <%= impressora.deviceName
                              ? impressora.deviceName
                              : 'Abra o agente e atualize a lista'
                            %>
                          </option>
                        </select>
                      </div>

                      <div class="field">
                        <label>Conexão</label>
                        <input
                          value="Impressora instalada no Windows"
                          disabled
                        >
                      </div>

                      <div class="printer-tools">
                        <button
                          type="button"
                          class="printer-tool-button"
                          data-refresh-usb
                          data-agent-required
                          disabled
                        >
                          ↻ Atualizar lista USB
                        </button>

                        <button
                          type="button"
                          class="printer-tool-button test"
                          data-test-printer
                          data-agent-required
                          disabled
                        >
                          🖨 Imprimir teste
                        </button>
                      </div>
                    </div>

                    <div
                      class="connection-panel <%= impressora.tipoConexao === 'rede'
                        ? 'active'
                        : ''
                      %>"
                      data-connection-panel="rede"
                    >
                      <div class="field">
                        <label>Endereço IP</label>
                        <input
                          name="impressoras[<%= indice %>][ip]"
                          value="<%= impressora.ip || '' %>"
                          placeholder="192.168.0.120"
                          inputmode="decimal"
                        >
                      </div>

                      <div class="field">
                        <label>Porta</label>
                        <input
                          type="number"
                          min="1"
                          max="65535"
                          name="impressoras[<%= indice %>][porta]"
                          value="<%= impressora.porta || 9100 %>"
                        >
                      </div>

                      <div class="printer-tools">
                        <button
                          type="button"
                          class="printer-tool-button"
                          data-scan-network
                          data-agent-required
                          disabled
                        >
                          🔍 Procurar na rede
                        </button>

                        <button
                          type="button"
                          class="printer-tool-button test"
                          data-test-printer
                          data-agent-required
                          disabled
                        >
                          🧪 Testar conexão e impressão
                        </button>
                      </div>
                    </div>

                    <div
                      class="printer-result"
                      data-printer-result
                    ></div>

                    <div class="field">
                      <label>Tamanho da letra</label>
                      <input
                        type="number"
                        min="8"
                        max="30"
                        name="impressoras[<%= indice %>][fontePx]"
                        value="<%= impressora.fontePx || 13 %>"
                      >
                    </div>

                    <div class="field">
                      <label>Espaçamento extra entre linhas</label>
                      <input
                        type="number"
                        min="0"
                        max="30"
                        name="impressoras[<%= indice %>][espacamentoLinhaPx]"
                        value="<%= impressora.espacamentoLinhaPx ?? 4 %>"
                      >
                    </div>

                    <div class="field">
                      <label>Espaçamento entre letras</label>
                      <input
                        type="number"
                        min="0"
                        max="10"
                        name="impressoras[<%= indice %>][espacamentoLetrasPx]"
                        value="<%= impressora.espacamentoLetrasPx ?? 0 %>"
                      >
                    </div>

                    <div class="field">
                      <label>Altura máxima do papel (mm)</label>
                      <input
                        type="number"
                        min="100"
                        max="3000"
                        name="impressoras[<%= indice %>][alturaMaximaMm]"
                        value="<%= impressora.alturaMaximaMm || 500 %>"
                        disabled
                        title="Em impressoras térmicas RAW, o papel tem altura variável e é cortado ao final do comprovante."
                      >
                      <small style="color:var(--cinza-500);line-height:1.4;">
                        Não se aplica à impressão térmica RAW; a bobina usa altura automática.
                      </small>
                    </div>

                    <% [
                      ['margemSuperiorMm', 'Margem superior', 30],
                      ['margemInferiorMm', 'Margem inferior', 80],
                      ['margemEsquerdaMm', 'Margem esquerda', 20],
                      ['margemDireitaMm', 'Margem direita', 20]
                    ].forEach(item => { %>
                      <div class="field">
                        <label><%= item[1] %> (mm)</label>
                        <input
                          type="number"
                          min="0"
                          max="<%= item[2] %>"
                          step="0.1"
                          id="impressora-<%= indice %>-<%= item[0] %>"
                          name="impressoras[<%= indice %>][<%= item[0] %>]"
                          value="<%= impressora[item[0]] ?? 2 %>"
                        >
                      </div>
                    <% }) %>

                    <% [
                      ['imprimirLogo', 'Imprimir logo (USB — requer suporte raster ESC/POS)'],
                      ['imprimirValores', 'Imprimir valores'],
                      ['imprimirEndereco', 'Imprimir endereço do estabelecimento e do delivery'],
                      ['imprimirCpfCnpj', 'Imprimir CPF/CNPJ cadastrado'],
                      ['imprimirObservacoes', 'Imprimir observações'],
                      ['corteAutomatico', 'Corte automático']
                    ].forEach(item => { %>
                      <div class="field">
                        <label>
                          <input
                            type="checkbox"
                            name="impressoras[<%= indice %>][<%= item[0] %>]"
                            style="width:auto;min-height:auto;"
                            <%= impressora[item[0]]
                              ? 'checked'
                              : ''
                            %>
                          >
                          <%= item[1] %>
                        </label>
                      </div>
                    <% }) %>
                  </div>
                </article>
              <% } %>

              <div class="printer-help">
                <strong>USB:</strong> a impressora deve estar instalada no
                Windows e o ComandaFácil Print Agent precisa estar aberto.
                <br>
                <strong>Rede:</strong> informe o IP da própria impressora e,
                normalmente, a porta 9100. A impressora e o computador devem
                estar conectados à mesma rede.
              </div>

              <button type="submit" class="button">
                Salvar impressoras
              </button>
            </form>
          </section>
          <% } %>
        </div>
      </section>
      <% } %>
    </main>
  </div>

  <% if (pode('estoque')) { %>
  <!-- MODAL ESTOQUE -->

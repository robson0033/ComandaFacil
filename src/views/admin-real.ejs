function criarHtmlItensPedido(
  itens
) {
  if (
    !Array.isArray(itens) ||
    !itens.length
  ) {
    return `
      <div class="empty">
        O pedido não possui itens.
      </div>
    `;
  }

  return itens
    .map(item => {
      const subtotal =
        Number(item.subtotal) ||
        Number(item.preco || 0) *
        Number(
          item.quantidade || 0
        );

      return `
        <div class="order-item">
          <div class="order-item-quantity">
            ${Number(
              item.quantidade || 0
            )}x
          </div>

          <div>
            <div class="order-item-name">
              ${escaparHtml(
                item.nome
              )}
            </div>

            ${Array.isArray(item.adicionais) && item.adicionais.length ? `
              <div class="order-item-addons" style="margin-top:5px;display:grid;gap:3px;overflow-wrap:anywhere">
                ${item.adicionais.filter(adicional => adicional && adicional.nome).map(adicional => {
                  const quantidade = Math.max(1, Number(adicional.quantidade || 1));
                  const preco = Number(adicional.preco);
                  return `<span>+ ${quantidade > 1 ? `${quantidade}x ` : ''}${escaparHtml(adicional.nome)}${Number.isFinite(preco) ? ` — ${formatarMoedaPedido(preco * quantidade)}` : ''}</span>`;
                }).join('')}
              </div>
            ` : ''}

            ${
              item.observacao
                ? `
                  <span class="order-item-note">
                    Observação:
                    ${escaparHtml(
                      item.observacao
                    )}
                  </span>
                `
                : ''
            }
          </div>

          <div class="order-item-price">
            ${formatarMoedaPedido(
              subtotal
            )}
          </div>
        </div>
      `;
    })
    .join('');
}


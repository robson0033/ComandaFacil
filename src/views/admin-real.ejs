      filterOrdersByText();
    }

    const uploadPreviewUrls = new Map();

    function liberarPreviewUpload(input, { removerElemento = true } = {}) {
      if (!input) return;
      const previewUrl = uploadPreviewUrls.get(input);
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        uploadPreviewUrls.delete(input);
      }
      if (removerElemento) {
        input.parentElement?.querySelector('[data-upload-preview]')?.remove();
      }
    }

    function limparPreviewsUpload(container = document) {
      container?.querySelectorAll?.('[data-image-upload]').forEach(input => {
        liberarPreviewUpload(input);
        input.value = '';
        input.setCustomValidity('');
        const feedback = input.parentElement?.querySelector('.upload-feedback');
        if (feedback) feedback.textContent = '';
      });
    }

    document.querySelectorAll('[data-image-upload]').forEach(input => {
      if (input.dataset.uploadListenerReady === 'true') return;
      input.dataset.uploadListenerReady = 'true';
      const message = document.createElement('small');
      message.className = 'upload-feedback';
      message.setAttribute('aria-live', 'polite');
      input.insertAdjacentElement('afterend', message);

      input.addEventListener('change', () => {
        const file = input.files?.[0];
        input.setCustomValidity('');
        message.textContent = '';
        liberarPreviewUpload(input);
        if (!file) return;

        const allowed = ['image/jpeg', 'image/png', 'image/webp'];
        const maxBytes = Number(input.dataset.maxBytes || 0);
        if (!allowed.includes(file.type)) {
          input.setCustomValidity('Selecione uma imagem PNG, JPEG ou WebP.');
          message.textContent = input.validationMessage;
          return;
        }
        if (!Number.isFinite(maxBytes) || file.size > maxBytes) {
          input.setCustomValidity('A imagem excede o tamanho permitido.');
          message.textContent = input.validationMessage;
          return;
        }

        const previewUrl = URL.createObjectURL(file);
        uploadPreviewUrls.set(input, previewUrl);
        const preview = document.createElement('img');
        preview.dataset.uploadPreview = 'true';
        preview.alt = 'Prévia da imagem selecionada';
        preview.style.cssText =
          'display:block;max-width:120px;max-height:120px;margin-top:8px;border-radius:10px;object-fit:cover';
        preview.addEventListener('error', () => {
          liberarPreviewUpload(input);
          input.setCustomValidity('Não foi possível visualizar esta imagem.');
          message.textContent = input.validationMessage;
        }, { once: true });
        preview.src = previewUrl;
        input.insertAdjacentElement('afterend', preview);
      });

      input.form?.addEventListener('reset', () => {
        setTimeout(() => liberarPreviewUpload(input), 0);
      });
    });

    window.addEventListener('beforeunload', () => {
      uploadPreviewUrls.forEach(previewUrl => {
        URL.revokeObjectURL(previewUrl);
      });
      uploadPreviewUrls.clear();
    });

    document.querySelector('#dashboardPeriodo')?.addEventListener(

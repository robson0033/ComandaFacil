    card.querySelector(
      '[data-connection-type]:checked'
    )?.value || 'usb';

  card
    .querySelectorAll(
      '[data-connection-panel]'
    )
    .forEach(panel => {
      panel.classList.toggle(
        'active',
        panel.dataset.connectionPanel === tipo
      );
    });
}


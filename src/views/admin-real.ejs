        <article
          class="order-card"
          data-order-id="<%= pedido._id %>"
          data-order-date="<%= pedido.createdAt
            ? new Date(pedido.createdAt).toISOString()
            : ''
          %>"
          data-order-channel="<%= pedido.canal === 'balcao'
            ? 'retirada'
            : (pedido.canal || 'retirada')
          %>"
          data-order-status="<%= pedido.status || 'novo' %>"
          data-order-search="<%= [
            String(pedido.codigoPublico || pedido._id).slice(pedido.codigoPublico ? 0 : -6).toUpperCase(),
            pedido.cliente,
            pedido.telefoneCliente,
            pedido.ruaEntrega,
            pedido.numeroEntrega,
            pedido.bairroEntrega,
            pedido.referenciaEntrega,
            pedido.enderecoEntrega
          ].filter(Boolean).join(' ').toLowerCase() %>"
        >
          <div class="order-card-header">
            <div class="order-number">
              <div class="order-icon">
                <%= origemIcone %>
              </div>

              <div>
                <h3>
                  Pedido #<%= String(pedido.codigoPublico || pedido._id).slice(pedido.codigoPublico ? 0 : -6).toUpperCase() %>
                </h3>

                <p>
                  <%= formatarDataHoraEstabelecimento(pedido.createdAt) %>
                </p>

                <span class="order-origin <%= origemClasse %>">
                  <%= origemIcone %>
                  <%= origemTexto %>
                </span>
              </div>
            </div>

            <div>
              <span class="status <%= pedido.status %>">
                <%= String(pedido.status || 'novo')
                  .replaceAll('_', ' ')
                %>
              </span>

              <span class="status <%= pedido.pagamentoStatus || 'pendente' %>" data-payment-status-badge>
                <%= String(
                  pedido.pagamentoStatus || 'pendente'
                ).replaceAll('_', ' ') %>
              </span>
            </div>
          </div>

          <div class="order-client-data">
            <div>
              <strong>Cliente:</strong>
              <%= pedido.cliente || 'Cliente não informado' %>
            </div>

            <% if (pedido.canal === 'delivery') { %>
              <div><strong>Rua:</strong> <%= pedido.ruaEntrega || pedido.enderecoEntrega || 'Não informado' %></div>
              <div><strong>Número:</strong> <%= pedido.numeroEntrega || 'Não informado' %></div>
              <div><strong>Bairro:</strong> <%= pedido.bairroEntrega || 'Não informado' %></div>
              <div><strong>Referência:</strong> <%= pedido.referenciaEntrega || 'Não informado' %></div>
            <% } %>

            <% if (pedido.telefoneCliente) { %>
              <div>
                <strong>WhatsApp:</strong>
                <%= pedido.telefoneCliente %>
              </div>
            <% } %>

            <div>
              <strong>Forma de pagamento:</strong>
              <%= formaPagamentoTexto %>
            </div>

            <div data-payment-status-text>
              <strong>Status do pagamento:</strong>
              <%= String(pedido.pagamentoStatus || 'pendente').replaceAll('_', ' ') %>
            </div>

            <div data-payment-date-text>
              <strong>Data/hora do pagamento:</strong>
              <%= dataPagamentoPedido ? formatarDataHoraEstabelecimento(dataPagamentoPedido) : 'Ainda não confirmado' %>
            </div>

            <% if (pedido.formaPagamento === 'dinheiro') { %>
              <div>
                <strong>Troco:</strong>
                <%= pedido.precisaTroco
                  ? `Troco para ${formatarMoeda(pedido.trocoPara || 0)}${pedido.valorTroco != null ? ` — devolver ${formatarMoeda(pedido.valorTroco)}` : ''}`
                  : 'Não precisa de troco'
                %>
              </div>
            <% } %>

            <% if (
              pedido.canal === 'delivery' &&
              pedido.enderecoEntrega
            ) { %>
              <div class="delivery-address">
                <strong>Endereço de entrega:</strong>
                <%= pedido.enderecoEntrega %>
              </div>
            <% } %>
          </div>

          <div class="order-items">
            <% if (!pedido.itens?.length) { %>
              <div class="empty">
                O pedido não possui itens.
              </div>
            <% } %>

            <% (pedido.itens || []).forEach(item => { %>
              <div class="order-item">
                <div class="order-item-quantity">
                  <%= item.quantidade %>x
                </div>

                <div>
                  <div class="order-item-name">
                    <%= item.nome %>
                  </div>

                  <% if (Array.isArray(item.adicionais) && item.adicionais.length) { %>
                    <div class="order-item-addons" style="margin-top:5px;display:grid;gap:3px;overflow-wrap:anywhere">
                      <% item.adicionais.filter(adicional => adicional && adicional.nome).forEach(adicional => { %>
                        <span>+ <%= Number(adicional.quantidade || 1) > 1 ? `${Number(adicional.quantidade)}x ` : '' %><%= adicional.nome %><%= Number.isFinite(Number(adicional.preco)) ? ` — ${formatarMoeda(Number(adicional.preco) * Number(adicional.quantidade || 1))}` : '' %></span>
                      <% }) %>
                    </div>
                  <% } %>

                  <% if (item.observacao) { %>
                    <span class="order-item-note">
                      Observação: <%= item.observacao %>
                    </span>
                  <% } %>
                </div>

                <div class="order-item-price">
                  <%= formatarMoeda(
                    Number(item.subtotal) ||
                    Number(item.preco || 0) *
                    Number(item.quantidade || 0)
                  ) %>
                </div>
              </div>
            <% }) %>
          </div>

          <% if (pedido.observacao) { %>
            <div class="order-observation">
              <strong>Observação geral:</strong>
              <%= pedido.observacao %>
            </div>
          <% } %>

          <div class="order-footer">
            <div class="order-total">
              <span>Total do pedido</span>

              <strong>
                <%= formatarMoeda(pedido.total) %>
              </strong>
            </div>

            <div class="order-actions">
              <form
                action="/admin/pedidos/<%= pedido._id %>/status"
                method="POST"
                class="order-status-form"
                <% if (
                  pedido.pagamentoStatus !== 'pago' &&
                  ['dinheiro', 'cartao'].includes(pedido.formaPagamento)
                ) { %>
                  data-confirm-finalize-pending
                <% } %>
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="status">
                  <option
                    value="novo"
                    <%= pedido.status === 'novo'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Novo
                  </option>

                  <option
                    value="preparo"
                    <%= pedido.status === 'preparo'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Em preparo
                  </option>

                  <option
                    value="pronto"
                    <%= pedido.status === 'pronto'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Pronto
                  </option>

                  <option
                    value="entregue"
                    <%= pedido.status === 'entregue'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Entregue
                  </option>

                  <option
                    value="finalizado"
                    <%= pedido.status === 'finalizado'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Finalizado
                  </option>

                  <option
                    value="cancelado"
                    <%= pedido.status === 'cancelado'
                      ? 'selected'
                      : ''
                    %>
                  >
                    Cancelado
                  </option>
                </select>

                <button
                  type="submit"
                  class="mini-button edit"
                >
                  Atualizar
                </button>
              </form>

              <% if (
                pedido.pagamentoStatus !== 'pago' &&
                pedido.status !== 'cancelado' &&
                pedido.formaPagamento !== 'pix'
              ) { %>
                <form
                  action="/admin/pedidos/<%= pedido._id %>/confirmar-pagamento"
                  method="POST"
                  data-confirm-payment
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button
                    type="submit"
                    class="mini-button edit"
                  >
                    Confirmar pagamento
                  </button>
                </form>
              <% } %>

              <% if (telefoneWhatsappBrasil) { %>
                <a
                  href="https://wa.me/<%= telefoneWhatsappBrasil %>?text=<%= mensagemWhatsapp %>"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="whatsapp-order-button"
                >
                  💬 Falar no WhatsApp
                </a>
              <% } %>

              <% if (pode('arquivar_pedidos')) { %>
                <button
                  type="button"
                  class="delete-order-button"
                  data-delete-order="<%= pedido._id %>"
                >
                  🗃 Arquivar pedido
                </button>
              <% } %>

              <% if (pode('imprimir_pedidos')) { %>
                <button
                  type="button"
                  class="print-order-button"
                  data-print-order="<%= pedido._id %>"
                >
                  🖨 Imprimir pedido
                </button>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <div
      class="orders-no-results"
      id="ordersNoResults"
    >
      Nenhum pedido encontrado com os filtros selecionados.
    </div>
  </section>
</section>
      <% } %>

      <% if (pode('arquivar_pedidos')) { %>

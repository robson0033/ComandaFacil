            '#dashboard';
        }
      }
    );

    function definirEstadoEnvioFormulario(form, enviando) {
      const botoes = Array.from(
        form.querySelectorAll('button[type="submit"], input[type="submit"]')
      );

      if (enviando) {
        form.dataset.submitting = 'true';
        form.setAttribute('aria-busy', 'true');

        botoes.forEach(botao => {
          if (!botao.dataset.submitOriginalDisabled) {
            botao.dataset.submitOriginalDisabled = botao.disabled ? 'true' : 'false';
          }
          if (!botao.dataset.submitOriginalText) {
            botao.dataset.submitOriginalText = botao.tagName === 'INPUT'
              ? botao.value
              : botao.textContent;
          }
          botao.disabled = true;
          botao.setAttribute('aria-disabled', 'true');
          if (botao.tagName === 'INPUT') {
            botao.value = 'Salvando...';
          } else {
            botao.textContent = 'Salvando...';
          }
        });
        return;
      }

      delete form.dataset.submitting;
      form.removeAttribute('aria-busy');
      botoes.forEach(botao => {
        botao.disabled = botao.dataset.submitOriginalDisabled === 'true';
        botao.removeAttribute('aria-disabled');
        if (botao.dataset.submitOriginalText) {
          if (botao.tagName === 'INPUT') {
            botao.value = botao.dataset.submitOriginalText;
          } else {
            botao.textContent = botao.dataset.submitOriginalText;
          }
        }
        delete botao.dataset.submitOriginalDisabled;
        delete botao.dataset.submitOriginalText;
      });
    }

    document.addEventListener('submit', async event => {
      const form = event.target;
      const uploadInput = form.querySelector?.('[data-image-upload]');
      if (
        form.matches('form[enctype="multipart/form-data"]')
      ) {
        event.preventDefault();

        if (form.dataset.submitting === 'true') {
          return;
        }

        definirEstadoEnvioFormulario(form, true);
        const feedback = uploadInput?.parentElement?.querySelector('.upload-feedback');

        try {
          const csrfToken = obterCsrfTokenAtual();
          if (!csrfToken) {
            const error = new Error('A página expirou. Atualize e tente novamente.');
            error.code = 'CSRF_TOKEN_AUSENTE_NO_FRONTEND';
            throw error;
          }

          const formData = new FormData(form);
          formData.set('_csrf', csrfToken);

          const response = await adminFetch(form.action, {
            method: String(form.method || 'POST').toUpperCase(),
            body: formData,
            headers: { Accept: 'application/json' },
          });
          const payload = await response.clone().json().catch(() => ({}));

          if (!response.ok) {
            const error = new Error(
              payload.message || 'Não foi possível salvar os dados do formulário.'
            );
            error.code = payload.code || 'FORM_SUBMIT_FAILED';
            error.correlationId = payload.correlationId;
            throw error;
          }

          // Mantém o formulário bloqueado até o reload para impedir um segundo POST.
          recarregarSecaoPainel(payload.section || 'catalogo');
        } catch (error) {
          definirEstadoEnvioFormulario(form, false);
          if (feedback) feedback.textContent = error.message;
          mostrarErroAdministrativo({
            code: error.code || 'FORM_SUBMIT_FAILED',
            message: error.message || 'Não foi possível salvar.',
            correlationId: error.correlationId,
          });
        }
        return;
      }
      if (form.matches('[data-confirm-finalize-pending]') &&
          form.elements.status?.value === 'finalizado' &&
          !window.confirm(
            'Finalizar este pedido? O pagamento continuará pendente até você usar Confirmar pagamento.'
          )) {
        event.preventDefault();
        return;
      }
      if (form.matches('[data-confirm-payment]') &&
          !window.confirm('Confirmar o recebimento deste pedido?')) {
        event.preventDefault();
        return;
      }
      if (form.matches('[data-confirm-mercado-pago-disconnect]') &&
          !window.confirm('Desconectar a conta Mercado Pago?')) {
        event.preventDefault();
        }
      });

    document.addEventListener('click', async event => {
      const button = event.target.closest('.btn-excluir-produto');
      if (!button || button.dataset.loading === 'true') return;

      const produtoId = String(button.dataset.produtoId || '');
      const produtoNome = String(button.dataset.produtoNome || 'Produto');
      const confirmar = window.confirm(
        `Excluir permanentemente o produto “${produtoNome}”?\n\n` +
        'Ele será removido do catálogo e do banco de dados. ' +
        'Os pedidos antigos continuarão preservados.'
      );
      if (!confirmar) return;

      button.dataset.loading = 'true';
      button.disabled = true;
      const textoOriginal = button.textContent;
      button.textContent = 'Excluindo...';

      try {
        const response = await adminFetch(
          `/admin/produtos/${encodeURIComponent(produtoId)}`,
          {
            method: 'DELETE',
            headers: { Accept: 'application/json' },
          }
        );
        const payload = await response.clone().json().catch(() => ({}));
        if (!response.ok || payload.code !== 'PRODUCT_DELETED') {
          throw new Error(payload.message || 'Não foi possível excluir o produto.');
        }
        document.querySelector(
          `[data-product-card="${CSS.escape(produtoId)}"]`
        )?.remove();
        window.location.hash = '#catalogo';
        window.alert(payload.message || 'Produto excluído permanentemente.');
      } catch (error) {
        button.dataset.loading = 'false';
        button.disabled = false;
        button.textContent = textoOriginal;
        mostrarErroAdministrativo({ message: error.message });
      }
    });

    document.addEventListener('submit', event => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || event.defaultPrevented) return;
      if (form.matches('[data-admin-loading-skip]')) return;
      const method = String(form.method || 'GET').toUpperCase();
      const target = new URL(form.action || window.location.href, window.location.href);
      if (!mutatingAdminMethods.has(method) || target.origin !== window.location.origin || !target.pathname.startsWith('/admin')) return;
      if (!form.checkValidity()) return;
      if (form.dataset.submitting === 'true') {
        event.preventDefault();
        return;
      }

      const submitter = event.submitter;
      if (submitter?.name) {
        const mirror = document.createElement('input');
        mirror.type = 'hidden';
        mirror.name = submitter.name;
        mirror.value = submitter.value;
        mirror.dataset.adminLoadingSubmitter = 'true';
        form.appendChild(mirror);
      }
      form.dataset.submitting = 'true';
      const action = form.dataset.loadingAction || (
        form.enctype === 'multipart/form-data' ? 'upload' :
        /pagamento/i.test(target.pathname) ? 'payment' :
        /excluir|arquivar|remover/i.test(target.pathname) ? 'delete' :
        /cancelar|desconectar/i.test(target.pathname) ? 'cancel' : 'save'
      );
      const options = {
        ...(window.AdminLoading.messages[action] || window.AdminLoading.messages.default),
        ...(form.dataset.loadingTitle ? { title: form.dataset.loadingTitle } : {}),
        ...(form.dataset.loadingMessage ? { message: form.dataset.loadingMessage } : {}),
      };
      if (submitter?.dataset.loadingTitle) options.title = submitter.dataset.loadingTitle;
      if (submitter?.dataset.loadingMessage) options.message = submitter.dataset.loadingMessage;
      window.AdminLoading.show(options);
      if (submitter) {
        submitter.disabled = true;
        submitter.setAttribute('aria-disabled', 'true');
      }
    });

  </script>

</body>
</html>

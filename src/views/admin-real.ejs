                </label>

                <input
                  type="file"
                  id="fotoPerfil"
                  name="fotoPerfil"
                  accept="image/jpeg,image/png,image/webp"
                  data-image-upload="perfil"
                  data-max-bytes="3145728"
                >
              </div>

              <div class="field">
                <label for="nomeEstabelecimento">
                  Nome do estabelecimento
                </label>

                <input
                  id="nomeEstabelecimento"
                  name="nomeEstabelecimento"
                  value="<%= config.nomeEstabelecimento %>"
                  required
                >
              </div>

              <div class="field">
                <label for="telefone">
                  Telefone
                </label>

                <input
                  id="telefone"
                  name="telefone"
                  value="<%= config.telefone || '' %>"
                >
              </div>

              <div class="field">
                <label>CPF ou CNPJ cadastrado</label>
                <input value="<%= usuario.cpfCnpj || '-' %>" readonly>
              </div>

              <div class="field full">
                <label for="endereco">
                  Endereço completo do estabelecimento
                </label>

                <input
                  id="endereco"
                  name="endereco"
                  value="<%= config.endereco || '' %>"
                  placeholder="Rua, número, bairro, cidade e estado"
                >
              </div>

              <div class="field">
                <label for="horarioAbertura">Horário de abertura</label>
                <input type="time" id="horarioAbertura" name="horarioAbertura" value="<%= config.horarioAbertura || '08:00' %>" required>
              </div>

              <div class="field">
                <label for="horarioFechamento">Horário de fechamento</label>
                <input type="time" id="horarioFechamento" name="horarioFechamento" value="<%= config.horarioFechamento || '22:00' %>" required>
              </div>

              <div class="field full">
                <label>Dias de funcionamento</label>
                <div class="week-days">
                  <%
                    const diasSelecionados = config.diasFuncionamento || [0,1,2,3,4,5,6];
                    const diasSemana = [
                      { valor: 0, nome: 'Domingo' }, { valor: 1, nome: 'Segunda' },
                      { valor: 2, nome: 'Terça' }, { valor: 3, nome: 'Quarta' },
                      { valor: 4, nome: 'Quinta' }, { valor: 5, nome: 'Sexta' },
                      { valor: 6, nome: 'Sábado' }
                    ];
                  %>
                  <% diasSemana.forEach(dia => { %>
                    <label class="week-day">
                      <input type="checkbox" name="diasFuncionamento" value="<%= dia.valor %>" <%= diasSelecionados.includes(dia.valor) ? 'checked' : '' %>>
                      <span><%= dia.nome %></span>
                    </label>
                  <% }) %>
                </div>
              </div>

              <div class="field full">
                <label for="descricao">
                  Descrição
                </label>

                <textarea
                  id="descricao"
                  name="descricao"
                ><%= config.descricao || '' %></textarea>
              </div>

              <div class="field full">

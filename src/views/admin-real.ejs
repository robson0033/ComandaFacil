                        Dinheiro
                      </option>

                      <option value="pix">
                        Pix
                      </option>

                      <option value="cartao">
                        Cartão
                      </option>

                      <option value="nao_informado">
                        Não informado
                      </option>
                    </select>

                    <button
                      type="submit"
                      class="mini-button success"
                    >
                      Pagar e liberar
                    </button>

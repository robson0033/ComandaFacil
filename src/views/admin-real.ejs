          <section class="panel">
            <div class="panel-header">
              <div class="panel-title">
                <h2>Recebimentos pelo Mercado Pago</h2>
                <p>Conecte sua própria conta para receber Pix diretamente nela.</p>
              </div>
            </div>
            <% if (config.mercadoPago && config.mercadoPago.conectado) { %>
              <div class="link-box" style="margin-bottom:14px">✅ Conta conectada — Pix automático disponível no catálogo.</div>
              <div class="link-box" style="margin-bottom:14px">
                <strong>Taxa de serviço Comanda Fácil:</strong> 1,5%<br>
                <strong>Tarifas Mercado Pago:</strong> conforme as condições da conta da loja<br>
                <strong>Termos aceitos em:</strong>
                <%= config.mercadoPago.termsAcceptedAt ? formatarDataHoraEstabelecimento(config.mercadoPago.termsAcceptedAt) : 'Aceite anterior não registrado' %><br>
                <strong>Versão:</strong> <%= config.mercadoPago.termsVersion || 'legada' %>
              </div>
              <% if (!config.mercadoPago.termsAcceptedAt) { %>
                <div class="link-box" style="margin-bottom:14px;border-color:#f59e0b;background:#fff7ed">
                  ⚠ Para continuar gerando novos pagamentos Pix online, revise e aceite os termos da taxa de serviço.
                </div>
              <% } %>
              <button type="button" class="button" data-mercado-pago-accept-terms style="margin-bottom:14px">
                <%= config.mercadoPago.termsAcceptedAt ? 'Consultar ou renovar termos' : 'Revisar e aceitar os termos' %>
              </button>
              <form action="/admin/mercado-pago/desconectar" method="POST" data-confirm-mercado-pago-disconnect>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="button" style="background:#777">Desconectar Mercado Pago</button>
              </form>
            <% } else { %>
              <div class="link-box" style="margin-bottom:14px">Conta ainda não conectada.</div>
              <form action="/admin/mercado-pago/conectar" method="POST" data-mercado-pago-connect>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="button">Conectar minha conta Mercado Pago</button>
              </form>
            <% } %>
          </section>


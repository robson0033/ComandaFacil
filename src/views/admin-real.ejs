async function verificarPrintAgent() {
  try {
    const response = await adminFetch(
      `${printAgentUrl}/status`,
      {
        signal:
          AbortSignal.timeout(1800)
      }
    );

    if (!response.ok) {
      throw new Error(
        'Agente indisponível'
      );
    }

    const result = await response.json();
    atualizarStatusAgente({
      conectado: Boolean(result.online),
      status: result.status?.status || (result.online ? 'conectado' : 'desconectado'),
      desatualizado: Boolean(result.status?.outdated),
      rolloutEnabled: result.status?.rolloutEnabled,
      versaoMinima: result.status?.minimumAgentVersion,
      atualizadoEm: result.agente?.ultimaConexao,
      nomeComputador: result.agente?.nomeComputador
    });
    return Boolean(result.online);
  } catch (error) {
    atualizarStatusAgente({
      conectado: false,
      status: 'desconectado'
    });
    return false;
  }
}

let printAgentConectado = false;

function atualizarStatusAgente({
  conectado,
  status,
  atualizadoEm,
  updatedAt,
  nomeComputador,
  desatualizado,
  versaoMinima,
  rolloutEnabled
} = {}) {
  const outdated = desatualizado === true || status === 'desatualizado';
  const rolloutBlocked = conectado === true && !outdated && rolloutEnabled === false;
  const online = conectado === true && !outdated && !rolloutBlocked;
  printAgentConectado = online;
  const badge = document.querySelector('#printAgentStatus');
  if (badge) {
    badge.textContent = outdated
      ? `Agente desatualizado${versaoMinima ? ` — mínimo ${versaoMinima}` : ''}`
      : rolloutBlocked
      ? 'Agente conectado — ativação pendente'
      : online
      ? (nomeComputador
          ? `Agente conectado — ${nomeComputador}`
          : 'Agente conectado')
      : 'Agente desconectado';
    badge.classList.toggle('online', online);
    badge.classList.toggle('outdated', outdated);
    badge.dataset.status = status || (online ? 'conectado' : 'desconectado');
    badge.dataset.updatedAt = String(atualizadoEm || updatedAt || '');
  }

  document.querySelectorAll(
    '[data-agent-required], [data-print-order]'
  ).forEach(button => {
    button.disabled = !online;
  });

  if (online) {
    const codeBox = document.querySelector('#agentPairCode');
    if (codeBox) codeBox.textContent = 'Vínculo concluído.';
  }
  return printAgentConectado;
}

function iniciarStreamStatusAgente() {
  if (typeof EventSource !== 'function') return null;
  const stream = new EventSource(`${printAgentUrl}/status/stream`);
  stream.addEventListener('print-agent-status', event => {
    try {
      const payload = JSON.parse(event.data);
      if (payload?.type !== 'print-agent-status') return;
      atualizarStatusAgente({
        conectado: payload.connected,
        status: payload.status,
        updatedAt: payload.updatedAt,
        nomeComputador: payload.nomeComputador,
        desatualizado: payload.outdated,
        rolloutEnabled: payload.rolloutEnabled,
        versaoMinima: payload.minimumAgentVersion
      });
    } catch (error) {
      console.error('Status inválido do agente:', error);
    }
  });
  stream.addEventListener('open', () => {
    void verificarPrintAgent();
  });
  return stream;
}

async function carregarPedidoImpressao(

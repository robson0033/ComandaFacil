        );
      });
  });

async function listarImpressorasUsb(card) {
  const resultBox =
    card.querySelector(
      '[data-printer-result]'
    );

  try {
    const response = await adminFetch(
      `${printAgentUrl}/impressoras`
    );

    const result = await response.json();

    if (!response.ok) {
      throw new Error(
        result.message ||
        'Não foi possível listar as impressoras.'
      );
    }

    const select =
      card.querySelector(
        '[data-usb-printer-select]'
      );

    const valorAtual =
      select.value;

    select.innerHTML = [
      '<option value="">Selecione uma impressora</option>',
      ...result.printers.map(
        printer => `
          <option
            value="${escaparHtml(printer.name)}"
            ${
              printer.name === valorAtual
                ? 'selected'
                : ''
            }
          >
            ${escaparHtml(printer.name)}
            ${printer.isDefault
              ? ' — padrão'
              : ''
            }
          </option>
        `
      )
    ].join('');

    resultBox.textContent =
      `${result.printers.length} impressora(s) encontrada(s) no Windows.`;
    resultBox.classList.add('visible');
  } catch (error) {
    resultBox.textContent = error.message;
    resultBox.classList.add('visible');
  }
}

function dadosImpressoraDoCard(card) {
  const campo = nome =>
    card.querySelector(
      `[name$="[${nome}]"]`
    );

  return {
    nome:
      campo('nome')?.value ||
      'Impressora',
    tipoConexao:
      card.querySelector(
        '[data-connection-type]:checked'
      )?.value || 'usb',
    deviceName:
      campo('deviceName')?.value || '',
    ip:
      campo('ip')?.value || '',
    porta:
      Number(
        campo('porta')?.value || 9100
      ),
    papel:
      campo('papel')?.value || '80mm',
    modo: 'manual',
    copias:
      Number(
        campo('copias')?.value || 1
      ),
    fontePx:
      Number(
        campo('fontePx')?.value || 13
      ),
    espacamentoLinhaPx:
      Number(
        campo('espacamentoLinhaPx')?.value ||
        4
      ),
    espacamentoLetrasPx:
      Number(
        campo('espacamentoLetrasPx')?.value ||
        0
      ),
    margemSuperiorMm:
      Number(
        campo('margemSuperiorMm')?.value ||
        2
      ),
    margemInferiorMm:
      Number(
        campo('margemInferiorMm')?.value ||
        5
      ),
    margemEsquerdaMm:
      Number(
        campo('margemEsquerdaMm')?.value ||
        2
      ),
    margemDireitaMm:
      Number(
        campo('margemDireitaMm')?.value ??
        2
      ),
    alturaMaximaMm:
      Number(
        campo('alturaMaximaMm')?.value ||
        500
      ),
    imprimirLogo:
      campo('imprimirLogo')?.checked ?? true,
    imprimirValores:
      campo('imprimirValores')?.checked ?? true,
    imprimirEndereco:
      campo('imprimirEndereco')?.checked ?? true,
    imprimirCpfCnpj:
      campo('imprimirCpfCnpj')?.checked ?? false,
    imprimirObservacoes:
      campo('imprimirObservacoes')?.checked ?? true,
    corteAutomatico:
      campo('corteAutomatico')?.checked ?? true
  };
}

document.addEventListener(
  'click',
  async event => {
    const refreshButton =
      event.target.closest(
        '[data-refresh-usb]'
      );

    if (refreshButton) {
      const card =
        refreshButton.closest(
          '[data-printer-card]'
        );

      await listarImpressorasUsb(card);
      return;
    }

    const scanButton =
      event.target.closest(
        '[data-scan-network]'
      );

    if (scanButton) {
      const card =
        scanButton.closest(
          '[data-printer-card]'
        );

      const resultBox =
        card.querySelector(
          '[data-printer-result]'
        );

      resultBox.textContent =
        'Procurando impressoras na rede local...';
      resultBox.classList.add('visible');

      try {
        const response = await adminFetch(
          `${printAgentUrl}/network/scan`,
          { method: 'POST', skipAdminLoading: true }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.message ||
            'A busca na rede falhou.'
          );
        }

        if (!result.devices.length) {
          resultBox.textContent =
            'Nenhuma impressora foi encontrada automaticamente. Você ainda pode informar o IP manualmente.';
          return;
        }

        resultBox.innerHTML =
          result.devices.map(device => `
            <button
              type="button"
              class="printer-tool-button"
              data-use-network-ip="${escaparHtml(device.ip)}"
            >
              Usar ${escaparHtml(device.ip)}:${device.port}
            </button>
          `).join('');
      } catch (error) {
        resultBox.textContent = error.message;
      }

      return;
    }

    const useIpButton =
      event.target.closest(
        '[data-use-network-ip]'
      );

    if (useIpButton) {
      const card =
        useIpButton.closest(
          '[data-printer-card]'
        );

      const ipInput =
        card.querySelector(
          '[name$="[ip]"]'
        );

      ipInput.value =
        useIpButton.dataset.useNetworkIp;
      return;
    }

    const testButton =
      event.target.closest(
        '[data-test-printer]'
      );

    if (testButton) {
      const card =
        testButton.closest(
          '[data-printer-card]'
        );

      const resultBox =
        card.querySelector(
          '[data-printer-result]'
        );

      testButton.disabled = true;
      resultBox.textContent =
        'Enviando impressão de teste...';
      resultBox.classList.add('visible');

      try {
        const response = await adminFetch(
          `${printAgentUrl}/teste`,
          {
            method: 'POST',
            skipAdminLoading: true,
            headers: {
              'Content-Type':
                'application/json'
            },
            body: JSON.stringify({
              impressora:
                dadosImpressoraDoCard(card)
            })
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.message ||
            'O teste falhou.'
          );
        }

        resultBox.textContent =
          'Teste enviado com sucesso.';
      } catch (error) {
        resultBox.textContent = error.message;
      } finally {
        testButton.disabled = false;
      }
    }
  }
);



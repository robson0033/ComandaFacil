            </small>

            <div class="technical-list" data-technical-list>
              <% (produto.fichaTecnica || []).forEach(ingrediente => { %>
                <%
                  const ingredienteIdAtual = String(
                    ingrediente.estoqueId?._id || ingrediente.estoqueId
                  );
                  const ingredienteDesativado =
                    listaIngredientesDesativadosReferenciados.find(
                      item => String(item._id) === ingredienteIdAtual
                    );
                %>
                <div class="technical-row">
                  <select name="fichaEstoqueId[]" class="technical-stock" required>
                    <option value="">Selecione o ingrediente</option>
                    <% if (ingredienteDesativado) { %>
                      <option
                        value="<%= ingredienteDesativado._id %>"
                        data-desativado="true"
                        selected
                      >
                        <%= ingredienteDesativado.nome %> — desativado
                      </option>
                    <% } %>
                    <% estoque.forEach(item => { %>
                      <option
                        value="<%= item._id %>"
                        data-unidade="<%= item.unidade || 'unidade' %>"
                        data-custo="<%= Number(item.custoUnitario || 0) %>"
                        <%= String(ingrediente.estoqueId?._id || ingrediente.estoqueId) === String(item._id) ? 'selected' : '' %>

function formatarCpf(valor) {
  const numeros = String(valor)
    .replace(/\D/g, '')
    .slice(0, 11);

  return numeros
    .replace(/^(\d{3})(\d)/, '$1.$2')
    .replace(
      /^(\d{3})\.(\d{3})(\d)/,
      '$1.$2.$3'
    )
    .replace(
      /^(\d{3})\.(\d{3})\.(\d{3})(\d)/,
      '$1.$2.$3-$4'
    );
}

function aplicarMascaraCpf(input) {
  input.addEventListener('input', event => {
    event.target.value =
      formatarCpf(event.target.value);
  });
}

function formatarTelefone(valor) {
  const numeros = String(valor)
    .replace(/\D/g, '')
    .slice(0, 11);

  if (numeros.length <= 10) {
    return numeros
      .replace(/^(\d{2})(\d)/, '($1) $2')
      .replace(
        /(\d{4})(\d{1,4})$/,
        '$1-$2'
      );
  }

  return numeros
    .replace(/^(\d{2})(\d)/, '($1) $2')
    .replace(
      /(\d{5})(\d{1,4})$/,
      '$1-$2'
    );
}

function aplicarMascaraTelefone(input) {
  input.addEventListener('input', event => {
    event.target.value =
      formatarTelefone(
        event.target.value
      );
  });
}


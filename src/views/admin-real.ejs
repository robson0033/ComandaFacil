    const ordersSearchNoResults = document.querySelector("#ordersSearchNoResults");

    function normalizeOrderSearch(value = "") {
      return String(value)
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9@.]+/g, " ")
        .trim();
    }

    function filterOrdersByText() {
      if (!ordersTextSearch) return;

      const query = normalizeOrderSearch(ordersTextSearch.value);
      const terms = query.split(/\s+/).filter(Boolean);
      const orderCards = [...document.querySelectorAll("#ordersGrid .order-card")];

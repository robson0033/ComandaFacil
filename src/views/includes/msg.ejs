<% if (errors && errors.length > 0) { %>
    <% errors.forEach(erro => { %>
        <p class="mensagem erro"><%= erro %></p>
    <% }); %>
<% } %>

<% if (success && success.length > 0) { %>
    <% success.forEach(succ => { %>
        <p class="mensagem sucesso"><%= succ %></p>
    <% }); %>
<% } %>
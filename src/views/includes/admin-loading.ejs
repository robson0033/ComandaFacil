<div class="admin-loading-overlay" id="adminLoadingOverlay" hidden aria-hidden="true">
  <section
    class="admin-loading-dialog"
    id="adminLoadingDialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="adminLoadingTitle"
    aria-describedby="adminLoadingMessage"
    aria-live="polite"
    tabindex="-1"
  >
    <div class="admin-loading-spinner" role="img" aria-label="Operação em andamento"></div>
    <h2 id="adminLoadingTitle">Processando...</h2>
    <p id="adminLoadingMessage">Aguarde um momento.</p>
  </section>
</div>

<button type="button" id="openMyOrders">📦 Meus pedidos</button>

<dialog id="myOrdersDialog">
  <div class="my-orders-shell">
    <header class="my-orders-header">
      <h2>Meus pedidos</h2>
      <button type="button" id="closeMyOrders" class="my-orders-close" aria-label="Fechar">✕</button>
    </header>
    <div class="my-orders-body">
      <form id="myOrdersForm" class="my-orders-form">
        <input id="ordersPhone" required inputmode="tel" autocomplete="tel" placeholder="Seu telefone/WhatsApp">
        <button type="submit">Consultar</button>
      </form>
      <div id="myOrdersResult" class="my-orders-result"></div>
    </div>
  </div>
</dialog>

<script>
(() => {
  const slug = <%- JSON.stringify(configuracao.slug) %>;
  const dialog = document.querySelector('#myOrdersDialog');
  const resultBox = document.querySelector('#myOrdersResult');
  const phoneInput = document.querySelector('#ordersPhone');

  const money = value => `R$ ${Number(value || 0).toFixed(2).replace('.', ',')}`;
  const escapeHtml = value => String(value ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  const statusText = status => ({
    novo: 'Novo', preparo: 'Em preparo', em_preparo: 'Em preparo', pronto: 'Pronto',
    entregue: 'Entregue', finalizado: 'Finalizado', cancelado: 'Cancelado'
  }[status] || status || 'Não informado');

  const paymentText = status => ({ pendente: 'Pendente', pago: 'Pago', cancelado: 'Cancelado' }[status] || status || 'Pendente');

  function openPixFromOrder(pix, pedidoId) {
    const orderModal = document.querySelector('#orderModal');
    const pixModal = document.querySelector('#pixPaymentModal');
    const qr = document.querySelector('#pixQrImage');
    const code = document.querySelector('#pixCopyCode');
    const status = document.querySelector('#pixPaymentStatus');
    const copyButton = document.querySelector('#copyPixButton');

    if (!pixModal || !qr || !code) throw new Error('Tela do Pix não foi encontrada.');
    if (orderModal) orderModal.classList.remove('open');
    dialog.close();
    qr.src = `data:image/png;base64,${pix.qrCodeBase64 || ''}`;
    code.value = pix.copiaCola || '';
    status.textContent = 'Aguardando pagamento...';
    copyButton.textContent = 'Copiar código Pix';
    copyButton.onclick = async () => {
      await navigator.clipboard.writeText(code.value);
      copyButton.textContent = 'Código copiado';
    };
    pixModal.classList.add('open');
    document.body.classList.add('modal-open');

    const interval = setInterval(async () => {
      try {
        const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/pedidos/${encodeURIComponent(pedidoId)}/pagamento-status`);
        const data = await response.json();
        if (data.pagamentoStatus === 'pago') {
          clearInterval(interval);
          status.textContent = '✅ Pagamento aprovado. Pedido confirmado!';
        }
      } catch (_) {}
    }, 5000);
  }

  async function finishPendingPix(button) {
    const pedidoId = button.dataset.orderId;
    button.disabled = true;
    const oldText = button.textContent;
    button.textContent = 'Gerando Pix...';
    try {
      const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/pedidos/${encodeURIComponent(pedidoId)}/pix`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Não foi possível gerar o Pix.');
      if (data.aprovado) {
        alert('Este pedido já está pago.');
        return;
      }
      openPixFromOrder(data, pedidoId);
    } catch (error) {
      alert(error.message);
    } finally {
      button.disabled = false;
      button.textContent = oldText;
    }
  }

  function renderOrders(orders) {
    if (!orders.length) {
      resultBox.innerHTML = '<div class="orders-empty">Nenhum pedido encontrado para este telefone.</div>';
      return;
    }

    resultBox.innerHTML = orders.map(order => {
      const pendingPix = order.formaPagamento === 'pix' && order.pagamentoStatus === 'pendente';
      const items = (order.itens || []).map(item => {
        const extras = (item.adicionais || []).map(extra => escapeHtml(extra.nome)).join(', ');
        return `<div class="customer-order-item">
          <span>${Number(item.quantidade || 1)}x</span>
          <div><strong>${escapeHtml(item.nome || 'Item')}</strong>${extras ? `<small>Adicionais: ${extras}</small>` : ''}${item.observacao ? `<small>Observação: ${escapeHtml(item.observacao)}</small>` : ''}</div>
          <strong class="customer-order-item-price">${money(item.subtotal || (Number(item.preco || 0) * Number(item.quantidade || 1)))}</strong>
        </div>`;
      }).join('');

      return `<article class="customer-order-card">
        <div class="customer-order-head">
          <div><div class="customer-order-number">Pedido #${escapeHtml(order.numero)}</div><div class="customer-order-date">${new Date(order.createdAt).toLocaleString('pt-BR')}</div></div>
          <div class="customer-order-badges">
            <span class="customer-order-badge">${escapeHtml(statusText(order.status))}</span>
            <span class="customer-order-badge ${order.pagamentoStatus === 'pago' ? 'paid' : 'pending'}">Pagamento: ${escapeHtml(paymentText(order.pagamentoStatus))}</span>
          </div>
        </div>
        <div><strong>Forma de pagamento:</strong> ${order.formaPagamento === 'pix' ? 'Pix online' : escapeHtml(order.formaPagamento || 'Não informada')}</div>
        ${order.observacao ? `<div><strong>Observação do pedido:</strong> ${escapeHtml(order.observacao)}</div>` : ''}
        <div class="customer-order-items">${items || '<div>Itens não informados.</div>'}</div>
        <div class="customer-order-footer">
          <div class="customer-order-total">Total: ${money(order.total)}</div>
          ${pendingPix ? `<button type="button" class="finish-pix-button" data-finish-pix data-order-id="${escapeHtml(order.id)}">Concluir pagamento Pix</button>` : ''}
        </div>
      </article>`;
    }).join('');
  }

  document.querySelector('#openMyOrders').onclick = () => dialog.showModal();
  document.querySelector('#closeMyOrders').onclick = () => dialog.close();
  dialog.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });

  resultBox.addEventListener('click', event => {
    const button = event.target.closest('[data-finish-pix]');
    if (button) finishPendingPix(button);
  });

  document.addEventListener('click', async event => {
    const button = event.target.closest('[data-rate-product]');
    if (!button) return;
    const telefone = prompt('Informe o telefone usado no pedido:');
    if (!telefone) return;
    const nota = Number(prompt('Nota de 1 a 5:'));
    if (!Number.isInteger(nota) || nota < 1 || nota > 5) return alert('Nota inválida.');
    const comentario = prompt('Comentário (opcional):') || '';
    const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/produtos/${encodeURIComponent(button.dataset.productId)}/avaliacoes`, {
      method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ telefone, nota, comentario })
    });
    const data = await response.json();
    alert(data.message || (response.ok ? 'Avaliação salva.' : 'Falha ao avaliar.'));
    if (response.ok) location.reload();
  });

  document.querySelector('#myOrdersForm').onsubmit = async event => {
    event.preventDefault();
    resultBox.innerHTML = '<div class="orders-loading">Consultando pedidos...</div>';
    try {
      const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/meus-pedidos?telefone=${encodeURIComponent(phoneInput.value)}`);
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Não foi possível consultar os pedidos.');
      renderOrders(data.pedidos || []);
    } catch (error) {
      resultBox.innerHTML = `<div class="orders-error">${escapeHtml(error.message)}</div>`;
    }
  };
})();
</script>
</body>
</html>
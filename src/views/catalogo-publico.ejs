    function currency(value) {
      return Number(
        value || 0
      ).toLocaleString(
        "pt-BR",
        {
          style: "currency",
          currency: "BRL"
        }
      );
    }

    function lerJsonArrayDataset(card, key) {
      try {
        const parsed = JSON.parse(card?.dataset?.[key] || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function lerAdicionaisCard(card) {
      return lerJsonArrayDataset(card, "productAdditionals");
    }

    function produtoDoCard(card) {
      if (!card) return null;
      return {
        id: String(card.dataset.id || ""),
        name: String(card.dataset.productName || ""),
        price: Number(card.dataset.productPrice || 0),
        image: String(card.dataset.productImage || ""),
        adicionais: lerAdicionaisCard(card),
        precosPizza: lerJsonArrayDataset(card, "productPizzaPrices").map(item => ({
          tamanhoId: String(item.tamanhoId || ""),
          tamanhoNome: String(item.tamanhoNome || ""),
          preco: Number(item.preco || 0),
        })),
        precosVariacoes: lerJsonArrayDataset(card, "productVariationPrices").map(item => ({
          variacaoId: String(item.variacaoId || ""),
          variacaoNome: String(item.variacaoNome || ""),
          preco: Number(item.preco || 0),
        })),
        categoria: {
          id: String(card.dataset.categoryId || ""),
          tipoProduto: String(card.dataset.categoryType || "normal"),
          permiteMeioAMeio: card.dataset.pizzaHalfEnabled === "true",
          regraPrecoMeioAMeio: String(
            card.dataset.pizzaPriceRule || "maior_sabor_escolhido",
          ),
          categoriasMeioAMeio: lerJsonArrayDataset(card, "pizzaCompatibleCategories")
            .map(item => String(item?.id || item?._id || item || ""))
            .filter(Boolean),
          tamanhos: lerJsonArrayDataset(card, "pizzaSizes").map(item => ({
            id: String(item.id || item._id || ""),
            nome: String(item.nome || ""),
            maxSabores: Math.max(1, Math.min(3, Number(item.maxSabores || 2))),
          })),
          variacoesHabilitadas: card.dataset.variationsEnabled === "true",
          variacoes: lerJsonArrayDataset(card, "categoryVariations").map(item => ({
            id: String(item.id || item._id || ""),
            nome: String(item.nome || ""),
          })),
        },
      };
    }

    const produtosCatalogoMap = new Map(
      [...cards]
        .map(card => produtoDoCard(card))
        .filter(Boolean)
        .map(produto => [produto.id, produto]),
    );

    function produtosDaCategoria(categoriaId) {
      return [...produtosCatalogoMap.values()]
        .filter(produto => produto.categoria?.id === String(categoriaId || ""))
        .sort((a, b) => a.name.localeCompare(b.name, "pt-BR"));
    }

    function idsCategoriasPizzaPermitidas(categoria = {}) {
      return new Set([
        String(categoria?.id || ""),
        ...(categoria?.categoriasMeioAMeio || []).map(id => String(id || "")),
      ].filter(Boolean));
    }

    function categoriasPizzaCompativeis(categoriaBase = {}, categoriaOutra = {}) {
      const baseId = String(categoriaBase?.id || "");
      const outraId = String(categoriaOutra?.id || "");
      if (!baseId || !outraId) return false;
      return baseId === outraId
        || idsCategoriasPizzaPermitidas(categoriaBase).has(outraId);
    }

    function produtosCategoriasPizzaPermitidas(categoria = {}) {
      const idsPermitidos = idsCategoriasPizzaPermitidas(categoria);
      return [...produtosCatalogoMap.values()]
        .filter(produto =>
          produto.categoria?.tipoProduto === "pizza"
          && idsPermitidos.has(String(produto.categoria?.id || "")),
        )
        .sort((a, b) => a.name.localeCompare(b.name, "pt-BR"));
    }

    function normalizarNomeTamanhoPizza(value) {
      return String(value || "")
        .trim()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("pt-BR");
    }

    function modoPizzaSelecionado() {
      return document.querySelector('input[name="pizzaModo"]:checked')?.value
        || "inteira";
    }

    function quantidadeSaboresModoPizza() {
      const modo = modoPizzaSelecionado();
      if (modo === "tres_sabores") return 3;
      if (modo === "meio_a_meio") return 2;
      return 1;
    }

    function precoProdutoNoTamanho(produto, tamanhoId = "", tamanhoNome = "") {
      const tamanhos = produto?.categoria?.tamanhos || [];
      if (!tamanhos.length) {
        return tamanhoId || tamanhoNome ? Number.NaN : Number(produto?.price || 0);
      }
      let tamanhoProduto = tamanhos.find(tamanho =>
        String(tamanho.id || "") === String(tamanhoId || ""),
      );
      if (!tamanhoProduto && tamanhoNome) {
        const nomeNormalizado = normalizarNomeTamanhoPizza(tamanhoNome);
        tamanhoProduto = tamanhos.find(tamanho =>
          normalizarNomeTamanhoPizza(tamanho.nome) === nomeNormalizado,
        );
      }
      if (!tamanhoProduto) return Number.NaN;
      const item = (produto?.precosPizza || []).find(preco =>
        String(preco.tamanhoId || "") === String(tamanhoProduto.id || ""),
      );
      return item ? Number(item.preco) : Number.NaN;
    }

    function tamanhosDisponiveisProduto(produto) {
      const tamanhosCategoria = produto?.categoria?.tamanhos || [];
      if (!tamanhosCategoria.length) return [];
      return tamanhosCategoria.filter(tamanho =>
        Number.isFinite(precoProdutoNoTamanho(produto, tamanho.id, tamanho.nome)),
      );
    }

    function tamanhoPizzaSelecionado() {
      if (!pendingPizza?.tamanhos?.length) return null;
      return pendingPizza.tamanhos.find(item => item.id === String(pizzaTamanho.value || ""))
        || null;
    }

    function maxSaboresTamanhoSelecionado() {
      if (!pendingPizza?.permiteMeioAMeio) return 1;
      const tamanho = tamanhoPizzaSelecionado();
      if (!pendingPizza?.tamanhos?.length) return 2;
      const maximo = Number(tamanho?.maxSabores || 2);
      return Number.isInteger(maximo) ? Math.max(1, Math.min(3, maximo)) : 2;
    }

    function calcularPrecoPizzaCliente({
      sabores = [],
      regra,
      tamanhoId = "",
      tamanhoNome = "",
    }) {
      const selecionados = (sabores || []).filter(Boolean);
      if (!selecionados.length) return Number.NaN;
      const precosSabores = selecionados.map(sabor =>
        precoProdutoNoTamanho(sabor, tamanhoId, tamanhoNome),
      );
      if (precosSabores.some(preco => !Number.isFinite(preco))) return Number.NaN;
      if (selecionados.length === 1) return precosSabores[0];
      if (regra === "maior_preco_categoria") {
        const precos = produtosCategoriasPizzaPermitidas(selecionados[0]?.categoria)
          .map(produto => precoProdutoNoTamanho(produto, tamanhoId, tamanhoNome))
          .filter(Number.isFinite);
        return precos.length ? Math.max(...precos) : Number.NaN;
      }
      return Math.max(...precosSabores);
    }

    function preencherSelectTamanhos(produto) {
      const tamanhos = tamanhosDisponiveisProduto(produto);
      pizzaTamanho.replaceChildren();
      pizzaTamanhoField.classList.toggle("hidden", !tamanhos.length);
      pizzaTamanho.disabled = !tamanhos.length;
      pizzaTamanho.required = tamanhos.length > 0;
      tamanhos.forEach(tamanho => {
        const option = document.createElement("option");
        option.value = tamanho.id;
        option.textContent = tamanho.nome;
        pizzaTamanho.appendChild(option);
      });
    }

    function preencherSelectSabores(select, produtos, selectedId = "", tamanhoId = "", tamanhoNome = "") {
      select.replaceChildren();
      produtos.forEach(produto => {
        const option = document.createElement("option");
        const preco = precoProdutoNoTamanho(produto, tamanhoId, tamanhoNome);
        option.value = produto.id;
        option.disabled = !Number.isFinite(preco);
        option.textContent = Number.isFinite(preco)
          ? `${produto.name} — ${currency(preco)}`
          : `${produto.name} — indisponível neste tamanho`;
        option.selected = produto.id === selectedId && !option.disabled;
        select.appendChild(option);
      });
      if (!select.value || select.selectedOptions[0]?.disabled) {
        const primeiroDisponivel = [...select.options].find(option => !option.disabled);
        if (primeiroDisponivel) select.value = primeiroDisponivel.value;
      }
    }

    function selecionarSaborDiferente(select, idsUsados = []) {
      if (!select) return;
      const usados = new Set(idsUsados.map(String));
      if (select.value && !usados.has(String(select.value))) return;
      const opcao = [...select.options].find(option =>
        !option.disabled && !usados.has(String(option.value || "")),
      );
      if (opcao) select.value = opcao.value;
    }

    function atualizarModalPizza({ atualizarSabores = false } = {}) {
      if (!pendingPizza) return;
      const maxSabores = maxSaboresTamanhoSelecionado();
      let quantidadeSabores = quantidadeSaboresModoPizza();
      if (quantidadeSabores > maxSabores) {
        document.querySelector('input[name="pizzaModo"][value="inteira"]').checked = true;
        quantidadeSabores = 1;
      }

      pizzaMeioAMeioOption.classList.toggle("hidden", maxSabores < 2);
      pizzaTresSaboresOption.classList.toggle("hidden", maxSabores < 3);
      document.querySelector('input[name="pizzaModo"][value="meio_a_meio"]').disabled = maxSabores < 2;
      document.querySelector('input[name="pizzaModo"][value="tres_sabores"]').disabled = maxSabores < 3;
      pizzaSabor2Field.classList.toggle("hidden", quantidadeSabores < 2);
      pizzaSabor3Field.classList.toggle("hidden", quantidadeSabores < 3);
      pizzaSabor2.disabled = quantidadeSabores < 2;
      pizzaSabor3.disabled = quantidadeSabores < 3;

      const tamanho = tamanhoPizzaSelecionado();
      const tamanhoId = tamanho?.id || "";
      const tamanhoNome = tamanho?.nome || "";
      if (atualizarSabores) {
        const categoriaBase = produtosCatalogoMap.get(pendingPizza.produtoInicialId)?.categoria || {};
        const produtosCategoria = produtosDaCategoria(pendingPizza.categoriaId);
        const produtosCompativeis = produtosCategoriasPizzaPermitidas(categoriaBase);
        const sabor1Atual = String(pizzaSabor1.value || pendingPizza.produtoInicialId || "");
        const sabor2Atual = String(pizzaSabor2.value || "");
        const sabor3Atual = String(pizzaSabor3.value || "");
        preencherSelectSabores(pizzaSabor1, produtosCategoria, sabor1Atual, tamanhoId, tamanhoNome);
        preencherSelectSabores(pizzaSabor2, produtosCompativeis, sabor2Atual, tamanhoId, tamanhoNome);
        preencherSelectSabores(pizzaSabor3, produtosCompativeis, sabor3Atual, tamanhoId, tamanhoNome);
      }

      selecionarSaborDiferente(pizzaSabor2, [pizzaSabor1.value]);
      selecionarSaborDiferente(pizzaSabor3, [pizzaSabor1.value, pizzaSabor2.value]);

      const sabores = [
        produtosCatalogoMap.get(String(pizzaSabor1.value || "")),
        produtosCatalogoMap.get(String(pizzaSabor2.value || "")),
        produtosCatalogoMap.get(String(pizzaSabor3.value || "")),
      ].slice(0, quantidadeSabores);
      const ids = sabores.map(sabor => String(sabor?.id || "")).filter(Boolean);
      const repetidos = ids.length !== new Set(ids).size;
      const preco = calcularPrecoPizzaCliente({
        sabores,
        regra: pendingPizza.regra,
        tamanhoId,
        tamanhoNome,
      });
      const tamanhoObrigatorioPendente = pendingPizza.tamanhos.length > 0 && !tamanho;
      const precoInvalido = !Number.isFinite(preco);
      const mensagemRepetido = repetidos ? "Escolha sabores diferentes." : "";

      pizzaPricePreview.textContent = precoInvalido ? "Indisponível" : currency(preco);
      pizzaSabor2.setCustomValidity(mensagemRepetido);
      pizzaSabor3.setCustomValidity(mensagemRepetido);
      document.querySelector("#confirmPizza").disabled = Boolean(
        tamanhoObrigatorioPendente
        || precoInvalido
        || sabores.length !== quantidadeSabores
        || sabores.some(sabor => !sabor)
        || repetidos,
      );

      const tamanhoTexto = tamanho ? ` no tamanho ${tamanho.nome}` : "";
      if (quantidadeSabores === 1) {
        pizzaRuleNote.textContent = `O sabor inteiro usa o preço cadastrado${tamanhoTexto}.`;
      } else if (pendingPizza.regra === "maior_preco_categoria") {
        pizzaRuleNote.textContent =
          `Regra da loja: será cobrado o maior preço das pizzas das categorias permitidas${tamanhoTexto}.`;
      } else {
        pizzaRuleNote.textContent =
          `Regra da loja: será cobrado o maior preço entre os ${quantidadeSabores} sabores escolhidos${tamanhoTexto}.`;
      }
    }

    function fecharModalPizza() {
      pizzaModal.classList.remove("open");
      document.body.classList.remove("modal-open");
      pendingPizza = null;
    }

    function abrirModalPizza(produto) {
      const produtosCategoria = produtosDaCategoria(produto.categoria.id);
      const produtosCompativeis = produtosCategoriasPizzaPermitidas(produto.categoria);
      pendingPizza = {
        categoriaId: produto.categoria.id,
        produtoInicialId: produto.id,
        regra: produto.categoria.regraPrecoMeioAMeio,
        permiteMeioAMeio: produto.categoria.permiteMeioAMeio === true,
        tamanhos: tamanhosDisponiveisProduto(produto),
      };
      pizzaModalTitle.textContent = "Monte sua pizza";
      document.querySelector('input[name="pizzaModo"][value="inteira"]').checked = true;
      preencherSelectTamanhos(produto);
      const tamanhoId = pendingPizza.tamanhos[0]?.id || "";
      if (tamanhoId) pizzaTamanho.value = tamanhoId;
      const tamanhoNome = pendingPizza.tamanhos[0]?.nome || "";
      preencherSelectSabores(pizzaSabor1, produtosCategoria, produto.id, tamanhoId, tamanhoNome);
      const segundoPadrao = produtosCompativeis.find(item => item.id !== produto.id)?.id
        || produto.id;
      preencherSelectSabores(pizzaSabor2, produtosCompativeis, segundoPadrao, tamanhoId, tamanhoNome);
      const terceiroPadrao = produtosCompativeis.find(item =>
        item.id !== produto.id && item.id !== segundoPadrao
      )?.id || segundoPadrao;
      preencherSelectSabores(pizzaSabor3, produtosCompativeis, terceiroPadrao, tamanhoId, tamanhoNome);
      atualizarModalPizza();
      pizzaModal.classList.add("open");
      document.body.classList.add("modal-open");
    }

    function precoProdutoNaVariacao(produto, variacaoId = "") {
      const item = (produto?.precosVariacoes || []).find(preco =>
        String(preco.variacaoId || "") === String(variacaoId || ""),
      );
      return item ? Number(item.preco) : Number.NaN;
    }

    function variacoesDisponiveisProduto(produto) {
      if (produto?.categoria?.variacoesHabilitadas !== true) return [];
      const opcoes = produto?.categoria?.variacoes || [];
      return opcoes.filter(opcao =>
        Number.isFinite(precoProdutoNaVariacao(produto, opcao.id)),
      );
    }

    function variacaoSelecionada() {
      if (!pendingVariation?.variacoes?.length) return null;
      return pendingVariation.variacoes.find(item =>
        item.id === String(variationSelect.value || ""),
      ) || null;
    }

    function atualizarModalVariacao() {
      if (!pendingVariation) return;
      const opcao = variacaoSelecionada();
      const preco = opcao
        ? precoProdutoNaVariacao(pendingVariation.produto, opcao.id)
        : Number.NaN;
      variationPricePreview.textContent = Number.isFinite(preco)
        ? currency(preco)
        : "Indisponível";
      document.querySelector("#confirmVariation").disabled = !opcao || !Number.isFinite(preco);
    }

    function fecharModalVariacao() {
      variationModal.classList.remove("open");
      document.body.classList.remove("modal-open");
      pendingVariation = null;
    }

    function abrirModalVariacao(produto) {
      const variacoes = variacoesDisponiveisProduto(produto);
      if (!variacoes.length) return;
      pendingVariation = { produto, variacoes };
      variationModalTitle.textContent = `Escolha uma opção para ${produto.name}`;
      variationSelect.replaceChildren();
      variacoes.forEach(opcao => {
        const option = document.createElement("option");
        option.value = opcao.id;
        option.textContent = `${opcao.nome} — ${currency(precoProdutoNaVariacao(produto, opcao.id))}`;
        variationSelect.appendChild(option);
      });
      if (variacoes[0]) variationSelect.value = variacoes[0].id;
      atualizarModalVariacao();
      variationModal.classList.add("open");
      document.body.classList.add("modal-open");
    }

    function abrirModalAdicionais(product, adicionais) {
      pendingProduct = { product, adicionais };
      addonTitle.textContent = `Adicionais de ${product.name}`;
      addonList.replaceChildren();
      adicionais.forEach(adicional => {
        const option = document.createElement("div");
        option.className = "addon-option";
        const label = document.createElement("label");
        const input = document.createElement("input");
        input.type = "checkbox";
        input.value = String(adicional._id || "");
        label.append(input, document.createTextNode(` ${String(adicional.nome || "")}`));
        const price = document.createElement("strong");
        price.textContent = `+ ${currency(adicional.preco)}`;
        option.append(label, price);
        addonList.appendChild(option);
      });
      addonModal.classList.add("open");
      document.body.classList.add("modal-open");
    }

    function continuarProdutoParaCarrinho(product, adicionais = []) {
      if (!adicionais.length) {
        addToCart(product, []);
        return;
      }
      abrirModalAdicionais(product, adicionais);
    }


    function valorDigitadoParaCentavos(value) {
      const text = String(value ?? "")
        .trim()
        .replace(/\s/g, "")
        .replace(/^R\$/i, "");
      if (!text) return null;

      let normalized = "";
      if (/^\d{1,3}(?:\.\d{3})*(?:,\d{1,2})?$/.test(text)) {
        normalized = text.replace(/\./g, "").replace(",", ".");
      } else if (/^\d+(?:,\d{1,2})?$/.test(text)) {
        normalized = text.replace(",", ".");
      } else if (/^\d+(?:\.\d{1,2})?$/.test(text)) {
        normalized = text;
      } else {
        return null;
      }

      const number = Number(normalized);
      const cents = Math.round(number * 100);
      return Number.isFinite(number) && Number.isSafeInteger(cents)
        ? cents
        : null;
    }

    function pagamentoCombinadoAtivo() {
      return formaPagamento?.value === "combinado";
    }

    function totalAtualPedidoCentavos() {
      return Math.max(
        0,
        Math.round((resumoFinanceiroPedido().total + Number.EPSILON) * 100),
      );
    }

    function atualizarPagamentoCombinado() {
      const active = pagamentoCombinadoAtivo();
      combinedPaymentPanel?.classList.toggle("hidden", !active);
      if (!combinedPaymentPanel) return;

      formaPagamento1.required = active;
      formaPagamento2.required = active;
      valorPagamento1.required = active;

      if (!active) {
        valorPagamento1.setCustomValidity("");
        formaPagamento2.setCustomValidity("");
        valorPagamento2.value = currency(0);
        return;
      }

      const totalCents = totalAtualPedidoCentavos();
      const firstCents = valorDigitadoParaCentavos(valorPagamento1.value);
      const secondCents = firstCents == null ? 0 : totalCents - firstCents;
      valorPagamento2.value = currency(Math.max(0, secondCents) / 100);

      const repeated = formaPagamento1.value === formaPagamento2.value;
      formaPagamento2.setCustomValidity(
        repeated ? "Escolha dois meios de pagamento diferentes." : "",
      );

      const validFirst = Number.isSafeInteger(firstCents)
        && firstCents > 0
        && firstCents < totalCents;
      valorPagamento1.setCustomValidity(
        validFirst
          ? ""
          : "Informe um primeiro valor maior que zero e menor que o total do pedido.",
      );

      if (combinedPaymentNote) {
        combinedPaymentNote.textContent = validFirst && !repeated
          ? `${formaPagamento1.selectedOptions[0]?.textContent?.trim() || "Primeiro pagamento"}: ${currency(firstCents / 100)} • ${formaPagamento2.selectedOptions[0]?.textContent?.trim() || "Segundo pagamento"}: ${currency(secondCents / 100)}`
          : "Informe somente o primeiro valor. O restante será calculado automaticamente usando o total atual do pedido.";
      }
    }

    function payloadIncluiForma(payload, method) {
      if (payload.formaPagamento !== "combinado") {
        return payload.formaPagamento === method;
      }
      return payload.formaPagamento1 === method || payload.formaPagamento2 === method;
    }

    function valorFormaPayloadCentavos(payload, method) {
      const totalCents = totalAtualPedidoCentavos();
      if (payload.formaPagamento !== "combinado") {
        return payload.formaPagamento === method ? totalCents : 0;
      }
      const firstCents = valorDigitadoParaCentavos(payload.valorPagamento1);
      if (!Number.isSafeInteger(firstCents)) return 0;
      if (payload.formaPagamento1 === method) return firstCents;
      if (payload.formaPagamento2 === method) return totalCents - firstCents;
      return 0;
    }

    function urlImagemSegura(value) {
      const text = String(value ?? '').trim();
      if (/[\u0000-\u001F\u007F]/.test(text)) return '';
      if (text.startsWith('/') && !text.startsWith('//')) return text;
      if (/^data:image\/(?:png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=\s]+$/i.test(text)) {
        return text;
      }
      try {
        const url = new URL(text);
        return url.protocol === 'https:' ? url.href : '';
      } catch {
        return '';
      }
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function filterProducts() {
      const query =
        String(searchInput.value || "")
          .toLowerCase()
          .trim();

      cards.forEach(card => {
        const corresponde =
          card.dataset.name.includes(query);

        card.classList.toggle(
          "hidden",
          !corresponde
        );
      });

      sections.forEach(section => {
        const categoria =
          section.dataset.section;

        const categoriaCorresponde =
          selectedCategory === "todos" ||
          selectedCategory === categoria;

        const possuiVisiveis =
          [...section.querySelectorAll(".product-card")]
            .some(card => {
              return !card.classList.contains("hidden");
            });

        section.classList.toggle(
          "hidden",
          !categoriaCorresponde ||
          !possuiVisiveis
        );
      });
    }

    categoryButtons.forEach(button => {
      button.addEventListener(
        "click",
        () => {
          categoryButtons.forEach(
            item => {
              item.classList.remove("active");
            }
          );

          button.classList.add("active");

          selectedCategory =
            button.dataset.cat;

          filterProducts();

          // Mantem a categoria selecionada visivel e centralizada na barra.
          if (categoryBar) {
            const barRect = categoryBar.getBoundingClientRect();
            const buttonRect = button.getBoundingClientRect();
            const deslocamento =
              buttonRect.left
              - barRect.left
              - ((barRect.width - buttonRect.width) / 2);

            categoryBar.scrollBy({
              left: deslocamento,
              behavior: "smooth"
            });
          }
        }
      );
    });

    searchInput.addEventListener(
      "input",
      filterProducts
    );

    function loadCart() {
      try {
        const saved =
          localStorage.getItem(
            storageKey
          );

        cart = saved
          ? JSON.parse(saved)
          : [];

        if (!Array.isArray(cart)) {
          cart = [];
        }
      } catch {
        cart = [];
      }
    }

    function saveCart() {
      localStorage.setItem(
        storageKey,
        JSON.stringify(cart)
      );
    }

    function totalItems() {
      return cart.reduce(
        (total, item) =>
          total +
          Number(item.quantity || 0),
        0
      );
    }

    function subtotal() {
      return cart.reduce(
        (total, item) => {
          return (
            total +
            (
              Number(item.price || 0) +
              (item.adicionais || []).reduce(
                (sum, adicional) => sum + Number(adicional.preco || 0),
                0
              )
            ) * Number(item.quantity || 0)
          );
        },
        0
      );
    }

    function inteiroCentavos(value, fallback = 0) {
      const numero = Number(value);
      return Number.isSafeInteger(numero) && numero >= 0 ? numero : fallback;
    }

    function regraEntregaSelecionadaCliente() {
      const delivery = canalPedido?.value === "delivery";
      const opcao = cidadeEntregaId?.selectedOptions?.[0] || null;
      const cidadeSelecionada = Boolean(cidadeEntregaId?.value && opcao);
      const subtotalCentavos = Math.max(
        0,
        Math.round((subtotal() + Number.EPSILON) * 100),
      );

      if (!delivery || !cidadeSelecionada) {
        return {
          delivery,
          cidadeSelecionada,
          cidadeNome: "",
          subtotalCentavos,
          pedidoMinimoCentavos: 0,
          faltamCentavos: 0,
          abaixoDoMinimo: false,
          bloqueado: false,
          taxaEntregaCentavos: 0,
          taxaNormalCentavos: 0,
          taxaAbaixoMinimoCentavos: 0,
          modo: "bloquear",
        };
      }

      const taxaNormalCentavos = inteiroCentavos(opcao.dataset.taxaCentavos);
      const pedidoMinimoCentavos = inteiroCentavos(opcao.dataset.pedidoMinimoCentavos);
      const taxaAbaixoMinimoCentavos = inteiroCentavos(
        opcao.dataset.taxaAbaixoMinimoCentavos,
      );
      const modo = opcao.dataset.abaixoMinimoModo === "taxa_especial"
        ? "taxa_especial"
        : "bloquear";
      const abaixoDoMinimo = pedidoMinimoCentavos > 0
        && subtotalCentavos < pedidoMinimoCentavos;
      const bloqueado = abaixoDoMinimo && modo === "bloquear";
      const taxaEntregaCentavos = abaixoDoMinimo && modo === "taxa_especial"
        ? taxaAbaixoMinimoCentavos
        : taxaNormalCentavos;

      return {
        delivery,
        cidadeSelecionada,
        cidadeNome: String(opcao.dataset.cidadeNome || "esta cidade"),
        subtotalCentavos,
        pedidoMinimoCentavos,
        faltamCentavos: abaixoDoMinimo
          ? Math.max(0, pedidoMinimoCentavos - subtotalCentavos)
          : 0,
        abaixoDoMinimo,
        bloqueado,
        taxaEntregaCentavos,
        taxaNormalCentavos,
        taxaAbaixoMinimoCentavos,
        modo,
      };
    }

    function taxaEntregaSelecionadaCentavos() {
      return regraEntregaSelecionadaCliente().taxaEntregaCentavos;
    }

    function resumoFinanceiroPedido() {
      const subtotalCentavos = Math.max(
        0,
        Math.round((subtotal() + Number.EPSILON) * 100),
      );
      const taxaEntregaCentavos = taxaEntregaSelecionadaCentavos();
      return {
        subtotal: subtotalCentavos / 100,
        taxaEntrega: taxaEntregaCentavos / 100,
        total: (subtotalCentavos + taxaEntregaCentavos) / 100,
      };
    }

    function atualizarAvisoRegraEntrega(regra) {
      if (!deliveryMinimumNotice) return;

      deliveryMinimumNotice.className = "delivery-rule-notice delivery-address-field hidden";
      deliveryMinimumNotice.textContent = "";

      if (!regra.delivery || !regra.cidadeSelecionada || regra.pedidoMinimoCentavos <= 0) {
        return;
      }

      if (regra.bloqueado) {
        deliveryMinimumNotice.className = "delivery-rule-notice delivery-address-field error";
        deliveryMinimumNotice.textContent =
          `Para ${regra.cidadeNome}, o delivery é feito somente a partir de ${currency(regra.pedidoMinimoCentavos / 100)}. ` +
          `Faltam ${currency(regra.faltamCentavos / 100)} em produtos para continuar.`;
        return;
      }

      if (regra.abaixoDoMinimo && regra.modo === "taxa_especial") {
        deliveryMinimumNotice.className = "delivery-rule-notice delivery-address-field";
        deliveryMinimumNotice.textContent =
          `O pedido mínimo de ${regra.cidadeNome} é ${currency(regra.pedidoMinimoCentavos / 100)}. ` +
          `Como seu pedido está abaixo desse valor, a taxa de entrega será ${currency(regra.taxaAbaixoMinimoCentavos / 100)}. ` +
          `Ao atingir o mínimo, a taxa normal será ${currency(regra.taxaNormalCentavos / 100)}.`;
        return;
      }

      deliveryMinimumNotice.className = "delivery-rule-notice delivery-address-field success";
      deliveryMinimumNotice.textContent =
        `Pedido mínimo de ${currency(regra.pedidoMinimoCentavos / 100)} atingido para ${regra.cidadeNome}. ` +
        `Taxa normal de entrega: ${currency(regra.taxaNormalCentavos / 100)}.`;
    }

    function atualizarResumoFinanceiroPedido() {
      const resumo = resumoFinanceiroPedido();
      const delivery = canalPedido?.value === "delivery";
      const cidadeSelecionada = Boolean(cidadeEntregaId?.value);
      const regra = regraEntregaSelecionadaCliente();

      if (orderSubtotal) orderSubtotal.textContent = currency(resumo.subtotal);
      if (orderDeliveryFeeRow) orderDeliveryFeeRow.classList.toggle("hidden", !delivery);
      if (orderDeliveryFee) {
        orderDeliveryFee.textContent = delivery && !cidadeSelecionada
          ? "Selecione a cidade"
          : currency(resumo.taxaEntrega);
      }
      if (orderTotal) orderTotal.textContent = currency(resumo.total);
      atualizarAvisoRegraEntrega(regra);
      atualizarPagamentoCombinado();
    }

    function validarRegraEntregaAntesDoEnvio() {
      const regra = regraEntregaSelecionadaCliente();
      if (!regra.bloqueado) return true;

      atualizarAvisoRegraEntrega(regra);
      formMessage.className = "form-message error";
      formMessage.textContent =
        `Delivery para ${regra.cidadeNome} somente a partir de ${currency(regra.pedidoMinimoCentavos / 100)}. ` +
        `Adicione mais ${currency(regra.faltamCentavos / 100)} ao carrinho.`;
      return false;
    }

    function renderCart() {
      cartList.replaceChildren();

      cartEmpty.classList.toggle(
        "hidden",
        cart.length > 0
      );

      cart.forEach(item => {
        const element =
          document.createElement("div");

        element.className =
          "cart-item";

        element.innerHTML = '<div class="cart-thumb"></div><div><h3 class="cart-name"></h3><div class="cart-price"></div><div class="cart-pizza-flavors"></div><div class="cart-addons"></div><div class="cart-actions"><div class="qty-box"><button type="button" class="qty-btn" data-action="decrease">−</button><span class="qty-number"></span><button type="button" class="qty-btn" data-action="increase">+</button></div><button type="button" class="remove-btn" data-action="remove" aria-label="Remover">×</button></div></div>';
        const imageUrl = urlImagemSegura(item.image);
        const thumb = element.querySelector('.cart-thumb');
        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = String(item.name || '');
          thumb.appendChild(image);
        } else {
          thumb.textContent = '🍔';
        }
        element.querySelector('.cart-name').textContent =
          String(item.name || '');
        element.querySelector('.cart-price').textContent = currency(
          Number(item.price || 0) +
          (item.adicionais || []).reduce(
            (sum, adicional) => sum + Number(adicional.preco || 0),
            0
          )
        );
        const detalhesPizzaCarrinho = [];
        if (item.tamanhoPizza?.nome) {
          detalhesPizzaCarrinho.push(`📏 ${String(item.tamanhoPizza.nome)}`);
        }
        if (item.variacao?.nome) {
          detalhesPizzaCarrinho.push(`📏 ${String(item.variacao.nome)}`);
        }
        if (item.pizzaMeioAMeio) {
          const quantidadeSaboresPizza = Math.max(2, (item.saboresPizza || []).length);
          const rotuloFracaoPizza = quantidadeSaboresPizza === 3 ? "1/3" : "1/2";
          detalhesPizzaCarrinho.push(
            ...(item.saboresPizza || []).map(sabor =>
              `${rotuloFracaoPizza} ${String(sabor.nome || "Sabor")}`
            ),
          );
        }
        element.querySelector('.cart-pizza-flavors').textContent =
          detalhesPizzaCarrinho.join('\n');
        element.querySelector('.cart-addons').textContent =
          (item.adicionais || [])
            .map(adicional => `+ ${adicional.nome} (${currency(adicional.preco)})`)
            .join('\n');
        element.querySelector('.qty-number').textContent =
          String(Number(item.quantity) || 0);
        element.querySelectorAll('[data-action]').forEach(button => {
          button.dataset.id = String(item.cartId || item.id || '');
        });

        cartList.appendChild(element);
      });

      const quantidade =
        totalItems();

      cartCount.textContent =
        quantidade;

      cartItemsCount.textContent =
        quantidade;

      mobileCartCount.textContent =
        quantidade;

      cartSubtotal.textContent =
        currency(subtotal());

      atualizarResumoFinanceiroPedido();
      atualizarBotoesPedido();
    }

    function avisarCarrinho(mensagem) {
      if (!mensagem) return;
      formMessage.className = "form-message error";
      formMessage.textContent = mensagem;
    }

    function bloquearLojaPublica() {
      lojaBloqueada = true;
      storeIsOpen = false;
      checkoutBtn.disabled = true;
      checkoutBtn.textContent = "Loja indisponível";
      document.querySelectorAll("[data-add-cart]").forEach(button => {
        button.disabled = true;
      });
      avisarCarrinho(
        "Esta loja está temporariamente indisponível para novos pedidos."
      );
    }

    function aplicarProdutosAtuais(produtosAtuais) {
      const produtosNormalizados = (produtosAtuais || []).map(produto => ({
        id: String(produto.id || ""),
        name: String(produto.nome || ""),
        price: Number(produto.preco || 0),
        precosPizza: (produto.precosPizza || []).map(item => ({
          tamanhoId: String(item.tamanhoId || ""),
          tamanhoNome: String(item.tamanhoNome || ""),
          preco: Number(item.preco || 0),
        })),
        precosVariacoes: (produto.precosVariacoes || []).map(item => ({
          variacaoId: String(item.variacaoId || ""),
          variacaoNome: String(item.variacaoNome || ""),
          preco: Number(item.preco || 0),
        })),
        image: String(produto.imagem || ""),
        adicionais: (produto.adicionais || []).map(adicional => ({
          _id: String(adicional.id || adicional._id || ""),
          nome: String(adicional.nome || ""),
          preco: Number(adicional.preco || 0),
        })),
        categoria: produto.categoria
          ? {
              id: String(produto.categoria.id || ""),
              tipoProduto: String(produto.categoria.tipoProduto || "normal"),
              permiteMeioAMeio: produto.categoria.permiteMeioAMeio === true,
              regraPrecoMeioAMeio: String(
                produto.categoria.regraPrecoMeioAMeio || "maior_sabor_escolhido",
              ),
              categoriasMeioAMeio: (produto.categoria.categoriasMeioAMeio || [])
                .map(id => String(id || ""))
                .filter(Boolean),
              tamanhos: (produto.categoria.tamanhos || []).map(tamanho => ({
                id: String(tamanho.id || tamanho._id || ""),
                nome: String(tamanho.nome || ""),
                maxSabores: Math.max(1, Math.min(3, Number(tamanho.maxSabores || 2))),
              })),
              variacoesHabilitadas: produto.categoria.variacoesHabilitadas === true,
              variacoes: (produto.categoria.variacoes || []).map(opcao => ({
                id: String(opcao.id || opcao._id || ""),
                nome: String(opcao.nome || ""),
              })),
            }
          : { id: "", tipoProduto: "normal", permiteMeioAMeio: false, categoriasMeioAMeio: [], tamanhos: [], variacoesHabilitadas: false, variacoes: [] },
      }));
      const mapaProdutos = new Map(
        produtosNormalizados.map(produto => [produto.id, produto]),
      );
      produtosCatalogoMap.clear();
      produtosNormalizados.forEach(produto => produtosCatalogoMap.set(produto.id, produto));

      const idsRemovidos = [];
      let precoAlterado = false;

      cart = cart.flatMap(item => {
        let produto = mapaProdutos.get(String(item.id));
        let produtoCarrinho = null;

        if (item.pizzaMeioAMeio) {
          const idsSabores = (item.saboresPizza || [])
            .map(sabor => String(sabor.produtoId || ""));
          const sabores = idsSabores.map(id => mapaProdutos.get(id));
          const tamanhos = sabores[0]?.categoria?.tamanhos || [];
          const tamanhoId = String(item.tamanhoPizza?.id || item.tamanhoPizzaId || "");
          const tamanho = tamanhos.length
            ? tamanhos.find(opcao => opcao.id === tamanhoId)
            : null;
          const maxSabores = sabores[0]?.categoria?.permiteMeioAMeio === true
            ? (tamanhos.length
                ? Math.max(1, Math.min(3, Number(tamanho?.maxSabores || 2)))
                : 2)
            : 1;
          const pizzaValida = idsSabores.length >= 2
            && idsSabores.length <= 3
            && new Set(idsSabores).size === idsSabores.length
            && idsSabores.length <= maxSabores
            && sabores.every(Boolean)
            && sabores.slice(1).every(sabor =>
              categoriasPizzaCompativeis(sabores[0]?.categoria, sabor?.categoria))
            && sabores[0].categoria?.tipoProduto === "pizza"
            && sabores[0].categoria?.permiteMeioAMeio === true
            && (!tamanhos.length || Boolean(tamanho));

          if (!pizzaValida) {
            idsRemovidos.push(String(item.cartId || item.id || "pizza"));
            return [];
          }

          produto = sabores[0];
          const regra = produto.categoria.regraPrecoMeioAMeio;
          const novoPreco = calcularPrecoPizzaCliente({
            sabores,
            regra,
            tamanhoId: tamanho?.id || "",
            tamanhoNome: tamanho?.nome || "",
          });
          if (!Number.isFinite(novoPreco)) {
            idsRemovidos.push(String(item.cartId || item.id || "pizza"));
            return [];
          }
          if (Math.abs(Number(item.price || 0) - novoPreco) > 0.001) {
            precoAlterado = true;
          }

          const quantidadeSabores = sabores.length;
          const fracao = 1 / quantidadeSabores;
          const rotuloFracao = quantidadeSabores === 3 ? "1/3" : "1/2";
          produtoCarrinho = {
            ...item,
            id: produto.id,
            name: `Pizza ${sabores.map(sabor => `${rotuloFracao} ${sabor.name}`).join(" + ")}`,
            price: novoPreco,
            image: sabores.find(sabor => sabor.image)?.image || "",
            categoria: produto.categoria,
            tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
            regraPrecoPizza: regra,
            saboresPizza: sabores.map(sabor => ({
              produtoId: sabor.id,
              nome: sabor.name,
              preco: precoProdutoNoTamanho(sabor, tamanho?.id || "", tamanho?.nome || ""),
              fracao,
            })),
          };
        } else {
          if (!produto) {
            idsRemovidos.push(String(item.id));
            return [];
          }
          const tamanhos = produto.categoria?.tipoProduto === "pizza"
            ? (produto.categoria?.tamanhos || [])
            : [];
          const tamanhoId = String(item.tamanhoPizza?.id || item.tamanhoPizzaId || "");
          const tamanho = tamanhos.length
            ? tamanhos.find(opcao => opcao.id === tamanhoId)
            : null;
          if (tamanhos.length && !tamanho) {
            idsRemovidos.push(String(item.cartId || item.id));
            return [];
          }

          const variacoes = produto.categoria?.tipoProduto !== "pizza"
            && produto.categoria?.variacoesHabilitadas === true
              ? (produto.categoria?.variacoes || [])
              : [];
          const variacaoId = String(item.variacao?.id || item.variacaoId || "");
          const variacao = variacoes.length
            ? variacoes.find(opcao => opcao.id === variacaoId)
            : null;
          if (variacoes.length && !variacao) {
            idsRemovidos.push(String(item.cartId || item.id));
            return [];
          }

          const novoPreco = produto.categoria?.tipoProduto === "pizza"
            ? precoProdutoNoTamanho(produto, tamanho?.id || "")
            : variacoes.length
              ? precoProdutoNaVariacao(produto, variacao?.id || "")
              : Number(produto.price || 0);
          if (!Number.isFinite(novoPreco)) {
            idsRemovidos.push(String(item.cartId || item.id));
            return [];
          }
          if (Math.abs(Number(item.price || 0) - novoPreco) > 0.001) {
            precoAlterado = true;
          }
          produtoCarrinho = {
            ...item,
            id: produto.id,
            name: produto.name,
            price: novoPreco,
            image: produto.image || "",
            categoria: produto.categoria,
            tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
            variacao: variacao ? { id: variacao.id, nome: variacao.nome } : null,
          };
        }

        const adicionaisAtuais = new Map(
          (produto.adicionais || []).map(adicional => [
            String(adicional._id || adicional.id),
            adicional,
          ]),
        );
        const adicionais = (item.adicionais || []).flatMap(adicional => {
          const atual = adicionaisAtuais.get(String(adicional._id || adicional.id));
          return atual ? [{
            _id: String(atual._id || atual.id),
            nome: atual.nome,
            preco: Number(atual.preco || 0),
          }] : [];
        });
        const addonsKey = adicionais
          .map(adicional => String(adicional._id))
          .sort()
          .join(",");
        const pizzaKey = produtoCarrinho.pizzaMeioAMeio
          ? `pizza:${produtoCarrinho.saboresPizza
              .map(sabor => String(sabor.produtoId || ""))
              .sort()
              .join("+")}:${String(produtoCarrinho.regraPrecoPizza || "")}`
          : produtoCarrinho.id;
        const tamanhoKey = produtoCarrinho.tamanhoPizza?.id
          ? `:tamanho:${String(produtoCarrinho.tamanhoPizza.id)}`
          : "";
        const variacaoKey = produtoCarrinho.variacao?.id
          ? `:variacao:${String(produtoCarrinho.variacao.id)}`
          : "";

        return [{
          ...produtoCarrinho,
          cartId: `${pizzaKey}${tamanhoKey}${variacaoKey}:${addonsKey}`,
          adicionais,
        }];
      });

      saveCart();
      renderCart();
      return { idsRemovidos, precoAlterado };
    }

    async function sincronizarCarrinho({ avisar = true } = {}) {
      if (lojaBloqueada) {
        return { idsRemovidos: [], precoAlterado: false, lojaIndisponivel: true };
      }
      if (sincronizacaoCarrinhoEmAndamento) {
        return sincronizacaoCarrinhoEmAndamento;
      }

      sincronizacaoCarrinhoEmAndamento = (async () => {
        const response = await fetch(
          `/catalogo/${encodeURIComponent(storeSlug)}/produtos-status`,
          { headers: { "Accept": "application/json" } }
        );
        const result = await response.json();
        if (response.status === 403 && result.code === "LOJA_INDISPONIVEL") {
          bloquearLojaPublica();
          return {
            idsRemovidos: [],
            precoAlterado: false,
            lojaIndisponivel: true
          };
        }
        if (!response.ok) {
          throw new Error("Não foi possível conferir os produtos do carrinho.");
        }
        const mudancas = aplicarProdutosAtuais(result.produtos);
        if (
          avisar
          && mudancas.idsRemovidos.length
          && !avisoProdutosRemovidosExibido
        ) {
          avisoProdutosRemovidosExibido = true;
          avisarCarrinho(
            "Um ou mais produtos foram removidos do seu carrinho porque não estão mais disponíveis."
          );
        }
        if (avisar && mudancas.precoAlterado) {
          avisarCarrinho("O preço de um produto foi atualizado. Confirme o pedido novamente.");
        }
        return mudancas;
      })();

      try {
        return await sincronizacaoCarrinhoEmAndamento;
      } finally {
        sincronizacaoCarrinhoEmAndamento = null;
      }
    }

    function addToCart(product, adicionais = []) {
      if (adicionais.length > PUBLIC_ORDER_LIMITS.maxAdditionsPerItem) {
        avisarCarrinho(
          `Escolha no máximo ${PUBLIC_ORDER_LIMITS.maxAdditionsPerItem} adicionais por item.`
        );
        return false;
      }

      const addonsKey = adicionais
        .map(adicional => String(adicional._id))
        .sort()
        .join(",");
      const pizzaKey = product.pizzaMeioAMeio
        ? `pizza:${(product.saboresPizza || [])
            .map(sabor => String(sabor.produtoId || ""))
            .sort()
            .join("+")}:${String(product.regraPrecoPizza || "")}`
        : String(product.id || "");
      const tamanhoKey = product.tamanhoPizza?.id
        ? `:tamanho:${String(product.tamanhoPizza.id)}`
        : "";
      const variacaoKey = product.variacao?.id
        ? `:variacao:${String(product.variacao.id)}`
        : "";
      const cartId = `${pizzaKey}${tamanhoKey}${variacaoKey}:${addonsKey}`;
      const existing = cart.find(item => item.cartId === cartId);

      if (totalItems() >= PUBLIC_ORDER_LIMITS.maxTotalQuantity) {
        avisarCarrinho(
          `O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxTotalQuantity} unidades.`
        );
        return false;
      }

      if (existing && Number(existing.quantity || 0) >= PUBLIC_ORDER_LIMITS.maxQuantityPerItem) {
        avisarCarrinho(
          `Cada item pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxQuantityPerItem} unidades.`
        );
        return false;
      }

      if (!existing && cart.length >= PUBLIC_ORDER_LIMITS.maxItems) {
        avisarCarrinho(
          `O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxItems} itens diferentes.`
        );
        return false;
      }

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          ...product,
          cartId,
          adicionais,
          quantity: 1
        });
      }

      saveCart();
      renderCart();
      return true;
    }

    function updateCartItem(
      id,
      action
    ) {
      const item =
        cart.find(
          product => (product.cartId || product.id) === id
        );

      if (!item) {
        return;
      }

      if (action === "increase") {
        if (totalItems() >= PUBLIC_ORDER_LIMITS.maxTotalQuantity) {
          avisarCarrinho(
            `O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxTotalQuantity} unidades.`
          );
          return;
        }
        if (Number(item.quantity || 0) >= PUBLIC_ORDER_LIMITS.maxQuantityPerItem) {
          avisarCarrinho(
            `Cada item pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxQuantityPerItem} unidades.`
          );
          return;
        }
        item.quantity += 1;
      }

      if (action === "decrease") {
        item.quantity -= 1;
      }

      if (
        action === "remove" ||
        item.quantity <= 0
      ) {
        cart = cart.filter(
          product => (product.cartId || product.id) !== id
        );
      }

      saveCart();
      renderCart();
    }


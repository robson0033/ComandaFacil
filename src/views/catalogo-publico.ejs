  <footer class="footer">
    Cardápio digital
  </footer>

  <script nonce="<%= cspNonce %>">
    const storeSlug =
      <%- safeJsonForHtml(configuracao.slug || "") %>;
    const lojaDisponivelInicial =
      <%- safeJsonForHtml(lojaDisponivel !== false) %>;

    const PUBLIC_ORDER_LIMITS = Object.freeze({
      maxItems: 50,
      maxTotalQuantity: 200,
      maxQuantityPerItem: 99,
      maxAdditionsPerItem: 20,
    });

    const horarioAbertura =
      <%- safeJsonForHtml(horarioAbertura) %>;

    const horarioFechamento =
      <%- safeJsonForHtml(horarioFechamento) %>;

    const diasFuncionamento =
      <%- safeJsonForHtml(diasFuncionamento) %>;

    const storageKey =
      `catalogo-cart-${storeSlug}`;

    const searchInput =

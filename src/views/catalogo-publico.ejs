  <footer class="footer">
    Cardápio digital
  </footer>

  <script>
    const storeSlug =
      <%- JSON.stringify(configuracao.slug || "") %>;

    const horarioAbertura =
      <%- JSON.stringify(horarioAbertura) %>;

    const horarioFechamento =
      <%- JSON.stringify(horarioFechamento) %>;

    const diasFuncionamento =
      <%- JSON.stringify(diasFuncionamento) %>;

    const storageKey =
      `catalogo-cart-${storeSlug}`;

    const searchInput =
      document.querySelector("#search");

    const categoryButtons =
      document.querySelectorAll(".cat-btn");

    const sections =
      document.querySelectorAll(".section");

    const cards =
      document.querySelectorAll(".product-card");

    const cartList =
      document.querySelector("#cartList");

    const cartEmpty =
      document.querySelector("#cartEmpty");

    const cartCount =
      document.querySelector("#cartCount");

    const cartItemsCount =
      document.querySelector("#cartItemsCount");

    const cartSubtotal =
      document.querySelector("#cartSubtotal");

    const checkoutBtn =
      document.querySelector("#checkoutBtn");

    const cartNote =
      document.querySelector("#cartNote");

    const mobileCartToggle =
      document.querySelector("#mobileCartToggle");

    const mobileCartCount =
      document.querySelector("#mobileCartCount");

    const sidebarCart =
      document.querySelector("#sidebarCart");

    const orderModal =
      document.querySelector("#orderModal");

    const closeOrderModal =
      document.querySelector("#closeOrderModal");

    const pixPaymentModal =
      document.querySelector("#pixPaymentModal");

    const closePixPaymentModal =
      document.querySelector("#closePixPaymentModal");

    const orderForm =
      document.querySelector("#orderForm");

    const canalPedido =
      document.querySelector("#canalPedido");

    const enderecoField =
      document.querySelector("#enderecoField");

    const enderecoEntrega =
      document.querySelector("#enderecoEntrega");

    const observacaoFinal =
      document.querySelector("#observacaoFinal");

    const sendOrderBtn =
      document.querySelector("#sendOrderBtn");

    const formMessage =
      document.querySelector("#formMessage");

    const storeStatus =
      document.querySelector("#storeStatus");

    const storeStatusText =
      document.querySelector("#storeStatusText");

    const addonModal = document.querySelector("#addonModal");
    const addonTitle = document.querySelector("#addonTitle");
    const addonList = document.querySelector("#addonList");
    let pendingProduct = null;

    let selectedCategory = "todos";
    let storeIsOpen = false;
    let cart = [];

    function currency(value) {
      return Number(
        value || 0
      ).toLocaleString(
        "pt-BR",
        {
          style: "currency",
          currency: "BRL"
        }
      );
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function filterProducts() {
      const query =
        String(searchInput.value || "")
          .toLowerCase()
          .trim();

      cards.forEach(card => {
        const corresponde =
          card.dataset.name.includes(query);

        card.classList.toggle(
          "hidden",
          !corresponde
        );
      });

      sections.forEach(section => {
        const categoria =
          section.dataset.section;

        const categoriaCorresponde =
          selectedCategory === "todos" ||
          selectedCategory === categoria;

        const possuiVisiveis =
          [...section.querySelectorAll(".product-card")]
            .some(card => {
              return !card.classList.contains("hidden");
            });

        section.classList.toggle(
          "hidden",
          !categoriaCorresponde ||
          !possuiVisiveis
        );
      });
    }

    categoryButtons.forEach(button => {
      button.addEventListener(
        "click",
        () => {
          categoryButtons.forEach(
            item => {
              item.classList.remove("active");
            }
          );

          button.classList.add("active");

          selectedCategory =
            button.dataset.cat;

          filterProducts();
        }
      );
    });

    searchInput.addEventListener(
      "input",
      filterProducts
    );

    function loadCart() {
      try {
        const saved =
          localStorage.getItem(
            storageKey
          );

        cart = saved
          ? JSON.parse(saved)
          : [];

        if (!Array.isArray(cart)) {
          cart = [];
        }
      } catch {
        cart = [];
      }
    }

    function saveCart() {
      localStorage.setItem(
        storageKey,
        JSON.stringify(cart)
      );
    }

    function totalItems() {
      return cart.reduce(
        (total, item) =>
          total +
          Number(item.quantity || 0),
        0
      );
    }

    function subtotal() {
      return cart.reduce(
        (total, item) => {
          return (
            total +
            (
              Number(item.price || 0) +
              (item.adicionais || []).reduce(
                (sum, adicional) => sum + Number(adicional.preco || 0),
                0
              )
            ) * Number(item.quantity || 0)
          );
        },
        0
      );
    }

    function renderCart() {
      cartList.innerHTML = "";

      cartEmpty.classList.toggle(
        "hidden",
        cart.length > 0
      );

      cart.forEach(item => {
        const element =
          document.createElement("div");

        element.className =
          "cart-item";

        element.innerHTML = `
          <div class="cart-thumb">
            ${
              item.image
                ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}">`
                : "🍔"
            }
          </div>

          <div>
            <h3 class="cart-name">
              ${escapeHtml(item.name)}
            </h3>

            <div class="cart-price">
              ${currency(
                Number(item.price || 0) +
                (item.adicionais || []).reduce(
                  (sum, adicional) => sum + Number(adicional.preco || 0), 0
                )
              )}
            </div>
            ${item.adicionais?.length ? `<div class="cart-addons">${item.adicionais.map(a => `+ ${escapeHtml(a.nome)} (${currency(a.preco)})`).join("<br>")}</div>` : ""}

            <div class="cart-actions">
              <div class="qty-box">
                <button
                  type="button"
                  class="qty-btn"
                  data-action="decrease"
                  data-id="${escapeHtml(item.cartId || item.id)}"
                >
                  −
                </button>

                <span class="qty-number">
                  ${Number(item.quantity)}
                </span>

                <button
                  type="button"
                  class="qty-btn"
                  data-action="increase"
                  data-id="${escapeHtml(item.cartId || item.id)}"
                >
                  +
                </button>
              </div>

              <button
                type="button"
                class="remove-btn"
                data-action="remove"
                data-id="${escapeHtml(item.cartId || item.id)}"
                aria-label="Remover"
              >
                ×
              </button>
            </div>
          </div>
        `;

        cartList.appendChild(element);
      });

      const quantidade =
        totalItems();

      cartCount.textContent =
        quantidade;

      cartItemsCount.textContent =
        quantidade;

      mobileCartCount.textContent =
        quantidade;

      cartSubtotal.textContent =
        currency(subtotal());

      atualizarBotoesPedido();
    }

    function addToCart(product, adicionais = []) {
      const addonsKey = adicionais
        .map(adicional => String(adicional._id))
        .sort()
        .join(",");
      const cartId = `${product.id}:${addonsKey}`;
      const existing = cart.find(item => item.cartId === cartId);

      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          ...product,
          cartId,
          adicionais,
          quantity: 1
        });
      }

      saveCart();
      renderCart();
    }

    function updateCartItem(
      id,
      action
    ) {
      const item =
        cart.find(
          product => (product.cartId || product.id) === id
        );

      if (!item) {
        return;
      }

      if (action === "increase") {
        item.quantity += 1;
      }

      if (action === "decrease") {
        item.quantity -= 1;
      }

      if (
        action === "remove" ||
        item.quantity <= 0
      ) {
        cart = cart.filter(
          product => (product.cartId || product.id) !== id
        );
      }

      saveCart();
      renderCart();
    }

    document
      .querySelectorAll("[data-add-cart]")
      .forEach(button => {
        button.addEventListener(
          "click",
          event => {
            if (!storeIsOpen) {
              alert(
                "O estabelecimento está fechado."
              );

              return;
            }

            const card =
              event.currentTarget.closest(
                ".product-card"
              );

            const product = {
              id: card.dataset.id,
              name: card.dataset.productName,
              price: Number(card.dataset.productPrice || 0),
              image: card.dataset.productImage || ""
            };

            let adicionais = [];
            try {
              adicionais = JSON.parse(card.dataset.productAdditionals || "[]");
            } catch {
              adicionais = [];
            }

            if (!adicionais.length) {
              addToCart(product, []);
              return;
            }

            pendingProduct = { product, adicionais };
            addonTitle.textContent = `Adicionais de ${product.name}`;
            addonList.innerHTML = adicionais.map(adicional => `
              <div class="addon-option">
                <label><input type="checkbox" value="${escapeHtml(adicional._id)}"> ${escapeHtml(adicional.nome)}</label>
                <strong>+ ${currency(adicional.preco)}</strong>
              </div>
            `).join("");
            addonModal.classList.add("open");
            document.body.classList.add("modal-open");
          }
        );
      });

    function closeAddonModal() {
      addonModal.classList.remove("open");
      document.body.classList.remove("modal-open");
      pendingProduct = null;
    }

    document.querySelector("#closeAddonModal").addEventListener("click", closeAddonModal);
    document.querySelector("#cancelAddon").addEventListener("click", closeAddonModal);
    addonModal.addEventListener("click", event => {
      if (event.target === addonModal) closeAddonModal();
    });
    document.querySelector("#confirmAddon").addEventListener("click", () => {
      if (!pendingProduct) return;
      const ids = [...addonList.querySelectorAll("input:checked")].map(input => input.value);
      const selected = pendingProduct.adicionais.filter(adicional => ids.includes(String(adicional._id)));
      addToCart(pendingProduct.product, selected);
      closeAddonModal();
    });

    cartList.addEventListener(
      "click",
      event => {
        const target =
          event.target.closest(
            "[data-action]"
          );

        if (!target) {
          return;
        }

        updateCartItem(
          target.dataset.id,
          target.dataset.action
        );
      }
    );

    function horarioEmMinutos(
      horario
    ) {
      const [hora, minuto] =
        String(horario)
          .split(":")
          .map(Number);

      return hora * 60 + minuto;
    }

    function obterHorarioBrasil() {
      const parts =
        new Intl.DateTimeFormat(
          "pt-BR",
          {
            timeZone:
              "America/Sao_Paulo",
            weekday: "short",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
          }
        ).formatToParts(
          new Date()
        );

      const diaTexto =
        String(
          parts.find(
            part =>
              part.type === "weekday"
          )?.value || ""
        )
          .replace(".", "")
          .toLowerCase();

      const dias = {
        dom: 0,
        seg: 1,
        ter: 2,
        qua: 3,
        qui: 4,
        sex: 5,
        sáb: 6,
        sab: 6
      };

      return {
        dia: dias[diaTexto],
        minutos:
          Number(
            parts.find(
              part =>
                part.type === "hour"
            )?.value || 0
          ) *
            60 +
          Number(
            parts.find(
              part =>
                part.type === "minute"
            )?.value || 0
          )
      };
    }

    function verificarLojaAberta() {
      const atual =
        obterHorarioBrasil();

      const abertura =
        horarioEmMinutos(
          horarioAbertura
        );

      const fechamento =
        horarioEmMinutos(
          horarioFechamento
        );

      const funcionaHoje =
        diasFuncionamento.includes(
          atual.dia
        );

      if (abertura === fechamento) {
        storeIsOpen =
          funcionaHoje;
      } else if (
        abertura < fechamento
      ) {
        storeIsOpen =
          funcionaHoje &&
          atual.minutos >= abertura &&
          atual.minutos < fechamento;
      } else {
        storeIsOpen =
          funcionaHoje &&
          (
            atual.minutos >= abertura ||
            atual.minutos < fechamento
          );
      }

      storeStatus.classList.remove(
        "open",
        "closed"
      );

      storeStatus.classList.add(
        storeIsOpen
          ? "open"
          : "closed"
      );

      storeStatusText.textContent =
        storeIsOpen
          ? "Aberto agora"
          : "Fechado agora";

      atualizarBotoesPedido();
    }

    function atualizarBotoesPedido() {
      document
        .querySelectorAll(
          "[data-add-cart]"
        )
        .forEach(button => {
          button.disabled =
            !storeIsOpen;

          const text =
            button.querySelector("span");

          if (text) {
            text.textContent =
              storeIsOpen
                ? "Pedir"
                : "Fechado";
          }
        });

      checkoutBtn.disabled =
        !storeIsOpen ||
        cart.length === 0;

      checkoutBtn.textContent =
        storeIsOpen
          ? "Continuar pedido"
          : "Estabelecimento fechado";
    }

    function openOrderModal() {
      if (
        !storeIsOpen ||
        !cart.length
      ) {
        return;
      }

      observacaoFinal.value =
        cartNote.value;

      formMessage.className =
        "form-message";

      formMessage.textContent = "";

      orderModal.classList.add(
        "open"
      );

      document.body.classList.add(
        "modal-open"
      );

      sidebarCart.classList.remove(
        "open"
      );
    }

    function closeModal() {
      orderModal.classList.remove("open");

      if (!pixPaymentModal.classList.contains("open")) {
        document.body.classList.remove("modal-open");
      }
    }

    function openPixPaymentModal() {
      orderModal.classList.remove("open");
      pixPaymentModal.classList.add("open");
      document.body.classList.add("modal-open");
    }

    function closePixModal() {
      pixPaymentModal.classList.remove("open");
      document.body.classList.remove("modal-open");
    }

    function atualizarEndereco() {
      const delivery =
        canalPedido.value ===
        "delivery";

      enderecoField.classList.toggle(
        "hidden",
        !delivery
      );

      enderecoEntrega.required =
        delivery;

      if (!delivery) {
        enderecoEntrega.value = "";
      }
    }

    checkoutBtn.addEventListener(
      "click",
      openOrderModal
    );

    closeOrderModal.addEventListener(
      "click",
      closeModal
    );

    closePixPaymentModal.addEventListener("click", closePixModal);
    pixPaymentModal.addEventListener("click", event => {
      if (event.target === pixPaymentModal) closePixModal();
    });

    orderModal.addEventListener(
      "click",
      event => {
        if (
          event.target ===
          orderModal
        ) {
          closeModal();
        }
      }
    );

    canalPedido.addEventListener(
      "change",
      atualizarEndereco
    );

    mobileCartToggle.addEventListener(
      "click",
      () => {
        sidebarCart.classList.add(
          "open"
        );
      }
    );

    sidebarCart.addEventListener(
      "click",
      event => {
        if (
          event.target ===
          sidebarCart
        ) {
          sidebarCart.classList.remove(
            "open"
          );
        }
      }
    );

    const formaPagamentoSelect = document.querySelector("#formaPagamento");
    const emailPixField = document.querySelector("#emailPixField");
    const emailPixInput = document.querySelector("#emailPix");

    function atualizarCampoEmailPix() {
      const pixSelecionado = formaPagamentoSelect.value === "pix";
      emailPixField.classList.toggle("hidden", !pixSelecionado);
      emailPixInput.required = pixSelecionado;
      if (!pixSelecionado) emailPixInput.value = "";
    }

    formaPagamentoSelect.addEventListener("change", atualizarCampoEmailPix);
    atualizarCampoEmailPix();

    const trocoModal = document.querySelector("#trocoModal");
    const closeTrocoModalBtn = document.querySelector("#closeTrocoModal");
    const semTrocoBtn = document.querySelector("#semTrocoBtn");
    const comTrocoBtn = document.querySelector("#comTrocoBtn");
    const trocoPergunta = document.querySelector("#trocoPergunta");
    const trocoValorArea = document.querySelector("#trocoValorArea");
    const trocoParaModal = document.querySelector("#trocoParaModal");
    const trocoMessage = document.querySelector("#trocoMessage");
    const confirmarTrocoBtn = document.querySelector("#confirmarTrocoBtn");
    const voltarTrocoBtn = document.querySelector("#voltarTrocoBtn");

    let pedidoPendente = null;

    function abrirModalTroco(payload) {
      pedidoPendente = payload;
      trocoPergunta.classList.remove("hidden");
      trocoValorArea.classList.add("hidden");
      trocoParaModal.value = "";
      trocoMessage.className = "form-message";
      trocoMessage.textContent = "";
      trocoModal.classList.add("open");
    }

    function fecharModalTroco() {
      trocoModal.classList.remove("open");
      pedidoPendente = null;
      trocoParaModal.value = "";
      trocoMessage.textContent = "";
    }

    closeTrocoModalBtn.addEventListener("click", fecharModalTroco);

    trocoModal.addEventListener("click", event => {
      if (event.target === trocoModal) fecharModalTroco();
    });

    comTrocoBtn.addEventListener("click", () => {
      trocoPergunta.classList.add("hidden");
      trocoValorArea.classList.remove("hidden");
      setTimeout(() => trocoParaModal.focus(), 50);
    });

    voltarTrocoBtn.addEventListener("click", () => {
      trocoValorArea.classList.add("hidden");
      trocoPergunta.classList.remove("hidden");
      trocoParaModal.value = "";
      trocoMessage.textContent = "";
    });

    async function enviarPedido(payload) {
      formMessage.className = "form-message";
      formMessage.textContent = "";
      sendOrderBtn.disabled = true;
      sendOrderBtn.textContent = "Enviando pedido...";
      confirmarTrocoBtn.disabled = true;

      try {
        const response = await fetch(
          `/catalogo/${encodeURIComponent(storeSlug)}/pedidos`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Não foi possível enviar o pedido.");
        }

        fecharModalTroco();
        formMessage.className = "form-message success";
        formMessage.textContent =
          `Pedido #${result.numeroPedido} enviado. Acompanhe pelo WhatsApp informado.`;

        if (payload.formaPagamento === "pix") {
          const pixResponse = await fetch(
            `/catalogo/${encodeURIComponent(storeSlug)}/pedidos/${encodeURIComponent(result.pedidoId)}/pix`,
            { method: "POST", headers: { "Content-Type": "application/json" } }
          );
          const pixResult = await pixResponse.json();
          if (!pixResponse.ok) {
            throw new Error(pixResult.message || "Não foi possível gerar o Pix.");
          }

          const qr = document.querySelector("#pixQrImage");
          const code = document.querySelector("#pixCopyCode");
          qr.src = `data:image/png;base64,${pixResult.qrCodeBase64}`;
          code.value = pixResult.copiaCola || "";
          document.querySelector("#pixPaymentStatus").textContent = "Aguardando pagamento...";
          document.querySelector("#copyPixButton").textContent = "Copiar código Pix";
          openPixPaymentModal();

          document.querySelector("#copyPixButton").onclick = async () => {
            await navigator.clipboard.writeText(code.value);
            document.querySelector("#copyPixButton").textContent = "Código copiado";
          };

          const interval = setInterval(async () => {
            const statusResponse = await fetch(
              `/catalogo/${encodeURIComponent(storeSlug)}/pedidos/${encodeURIComponent(result.pedidoId)}/pagamento-status`
            );
            const statusResult = await statusResponse.json();
            if (statusResult.pagamentoStatus === "pago") {
              clearInterval(interval);
              document.querySelector("#pixPaymentStatus").textContent =
                "✅ Pagamento aprovado. Pedido confirmado!";
            }
          }, 5000);
        }

        cart = [];
        saveCart();
        renderCart();
        orderForm.reset();
        atualizarEndereco();

        if (payload.formaPagamento !== "pix") {
          setTimeout(() => closeModal(), 2500);
        }
      } catch (error) {
        formMessage.className = "form-message error";
        formMessage.textContent = error.message;

        if (trocoModal.classList.contains("open")) {
          trocoMessage.className = "form-message error";
          trocoMessage.textContent = error.message;
        }
      } finally {
        sendOrderBtn.disabled = false;
        sendOrderBtn.textContent = "Enviar pedido";
        confirmarTrocoBtn.disabled = false;
        confirmarTrocoBtn.textContent = "Confirmar e enviar pedido";
      }
    }

    semTrocoBtn.addEventListener("click", async () => {
      if (!pedidoPendente) return;
      const payload = {
        ...pedidoPendente,
        precisaTroco: false,
        trocoPara: null
      };
      await enviarPedido(payload);
    });

    confirmarTrocoBtn.addEventListener("click", async () => {
      if (!pedidoPendente) return;

      const valorDigitado = String(trocoParaModal.value || "")
        .trim()
        .replace(/\s/g, "")
        .replace("R$", "")
        .replace(/\./g, "")
        .replace(",", ".");
      const trocoPara = Number(valorDigitado);

      if (!Number.isFinite(trocoPara) || trocoPara <= 0) {
        trocoMessage.className = "form-message error";
        trocoMessage.textContent = "Informe um valor válido. Exemplo: 50,00.";
        trocoParaModal.focus();
        return;
      }

      const payload = {
        ...pedidoPendente,
        precisaTroco: true,
        trocoPara
      };

      confirmarTrocoBtn.disabled = true;
      confirmarTrocoBtn.textContent = "Enviando pedido...";
      await enviarPedido(payload);
    });

    orderForm.addEventListener("submit", async event => {
      event.preventDefault();

      if (!storeIsOpen || !cart.length) return;

      const formData = new FormData(orderForm);
      const payload = {
        cliente: String(formData.get("cliente") || "").trim(),
        telefone: String(formData.get("telefone") || "").trim(),
        canal: String(formData.get("canal") || ""),
        enderecoEntrega: String(formData.get("enderecoEntrega") || "").trim(),
        observacao: String(formData.get("observacao") || "").trim(),
        formaPagamento: String(formData.get("formaPagamento") || "nao_informado"),
        emailCliente: String(formData.get("emailPix") || "").trim().toLowerCase(),
        precisaTroco: false,
        trocoPara: null,
        itens: cart.map(item => ({
          produtoId: item.id,
          quantidade: Number(item.quantity),
          adicionais: (item.adicionais || []).map(adicional => ({
            _id: adicional._id
          })),
          observacao: String(item.observacao || "")
        }))
      };

      if (payload.formaPagamento === "pix") {
        const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.emailCliente);
        if (!emailValido) {
          formMessage.className = "form-message error";
          formMessage.textContent = "Informe um e-mail válido para gerar o pagamento Pix.";
          emailPixInput.focus();
          return;
        }
      }

      if (payload.formaPagamento === "dinheiro") {
        abrirModalTroco(payload);
        return;
      }

      await enviarPedido(payload);
    });

    loadCart();
    renderCart();
    filterProducts();
    atualizarEndereco();
    verificarLojaAberta();

    setInterval(
      verificarLojaAberta,
      60000
    );
  </script>


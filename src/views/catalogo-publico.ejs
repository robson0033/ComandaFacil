    function horarioEmMinutos(
      horario
    ) {
      const [hora, minuto] =
        String(horario)
          .split(":")
          .map(Number);

      return hora * 60 + minuto;
    }

    function obterHorarioBrasil() {
      const parts =
        new Intl.DateTimeFormat(
          "pt-BR",
          {
            timeZone:
              "America/Sao_Paulo",
            weekday: "short",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
          }
        ).formatToParts(
          new Date()
        );

      const diaTexto =
        String(
          parts.find(
            part =>
              part.type === "weekday"
          )?.value || ""
        )
          .replace(".", "")
          .toLowerCase();

      const dias = {
        dom: 0,
        seg: 1,
        ter: 2,
        qua: 3,
        qui: 4,
        sex: 5,
        sáb: 6,
        sab: 6
      };

      return {
        dia: dias[diaTexto],
        minutos:
          Number(
            parts.find(
              part =>
                part.type === "hour"
            )?.value || 0
          ) *
            60 +
          Number(
            parts.find(
              part =>
                part.type === "minute"
            )?.value || 0
          )
      };
    }

    function verificarLojaAberta() {
      const atual =
        obterHorarioBrasil();

      const abertura =
        horarioEmMinutos(
          horarioAbertura
        );

      const fechamento =
        horarioEmMinutos(
          horarioFechamento
        );

      const funcionaHoje =
        diasFuncionamento.includes(
          atual.dia
        );

      if (abertura === fechamento) {
        storeIsOpen =
          funcionaHoje;
      } else if (
        abertura < fechamento
      ) {
        storeIsOpen =
          funcionaHoje &&
          atual.minutos >= abertura &&
          atual.minutos < fechamento;
      } else {
        storeIsOpen =
          funcionaHoje &&
          (
            atual.minutos >= abertura ||
            atual.minutos < fechamento
          );
      }

      storeStatus.classList.remove(
        "open",
        "closed"
      );

      storeStatus.classList.add(
        storeIsOpen
          ? "open"
          : "closed"
      );

      storeStatusText.textContent =
        storeIsOpen
          ? "Aberto agora"
          : "Fechado agora";

      atualizarBotoesPedido();
    }


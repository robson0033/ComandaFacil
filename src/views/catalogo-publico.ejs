    }

    function iniciarContagemPix(expiraEm) {
      clearPixExpirationTimer();
      const expirationTime = new Date(String(expiraEm || "")).getTime();
      const countdown = document.querySelector("#pixCountdown");
      if (!Number.isFinite(expirationTime)) {
        if (countdown) countdown.textContent = "10:00";
        return;
      }
      if (pixPollingContext) pixPollingContext.expiraEm = new Date(expirationTime).toISOString();
      const atualizar = () => {
        const restanteMs = expirationTime - Date.now();
        if (restanteMs <= 0) {
          mostrarPixExpiracaoPendente();
          if (pixPollingContext && !pixPollingInFlight) void pollPixStatus();
          return;
        }
        const segundos = Math.ceil(restanteMs / 1000);
        const minutos = Math.floor(segundos / 60);
        const resto = segundos % 60;
        if (countdown) countdown.textContent = `${String(minutos).padStart(2, "0")}:${String(resto).padStart(2, "0")}`;
      };
      atualizar();
      if (expirationTime > Date.now()) pixExpirationTimer = setInterval(atualizar, 1000);
    }


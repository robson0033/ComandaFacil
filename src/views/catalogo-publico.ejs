<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <title><%= configuracao.nomeEstabelecimento %> | Cardápio</title>
  <link rel="icon" href="/assets/imgs/comanda.png" type="image/x-png">

  <style nonce="<%= cspNonce %>">
    :root {
      --bg: #f7f4f1;
      --card: #ffffff;
      --text: #23140f;
      --muted: #756762;
      --line: #eadfd7;
      --dark: #25110d;
      --dark-2: #431712;
      --orange: #f27613;
      --orange-2: #ff8a1d;
      --green: #1f9254;
      --red: #dc3030;
      --shadow: 0 14px 35px rgba(43, 19, 8, 0.12);
      --shadow-strong: 0 22px 50px rgba(43, 19, 8, 0.18);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, Arial, sans-serif;
    }

    body.modal-open {
      overflow: hidden;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .botao-whatsapp {
      position: fixed;
      left: 18px;
      bottom: 18px;
      z-index: 95;
      width: 58px;
      height: 58px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, #25d366, #128c4a);
      color: #fff;
      text-decoration: none;
      box-shadow:
        0 16px 34px rgba(18, 140, 74, 0.34),
        0 0 0 0 rgba(37, 211, 102, 0.35);
      transition:
        transform 0.2s ease,
        filter 0.2s ease,
        box-shadow 0.2s ease;
      animation: whatsappPulse 2.2s infinite;
    }

    .botao-whatsapp:hover {
      transform: translateY(-3px) scale(1.04);
      filter: brightness(0.96);
      box-shadow:
        0 20px 40px rgba(18, 140, 74, 0.42),
        0 0 0 8px rgba(37, 211, 102, 0.12);
    }

    .botao-whatsapp:focus-visible {
      outline: 3px solid rgba(37, 211, 102, 0.35);
      outline-offset: 4px;
    }

    .botao-whatsapp svg {
      width: 31px;
      height: 31px;
      fill: currentColor;
    }

    .botao-whatsapp-texto {
      position: absolute;
      left: 68px;
      min-width: max-content;
      padding: 8px 11px;
      border-radius: 9px;
      background: #163d29;
      color: #fff;
      font-size: 12px;
      font-weight: 850;
      line-height: 1;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-7px);
      transition: 0.2s ease;
      box-shadow: 0 8px 20px rgba(16, 58, 36, 0.22);
    }

    .botao-whatsapp:hover .botao-whatsapp-texto,
    .botao-whatsapp:focus-visible .botao-whatsapp-texto {
      opacity: 1;
      transform: translateX(0);
    }

    @keyframes whatsappPulse {
      0%,
      100% {
        box-shadow:
          0 16px 34px rgba(18, 140, 74, 0.34),
          0 0 0 0 rgba(37, 211, 102, 0.28);
      }

      50% {
        box-shadow:
          0 16px 34px rgba(18, 140, 74, 0.34),
          0 0 0 10px rgba(37, 211, 102, 0);
      }
    }

    @media (max-width: 600px) {
      .botao-whatsapp {
        left: 13px;
        bottom: 13px;
        width: 54px;
        height: 54px;
      }

      .botao-whatsapp-texto {
        display: none;
      }
    }

    img {
      display: block;
      max-width: 100%;
    }

    .hidden {
      display: none !important;
    }

    .hero {
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(90deg, rgba(22, 7, 5, 0.9), rgba(84, 10, 12, 0.76), rgba(233, 107, 19, 0.62)),
        url("/assets/imgs/template1.png") center / cover no-repeat;
    }

    .hero-inner {
      max-width: 1360px;
      margin: auto;
      padding: 34px 22px 105px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 420px;
      gap: 30px;
      align-items: center;
    }

    .hero-main {
      display: flex;
      align-items: center;
      gap: 22px;
      min-width: 0;
    }

    .hero-avatar {
      width: 116px;
      height: 116px;
      flex: 0 0 116px;
      overflow: hidden;
      border: 4px solid rgba(255, 255, 255, 0.92);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.1);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
    }

    .hero-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-avatar-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 54px;
    }

    .hero-copy {
      min-width: 0;
    }

    .hero-title {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 1;
      letter-spacing: -1.8px;
    }

    .hero-subtitle {
      margin-top: 12px;
      color: #ffc56d;
      font-size: 15px;
      font-weight: 800;
    }

    .hero-description {
      max-width: 700px;
      margin: 14px 0 0;
      color: #f5ddd0;
      font-size: 16px;
      line-height: 1.65;
    }

    .store-status {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 46px;
      margin-top: 15px;
      padding: 8px 14px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(8px);
    }

    .status-dot {
      width: 11px;
      height: 11px;
      flex: 0 0 11px;
      border-radius: 50%;
      background: #9ca3af;
      box-shadow: 0 0 0 5px rgba(156, 163, 175, 0.16);
    }

    .store-status.open .status-dot {
      background: #23c875;
      box-shadow: 0 0 0 5px rgba(35, 200, 117, 0.2);
    }

    .store-status.closed .status-dot {
      background: #ff5252;
      box-shadow: 0 0 0 5px rgba(255, 82, 82, 0.2);
    }

    .store-status strong,
    .store-status small {
      display: block;
    }

    .store-status small {
      margin-top: 3px;
      color: #efd9ce;
      font-size: 12px;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-top: 16px;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 15px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 14px;
      font-weight: 750;
      text-decoration: none;
      backdrop-filter: blur(8px);
    }

    .hero-side {
      position: relative;
      min-height: 275px;
    }

    .hero-food {
      width: 100%;
      height: 275px;
      overflow: hidden;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.08);
    }

    .hero-food img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-food-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 96px;
    }

    .made-badge {
      position: absolute;
      left: -30px;
      bottom: 18px;
      z-index: 2;
      max-width: 215px;
      padding: 16px 18px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(116, 24, 9, 0.94), rgba(245, 117, 17, 0.82));
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(10px);
    }

    .made-badge strong {
      color: #ffd36e;
      font-size: 14px;
      text-transform: uppercase;
    }

    .made-badge p {
      margin: 7px 0 0;
      color: #fff1e6;
      font-size: 13px;
      line-height: 1.45;
    }

    .toolbar-wrap {
      position: sticky;
      top: 0;
      z-index: 40;
      margin-top: -48px;
      padding: 0 18px;
    }

    .toolbar {
      max-width: 1360px;
      margin: auto;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 18px 45px rgba(43, 19, 8, 0.12);
      backdrop-filter: blur(12px);
    }

    .search {
      width: 100%;
      min-height: 54px;
      padding: 0 18px;
      border: 1px solid #ddd4ce;
      border-radius: 17px;
      background: #fff;
      color: var(--text);
      font-size: 16px;
      outline: none;
    }

    .search:focus {
      border-color: var(--orange);
      box-shadow: 0 0 0 4px rgba(242, 118, 19, 0.1);
    }

    .content-shell {
      max-width: 1360px;
      margin: 22px auto 60px;
      padding: 0 18px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 350px;
      gap: 28px;
      align-items: start;
    }

    /* Categorias em uma unica linha com rolagem horizontal */
    .categories {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 10px;
      width: 100%;
      max-width: 100%;
      margin-bottom: 28px;
      padding: 2px 2px 8px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-inline: contain;
      touch-action: pan-x;
    }

    .categories::-webkit-scrollbar {
      display: none;
    }

    .cat-btn {
      flex: 0 0 auto;
      min-height: 48px;
      padding: 0 18px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: #3c241c;
      font-size: 15px;
      font-weight: 850;
      white-space: nowrap;
      scroll-snap-align: start;
      transition: 0.2s;
    }

    .cat-btn.active {
      border-color: transparent;
      background: linear-gradient(135deg, #2a110d, #4c2017);
      color: #fff;
      box-shadow: 0 14px 28px rgba(43, 19, 8, 0.2);
    }

    .section {
      margin-top: 24px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }

    .section-head h2 {
      margin: 0;
      font-size: 28px;
    }

    .section-count {
      color: #8a776f;
      font-size: 14px;
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 22px;
    }

    .product-card {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--card);
      box-shadow: var(--shadow);
      transition: 0.22s;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-strong);
    }

    .product-cover {
      height: 210px;
      overflow: hidden;
      background: linear-gradient(135deg, #f7ead6, #efd2c1);
    }

    .product-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-cover-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 62px;
    }

    .product-body {
      padding: 17px;
    }

    .product-category {
      color: #b83a1e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .product-name {
      margin: 7px 0 8px;
      font-size: 19px;
    }

    .product-desc {
      min-height: 60px;
      margin: 0;
      color: #6e615d;
      font-size: 14px;
      line-height: 1.55;
    }

    .product-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 16px;
    }

    .product-price {
      color: var(--green);
      font-size: 19px;
      font-weight: 900;
    }

    .add-btn {
      min-height: 44px;
      padding: 0 16px;
      border: 0;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 14px;
      font-weight: 900;
      box-shadow: 0 12px 24px rgba(242, 118, 19, 0.25);
    }

    .add-btn:disabled {
      opacity: 0.58;
      cursor: not-allowed;
    }

    .sidebar {
      position: sticky;
      top: 100px;
    }

    .cart-card {
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      background: linear-gradient(180deg, #381510, #421611);
      color: #fff;
      box-shadow: 0 18px 42px rgba(43, 19, 8, 0.22);
    }

    .cart-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 22px 20px 16px;
    }

    .cart-head h2 {
      margin: 0;
      font-size: 20px;
    }

    .cart-badge {
      min-width: 28px;
      height: 28px;
      padding: 0 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--orange);
      font-size: 13px;
      font-weight: 900;
    }

    .cart-empty {
      margin: 0 16px 16px;
      padding: 22px 14px;
      border: 1px dashed rgba(255, 255, 255, 0.17);
      border-radius: 18px;
      color: #d9c0b5;
      text-align: center;
      line-height: 1.55;
    }

    .cart-list {
      max-height: 340px;
      overflow: auto;
      padding: 0 16px;
      display: grid;
      gap: 11px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 11px;
      padding: 11px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.04);
    }

    .cart-thumb {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border-radius: 13px;
      background: rgba(255, 255, 255, 0.08);
      font-size: 26px;
    }

    .cart-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-name {
      margin: 0 0 5px;
      font-size: 14px;
    }

    .cart-price {
      color: #fbe6dc;
      font-size: 13px;
      font-weight: 800;
    }

    .cart-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 7px;
    }

    .qty-box {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 3px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.18);
    }

    .qty-btn,
    .remove-btn {
      border: 0;
      color: #fff;
    }

    .qty-btn {
      width: 29px;
      height: 29px;
      border-radius: 50%;
      background: transparent;
      font-size: 18px;
    }

    .qty-number {
      min-width: 18px;
      text-align: center;
      font-size: 13px;
      font-weight: 900;
    }

    .remove-btn {
      width: 31px;
      height: 31px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .cart-note-wrap {
      padding: 15px 16px 0;
    }

    .cart-note-wrap label {
      display: block;
      margin-bottom: 7px;
      color: #f1d2c3;
      font-size: 13px;
      font-weight: 800;
    }

    .cart-note {
      width: 100%;
      min-height: 76px;
      resize: vertical;
      padding: 12px 13px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 15px;
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      outline: none;
    }

    .cart-footer {
      padding: 16px;
    }

    .cart-subtotal {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 14px;
      font-weight: 850;
    }

    .checkout-btn {
      width: 100%;
      min-height: 52px;
      border: 0;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 16px;
      font-weight: 900;
      box-shadow: 0 16px 30px rgba(242, 118, 19, 0.25);
    }

    .checkout-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .mobile-cart-toggle {
      position: fixed;
      right: 13px;
      bottom: 73px;
      z-index: 70;
      min-height: 54px;
      padding: 0 18px;
      display: none;
      align-items: center;
      gap: 9px;
      border: 0;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-weight: 900;
      box-shadow: 0 18px 35px rgba(242, 118, 19, 0.32);
    }

    .mobile-cart-count {
      min-width: 24px;
      height: 24px;
      padding: 0 7px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.18);
      font-size: 12px;
    }

    .empty-state {
      padding: 60px 24px;
      border: 1px dashed #d7c7bd;
      border-radius: 24px;
      background: #fff;
      color: #7d706a;
      text-align: center;
    }

    .footer {
      padding: 26px 18px;
      background: #21120d;
      color: #ddcbc4;
      text-align: center;
      font-size: 14px;
    }

    .order-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      place-items: center;
      padding: 18px;
      background: rgba(22, 9, 6, 0.68);
      backdrop-filter: blur(7px);
    }

    .order-modal.open {
      display: grid;
    }

    .order-modal-card {
      width: min(650px, 100%);
      max-height: 92vh;
      overflow: auto;
      border-radius: 25px;
      background: #fff;
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.3);
    }

    .modal-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 22px 22px 15px;
      border-bottom: 1px solid var(--line);
    }

    .modal-head h2 {
      margin: 0;
      font-size: 23px;
    }

    .modal-head p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .modal-close {
      width: 42px;
      height: 42px;
      border: 0;
      border-radius: 50%;
      background: #f4efec;
      color: var(--text);
      font-size: 24px;
    }

    .order-form {
      padding: 20px 22px 24px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .form-field {
      display: grid;
      gap: 7px;
    }

    .form-field.full {
      grid-column: 1 / -1;
    }

    .form-field label {
      font-size: 13px;
      font-weight: 850;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
      width: 100%;
      min-height: 48px;
      padding: 10px 13px;
      border: 1px solid #ddd4ce;
      border-radius: 13px;
      outline: none;
    }

    .form-field textarea {
      min-height: 90px;
      resize: vertical;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      border-color: var(--orange);
      box-shadow: 0 0 0 4px rgba(242, 118, 19, 0.1);
    }

    .combined-payment-panel {
      grid-column: 1 / -1;
      padding: 15px;
      border: 1px solid #eadfd8;
      border-radius: 15px;
      background: #fff8f3;
      box-shadow: inset 0 0 0 1px rgba(242, 118, 19, 0.03);
    }

    .combined-payment-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .combined-payment-note {
      grid-column: 1 / -1;
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    .calculated-payment-value {
      background: #f4efec;
      color: #2b201b;
      font-weight: 850;
    }

    .send-order-btn {
      grid-column: 1 / -1;
      min-height: 52px;
      border: 0;
      border-radius: 15px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 16px;
      font-weight: 900;
    }

    .send-order-btn:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .form-message {
      grid-column: 1 / -1;
      display: none;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 750;
    }

    .form-message.error {
      display: block;
      background: #ffe1e1;
      color: #9d1c1c;
    }

    .form-message.success {
      display: block;
      background: #dff7e9;
      color: #176e42;
    }

    .delivery-rule-notice {
      grid-column: 1 / -1;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 800;
      line-height: 1.45;
      background: #fff4d6;
      color: #7a4d00;
      border: 1px solid #f3d38a;
    }

    .delivery-rule-notice.error {
      background: #ffe1e1;
      color: #9d1c1c;
      border-color: #f0b7b7;
    }

    .delivery-rule-notice.success {
      background: #dff7e9;
      color: #176e42;
      border-color: #bce7cf;
    }

    .delivery-rule-notice.hidden {
      display: none;
    }

    .checkout-summary {
      grid-column: 1 / -1;
      display: grid;
      gap: 9px;
      padding: 15px 16px;
      border: 1px solid #eadfd8;
      border-radius: 15px;
      background: #fff8f3;
    }

    .checkout-summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: #6f5a50;
      font-size: 14px;
      font-weight: 750;
    }

    .checkout-summary-row.total {
      padding-top: 10px;
      border-top: 1px solid #eadfd8;
      color: var(--text);
      font-size: 17px;
      font-weight: 900;
    }

    .addon-modal {
      position: fixed; inset: 0; z-index: 130; display: none;
      place-items: center; padding: 18px; background: rgba(22,9,6,.68);
      backdrop-filter: blur(7px);
    }
    .addon-modal.open { display: grid; }
    .addon-card { width: min(560px,100%); max-height: 90vh; overflow:auto; padding:22px; border-radius:24px; background:#fff; box-shadow:0 28px 80px rgba(0,0,0,.3); }
    .addon-head { display:flex; justify-content:space-between; gap:14px; align-items:flex-start; margin-bottom:16px; }
    .addon-head h2 { margin:0; font-size:22px; }
    .addon-head p { margin:5px 0 0; color:var(--muted); font-size:13px; }
    .addon-list { display:grid; gap:10px; }
    .addon-option { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:13px; border:1px solid var(--line); border-radius:14px; background:#fffaf6; }
    .addon-option label { display:flex; align-items:center; gap:9px; font-weight:800; }
    .addon-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:17px; }
    .addon-actions button { min-height:48px; border-radius:13px; font-weight:900; }
    .addon-cancel { border:1px solid var(--line); background:#fff; }
    .addon-confirm { border:0; color:#fff; background:linear-gradient(135deg,var(--orange),var(--orange-2)); }
    .cart-addons { margin-top:5px; color:#f3cdbc; font-size:11px; line-height:1.45; }
    .pizza-half-badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      margin-top: 8px;
      padding: 5px 9px;
      border-radius: 999px;
      background: #fff1e4;
      color: #9a460c;
      font-size: 11px;
      font-weight: 900;
    }
    .pizza-modal {
      position: fixed;
      inset: 0;
      z-index: 135;
      display: none;
      place-items: center;
      padding: 18px;
      background: rgba(22, 9, 6, .68);
      backdrop-filter: blur(7px);
    }
    .pizza-modal.open { display: grid; }
    .pizza-card {
      width: min(620px, 100%);
      max-height: 92vh;
      overflow: auto;
      padding: 22px;
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 28px 80px rgba(0,0,0,.3);
    }
    .pizza-mode-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 16px 0;
    }
    .pizza-mode-option {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 50px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fffaf6;
      font-weight: 900;
      cursor: pointer;
    }
    .pizza-select-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .pizza-price-preview {
      margin-top: 16px;
      padding: 15px;
      border: 1px solid #f1d6c2;
      border-radius: 14px;
      background: #fff5ec;
    }
    .pizza-price-preview strong {
      display: block;
      margin-top: 5px;
      color: #7e2c12;
      font-size: 24px;
    }
    .pizza-rule-note {
      margin-top: 8px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }
    .cart-pizza-flavors {
      margin-top: 5px;
      color: #ffd7c4;
      font-size: 11px;
      line-height: 1.45;
      white-space: pre-line;
    }
    @media (max-width: 1180px) {
      .content-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }

      .hero-inner {
        grid-template-columns: 1fr;
      }

      .hero-side {
        display: none;
      }

    @media (max-width: 760px) {
      .hero-inner {
        padding: 24px 16px 88px;
      }

      .hero-main {
        align-items: flex-start;
      }

      .hero-avatar {
        width: 82px;
        height: 82px;
        flex-basis: 82px;
        border-radius: 24px;
      }

      .hero-title {
        font-size: 30px;
      }

      .toolbar-wrap {
        margin-top: -36px;
        padding: 0 12px;
      }

      .content-shell {
        padding: 0 12px;
      }

      .categories {
        gap: 8px;
        margin-bottom: 22px;
        padding-bottom: 6px;
      }

      .cat-btn {
        min-height: 44px;
        padding: 0 16px;
        font-size: 14px;
      }

      .mobile-cart-toggle {
        display: inline-flex;
        margin-left: 17.8em;
        margin-bottom: 4.5em;
      }

      .sidebar {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: none;
        align-items: flex-end;
        padding: 16px;
        background: rgba(18, 9, 6, 0.64);
        backdrop-filter: blur(5px);
      }

      .sidebar.open {
        display: flex;
      }

      .sidebar-panel {
        width: 100%;
        max-height: 92vh;
        overflow: auto;
      }

      .order-form {
        grid-template-columns: 1fr;
      }

      .pizza-mode-options,
      .pizza-select-grid {
        grid-template-columns: 1fr;
      }

      .combined-payment-grid {
        grid-template-columns: 1fr;
      }

      .form-field.full,
      .send-order-btn,
      .form-message {
        grid-column: auto;
      }
    }
  

    /* COMANDAFACIL: CARDS MOBILE VERTICAIS 2 COLUNAS v2 - INICIO */
    /*
     * Ajuste somente visual para celular.
     * Mantém os cards VERTICAIS, com imagem em cima, e 2 por linha.
     * Não altera carrinho, pedidos, pagamentos, pizza meio a meio ou backend.
     */
    @media (max-width: 760px) {
      .section {
        margin-top: 14px !important;
      }
    
      .section-head {
        align-items: center !important;
        gap: 8px !important;
        margin-bottom: 9px !important;
      }
    
      .section-head h2 {
        font-size: 18px !important;
        line-height: 1.15 !important;
      }
    
      .section-count {
        flex: 0 0 auto !important;
        font-size: 10px !important;
      }
    
      .grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 8px !important;
        align-items: stretch !important;
      }
    
      .grid > .product-card {
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        overflow: hidden !important;
        border-radius: 13px !important;
        box-shadow: 0 5px 14px rgba(65, 29, 14, 0.08) !important;
        transform: none !important;
      }
    
      .grid > .product-card:hover {
        transform: none !important;
      }
    
      .grid > .product-card .product-cover {
        width: 100% !important;
        height: 104px !important;
        min-height: 104px !important;
        max-height: 104px !important;
        overflow: hidden !important;
      }
    
      .grid > .product-card .product-cover img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }
    
      .grid > .product-card .product-cover-placeholder {
        width: 100% !important;
        height: 104px !important;
        min-height: 104px !important;
        display: grid !important;
        place-items: center !important;
        font-size: 31px !important;
      }
    
      .grid > .product-card .product-body {
        display: flex !important;
        flex: 1 1 auto !important;
        flex-direction: column !important;
        min-width: 0 !important;
        padding: 7px 8px 8px !important;
      }
    
      .grid > .product-card .product-category {
        overflow: hidden !important;
        font-size: 7.5px !important;
        line-height: 1.1 !important;
        letter-spacing: .45px !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
      }
    
      .grid > .product-card .pizza-half-badge {
        max-width: 100% !important;
        margin-top: 3px !important;
        padding: 3px 5px !important;
        overflow: hidden !important;
        font-size: 7px !important;
        line-height: 1.1 !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
      }
    
      /* COMANDAFACIL: CATALOGO TEXTO COMPLETO v1 - nome */
      .grid > .product-card .product-name {
        margin: 3px 0 0 !important;
        overflow: visible !important;
        font-size: 12px !important;
        line-height: 1.15 !important;
        text-overflow: clip !important;
        white-space: normal !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }
    
      .grid > .product-card .product-name + div {
        margin-top: 2px !important;
        overflow: hidden !important;
        font-size: 7.5px !important;
        line-height: 1.15 !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
      }
    
      /* COMANDAFACIL: CATALOGO TEXTO COMPLETO v1 - ingredientes/descrição */
      .grid > .product-card .product-desc {
        min-height: 0 !important;
        max-height: none !important;
        margin: 3px 0 0 !important;
        display: block !important;
        overflow: visible !important;
        -webkit-box-orient: initial !important;
        -webkit-line-clamp: unset !important;
        font-size: 8px !important;
        line-height: 1.4 !important;
        white-space: normal !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }
    
      .grid > .product-card .product-foot {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 4px !important;
        margin-top: auto !important;
        padding-top: 6px !important;
      }
    
      .grid > .product-card .product-price {
        flex: 0 1 auto !important;
        min-width: 0 !important;
        font-size: 12px !important;
        line-height: 1 !important;
        white-space: nowrap !important;
      }
    
      .grid > .product-card .product-foot > div:last-child {
        min-width: 0 !important;
      }
    
      .grid > .product-card .add-btn {
        min-height: 28px !important;
        padding: 0 6px !important;
        border-radius: 8px !important;
        font-size: 7.5px !important;
        line-height: 1 !important;
        box-shadow: none !important;
        white-space: nowrap !important;
      }
    }
    
    /* Celulares estreitos: continua com DUAS colunas. */
    @media (max-width: 360px) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 6px !important;
      }
    
      .grid > .product-card .product-cover,
      .grid > .product-card .product-cover-placeholder {
        height: 92px !important;
        min-height: 92px !important;
        max-height: 92px !important;
      }
    
      .grid > .product-card .product-body {
        padding: 6px 6px 7px !important;
      }
    
      .grid > .product-card .product-name {
        font-size: 11px !important;
      }
    
      .grid > .product-card .product-desc {
        min-height: 0 !important;
        max-height: none !important;
        font-size: 7.5px !important;
      }
    
      .grid > .product-card .product-price {
        font-size: 11px !important;
      }
    
      .grid > .product-card .add-btn {
        min-height: 26px !important;
        padding: 0 5px !important;
        font-size: 7px !important;
      }
    }
    /* COMANDAFACIL: CARDS MOBILE VERTICAIS 2 COLUNAS v2 - FIM */



</style>
</head>

<body>
  <%
    const categorias = [
      ...new Set(
        produtos
          .map(produto => produto.categoriaId?.nome)
          .filter(Boolean)
      )
    ];

    const heroProduto =
      produtos.find(produto => produto.imagem) ||
      produtos[0];

    const telefoneNumeros =
      String(configuracao.telefone || "")
        .replace(/\D/g, "");

    const whatsappLoja =
      telefoneNumeros
        ? (
            telefoneNumeros.startsWith("55")
              ? telefoneNumeros
              : `55${telefoneNumeros}`
          )
        : "";

    const descricaoLoja =
      configuracao.descricao ||
      "Confira nossos produtos e escolha seus favoritos.";

    const horarioAbertura =
      configuracao.horarioAbertura ||
      "08:00";

    const horarioFechamento =
      configuracao.horarioFechamento ||
      "22:00";

    const diasFuncionamento =
      Array.isArray(configuracao.diasFuncionamento)
        ? configuracao.diasFuncionamento
        : [0, 1, 2, 3, 4, 5, 6];
  %>

  <header class="hero">
    <div class="hero-inner">
      <div class="hero-main">
        <div class="hero-avatar">
          <% if (configuracao.fotoPerfil) { %>
            <img
              src="<%= safePublicUrl(configuracao.fotoPerfil, { allowDataImage: true }) %>"
              alt="<%= configuracao.nomeEstabelecimento %>"
            >
          <% } else { %>
            <div class="hero-avatar-placeholder">🍔</div>
          <% } %>
        </div>

        <div class="hero-copy">
          <h1 class="hero-title">
            <%= configuracao.nomeEstabelecimento %>
          </h1>

          <div class="hero-subtitle">
            Sabor que acolhe, qualidade que fica.
          </div>

          <p class="hero-description">
            <%= descricaoLoja %>
          </p>

          <div
            class="store-status"
            id="storeStatus"
          >
            <span class="status-dot"></span>

            <div>
              <strong id="storeStatusText">
                Verificando horário...
              </strong>

              <small>
                <%= horarioAbertura %>
                até
                <%= horarioFechamento %>
              </small>
            </div>
          </div>

          <div class="hero-meta">
            <% if (configuracao.telefone) { %>
              <a
                class="hero-chip"
                href="<%= safePublicUrl(whatsappLoja ? `https://wa.me/${whatsappLoja}` : "#", { allowHash: true }) %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                📱 <%= configuracao.telefone %>
              </a>
            <% } %>

            <% if (configuracao.endereco) { %>
              <div class="hero-chip">
                📍 <%= configuracao.endereco %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="hero-side">
        <div class="made-badge">
          <strong>🔥 Feito na hora</strong>

          <p>
            Ingredientes selecionados e muito sabor para você.
          </p>
        </div>

        <div class="hero-food">
          <% if (heroProduto?.imagem) { %>
            <img
              src="<%= safePublicUrl(heroProduto.imagem, { allowDataImage: true }) %>"
              alt="<%= heroProduto.nome %>"
            >
          <% } else { %>
            <div class="hero-food-placeholder">🍔</div>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <% if (lojaDisponivel === false) { %>
    <div
      role="status"
      style="max-width:1180px;margin:24px auto;padding:22px;border:1px solid #eadfd7;border-radius:16px;background:#fff;color:#431712;text-align:center;font-weight:800;"
    >
      Esta loja está temporariamente indisponível para novos pedidos.
    </div>
  <% } %>

  <div class="toolbar-wrap" <%- lojaDisponivel === false ? 'style="display:none"' : '' %>>
    <div class="toolbar">
      <input
        id="search"
        class="search"
        type="search"
        placeholder="Buscar produto no cardápio..."
      >
    </div>
  </div>

  <main class="content-shell" <%- lojaDisponivel === false ? 'style="display:none"' : '' %>>
    <div>
      <nav class="categories">
        <button
          type="button"
          class="cat-btn active"
          data-cat="todos"
        >
          Todos
        </button>

        <% categorias.forEach(categoria => { %>
          <button
            type="button"
            class="cat-btn"
            data-cat="<%= categoria %>"
          >
            <%= categoria %>
          </button>
        <% }) %>
      </nav>

      <% if (!produtos.length) { %>
        <div class="empty-state">
          Nenhum produto disponível no momento.
        </div>
      <% } %>

      <% categorias.forEach(categoria => {
        const lista = produtos.filter(
          produto => produto.categoriaId?.nome === categoria
        );
      %>
        <section
          class="section"
          data-section="<%= categoria %>"
        >
          <div class="section-head">
            <h2><%= categoria %></h2>

            <span class="section-count">
              <%= lista.length %> produto(s)
            </span>
          </div>

          <div class="grid">
            <% lista.forEach(produto => {
              const tamanhosCategoriaPizzaAtivos =
                produto.categoriaId?.tipoProduto === 'pizza'
                  ? (produto.categoriaId?.configuracaoPizza?.tamanhos || [])
                      .filter(tamanho => tamanho.ativo !== false)
                      .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
                  : [];
              const precosPizzaExibicao = (produto.precosPizza || [])
                .map(item => Number(item.preco))
                .filter(Number.isFinite);
              const idsTamanhosComPreco = new Set(
                (produto.precosPizza || []).map(item => String(item.tamanhoId || ''))
              );
              const tamanhosPizzaProduto = tamanhosCategoriaPizzaAtivos
                .filter(tamanho => idsTamanhosComPreco.has(String(tamanho._id)));
              const pizzaPrecificacaoPendente =
                produto.categoriaId?.tipoProduto === 'pizza'
                && tamanhosCategoriaPizzaAtivos.length > 0
                && precosPizzaExibicao.length === 0;
              const variacoesCategoriaAtivas =
                produto.categoriaId?.tipoProduto !== 'pizza'
                && produto.categoriaId?.configuracaoVariacoes?.habilitado === true
                  ? (produto.categoriaId?.configuracaoVariacoes?.opcoes || [])
                      .filter(opcao => opcao.ativo !== false)
                      .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
                  : [];
              const precosVariacoesExibicao = (produto.precosVariacoes || [])
                .map(item => Number(item.preco))
                .filter(Number.isFinite);
              const idsVariacoesComPreco = new Set(
                (produto.precosVariacoes || []).map(item => String(item.variacaoId || ''))
              );
              const variacoesProduto = variacoesCategoriaAtivas
                .filter(opcao => idsVariacoesComPreco.has(String(opcao._id)));
              const variacaoPrecificacaoPendente =
                variacoesCategoriaAtivas.length > 0
                && precosVariacoesExibicao.length === 0;
            %>
              <article
                class="product-card"
                data-name="<%= (
                  produto.nome +
                  " " +
                  (produto.descricao || "") +
                  " " +
                  categoria
                ).toLowerCase() %>"
                data-id="<%= produto._id %>"
                data-product-name="<%= produto.nome %>"
                data-product-price="<%= Number(produto.preco || 0) %>"
                data-product-image="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                data-category-id="<%= produto.categoriaId?._id || '' %>"
                data-category-type="<%= produto.categoriaId?.tipoProduto || 'normal' %>"
                data-pizza-half-enabled="<%= produto.categoriaId?.tipoProduto === 'pizza' && produto.categoriaId?.configuracaoPizza?.permiteMeioAMeio === true ? 'true' : 'false' %>"
                data-pizza-price-rule="<%= produto.categoriaId?.configuracaoPizza?.regraPrecoMeioAMeio || 'maior_sabor_escolhido' %>"
                data-pizza-compatible-categories='<%= safeJsonForHtml(
                  (produto.categoriaId?.configuracaoPizza?.categoriasMeioAMeio || [])
                    .map(categoriaId => String(categoriaId?._id || categoriaId || ''))
                    .filter(Boolean)
                ) %>'
                data-pizza-sizes='<%= safeJsonForHtml(
                  (produto.categoriaId?.configuracaoPizza?.tamanhos || [])
                    .filter(tamanho => tamanho.ativo !== false)
                    .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
                    .map(tamanho => ({
                      id: String(tamanho._id),
                      nome: String(tamanho.nome || ''),
                      maxSabores: Math.max(1, Math.min(3, Number(tamanho.maxSabores || 2)))
                    }))
                ) %>'
                data-product-pizza-prices='<%= safeJsonForHtml(
                  (produto.precosPizza || []).map(item => ({
                    tamanhoId: String(item.tamanhoId || ''),
                    tamanhoNome: String(item.tamanhoNome || ''),
                    preco: Number(item.preco || 0)
                  }))
                ) %>'
                data-variations-enabled="<%= variacoesCategoriaAtivas.length ? 'true' : 'false' %>"
                data-category-variations='<%= safeJsonForHtml(
                  variacoesCategoriaAtivas.map(opcao => ({
                    id: String(opcao._id),
                    nome: String(opcao.nome || '')
                  }))
                ) %>'
                data-product-variation-prices='<%= safeJsonForHtml(
                  (produto.precosVariacoes || []).map(item => ({
                    variacaoId: String(item.variacaoId || ''),
                    variacaoNome: String(item.variacaoNome || ''),
                    preco: Number(item.preco || 0)
                  }))
                ) %>'
                data-product-additionals='<%= safeJsonForHtml(
                  (produto.adicionais || [])
                    .filter(adicional => adicional.ativo !== false)
                    .map(adicional => ({
                      _id: String(adicional._id),
                      nome: adicional.nome,
                      preco: Number(adicional.preco || 0)
                    }))
                ) %>'
              >
                <div class="product-cover">
                  <% if (produto.imagem) { %>
                    <img
                      src="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                      alt="<%= produto.nome %>"
                      loading="lazy"
                      decoding="async"
                    >
                  <% } else { %>
                    <div class="product-cover-placeholder">
                      🍽️
                    </div>
                  <% } %>
                </div>

                <div class="product-body">
                  <div class="product-category">
                    <%= categoria %>
                  </div>

                  <% if (produto.categoriaId?.tipoProduto === 'pizza') { %>
                    <% if (produto.categoriaId?.configuracaoPizza?.permiteMeioAMeio === true) { %>
                      <div class="pizza-half-badge">🍕 Meio a meio disponível</div>
                    <% } %>
                    <% if (tamanhosPizzaProduto.length) { %>
                      <div class="pizza-half-badge">📏 <%= tamanhosPizzaProduto.map(t => t.nome).join(' • ') %></div>
                    <% } else if (pizzaPrecificacaoPendente) { %>
                      <div class="pizza-half-badge">⚠️ Temporariamente indisponível</div>
                    <% } %>
                  <% } %>
                  <% if (variacoesProduto.length) { %>
                    <div class="pizza-half-badge">📏 <%= variacoesProduto.map(opcao => opcao.nome).join(' • ') %></div>
                  <% } else if (variacaoPrecificacaoPendente) { %>
                    <div class="pizza-half-badge">⚠️ Temporariamente indisponível</div>
                  <% } %>

                  <h3 class="product-name"><%= produto.nome %></h3>
                  <% const avaliacao = avaliacoesPorProduto?.[String(produto._id)] || { media: '0.0', quantidade: 0 }; %>
                  <div style="font-size:13px;color:#9a5a12;margin-top:4px">★ <%= avaliacao.media %> · <%= avaliacao.quantidade %> avaliação(ões)</div>

                  <p class="product-desc">
                    <%= produto.descricao || "Produto disponível em nosso cardápio." %>
                  </p>

                  <div class="product-foot">
                    <div class="product-price">
                      <% if (produto.categoriaId?.tipoProduto === 'pizza' && precosPizzaExibicao.length) { %>
                        <small style="display:block;font-size:9px;line-height:1;">A partir de</small>
                        <%= Math.min(...precosPizzaExibicao).toLocaleString(
                          "pt-BR",
                          { style: "currency", currency: "BRL" }
                        ) %>
                      <% } else if (precosVariacoesExibicao.length) { %>
                        <small style="display:block;font-size:9px;line-height:1;">A partir de</small>
                        <%= Math.min(...precosVariacoesExibicao).toLocaleString(
                          "pt-BR",
                          { style: "currency", currency: "BRL" }
                        ) %>
                      <% } else if (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente) { %>
                        <small style="display:block;font-size:10px;line-height:1.2;">Indisponível</small>
                      <% } else { %>
                        <%= Number(produto.preco || 0).toLocaleString(
                          "pt-BR",
                          { style: "currency", currency: "BRL" }
                        ) %>
                      <% } %>
                    </div>

                    <div style="display:flex;gap:7px">
                      <button
                        type="button"
                        class="add-btn"
                        data-add-cart
                        <%= (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente) ? 'disabled title="Preços por opção ainda não configurados"' : '' %>
                      >
                        <span><%= (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente)
                          ? 'Indisponível'
                          : (produto.categoriaId?.tipoProduto === 'pizza' || variacoesProduto.length ? 'Escolher' : 'Pedir')
                        %></span>
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% }) %>
    </div>

    <aside
      class="sidebar"
      id="sidebarCart"
    >
      <div class="sidebar-panel">
        <div class="cart-card">
          <div class="cart-head">
            <h2>Meu pedido</h2>

            <div class="cart-head-actions">
              <span
                class="cart-badge"
                id="cartCount"
              >
                0
              </span>
              <button
                type="button"
                class="cart-modal-close"
                id="closeCartModal"
                aria-label="Fechar meu pedido"
              >
                ✕
              </button>
            </div>
          </div>

          <div
            id="cartEmpty"
            class="cart-empty"
          >
            Seu carrinho está vazio.<br>
            Adicione produtos para continuar.
          </div>

          <div
            id="cartList"
            class="cart-list"
          ></div>

          <div class="cart-note-wrap">
            <label for="cartNote">
              Observações
            </label>

            <textarea
              id="cartNote"
              class="cart-note"
              placeholder="Ex.: sem cebola, retirar ingrediente..."
            ></textarea>
          </div>

          <div class="cart-footer">
            <div class="cart-subtotal">
              <span>
                Subtotal
                (<span id="cartItemsCount">0</span> itens)
              </span>

              <strong id="cartSubtotal">
                R$ 0,00
              </strong>
            </div>

            <button
              type="button"
              class="checkout-btn"
              id="checkoutBtn"
              disabled
            >
              Continuar pedido
            </button>
          </div>
        </div>
      </div>
    </aside>
  </main>

  <div class="public-order-actions" aria-label="Ações do pedido">

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= configuracao.nomeEstabelecimento %> | Cardápio</title>

  <style>
    :root {
      --bg: #f7f4f1;
      --card: #ffffff;
      --text: #23140f;
      --muted: #756762;
      --line: #eadfd7;
      --dark: #25110d;
      --dark-2: #431712;
      --orange: #f27613;
      --orange-2: #ff8a1d;
      --green: #1f9254;
      --red: #dc3030;
      --shadow: 0 14px 35px rgba(43, 19, 8, 0.12);
      --shadow-strong: 0 22px 50px rgba(43, 19, 8, 0.18);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, Arial, sans-serif;
    }

    body.modal-open {
      overflow: hidden;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .hidden {
      display: none !important;
    }

    .hero {
      position: relative;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(90deg, rgba(22, 7, 5, 0.9), rgba(84, 10, 12, 0.76), rgba(233, 107, 19, 0.62)),
        url("/assets/imgs/template1.png") center / cover no-repeat;
    }

    .hero-inner {
      max-width: 1360px;
      margin: auto;
      padding: 34px 22px 105px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 420px;
      gap: 30px;
      align-items: center;
    }

    .hero-main {
      display: flex;
      align-items: center;
      gap: 22px;
      min-width: 0;
    }

    .hero-avatar {
      width: 116px;
      height: 116px;
      flex: 0 0 116px;
      overflow: hidden;
      border: 4px solid rgba(255, 255, 255, 0.92);
      border-radius: 34px;
      background: rgba(255, 255, 255, 0.1);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
    }

    .hero-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-avatar-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 54px;
    }

    .hero-copy {
      min-width: 0;
    }

    .hero-title {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 1;
      letter-spacing: -1.8px;
    }

    .hero-subtitle {
      margin-top: 12px;
      color: #ffc56d;
      font-size: 15px;
      font-weight: 800;
    }

    .hero-description {
      max-width: 700px;
      margin: 14px 0 0;
      color: #f5ddd0;
      font-size: 16px;
      line-height: 1.65;
    }

    .store-status {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 46px;
      margin-top: 15px;
      padding: 8px 14px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(8px);
    }

    .status-dot {
      width: 11px;
      height: 11px;
      flex: 0 0 11px;
      border-radius: 50%;
      background: #9ca3af;
      box-shadow: 0 0 0 5px rgba(156, 163, 175, 0.16);
    }

    .store-status.open .status-dot {
      background: #23c875;
      box-shadow: 0 0 0 5px rgba(35, 200, 117, 0.2);
    }

    .store-status.closed .status-dot {
      background: #ff5252;
      box-shadow: 0 0 0 5px rgba(255, 82, 82, 0.2);
    }

    .store-status strong,
    .store-status small {
      display: block;
    }

    .store-status small {
      margin-top: 3px;
      color: #efd9ce;
      font-size: 12px;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-top: 16px;
    }

    .hero-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 15px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 14px;
      font-weight: 750;
      text-decoration: none;
      backdrop-filter: blur(8px);
    }

    .hero-side {
      position: relative;
      min-height: 275px;
    }

    .hero-food {
      width: 100%;
      height: 275px;
      overflow: hidden;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.08);
    }

    .hero-food img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-food-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 96px;
    }

    .made-badge {
      position: absolute;
      left: -30px;
      bottom: 18px;
      z-index: 2;
      max-width: 215px;
      padding: 16px 18px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(116, 24, 9, 0.94), rgba(245, 117, 17, 0.82));
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(10px);
    }

    .made-badge strong {
      color: #ffd36e;
      font-size: 14px;
      text-transform: uppercase;
    }

    .made-badge p {
      margin: 7px 0 0;
      color: #fff1e6;
      font-size: 13px;
      line-height: 1.45;
    }

    .toolbar-wrap {
      position: sticky;
      top: 0;
      z-index: 40;
      margin-top: -48px;
      padding: 0 18px;
    }

    .toolbar {
      max-width: 1360px;
      margin: auto;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 18px 45px rgba(43, 19, 8, 0.12);
      backdrop-filter: blur(12px);
    }

    .search {
      width: 100%;
      min-height: 54px;
      padding: 0 18px;
      border: 1px solid #ddd4ce;
      border-radius: 17px;
      background: #fff;
      color: var(--text);
      font-size: 16px;
      outline: none;
    }

    .search:focus {
      border-color: var(--orange);
      box-shadow: 0 0 0 4px rgba(242, 118, 19, 0.1);
    }

    .content-shell {
      max-width: 1360px;
      margin: 22px auto 60px;
      padding: 0 18px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 350px;
      gap: 28px;
      align-items: start;
    }

    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-bottom: 28px;
    }

    .cat-btn {
      min-height: 48px;
      padding: 0 18px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: #3c241c;
      font-size: 15px;
      font-weight: 850;
      transition: 0.2s;
    }

    .cat-btn.active {
      border-color: transparent;
      background: linear-gradient(135deg, #2a110d, #4c2017);
      color: #fff;
      box-shadow: 0 14px 28px rgba(43, 19, 8, 0.2);
    }

    .section {
      margin-top: 24px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }

    .section-head h2 {
      margin: 0;
      font-size: 28px;
    }

    .section-count {
      color: #8a776f;
      font-size: 14px;
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 22px;
    }

    .product-card {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--card);
      box-shadow: var(--shadow);
      transition: 0.22s;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-strong);
    }

    .product-cover {
      height: 210px;
      overflow: hidden;
      background: linear-gradient(135deg, #f7ead6, #efd2c1);
    }

    .product-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-cover-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 62px;
    }

    .product-body {
      padding: 17px;
    }

    .product-category {
      color: #b83a1e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .product-name {
      margin: 7px 0 8px;
      font-size: 19px;
    }

    .product-desc {
      min-height: 60px;
      margin: 0;
      color: #6e615d;
      font-size: 14px;
      line-height: 1.55;
    }

    .product-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 16px;
    }

    .product-price {
      color: var(--green);
      font-size: 19px;
      font-weight: 900;
    }

    .add-btn {
      min-height: 44px;
      padding: 0 16px;
      border: 0;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 14px;
      font-weight: 900;
      box-shadow: 0 12px 24px rgba(242, 118, 19, 0.25);
    }

    .add-btn:disabled {
      opacity: 0.58;
      cursor: not-allowed;
    }

    .sidebar {
      position: sticky;
      top: 100px;
    }

    .cart-card {
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      background: linear-gradient(180deg, #381510, #421611);
      color: #fff;
      box-shadow: 0 18px 42px rgba(43, 19, 8, 0.22);
    }

    .cart-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 22px 20px 16px;
    }

    .cart-head h2 {
      margin: 0;
      font-size: 20px;
    }

    .cart-badge {
      min-width: 28px;
      height: 28px;
      padding: 0 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--orange);
      font-size: 13px;
      font-weight: 900;
    }

    .cart-empty {
      margin: 0 16px 16px;
      padding: 22px 14px;
      border: 1px dashed rgba(255, 255, 255, 0.17);
      border-radius: 18px;
      color: #d9c0b5;
      text-align: center;
      line-height: 1.55;
    }

    .cart-list {
      max-height: 340px;
      overflow: auto;
      padding: 0 16px;
      display: grid;
      gap: 11px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr);
      gap: 11px;
      padding: 11px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.04);
    }

    .cart-thumb {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border-radius: 13px;
      background: rgba(255, 255, 255, 0.08);
      font-size: 26px;
    }

    .cart-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-name {
      margin: 0 0 5px;
      font-size: 14px;
    }

    .cart-price {
      color: #fbe6dc;
      font-size: 13px;
      font-weight: 800;
    }

    .cart-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 7px;
    }

    .qty-box {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 3px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.18);
    }

    .qty-btn,
    .remove-btn {
      border: 0;
      color: #fff;
    }

    .qty-btn {
      width: 29px;
      height: 29px;
      border-radius: 50%;
      background: transparent;
      font-size: 18px;
    }

    .qty-number {
      min-width: 18px;
      text-align: center;
      font-size: 13px;
      font-weight: 900;
    }

    .remove-btn {
      width: 31px;
      height: 31px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
    }

    .cart-note-wrap {
      padding: 15px 16px 0;
    }

    .cart-note-wrap label {
      display: block;
      margin-bottom: 7px;
      color: #f1d2c3;
      font-size: 13px;
      font-weight: 800;
    }

    .cart-note {
      width: 100%;
      min-height: 76px;
      resize: vertical;
      padding: 12px 13px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 15px;
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      outline: none;
    }

    .cart-footer {
      padding: 16px;
    }

    .cart-subtotal {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 14px;
      font-weight: 850;
    }

    .checkout-btn {
      width: 100%;
      min-height: 52px;
      border: 0;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 16px;
      font-weight: 900;
      box-shadow: 0 16px 30px rgba(242, 118, 19, 0.25);
    }

    .checkout-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .mobile-cart-toggle {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 70;
      min-height: 54px;
      padding: 0 18px;
      display: none;
      align-items: center;
      gap: 9px;
      border: 0;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-weight: 900;
      box-shadow: 0 18px 35px rgba(242, 118, 19, 0.32);
    }

    .mobile-cart-count {
      min-width: 24px;
      height: 24px;
      padding: 0 7px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.18);
      font-size: 12px;
    }

    .empty-state {
      padding: 60px 24px;
      border: 1px dashed #d7c7bd;
      border-radius: 24px;
      background: #fff;
      color: #7d706a;
      text-align: center;
    }

    .footer {
      padding: 26px 18px;
      background: #21120d;
      color: #ddcbc4;
      text-align: center;
      font-size: 14px;
    }

    .order-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      place-items: center;
      padding: 18px;
      background: rgba(22, 9, 6, 0.68);
      backdrop-filter: blur(7px);
    }

    .order-modal.open {
      display: grid;
    }

    .order-modal-card {
      width: min(650px, 100%);
      max-height: 92vh;
      overflow: auto;
      border-radius: 25px;
      background: #fff;
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.3);
    }

    .modal-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 22px 22px 15px;
      border-bottom: 1px solid var(--line);
    }

    .modal-head h2 {
      margin: 0;
      font-size: 23px;
    }

    .modal-head p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .modal-close {
      width: 42px;
      height: 42px;
      border: 0;
      border-radius: 50%;
      background: #f4efec;
      color: var(--text);
      font-size: 24px;
    }

    .order-form {
      padding: 20px 22px 24px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .form-field {
      display: grid;
      gap: 7px;
    }

    .form-field.full {
      grid-column: 1 / -1;
    }

    .form-field label {
      font-size: 13px;
      font-weight: 850;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
      width: 100%;
      min-height: 48px;
      padding: 10px 13px;
      border: 1px solid #ddd4ce;
      border-radius: 13px;
      outline: none;
    }

    .form-field textarea {
      min-height: 90px;
      resize: vertical;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      border-color: var(--orange);
      box-shadow: 0 0 0 4px rgba(242, 118, 19, 0.1);
    }

    .send-order-btn {
      grid-column: 1 / -1;
      min-height: 52px;
      border: 0;
      border-radius: 15px;
      background: linear-gradient(135deg, var(--orange), var(--orange-2));
      color: #fff;
      font-size: 16px;
      font-weight: 900;
    }

    .send-order-btn:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .form-message {
      grid-column: 1 / -1;
      display: none;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 750;
    }

    .form-message.error {
      display: block;
      background: #ffe1e1;
      color: #9d1c1c;
    }

    .form-message.success {
      display: block;
      background: #dff7e9;
      color: #176e42;
    }

    .addon-modal {
      position: fixed; inset: 0; z-index: 130; display: none;
      place-items: center; padding: 18px; background: rgba(22,9,6,.68);
      backdrop-filter: blur(7px);
    }
    .addon-modal.open { display: grid; }
    .addon-card { width: min(560px,100%); max-height: 90vh; overflow:auto; padding:22px; border-radius:24px; background:#fff; box-shadow:0 28px 80px rgba(0,0,0,.3); }
    .addon-head { display:flex; justify-content:space-between; gap:14px; align-items:flex-start; margin-bottom:16px; }
    .addon-head h2 { margin:0; font-size:22px; }
    .addon-head p { margin:5px 0 0; color:var(--muted); font-size:13px; }
    .addon-list { display:grid; gap:10px; }
    .addon-option { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:13px; border:1px solid var(--line); border-radius:14px; background:#fffaf6; }
    .addon-option label { display:flex; align-items:center; gap:9px; font-weight:800; }
    .addon-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:17px; }
    .addon-actions button { min-height:48px; border-radius:13px; font-weight:900; }
    .addon-cancel { border:1px solid var(--line); background:#fff; }
    .addon-confirm { border:0; color:#fff; background:linear-gradient(135deg,var(--orange),var(--orange-2)); }
    .cart-addons { margin-top:5px; color:#f3cdbc; font-size:11px; line-height:1.45; }
    @media (max-width: 1180px) {
      .content-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }

      .hero-inner {
        grid-template-columns: 1fr;
      }

      .hero-side {
        display: none;
      }
    }

    @media (max-width: 760px) {
      .hero-inner {
        padding: 24px 16px 88px;
      }

      .hero-main {
        align-items: flex-start;
      }

      .hero-avatar {
        width: 82px;
        height: 82px;
        flex-basis: 82px;
        border-radius: 24px;
      }

      .hero-title {
        font-size: 30px;
      }

      .toolbar-wrap {
        margin-top: -36px;
        padding: 0 12px;
      }

      .content-shell {
        padding: 0 12px;
      }

      .categories {
        flex-wrap: nowrap;
        overflow-x: auto;
      }

      .cat-btn {
        flex: 0 0 auto;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .mobile-cart-toggle {
        display: inline-flex;
      }

      .sidebar {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: none;
        align-items: flex-end;
        padding: 16px;
        background: rgba(18, 9, 6, 0.64);
        backdrop-filter: blur(5px);
      }

      .sidebar.open {
        display: flex;
      }

      .sidebar-panel {
        width: 100%;
        max-height: 92vh;
        overflow: auto;
      }

      .order-form {
        grid-template-columns: 1fr;
      }

      .form-field.full,
      .send-order-btn,
      .form-message {
        grid-column: auto;
      }
    }
  </style>
</head>

<body>
  <%
    const categorias = [
      ...new Set(
        produtos
          .map(produto => produto.categoriaId?.nome)
          .filter(Boolean)
      )
    ];

    const heroProduto =
      produtos.find(produto => produto.imagem) ||
      produtos[0];

    const telefoneNumeros =
      String(configuracao.telefone || "")
        .replace(/\D/g, "");

    const whatsappLoja =
      telefoneNumeros
        ? (
            telefoneNumeros.startsWith("55")
              ? telefoneNumeros
              : `55${telefoneNumeros}`
          )
        : "";

    const descricaoLoja =
      configuracao.descricao ||
      "Confira nossos produtos e escolha seus favoritos.";

    const horarioAbertura =
      configuracao.horarioAbertura ||
      "08:00";

    const horarioFechamento =
      configuracao.horarioFechamento ||
      "22:00";

    const diasFuncionamento =
      Array.isArray(configuracao.diasFuncionamento)
        ? configuracao.diasFuncionamento
        : [0, 1, 2, 3, 4, 5, 6];
  %>

  <header class="hero">
    <div class="hero-inner">
      <div class="hero-main">
        <div class="hero-avatar">
          <% if (configuracao.fotoPerfil) { %>
            <img
              src="<%= configuracao.fotoPerfil %>"
              alt="<%= configuracao.nomeEstabelecimento %>"
            >
          <% } else { %>
            <div class="hero-avatar-placeholder">🍔</div>
          <% } %>
        </div>

        <div class="hero-copy">
          <h1 class="hero-title">
            <%= configuracao.nomeEstabelecimento %>
          </h1>

          <div class="hero-subtitle">
            Sabor que acolhe, qualidade que fica.
          </div>

          <p class="hero-description">
            <%= descricaoLoja %>
          </p>

          <div
            class="store-status"
            id="storeStatus"
          >
            <span class="status-dot"></span>

            <div>
              <strong id="storeStatusText">
                Verificando horário...
              </strong>

              <small>
                <%= horarioAbertura %>
                até
                <%= horarioFechamento %>
              </small>
            </div>
          </div>

          <div class="hero-meta">
            <% if (configuracao.telefone) { %>
              <a
                class="hero-chip"
                href="<%= whatsappLoja ? `https://wa.me/${whatsappLoja}` : "#" %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                📱 <%= configuracao.telefone %>
              </a>
            <% } %>

            <% if (configuracao.endereco) { %>
              <div class="hero-chip">
                📍 <%= configuracao.endereco %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="hero-side">
        <div class="made-badge">
          <strong>🔥 Feito na hora</strong>

          <p>
            Ingredientes selecionados e muito sabor para você.
          </p>
        </div>

        <div class="hero-food">
          <% if (configuracao.fotoPerfil) { %>
            <img
              src="<%= configuracao.fotoPerfil %>"
              alt="<%= configuracao.nomeEstabelecimento %>"
            >
          <% } else if (heroProduto?.imagem) { %>
            <img src="<%= heroProduto.imagem %>" alt="<%= heroProduto.nome %>">
          <% } else { %>
            <div class="hero-food-placeholder">🍔</div>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <div class="toolbar-wrap">
    <div class="toolbar">
      <input
        id="search"
        class="search"
        type="search"
        placeholder="Buscar produto no cardápio..."
      >
    </div>
  </div>

  <main class="content-shell">
    <div>
      <nav class="categories">
        <button
          type="button"
          class="cat-btn active"
          data-cat="todos"
        >
          Todos
        </button>

        <% categorias.forEach(categoria => { %>
          <button
            type="button"
            class="cat-btn"
            data-cat="<%= categoria %>"
          >
            <%= categoria %>
          </button>
        <% }) %>
      </nav>

      <% if (!produtos.length) { %>
        <div class="empty-state">
          Nenhum produto disponível no momento.
        </div>
      <% } %>

      <% categorias.forEach(categoria => {
        const lista = produtos.filter(
          produto => produto.categoriaId?.nome === categoria
        );
      %>
        <section
          class="section"
          data-section="<%= categoria %>"
        >
          <div class="section-head">
            <h2><%= categoria %></h2>

            <span class="section-count">
              <%= lista.length %> produto(s)
            </span>
          </div>

          <div class="grid">
            <% lista.forEach(produto => { %>
              <article
                class="product-card"
                data-name="<%= (
                  produto.nome +
                  " " +
                  (produto.descricao || "") +
                  " " +
                  categoria
                ).toLowerCase() %>"
                data-id="<%= produto._id %>"
                data-product-name="<%= produto.nome %>"
                data-product-price="<%= Number(produto.preco || 0) %>"
                data-product-image="<%= produto.imagem || "" %>"
                data-product-additionals='<%- JSON.stringify(
                  (produto.adicionais || [])
                    .filter(adicional => adicional.ativo !== false)
                    .map(adicional => ({
                      _id: String(adicional._id),
                      nome: adicional.nome,
                      preco: Number(adicional.preco || 0)
                    }))
                ) %>'
              >
                <div class="product-cover">
                  <% if (produto.imagem) { %>
                    <img
                      src="<%= produto.imagem %>"
                      alt="<%= produto.nome %>"
                    >
                  <% } else { %>
                    <div class="product-cover-placeholder">
                      🍽️
                    </div>
                  <% } %>
                </div>

                <div class="product-body">
                  <div class="product-category">
                    <%= categoria %>
                  </div>

                  <h3 class="product-name"><%= produto.nome %></h3>
                  <% const avaliacao = avaliacoesPorProduto?.[String(produto._id)] || { media: '0.0', quantidade: 0 }; %>
                  <div style="font-size:13px;color:#9a5a12;margin-top:4px">★ <%= avaliacao.media %> · <%= avaliacao.quantidade %> avaliação(ões)</div>

                  <p class="product-desc">
                    <%= produto.descricao || "Produto disponível em nosso cardápio." %>
                  </p>

                  <div class="product-foot">
                    <div class="product-price">
                      <%= Number(produto.preco || 0).toLocaleString(
                        "pt-BR",
                        {
                          style: "currency",
                          currency: "BRL"
                        }
                      ) %>
                    </div>

                    <div style="display:flex;gap:7px">
                      <button type="button" class="add-btn" data-rate-product data-product-id="<%= produto._id %>" data-product-name="<%= produto.nome %>"><span>Avaliar</span></button>
                      <button type="button" class="add-btn" data-add-cart><span>Pedir</span></button>
                    </div>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      <% }) %>
    </div>

    <aside
      class="sidebar"
      id="sidebarCart"
    >
      <div class="sidebar-panel">
        <div class="cart-card">
          <div class="cart-head">
            <h2>Meu pedido</h2>

            <span
              class="cart-badge"
              id="cartCount"
            >
              0
            </span>
          </div>

          <div
            id="cartEmpty"
            class="cart-empty"
          >
            Seu carrinho está vazio.<br>
            Adicione produtos para continuar.
          </div>

          <div
            id="cartList"
            class="cart-list"
          ></div>

          <div class="cart-note-wrap">
            <label for="cartNote">
              Observações
            </label>

            <textarea
              id="cartNote"
              class="cart-note"
              placeholder="Ex.: sem cebola, retirar ingrediente..."
            ></textarea>
          </div>

          <div class="cart-footer">
            <div class="cart-subtotal">
              <span>
                Subtotal
                (<span id="cartItemsCount">0</span> itens)
              </span>

              <strong id="cartSubtotal">
                R$ 0,00
              </strong>
            </div>

            <button
              type="button"
              class="checkout-btn"
              id="checkoutBtn"
              disabled
            >
              Continuar pedido
            </button>
          </div>
        </div>
      </div>
    </aside>
  </main>

  <button
    type="button"
    class="mobile-cart-toggle"
    id="mobileCartToggle"
  >
    Meu pedido
    <span
      class="mobile-cart-count"
      id="mobileCartCount"
    >
      0
    </span>
  </button>

  <div
    class="order-modal"
    id="orderModal"
  >
    <div class="order-modal-card">
      <div class="modal-head">
        <div>
          <h2>Finalizar pedido</h2>

          <p>
            O pedido será enviado para a aba Pedidos do estabelecimento.
          </p>
        </div>

        <button
          type="button"
          class="modal-close"
          id="closeOrderModal"
          aria-label="Fechar"
        >
          ×
        </button>
      </div>

      <form
        class="order-form"
        id="orderForm"
      >
        <div class="form-field">
          <label for="clienteNome">
            Nome
          </label>

          <input
            id="clienteNome"
            name="cliente"
            required
          >
        </div>

        <div class="form-field">
          <label for="clienteTelefone">
            WhatsApp
          </label>

          <input
            id="clienteTelefone"
            name="telefone"
            inputmode="tel"
            placeholder="(99) 99999-9999"
            required
          >
        </div>

        <div class="form-field full">
          <label for="canalPedido">
            Tipo do pedido
          </label>

          <select
            id="canalPedido"
            name="canal"
            required
          >
            <option value="delivery">
              Delivery
            </option>

            <option value="retirada">
              Retirada no local
            </option>
          </select>
        </div>

        <div
          class="form-field full"
          id="enderecoField"
        >
          <label for="enderecoEntrega">
            Endereço de entrega
          </label>

          <input
            id="enderecoEntrega"
            name="enderecoEntrega"
            placeholder="Rua, número, bairro e referência"
            required
          >
        </div>

        <div class="form-field full">
          <label for="formaPagamento">Forma de pagamento</label>
          <select id="formaPagamento" name="formaPagamento" required>
            <option value="pix" <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : 'disabled' %>>Pix online <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : '(indisponível)' %></option>
            <option value="dinheiro">Dinheiro na entrega/retirada</option>
            <option value="cartao">Cartão na entrega/retirada</option>
          </select>
        </div>

        <div class="form-field full hidden" id="emailPixField">
          <label for="emailPix">E-mail para o pagamento Pix</label>
          <input
            type="email"
            id="emailPix"
            name="emailPix"
            placeholder="cliente@email.com"
            autocomplete="email"
          >
          <small style="display:block;margin-top:6px;color:#786b66">O Mercado Pago exige um e-mail válido para gerar o Pix.</small>
        </div>

        <div class="form-field full">
          <label for="observacaoFinal">
            Observações do pedido
          </label>

          <textarea
            id="observacaoFinal"
            name="observacao"
            placeholder="Alguma observação adicional?"
          ></textarea>
        </div>

        <div
          id="formMessage"
          class="form-message"
        ></div>

        <button
          type="submit"
          class="send-order-btn"
          id="sendOrderBtn"
        >
          Enviar pedido
        </button>
      </form>
    </div>
  </div>

  <div class="order-modal" id="pixPaymentModal">
    <div class="order-modal-card" style="max-width:520px">
      <div class="modal-head">
        <div>
          <h2>Pagamento Pix</h2>
          <p>Escaneie o QR Code ou copie o código Pix.</p>
        </div>
        <button type="button" class="modal-close" id="closePixPaymentModal" aria-label="Fechar">×</button>
      </div>

      <section id="pixPaymentBox" style="padding:8px 0;text-align:center;background:#fff">
        <h3 style="margin-top:0">Pague com Pix</h3>
        <img id="pixQrImage" alt="QR Code Pix" style="display:block;width:240px;max-width:100%;margin:12px auto">
        <textarea id="pixCopyCode" readonly style="width:100%;min-height:90px;padding:10px;border:1px solid #ddd;border-radius:10px"></textarea>
        <button type="button" class="send-order-btn" id="copyPixButton" style="margin-top:10px">Copiar código Pix</button>
        <p id="pixPaymentStatus">Aguardando pagamento...</p>

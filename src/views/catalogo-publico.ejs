    function pixPollingDelay() {
      const elapsed = Date.now() - pixPollingStartedAt;
      if (elapsed < 30_000) return 2_000;
      if (elapsed < 120_000) return 5_000;
      return 10_000;
    }

    function schedulePixPolling(delay = pixPollingDelay()) {
      if (!pixPollingContext || pixPollingTimer || document.hidden) return;
      pixPollingTimer = setTimeout(() => {
        pixPollingTimer = null;
        void pollPixStatus();
      }, delay);
    }

    async function pollPixStatus() {
      if (!pixPollingContext || pixPollingInFlight || document.hidden) return;
      pixPollingInFlight = true;
      try {
        const statusResponse = await fetch(
          `/catalogo/${encodeURIComponent(storeSlug)}/pedido/pagamento-status`,
          { method: "POST", headers: { "Authorization": `Bearer ${pixPollingContext.token}` } }
        );
        const statusResult = await statusResponse.json();
        if (!statusResponse.ok) throw new Error("Falha temporária ao confirmar pagamento.");
        if (statusResult.pixAprovado && statusResult.aguardandoPagamentoRestante) {
          document.querySelector("#pixPaymentStatus").textContent =
            "✅ Parte Pix aprovada. O restante será pago na entrega/retirada.";
          const card = document.querySelector(`[data-public-order-code="${CSS.escape(pixPollingContext.codigoPublico)}"]`);
          const badge = card?.querySelector(".payment-status");
          if (badge) {
            badge.className = "customer-order-badge payment-status pending";
            badge.textContent = "Pix pago • restante pendente";
          }
          formMessage.className = "form-message success";
          formMessage.textContent =
            "Parte Pix confirmada! O pedido foi enviado para a loja e o restante será recebido na entrega/retirada.";
          setTimeout(closePixModal, 1200);
          return;
        }
        if (statusResult.pagamentoStatus === "pago") {
          document.querySelector("#pixPaymentStatus").textContent = "✅ Pagamento aprovado.";
          const card = document.querySelector(`[data-public-order-code="${CSS.escape(pixPollingContext.codigoPublico)}"]`);
          const badge = card?.querySelector(".payment-status");
          if (badge) { badge.className = "customer-order-badge payment-status paid"; badge.textContent = "Pagamento: Pago"; }
          formMessage.className = "form-message success";
          formMessage.textContent = "Pagamento confirmado! Seu pedido foi enviado para a loja.";
          setTimeout(closePixModal, 700);
          return;
        }
        if (statusResult.pixExpiracaoPendente
          || String(statusResult.pagamentoStatus || "").toLowerCase() === "expiracao_pendente") {
          mostrarPixExpiracaoPendente();
          schedulePixPolling(3000);
          return;
        }
        if (statusResult.pixExpirado
          || String(statusResult.pagamentoStatus || "").toLowerCase() === "expirado"
          || ["expired", "cancelled", "canceled", "rejected"].includes(String(statusResult.status || "").toLowerCase())) {
          mostrarPixExpirado();
          if (pixPollingTimer) clearTimeout(pixPollingTimer);
          pixPollingTimer = null;
          pixPollingContext = null;
          return;
        }
        if (["cancelado", "rejected", "cancelled", "canceled", "refunded", "charged_back"]
          .includes(String(statusResult.pagamentoStatus || statusResult.status || "").toLowerCase())) {
          clearPixExpirationTimer();
          document.querySelector("#pixPaymentStatus").textContent = "Pagamento não aprovado.";
          if (pixPollingTimer) clearTimeout(pixPollingTimer);
          pixPollingTimer = null;
          pixPollingContext = null;
          return;
        }
        schedulePixPolling();
      } catch (_) {
        schedulePixPolling();
      } finally {
        pixPollingInFlight = false;
      }
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (pixPollingTimer) clearTimeout(pixPollingTimer);
        pixPollingTimer = null;
      } else if (pixPollingContext) {
        schedulePixPolling(0);
      }
    });

    function atualizarEndereco() {
      let delivery =
        canalPedido.value ===
        "delivery";

      if (delivery && !cidadesEntregaDisponiveis) {
        canalPedido.value = "retirada";
        delivery = false;
        formMessage.className = "form-message error";
        formMessage.textContent =
          "Esta loja ainda não cadastrou cidades para entrega. Selecione retirada no local.";
      }

      document.querySelectorAll(".delivery-address-field").forEach(field => {
        field.classList.toggle("hidden", !delivery);
      });

      [cidadeEntregaId, ruaEntrega, numeroEntrega, bairroEntrega].forEach(input => {
        if (input) input.required = delivery;
      });

      if (!delivery) {
        [cidadeEntregaId, ruaEntrega, numeroEntrega, bairroEntrega, referenciaEntrega].forEach(input => {
          if (input) input.value = "";
        });
      }

      atualizarResumoFinanceiroPedido();
    }

    checkoutBtn.addEventListener(
      "click",
      openOrderModal
    );

    closeOrderModal.addEventListener(
      "click",
      closeModal
    );

    closePixPaymentModal.addEventListener("click", closePixModal);
    pixPaymentModal.addEventListener("click", event => {
      if (event.target === pixPaymentModal) closePixModal();
    });

    orderModal.addEventListener(
      "click",
      event => {
        if (
          event.target ===
          orderModal
        ) {
          closeModal();
        }
      }
    );

    canalPedido.addEventListener(
      "change",
      atualizarEndereco
    );

    cidadeEntregaId.addEventListener(
      "change",
      atualizarResumoFinanceiroPedido
    );


    formaPagamento.addEventListener("change", atualizarPagamentoCombinado);
    formaPagamento1.addEventListener("change", atualizarPagamentoCombinado);
    formaPagamento2.addEventListener("change", atualizarPagamentoCombinado);
    valorPagamento1.addEventListener("input", atualizarPagamentoCombinado);

    if (!pixOnlineDisponivel) {
      if (formaPagamento.value === "pix") formaPagamento.value = "dinheiro";
      if (formaPagamento1.value === "pix") formaPagamento1.value = "dinheiro";
      if (formaPagamento2.value === "pix") formaPagamento2.value = "cartao";
    }

    mobileCartToggle.addEventListener(
      "click",
      async () => {
        try {
          await sincronizarCarrinho();
        } catch (error) {
          avisarCarrinho(error.message);
          return;
        }
        sidebarCart.classList.add(
          "open"
        );
      }
    );

    sidebarCart.addEventListener(
      "click",
      event => {
        if (
          event.target ===
          sidebarCart
        ) {
          sidebarCart.classList.remove(
            "open"
          );
        }
      }
    );

    closeCartModal?.addEventListener(
      "click",
      () => sidebarCart.classList.remove("open")
    );

    const trocoModal = document.querySelector("#trocoModal");
    const closeTrocoModalBtn = document.querySelector("#closeTrocoModal");
    const semTrocoBtn = document.querySelector("#semTrocoBtn");
    const comTrocoBtn = document.querySelector("#comTrocoBtn");
    const trocoPergunta = document.querySelector("#trocoPergunta");
    const trocoValorArea = document.querySelector("#trocoValorArea");
    const trocoParaModal = document.querySelector("#trocoParaModal");
    const trocoMessage = document.querySelector("#trocoMessage");
    const trocoDescription = document.querySelector("#trocoDescription");
    const confirmarTrocoBtn = document.querySelector("#confirmarTrocoBtn");
    const voltarTrocoBtn = document.querySelector("#voltarTrocoBtn");

    const csrfTokenPublico = <%- safeJsonForHtml(csrfToken) %>;
    let pedidoIdempotencyKeyAtual = null;
    let pedidoPreparacaoEmAndamento = false;
    let pedidoEnvioEmAndamento = false;

    function criarIdempotencyKey() {
      if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
      return "10000000-1000-4000-8000-100000000000".replace(/[018]/g, caractere =>
        (Number(caractere) ^ (globalThis.crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (Number(caractere) / 4))))
          .toString(16));
    }

    let pedidoPendente = null;
    let pedidoPendenteValorDinheiroCentavos = 0;

    function abrirModalTroco(payload, valorDinheiroCentavos) {
      pedidoPendente = payload;
      pedidoPendenteValorDinheiroCentavos = Math.max(0, Number(valorDinheiroCentavos || 0));
      if (trocoDescription) {
        trocoDescription.textContent =
          `A parte em dinheiro é ${currency(pedidoPendenteValorDinheiroCentavos / 100)}. Informe se será necessário levar troco.`;
      }
      trocoPergunta.classList.remove("hidden");
      trocoValorArea.classList.add("hidden");
      trocoParaModal.value = "";
      trocoMessage.className = "form-message";
      trocoMessage.textContent = "";
      trocoModal.classList.add("open");
    }

    function fecharModalTroco() {
      trocoModal.classList.remove("open");
      pedidoPendente = null;
      pedidoPendenteValorDinheiroCentavos = 0;
      trocoParaModal.value = "";
      trocoMessage.textContent = "";
    }

    closeTrocoModalBtn.addEventListener("click", fecharModalTroco);

    trocoModal.addEventListener("click", event => {
      if (event.target === trocoModal) fecharModalTroco();
    });

    comTrocoBtn.addEventListener("click", () => {
      trocoPergunta.classList.add("hidden");
      trocoValorArea.classList.remove("hidden");
      setTimeout(() => trocoParaModal.focus(), 50);
    });

    voltarTrocoBtn.addEventListener("click", () => {
      trocoValorArea.classList.add("hidden");
      trocoPergunta.classList.remove("hidden");
      trocoParaModal.value = "";
      trocoMessage.textContent = "";
    });

    async function enviarPedido(payload) {
      if (pedidoEnvioEmAndamento) return;
      pedidoEnvioEmAndamento = true;

      formMessage.className = "form-message";
      formMessage.textContent = "";
      sendOrderBtn.disabled = true;
      sendOrderBtn.textContent = "Enviando pedido...";
      confirmarTrocoBtn.disabled = true;
      semTrocoBtn.disabled = true;
      comTrocoBtn.disabled = true;

      try {
        const response = await fetch(
          `/catalogo/${encodeURIComponent(storeSlug)}/pedidos`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfTokenPublico
            },
            body: JSON.stringify(payload)
          }
        );

        const result = await response.json();

        if (!response.ok) {
          // Erros de validação permitem uma nova tentativa com outro payload.
          // Em falhas 5xx/rede, a chave é preservada para repetir com segurança.
          if (response.status < 500) pedidoIdempotencyKeyAtual = null;
          if (result.code === "LOJA_INDISPONIVEL") {
            bloquearLojaPublica();
          }
          if (result.code === "PRODUTO_INDISPONIVEL") {
            const invalidos = new Set(
              (result.produtosInvalidos || []).map(String)
            );
            cart = cart.filter(item => !invalidos.has(String(item.id)));
            saveCart();
            renderCart();
          }
          if (result.code === "PRECO_ATUALIZADO") {
            const atualizados = new Map(
              (result.produtosAtualizados || []).map(produto => [
                String(produto.id),
                produto
              ])
            );
            cart = cart.map(item => {
              const produto = atualizados.get(String(item.id));
              return produto ? {
                ...item,
                name: produto.nome,
                price: Number(produto.preco || 0),
                image: produto.imagem || ""
              } : item;
            });
            saveCart();
            renderCart();
          }
          throw new Error(result.message || "Não foi possível enviar o pedido.");
        }

        fecharModalTroco();
        pedidoIdempotencyKeyAtual = null;

        if (payloadIncluiForma(payload, "pix")) {
          const pixResponse = await fetch(
            `/catalogo/${encodeURIComponent(storeSlug)}/pedido/pix`,
            {
              method: "POST",
              headers: {
                "Authorization": `Bearer ${result.acompanhamentoToken}`,
                "Content-Type": "application/json"
              }
            }
          );
          const pixResult = await pixResponse.json().catch(() => ({
            success: false,
            code: "PIX_INVALID_RESPONSE",
            message: "O servidor retornou uma resposta inválida ao gerar o Pix."
          }));
          if (!pixResponse.ok || !pixResult.success) {
            // O pedido já existe. Limpa o carrinho para impedir um segundo pedido
            // e apresenta um estado explícito, em vez de deixar o formulário preso.
            cart = [];
            saveCart();
            renderCart();
            orderForm.reset();
            atualizarEndereco();
            formMessage.className = "form-message error";
            formMessage.textContent =
              `Pedido #${result.numeroPedido} criado, mas o Pix não foi gerado. ` +
              (pixResult.message || "Entre em contato com a loja.");
            window.registrarPedidoAcompanhamento?.({
              codigoPublico: result.codigoPublico || result.numeroPedido,
              token: result.acompanhamentoToken,
              criadoEm: new Date().toISOString()
            });
            window.mostrarSucessoPedido?.(
              result.codigoPublico || result.numeroPedido,
              formMessage.textContent
            );
            return;
          }

          const qr = document.querySelector("#pixQrImage");
          const code = document.querySelector("#pixCopyCode");
          prepararVisualPixAtivo();
          if (pixResult.expiracaoPendente) {
            openPixPaymentModal();
            mostrarPixExpiracaoPendente();
            return;
          }
          if (pixResult.expirado) {
            openPixPaymentModal();
            mostrarPixExpirado();
            return;
          }
          qr.src = `data:image/png;base64,${pixResult.qrCodeBase64}`;
          code.value = pixResult.copiaCola || "";
          const valorPixTexto = currency(Number(pixResult.valorPix || 0));
          document.querySelector("#pixPaymentStatus").textContent = pixResult.pagamentoCombinado
            ? `Aguardando o Pix de ${valorPixTexto}. O restante será pago na entrega/retirada.`
            : `Aguardando o Pix de ${valorPixTexto}.`;
          document.querySelector("#copyPixButton").textContent = "Copiar código Pix";
          openPixPaymentModal();

          document.querySelector("#copyPixButton").onclick = async () => {
            await navigator.clipboard.writeText(code.value);
            document.querySelector("#copyPixButton").textContent = "Código copiado";
          };

          if (pixPollingTimer) clearTimeout(pixPollingTimer);
          pixPollingStartedAt = Date.now();
          pixPollingContext = {
            token: result.acompanhamentoToken,
            codigoPublico: result.codigoPublico || result.numeroPedido,
            expiraEm: pixResult.expiraEm || null
          };
          iniciarContagemPix(pixResult.expiraEm);
          schedulePixPolling(2_000);
        }

        formMessage.className = "form-message success";
        formMessage.textContent =
          `Pedido #${result.numeroPedido} enviado. Use “Meus pedidos” para acompanhar.`;
        window.registrarPedidoAcompanhamento?.({
          codigoPublico: result.codigoPublico || result.numeroPedido,
          token: result.acompanhamentoToken,
          criadoEm: new Date().toISOString()
        });
        // No Pix, o QR Code é a tela principal neste momento. A confirmação
        // final é mostrada somente depois que o pagamento for aprovado.
        if (!payloadIncluiForma(payload, "pix")) {
          window.mostrarSucessoPedido?.(
            result.codigoPublico || result.numeroPedido,
            result.emailAviso || ""
          );
        }

        cart = [];
        saveCart();
        renderCart();
        orderForm.reset();
        atualizarEndereco();

        if (!payloadIncluiForma(payload, "pix")) {
          setTimeout(() => closeModal(), 2500);
        }
      } catch (error) {
        formMessage.className = "form-message error";
        formMessage.textContent = error.message;

        if (trocoModal.classList.contains("open")) {
          trocoMessage.className = "form-message error";
          trocoMessage.textContent = error.message;
        }
      } finally {
        pedidoEnvioEmAndamento = false;
        sendOrderBtn.disabled = false;
        sendOrderBtn.textContent = "Enviar pedido";
        confirmarTrocoBtn.disabled = false;
        confirmarTrocoBtn.textContent = "Confirmar e enviar pedido";
        semTrocoBtn.disabled = false;
        comTrocoBtn.disabled = false;
      }
    }

    semTrocoBtn.addEventListener("click", async () => {
      if (!pedidoPendente) return;
      const payload = {
        ...pedidoPendente,
        precisaTroco: false,
        trocoPara: null
      };
      await enviarPedido(payload);
    });

    confirmarTrocoBtn.addEventListener("click", async () => {
      if (!pedidoPendente) return;

      const valorDigitado = String(trocoParaModal.value || "")
        .trim()
        .replace(/\s/g, "")
        .replace("R$", "")
        .replace(/\./g, "")
        .replace(",", ".");
      const trocoPara = Number(valorDigitado);

      if (!Number.isFinite(trocoPara) || trocoPara <= 0) {
        trocoMessage.className = "form-message error";
        trocoMessage.textContent = "Informe um valor válido. Exemplo: 50,00.";
        trocoParaModal.focus();
        return;
      }

      if (Math.round(trocoPara * 100) < pedidoPendenteValorDinheiroCentavos) {
        trocoMessage.className = "form-message error";
        trocoMessage.textContent =
          `O valor para troco deve ser igual ou maior que ${currency(pedidoPendenteValorDinheiroCentavos / 100)}.`;
        trocoParaModal.focus();
        return;
      }

      const payload = {
        ...pedidoPendente,
        precisaTroco: true,
        trocoPara
      };

      confirmarTrocoBtn.disabled = true;
      confirmarTrocoBtn.textContent = "Enviando pedido...";
      await enviarPedido(payload);
    });

    orderForm.addEventListener("submit", async event => {
      event.preventDefault();

      // O bloqueio precisa acontecer antes da primeira operação assíncrona.
      // Sem isso, vários cliques entram simultaneamente em sincronizarCarrinho()
      // e podem gerar chaves diferentes depois que a primeira requisição termina.
      if (pedidoPreparacaoEmAndamento || pedidoEnvioEmAndamento) return;
      if (!storeIsOpen || !cart.length) return;

      pedidoPreparacaoEmAndamento = true;
      sendOrderBtn.disabled = true;
      sendOrderBtn.textContent = "Preparando pedido...";

      try {
        try {
          const mudancas = await sincronizarCarrinho();
          if (
            mudancas.lojaIndisponivel
            || mudancas.idsRemovidos.length
            || mudancas.precoAlterado
          ) {
            return;
          }
        } catch (error) {
          avisarCarrinho(error.message);
          return;
        }

        atualizarResumoFinanceiroPedido();
        if (!validarRegraEntregaAntesDoEnvio()) return;

        const formData = new FormData(orderForm);
        const payload = {
          cliente: String(formData.get("cliente") || "").trim(),
          telefone: String(formData.get("telefone") || "").trim(),
          canal: String(formData.get("canal") || ""),
          cidadeEntregaId: String(formData.get("cidadeEntregaId") || "").trim(),
          ruaEntrega: String(formData.get("ruaEntrega") || "").trim(),
          numeroEntrega: String(formData.get("numeroEntrega") || "").trim(),
          bairroEntrega: String(formData.get("bairroEntrega") || "").trim(),
          referenciaEntrega: String(formData.get("referenciaEntrega") || "").trim(),
          observacao: String(formData.get("observacao") || "").trim(),
          formaPagamento: String(formData.get("formaPagamento") || "nao_informado"),
          formaPagamento1: String(formData.get("formaPagamento1") || ""),
          valorPagamento1: String(formData.get("valorPagamento1") || "").trim(),
          formaPagamento2: String(formData.get("formaPagamento2") || ""),
          valorPagamento2: String(formData.get("valorPagamento2") || "").trim(),
          precisaTroco: false,
          trocoPara: null,
          idempotencyKey: pedidoIdempotencyKeyAtual ||= criarIdempotencyKey(),
          itens: cart.map(item => ({
            produtoId: item.id,
            preco: Number(item.price),
            quantidade: Number(item.quantity),
            tamanhoPizzaId: String(item.tamanhoPizza?.id || ""),
            variacaoId: String(item.variacao?.id || ""),
            pizzaMeioAMeio: item.pizzaMeioAMeio === true,
            saboresPizza: item.pizzaMeioAMeio
              ? (item.saboresPizza || []).map(sabor => ({
                  produtoId: String(sabor.produtoId || ""),
                }))
              : [],
            adicionais: (item.adicionais || []).map(adicional => ({
              _id: adicional._id
            })),
            observacao: String(item.observacao || "")
          }))
        };

        if (payload.formaPagamento === "combinado") {
          atualizarPagamentoCombinado();
          if (!orderForm.reportValidity()) return;
        }

        const valorDinheiroCentavos = valorFormaPayloadCentavos(payload, "dinheiro");
        if (valorDinheiroCentavos > 0) {
          abrirModalTroco(payload, valorDinheiroCentavos);
          return;
        }

        await enviarPedido(payload);
      } finally {
        pedidoPreparacaoEmAndamento = false;
        if (!pedidoEnvioEmAndamento) {
          sendOrderBtn.disabled = false;
          sendOrderBtn.textContent = "Enviar pedido";
        }
      }
    });

    loadCart();
    renderCart();
    sincronizarCarrinho().catch(error => avisarCarrinho(error.message));
    filterProducts();
    atualizarEndereco();
    verificarLojaAberta();

    setInterval(
      verificarLojaAberta,
      60000
    );

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        sincronizarCarrinho().catch(error => avisarCarrinho(error.message));
      }
    });

    window.addEventListener("pageshow", () => {
      sincronizarCarrinho().catch(error => avisarCarrinho(error.message));
    });
  </script>

<style nonce="<%= cspNonce %>">
  #openMyOrders {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 50;
    padding: 14px 18px;
    border: 0;
    border-radius: 999px;
    background: #5a1e14;
    color: #fff;
    font-weight: 800;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .24);
  }

  #myOrdersDialog {
    width: min(720px, 94vw);
    max-height: min(86vh, 760px);
    border: 0;
    border-radius: 20px;
    padding: 0;
    overflow: hidden;
    background: #fff;
    color: #241915;
  }

  #myOrdersDialog::backdrop {
    background: rgba(20, 10, 6, .72);
    backdrop-filter: blur(5px);
  }

  .my-orders-shell { display: flex; flex-direction: column; max-height: min(86vh, 760px); }
  .my-orders-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px 20px; border-bottom:1px solid #eadfd9; }
  .my-orders-header h2 { margin:0; font-size:1.45rem; }
  .my-orders-close { width:40px; height:40px; border:0; border-radius:50%; font-size:1.2rem; cursor:pointer; }
  .my-orders-body { padding:18px 20px 22px; overflow:auto; }
  .my-orders-form { display:grid; grid-template-columns:1fr auto; gap:10px; }
  .my-orders-form input { min-width:0; width:100%; padding:13px 14px; border:1px solid #d9cdc7; border-radius:12px; font-size:16px; }
  .my-orders-form button { border:0; border-radius:12px; padding:0 18px; background:#ee6b18; color:#fff; font-weight:800; cursor:pointer; }
  .my-orders-result { margin-top:16px; display:grid; gap:12px; }
  .customer-order-card { border:1px solid #eadfd9; border-radius:16px; padding:15px; background:#fffaf7; box-shadow:0 5px 18px rgba(60,25,10,.07); overflow:hidden; }
  .customer-order-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:10px; }
  .customer-order-number { font-size:1.05rem; font-weight:900; }
  .customer-order-date { font-size:.78rem; color:#7d6b63; margin-top:2px; }
  .customer-order-badges { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:6px; }
  .customer-order-badge { padding:5px 8px; border-radius:999px; font-size:.72rem; font-weight:800; background:#efe7e2; }
  .customer-order-badge.pending { background:#fff0bf; color:#785300; }
  .customer-order-badge.paid { background:#dff6e6; color:#126330; }
  .customer-order-badge.expired { background:#fde2e2; color:#a32121; }
  .customer-order-items { margin:10px 0; border-top:1px dashed #d9c9c0; border-bottom:1px dashed #d9c9c0; padding:8px 0; }
  .customer-order-item { display:grid; grid-template-columns:auto 1fr auto; gap:8px; padding:5px 0; align-items:start; }
  .customer-order-item strong { overflow-wrap:anywhere; }
  .customer-order-item small { display:block; color:#74645d; margin-top:2px; }
  .customer-order-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:10px; }
  .customer-order-total { font-size:1.08rem; font-weight:900; color:#11833a; }
  .finish-pix-button { border:0; border-radius:11px; padding:11px 14px; background:#1769e0; color:white; font-weight:800; cursor:pointer; }
  .finish-pix-button:disabled { opacity:.6; cursor:wait; }
  .orders-empty, .orders-loading, .orders-error { padding:18px; text-align:center; border-radius:13px; background:#f7f1ed; }
  .orders-error { background:#ffe2e2; color:#a11d1d; }

  @media (max-width: 560px) {
    #openMyOrders { right:12px; bottom:12px; padding:12px 15px; }
    #myOrdersDialog { width:calc(100vw - 20px); max-height:calc(100dvh - 20px); border-radius:16px; }
    .my-orders-shell { max-height:calc(100dvh - 20px); }
    .my-orders-header { padding:14px 15px; }
    .my-orders-body { padding:14px 12px 18px; }
    .my-orders-form { grid-template-columns:1fr; }
    .my-orders-form button { min-height:46px; }
    .customer-order-head, .customer-order-footer { align-items:stretch; flex-direction:column; }
    .customer-order-badges { justify-content:flex-start; }
    .finish-pix-button { width:100%; min-height:46px; }
    .customer-order-item { grid-template-columns:auto minmax(0, 1fr); }
    .customer-order-item-price { grid-column:2; }
  }

  #orderSuccessDialog, #ratingDialog {
    width:min(520px, calc(100vw - 24px)); border:0; border-radius:24px; padding:0;
    overflow:hidden; background:#fff; color:#241915; box-shadow:0 28px 80px rgba(40,18,8,.32);
  }
  #orderSuccessDialog::backdrop, #ratingDialog::backdrop { background:rgba(30,12,6,.68); backdrop-filter:blur(6px); }
  .success-card, .rating-card { padding:28px; text-align:center; }
  .success-icon, .rating-icon { width:68px; height:68px; margin:0 auto 14px; border-radius:22px; display:grid; place-items:center; font-size:32px; background:linear-gradient(135deg,#fff0df,#ffd0a7); }
  .success-card h2, .rating-card h2 { margin:0; font-size:clamp(1.45rem,4vw,1.9rem); }
  .success-card p, .rating-card p { color:#74645d; line-height:1.5; }
  .success-code { display:inline-flex; margin:8px 0 4px; padding:12px 18px; border-radius:14px; background:#fff4eb; color:#b8420d; font-size:1.35rem; letter-spacing:1px; }
  .success-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:20px; }
  .success-actions button, .rating-actions button { min-height:48px; border:0; border-radius:14px; font-weight:900; cursor:pointer; }
  .success-actions .primary, .rating-actions .primary { background:linear-gradient(135deg,#f4511e,#f57c00); color:#fff; }
  .success-actions .secondary, .rating-actions .secondary { background:#f4ece7; color:#4a2b20; }
  .success-actions .full { grid-column:1/-1; }
  .rating-stars { display:flex; justify-content:center; gap:8px; margin:18px 0; }
  .rating-star-button { width:48px; height:48px; border:0; border-radius:14px; background:#f5eee9; color:#c8b5aa; font-size:28px; cursor:pointer; transition:.18s ease; }
  .rating-star-button.active { background:#fff0d4; color:#f59e0b; transform:translateY(-2px); }
  .rating-product { font-weight:900; margin-top:6px; }
  #ratingComment { width:100%; min-height:100px; resize:vertical; border:1px solid #decfc7; border-radius:14px; padding:13px; font:inherit; }
  .rating-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px; }
  @media(max-width:560px){ .success-card,.rating-card{padding:22px 16px}.success-actions,.rating-actions{grid-template-columns:1fr}.success-actions .full{grid-column:auto}.rating-star-button{width:44px;height:44px} }



  /* COMANDAFACIL: MEU PEDIDO EM MODAL + BOTOES FIXOS */
  .content-shell {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .sidebar {
    position: fixed !important;
    inset: 0 !important;
    z-index: 120 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 18px !important;
    background: rgba(20, 10, 6, .72) !important;
    backdrop-filter: blur(5px);
  }

  .sidebar.open {
    display: flex !important;
  }

  .sidebar-panel {
    width: min(520px, 100%) !important;
    max-height: min(88dvh, 760px) !important;
    overflow: auto !important;
    border-radius: 24px !important;
  }

  .cart-card {
    border-radius: 24px !important;
  }

  .cart-head-actions {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .cart-modal-close {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.10);
    color: #fff;
    font-size: 17px;
    cursor: pointer;
  }

  /*
   * Os dois atalhos usam o mesmo contêiner.
   * Isso evita posições separadas que se desalinhavam em outros tamanhos de tela.
   */
  .public-order-actions {
    position: fixed;
    right: calc(18px + env(safe-area-inset-right, 0px));
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 95;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    gap: 10px;
    pointer-events: none;
  }

  .public-order-actions > button {
    position: static !important;
    inset: auto !important;
    transform: none !important;
    margin: 0 !important;
    min-height: 48px !important;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px !important;
    border: 0;
    border-radius: 999px !important;
    color: #fff;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(0,0,0,.24) !important;
    pointer-events: auto;
  }

  .public-order-actions > .mobile-cart-toggle {
    background: linear-gradient(135deg, var(--orange), var(--orange-2)) !important;
  }

  .public-order-actions > #openMyOrders {
    background: #5a1e14 !important;
  }

  .public-order-actions > #mobileCartToggle[hidden] {
    display: none !important;
  }

  @media (max-width: 600px) {
    .sidebar {
      align-items: flex-end !important;
      padding: 10px !important;
    }

    .sidebar-panel {
      width: 100% !important;
      max-height: calc(100dvh - 20px) !important;
      border-radius: 20px !important;
    }

    /*
     * Reserva o lado esquerdo para o WhatsApp.
     * Os dois botões dividem igualmente o espaço restante.
     */
    .public-order-actions {
      left: calc(76px + env(safe-area-inset-left, 0px));
      right: calc(12px + env(safe-area-inset-right, 0px));
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      gap: 8px;
    }

    .public-order-actions > button {
      flex: 1 1 0;
      min-width: 0;
      min-height: 46px !important;
      padding: 0 10px !important;
      font-size: 12.5px !important;
    }

    .public-order-actions .mobile-cart-count {
      flex: 0 0 auto;
    }
  }

  /*
   * Em telas muito estreitas, sobe os atalhos acima do WhatsApp
   * para evitar qualquer sobreposição.
   */
  @media (max-width: 360px) {
    .public-order-actions {
      left: calc(12px + env(safe-area-inset-left, 0px));
      bottom: calc(76px + env(safe-area-inset-bottom, 0px));
    }

    .public-order-actions > button {
      font-size: 12px !important;
      padding: 0 8px !important;
    }
  }


</style>

<dialog id="myOrdersDialog">
  <div class="my-orders-shell">
    <header class="my-orders-header">
      <h2>Consultar meus pedidos</h2>
      <button type="button" id="closeMyOrders" class="my-orders-close" aria-label="Fechar">✕</button>
    </header>
    <div class="my-orders-body">
      <p style="margin-top:0;color:#74645d">Informe o telefone usado na compra e os últimos quatro caracteres do número do pedido.</p>
      <form id="orderLookupForm" class="my-orders-form">
        <label>Telefone usado no pedido<input id="orderLookupPhone" required inputmode="tel" autocomplete="tel"></label>
        <label>Últimos 4 caracteres do pedido<input id="orderLookupSuffix" required maxlength="4" pattern="[A-Fa-f0-9]{4}" autocomplete="off"></label>
        <label id="orderLookupFullLabel" hidden>Número completo do pedido<input id="orderLookupFull" maxlength="8" pattern="[A-Fa-f0-9]{8}" autocomplete="off"></label>
        <button type="button" id="orderLookupButton">Consultar pedido</button>
      </form>
      <div id="myOrdersResult" class="my-orders-result"></div>
    </div>
  </div>


</dialog>

<dialog id="orderLookupLoading" aria-labelledby="orderLookupLoadingTitle">
  <div class="my-orders-shell" aria-busy="true">
    <h2 id="orderLookupLoadingTitle">Consultando pedido...</h2>
    <p>Aguarde enquanto localizamos as informações.</p>
  </div>
</dialog>

<dialog id="orderSuccessDialog" aria-labelledby="orderSuccessTitle">
  <div class="success-card">
    <div class="success-icon">✓</div>
    <h2 id="orderSuccessTitle">Pedido realizado!</h2>
    <p>Seu pedido foi enviado para o estabelecimento.</p>
    <strong class="success-code" id="orderSuccessCode"></strong>
    <p>Guarde este número para acompanhar o andamento.</p>
    <p id="orderSuccessWarning" hidden></p>
    <div class="success-actions">
      <button type="button" class="primary" id="copyOrderCode">Copiar número</button>
      <button type="button" class="secondary" id="trackCreatedOrder">Acompanhar pedido</button>
      <button type="button" class="secondary full" id="closeOrderSuccess">Fechar</button>
    </div>
  </div>
</dialog>

<dialog id="ratingDialog" aria-labelledby="ratingTitle">
  <div class="rating-card">
    <div class="rating-icon">★</div>
    <h2 id="ratingTitle">Como foi seu pedido?</h2>
    <p>Avalie o produto depois que o pedido for entregue.</p>
    <div class="rating-product" id="ratingProductName"></div>
    <div class="rating-stars" role="radiogroup" aria-label="Nota de 1 a 5">
      <% for (let star = 1; star <= 5; star += 1) { %>
        <button type="button" class="rating-star-button" data-rating-star="<%= star %>" aria-label="<%= star %> estrela<%= star === 1 ? '' : 's' %>">★</button>
      <% } %>
    </div>
    <textarea id="ratingComment" maxlength="500" placeholder="Conte como foi sua experiência (opcional)"></textarea>
    <div class="rating-actions">
      <button type="button" class="secondary" id="skipRating">Agora não</button>
      <button type="button" class="primary" id="sendCatalogRating" disabled>Enviar avaliação</button>
    </div>
  </div>
</dialog>

<script nonce="<%= cspNonce %>">
(() => {
  const slug = <%- safeJsonForHtml(configuracao.slug) %>;
  const establishmentTimezone = <%- safeJsonForHtml(configuracao.timezone || 'America/Sao_Paulo') %>;
  const formatOrderDate = value => new Intl.DateTimeFormat('pt-BR', {
    timeZone: establishmentTimezone, day: '2-digit', month: '2-digit', year: 'numeric',
    hour: '2-digit', minute: '2-digit', hour12: false
  }).format(new Date(value));
  const dialog = document.querySelector('#myOrdersDialog');
  const resultBox = document.querySelector('#myOrdersResult');
  const tokensDosPedidos = new Map();
  const money = value => `R$ ${Number(value || 0).toFixed(2).replace('.', ',')}`;
  const escapeHtml = value => String(value ?? '')
    .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

  const statusText = status => ({
    novo: 'Novo', preparo: 'Em preparo', em_preparo: 'Em preparo', pronto: 'Pronto',
    entregue: 'Entregue', finalizado: 'Finalizado', cancelado: 'Cancelado'
  }[status] || status || 'Não informado');

  const paymentText = status => ({ pendente: 'Pendente', pago: 'Pago', cancelado: 'Cancelado', expiracao_pendente: 'Expiração pendente', expirado: 'Pagamento expirado' }[status] || status || 'Pendente');

  window.registrarPedidoAcompanhamento = () => {
    document.querySelector('#openMyOrders').textContent = '📦 Consultar meus pedidos';
  };

  function mostrarMensagemPedidos(className, mensagem) {
    const box = document.createElement('div');
    box.className = className;
    box.textContent = String(mensagem || '');
    resultBox.replaceChildren(box);
  }

  const ratingDialog = document.querySelector('#ratingDialog');
  const ratingProductName = document.querySelector('#ratingProductName');
  const ratingComment = document.querySelector('#ratingComment');
  const sendCatalogRating = document.querySelector('#sendCatalogRating');
  let ratingContext = null;
  let ratingValue = 0;

  function selectRating(value) {
    ratingValue = Number(value || 0);
    document.querySelectorAll('[data-rating-star]').forEach(button => {
      button.classList.toggle('active', Number(button.dataset.ratingStar) <= ratingValue);
      button.setAttribute('aria-checked', String(Number(button.dataset.ratingStar) === ratingValue));
    });
    sendCatalogRating.disabled = ratingValue < 1;
  }

  function openRatingModal(context) {
    if (!context?.produtoId || !context?.codigoPublico) return;
    ratingContext = context;
    ratingProductName.textContent = context.nome || 'Produto';
    ratingComment.value = '';
    selectRating(0);
    if (!ratingDialog.open) ratingDialog.showModal();
  }

  document.querySelectorAll('[data-rating-star]').forEach(button => {
    button.addEventListener('click', () => selectRating(button.dataset.ratingStar));
  });
  document.querySelector('#skipRating').addEventListener('click', () => ratingDialog.close());
  ratingDialog.addEventListener('click', event => { if (event.target === ratingDialog) ratingDialog.close(); });
  sendCatalogRating.addEventListener('click', async () => {
    if (!ratingContext || ratingValue < 1) return;
    sendCatalogRating.disabled = true;
    sendCatalogRating.textContent = 'Enviando...';
    try {
      const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/pedido/avaliacao`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          codigoPublico: ratingContext.codigoPublico,
          produtoId: ratingContext.produtoId,
          nota: ratingValue,
          comentario: ratingComment.value
        })
      });
      const data = await parseJsonSafe(response);
      if (!response.ok) throw new Error(data.message || 'Não foi possível salvar a avaliação.');
      ratingDialog.close();
      const target = document.querySelector(`[data-rate-product][data-order-code="${CSS.escape(ratingContext.codigoPublico)}"][data-product-id="${CSS.escape(ratingContext.produtoId)}"]`);
      if (target) { target.textContent = 'Avaliado'; target.disabled = true; }
    } catch (error) {
      alert(error.message);
    } finally {
      sendCatalogRating.textContent = 'Enviar avaliação';
      sendCatalogRating.disabled = ratingValue < 1;
    }
  });

  function renderOrders(orders) {
    tokensDosPedidos.clear();
    if (!orders.length) {
      mostrarMensagemPedidos(
        'orders-empty',
        'Nenhum pedido acompanhado neste navegador.'
      );
      return;
    }

    const cards = orders.map(order => {
      tokensDosPedidos.set(
        String(order.codigoPublico),
        null
      );
      const card = document.createElement('article');
      card.className = 'customer-order-card';
      card.dataset.publicOrderCode = String(order.codigoPublico || '');
      card.innerHTML = '<div class="customer-order-head"><div><div class="customer-order-number"></div><div class="customer-order-date"></div></div><div class="customer-order-badges"><span class="customer-order-badge order-status"></span><span class="customer-order-badge payment-status"></span></div></div><div class="customer-order-delivery"><strong>Entrega: </strong><span></span></div><div class="customer-order-message"></div><div class="customer-order-items"></div><div class="customer-order-footer"><div class="customer-order-total"></div></div>';
      const numeroExibicao = String(order.numeroPedido || order.codigoPublico || '');
      card.querySelector('.customer-order-number').textContent =
        `Pedido #${numeroExibicao}`;
      card.querySelector('.customer-order-date').textContent =
        order.numeroPedido && order.codigoPublico
          ? `Código: ${String(order.codigoPublico)} · ${formatOrderDate(order.data)}`
          : formatOrderDate(order.data);
      card.querySelector('.order-status').textContent =
        statusText(order.status);
      const payment = card.querySelector('.payment-status');
      payment.classList.add(
        order.pagamentoStatus === 'pago'
          ? 'paid'
          : order.pagamentoStatus === 'expirado'
            ? 'expired'
            : 'pending'
      );
      payment.textContent =
        `Pagamento: ${paymentText(order.pagamentoStatus)}`;
      card.querySelector('.customer-order-delivery span').textContent =
        String(order.formaEntrega || 'Não informada');
      card.querySelector('.customer-order-message').textContent =
        String(order.mensagem || '');
      card.querySelector('.customer-order-total').textContent =
        `Total: ${money(order.total)}`;
      const itemsBox = card.querySelector('.customer-order-items');
      if (!(order.itens || []).length) {
        const empty = document.createElement('div');
        empty.textContent = 'Itens não informados.';
        itemsBox.appendChild(empty);
      }
      (order.itens || []).forEach(item => {
        const itemRow = document.createElement('div');
        itemRow.className = 'customer-order-item';
        const quantity = document.createElement('span');
        quantity.textContent = `${Number(item.quantidade || 1)}x`;
        const nameBox = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = String(item.nome || 'Item');
        nameBox.appendChild(name);
        itemRow.append(quantity, nameBox);
        if (order.podeAvaliar && item.produtoId) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'finish-pix-button';
          button.dataset.rateProduct = '';
          button.dataset.orderCode = String(order.codigoPublico || '');
          button.dataset.productId = String(item.produtoId);
          button.textContent = item.avaliado ? 'Avaliado' : 'Avaliar';
          button.disabled = Boolean(item.avaliado);
          itemRow.appendChild(button);
        }
        itemsBox.appendChild(itemRow);
      });
      return card;
    });
    resultBox.replaceChildren(...cards);
    const primeiro = orders.flatMap(order => (order.itens || []).map(item => ({ order, item })))
      .find(entry => entry.order.podeAvaliar && entry.item.produtoId && !entry.item.avaliado);
    if (primeiro) {
      setTimeout(() => openRatingModal({
        codigoPublico: primeiro.order.codigoPublico,
        produtoId: primeiro.item.produtoId,
        nome: primeiro.item.nome
      }), 350);
    }
  }

  document.querySelector('#openMyOrders').onclick = async () => {
    dialog.showModal();
  };
  document.querySelector('#closeMyOrders').onclick = () => { resultBox.replaceChildren(); dialog.close(); };
  dialog.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });
  const lookupButton = document.querySelector('#orderLookupButton');
  const lookupPhone = document.querySelector('#orderLookupPhone');
  const lookupSuffix = document.querySelector('#orderLookupSuffix');
  const lookupFull = document.querySelector('#orderLookupFull');
  const lookupFullLabel = document.querySelector('#orderLookupFullLabel');
  const loadingDialog = document.querySelector('#orderLookupLoading');
  let consultaEmAndamento = false;

  async function parseJsonSafe(response) {
    try { return await response.json(); } catch (_) {
      return { ok: false, message: 'A resposta do servidor não pôde ser lida.' };
    }
  }

  lookupButton.addEventListener('click', async () => {
    if (consultaEmAndamento) return;
    const telefone = lookupPhone.value.replace(/\D/g, '').slice(-11);
    const codigoFinal = lookupSuffix.value.trim().toUpperCase();
    const codigoCompleto = lookupFullLabel.hidden
      ? ''
      : lookupFull.value.trim().toUpperCase();
    if (telefone.length < 10 || !/^[A-F0-9]{4}$/.test(codigoFinal)
      || (!lookupFullLabel.hidden && !/^[A-F0-9]{8}$/.test(codigoCompleto))) {
      mostrarMensagemPedidos('orders-error', 'Informe um telefone válido e o código solicitado.');
      return;
    }
    consultaEmAndamento = true;
    lookupButton.disabled = true;
    lookupButton.textContent = 'Consultando...';
    loadingDialog.showModal();
    try {
      const response = await fetch(`/catalogo/${encodeURIComponent(slug)}/pedidos/consultar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ telefone, codigoFinal, ...(codigoCompleto ? { codigoCompleto } : {}) })
      });
      const data = await parseJsonSafe(response);
      if (!response.ok || !data.ok) {
        if (data.code === 'ORDER_LOOKUP_FULL_CODE_REQUIRED') {
          lookupFullLabel.hidden = false;
          lookupFull.focus();
        }
        mostrarMensagemPedidos('orders-error', data.message || 'Não foi possível localizar o pedido com os dados informados.');
        return;
      }
      renderOrders([data.pedido]);
    } catch (_) {
      mostrarMensagemPedidos('orders-error', 'Não foi possível consultar o pedido agora.');
    } finally {
      if (loadingDialog.open) loadingDialog.close();
      document.body.style.overflow = '';
      document.body.removeAttribute('aria-busy');
      consultaEmAndamento = false;
      lookupButton.disabled = false;
      lookupButton.textContent = 'Consultar pedido';
      lookupButton.focus();
    }
  });

  const successDialog = document.querySelector('#orderSuccessDialog');
  let ultimoCodigoPublico = '';
  window.mostrarSucessoPedido = (codigo, aviso) => {
    ultimoCodigoPublico = String(codigo || '').toUpperCase();
    document.querySelector('#orderSuccessCode').textContent = `#${ultimoCodigoPublico}`;
    const warning = document.querySelector('#orderSuccessWarning');
    warning.textContent = String(aviso || '');
    warning.hidden = !aviso;
    successDialog.showModal();
  };
  document.querySelector('#copyOrderCode').addEventListener('click', async event => {
    try {
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(ultimoCodigoPublico);
      else {
        const area = document.createElement('textarea');
        area.value = ultimoCodigoPublico; area.readOnly = true; area.style.position = 'fixed'; area.style.opacity = '0';
        document.body.appendChild(area); area.select(); document.execCommand('copy'); area.remove();
      }
      event.currentTarget.textContent = 'Número copiado';
    } catch (_) { event.currentTarget.textContent = 'Não foi possível copiar'; }
  });
  document.querySelector('#trackCreatedOrder').addEventListener('click', () => {
    successDialog.close(); dialog.showModal(); lookupSuffix.value = ultimoCodigoPublico.slice(-4); lookupPhone.focus();
  });
  document.querySelector('#closeOrderSuccess').addEventListener('click', () => successDialog.close());
  resultBox.addEventListener('click', event => {
    const button = event.target.closest('[data-rate-product]');
    if (!button || button.disabled) return;
    openRatingModal({
      codigoPublico: button.dataset.orderCode,
      produtoId: button.dataset.productId,
      nome: button.closest('.customer-order-item')?.querySelector('strong')?.textContent || 'Produto'
    });
  });

})();
</script>
</body>
</html>
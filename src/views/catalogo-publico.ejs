        class="mobile-cart-count"
        id="mobileCartCount"
      >
        0
      </span>
    </button>

    <button type="button" id="openMyOrders">
      📦 Meus pedidos
    </button>
  </div>

  <div
    class="order-modal"
    id="orderModal"
  >
    <div class="order-modal-card">
      <div class="modal-head">
        <div>
          <h2>Finalizar pedido</h2>

          <p>
            O pedido será enviado para a aba Pedidos do estabelecimento.
          </p>
        </div>

        <button
          type="button"
          class="modal-close"
          id="closeOrderModal"
          aria-label="Fechar"
        >
          ×
        </button>
      </div>

      <form
        class="order-form"
        id="orderForm"
      >
        <div class="form-field">
          <label for="clienteNome">
            Nome
          </label>

          <input
            id="clienteNome"
            name="cliente"
            maxlength="120"
            required
          >
        </div>

        <div class="form-field">
          <label for="clienteTelefone">
            WhatsApp
          </label>

          <input
            id="clienteTelefone"
            name="telefone"
            inputmode="tel"
            maxlength="30"
            placeholder="(99) 99999-9999"
            required
          >
        </div>

        <div class="form-field full">
          <label for="canalPedido">
            Tipo do pedido
          </label>

          <select
            id="canalPedido"
            name="canal"
            required
          >
            <option value="delivery">
              Delivery
            </option>

            <option value="retirada">
              Retirada no local
            </option>
          </select>
        </div>

        <div class="form-field full delivery-address-field" id="cidadeEntregaField">
          <label for="cidadeEntregaId">Cidade atendida</label>
          <select
            id="cidadeEntregaId"
            name="cidadeEntregaId"
            required
          >
            <option value="">Selecione a cidade</option>
            <% for (const cidade of (cidadesEntrega || [])) { %>
              <option
                value="<%= cidade.id %>"
                data-cidade-nome="<%= cidade.nome %> - <%= cidade.uf %>"
                data-taxa-centavos="<%= cidade.taxaCentavos %>"
                data-pedido-minimo-centavos="<%= cidade.pedidoMinimoCentavos || 0 %>"
                data-abaixo-minimo-modo="<%= cidade.abaixoMinimoModo || 'bloquear' %>"
                data-taxa-abaixo-minimo-centavos="<%= cidade.taxaAbaixoMinimoCentavos || 0 %>"
              >
                <%= cidade.nome %> - <%= cidade.uf %> — <%= (Number(cidade.taxaCentavos || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
              </option>
            <% } %>
          </select>
          <% if (!(cidadesEntrega || []).length) { %>
            <small>Esta loja ainda não cadastrou cidades para entrega.</small>
          <% } %>
        </div>

        <div
          id="deliveryMinimumNotice"
          class="delivery-rule-notice delivery-address-field hidden"
          aria-live="polite"
        ></div>

        <div class="form-field full delivery-address-field" id="enderecoField">
          <label for="ruaEntrega">Rua</label>
          <input id="ruaEntrega" name="ruaEntrega" maxlength="180" placeholder="Nome da rua" required>
        </div>

        <div class="form-field delivery-address-field">
          <label for="numeroEntrega">Número</label>
          <input id="numeroEntrega" name="numeroEntrega" maxlength="40" placeholder="Ex.: 03" required>
        </div>

        <div class="form-field delivery-address-field">
          <label for="bairroEntrega">Bairro</label>
          <input id="bairroEntrega" name="bairroEntrega" maxlength="120" placeholder="Nome do bairro" required>
        </div>

        <div class="form-field full delivery-address-field">
          <label for="referenciaEntrega">Ponto de referência</label>
          <input id="referenciaEntrega" name="referenciaEntrega" maxlength="240" placeholder="Ex.: próximo à praça">
        </div>

        <div class="form-field full">
          <label for="formaPagamento">Forma de pagamento</label>
          <select id="formaPagamento" name="formaPagamento" required>
            <option value="pix" <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : 'disabled' %>>Pix online <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : '(indisponível)' %></option>
            <option value="dinheiro">Dinheiro na entrega/retirada</option>
            <option value="cartao">Cartão na entrega/retirada</option>
            <option value="combinado">Combinar 2 pagamentos</option>
          </select>
        </div>

        <div class="combined-payment-panel hidden" id="combinedPaymentPanel">
          <div class="combined-payment-grid">
            <div class="form-field">
              <label for="formaPagamento1">Primeiro pagamento</label>
              <select id="formaPagamento1" name="formaPagamento1">
                <option value="pix" <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : 'disabled' %>>Pix online <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : '(indisponível)' %></option>
                <option value="dinheiro">Dinheiro</option>
                <option value="cartao">Cartão</option>
              </select>
            </div>

            <div class="form-field">
              <label for="valorPagamento1">Valor do primeiro pagamento</label>
              <input
                id="valorPagamento1"
                name="valorPagamento1"
                inputmode="decimal"
                autocomplete="off"
                placeholder="Ex.: 50,00"
              >
            </div>

            <div class="form-field">
              <label for="formaPagamento2">Segundo pagamento</label>
              <select id="formaPagamento2" name="formaPagamento2">
                <option value="cartao">Cartão</option>
                <option value="dinheiro">Dinheiro</option>
                <option value="pix" <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : 'disabled' %>>Pix online <%= configuracao.mercadoPago && configuracao.mercadoPago.conectado ? '' : '(indisponível)' %></option>
              </select>
            </div>

            <div class="form-field">
              <label for="valorPagamento2">Valor restante</label>
              <input
                id="valorPagamento2"
                name="valorPagamento2"
                class="calculated-payment-value"
                readonly
                aria-readonly="true"
                value="R$ 0,00"
              >
            </div>

            <p class="combined-payment-note" id="combinedPaymentNote">
              Informe somente o primeiro valor. O restante será calculado automaticamente usando o total atual do pedido.
            </p>
          </div>
        </div>

        <div class="form-field full">
          <label for="observacaoFinal">
            Observações do pedido
          </label>

          <textarea
            id="observacaoFinal"
            name="observacao"
            maxlength="500"
            placeholder="Alguma observação adicional?"
          ></textarea>
        </div>

        <div class="checkout-summary" aria-live="polite">
          <div class="checkout-summary-row">
            <span>Subtotal dos produtos</span>
            <strong id="orderSubtotal">R$ 0,00</strong>
          </div>
          <div class="checkout-summary-row" id="orderDeliveryFeeRow">
            <span>Taxa de entrega</span>
            <strong id="orderDeliveryFee">Selecione a cidade</strong>
          </div>
          <div class="checkout-summary-row total">
            <span>Total do pedido</span>
            <strong id="orderTotal">R$ 0,00</strong>
          </div>
        </div>

        <div
          id="formMessage"
          class="form-message"
        ></div>

        <button
          type="submit"
          class="send-order-btn"
          id="sendOrderBtn"
        >
          Enviar pedido
        </button>
      </form>
    </div>
  </div>

  <div class="order-modal" id="pixPaymentModal">
    <div class="order-modal-card" style="max-width:520px">
      <div class="modal-head">
        <div>
          <h2>Pagamento Pix</h2>

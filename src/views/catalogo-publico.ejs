    document.querySelector("#confirmPizza").addEventListener("click", () => {
      if (!pendingPizza) return;
      const tamanho = tamanhoPizzaSelecionado();
      const tamanhoId = tamanho?.id || "";
      const tamanhoNome = tamanho?.nome || "";
      if (pendingPizza.tamanhos.length && !tamanho) {
        pizzaTamanho.setCustomValidity("Escolha o tamanho da pizza.");
        pizzaTamanho.reportValidity();
        return;
      }
      pizzaTamanho.setCustomValidity("");

      const quantidadeSabores = quantidadeSaboresModoPizza();
      const maxSabores = maxSaboresTamanhoSelecionado();
      if (quantidadeSabores > maxSabores) {
        atualizarModalPizza();
        return;
      }
      const sabores = [
        produtosCatalogoMap.get(String(pizzaSabor1.value || "")),
        produtosCatalogoMap.get(String(pizzaSabor2.value || "")),
        produtosCatalogoMap.get(String(pizzaSabor3.value || "")),
      ].slice(0, quantidadeSabores);
      if (sabores.some(sabor => !sabor)) return;
      const idsSabores = sabores.map(sabor => String(sabor.id || ""));
      if (new Set(idsSabores).size !== idsSabores.length) {
        const campo = quantidadeSabores === 3 ? pizzaSabor3 : pizzaSabor2;
        campo.setCustomValidity("Escolha sabores diferentes.");
        campo.reportValidity();
        return;
      }
      pizzaSabor2.setCustomValidity("");
      pizzaSabor3.setCustomValidity("");

      const preco = calcularPrecoPizzaCliente({
        sabores,
        regra: pendingPizza.regra,
        tamanhoId,
        tamanhoNome,
      });
      if (!Number.isFinite(preco)) return;

      if (quantidadeSabores === 1) {
        const sabor1 = sabores[0];
        const pizzaInteira = {
          ...sabor1,
          price: preco,
          tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
        };
        fecharModalPizza();
        continuarProdutoParaCarrinho(pizzaInteira, sabor1.adicionais || []);
        return;
      }

      const fracao = 1 / quantidadeSabores;
      const rotuloFracao = quantidadeSabores === 3 ? "1/3" : "1/2";
      const sabor1 = sabores[0];
      const pizza = {
        id: sabor1.id,
        name: `Pizza ${sabores.map(sabor => `${rotuloFracao} ${sabor.name}`).join(" + ")}`,
        price: preco,
        image: sabores.find(sabor => sabor.image)?.image || "",
        categoria: sabor1.categoria,
        tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
        pizzaMeioAMeio: true,
        saboresPizza: sabores.map(sabor => ({
          produtoId: sabor.id,
          nome: sabor.name,
          preco: precoProdutoNoTamanho(sabor, tamanhoId, tamanhoNome),
          fracao,
        })),
        regraPrecoPizza: pendingPizza.regra,
      };

      fecharModalPizza();
      continuarProdutoParaCarrinho(pizza, sabor1.adicionais || []);
    });


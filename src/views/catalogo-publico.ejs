  <div class="addon-modal" id="addonModal">
    <div class="addon-card">
      <div class="addon-head">
        <div><h2 id="addonTitle">Escolha os adicionais</h2><p>Os valores serão somados ao produto.</p></div>
        <button type="button" class="modal-close" id="closeAddonModal">×</button>
      </div>
      <div class="addon-list" id="addonList"></div>
      <div class="addon-actions">
        <button type="button" class="addon-cancel" id="cancelAddon">Cancelar</button>
        <button type="button" class="addon-confirm" id="confirmAddon">Adicionar ao pedido</button>
      </div>

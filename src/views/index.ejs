<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>Login e cadastro | ComandaFacíl</title>
  <link rel="icon" href="/assets/imgs/comanda.png" type="image/png">

  <style nonce="<%= cspNonce %>">
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --orange: #ff5a00;
      --orange-2: #ff7a00;
      --orange-soft: #fff4eb;
      --ink: #171d26;
      --muted: #656a70;
      --line: #ece7e2;
      --cream: #fdfbf8;
      --white: #fff;
      --success: #177544;
      --success-bg: #e8f7ed;
      --error: #b42323;
      --error-bg: #fdeaea;
    }

    html { min-height: 100%; }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at 3% 8%, rgba(255, 141, 64, .05), transparent 24%),
        radial-gradient(circle at 97% 84%, rgba(255, 122, 0, .06), transparent 27%),
        #fcfbfa;
    }

    button, input { font: inherit; }
    button { border: 0; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }
    svg { display: block; }

    .screen-decoration,
    .screen-decoration::before,
    .screen-decoration::after {
      position: fixed;
      z-index: -1;
      pointer-events: none;
      content: "";
    }

    .screen-decoration {
      inset: 0;
      background:
        radial-gradient(circle at 2.2% 54%, #c9c0b8 0 2px, transparent 3px),
        radial-gradient(circle at 97.8% 21%, rgba(255, 167, 97, .48) 0 3px, transparent 4px),
        radial-gradient(circle at 99.2% 21%, rgba(255, 167, 97, .48) 0 3px, transparent 4px);
    }

    .screen-decoration::before {
      width: 420px;
      height: 420px;
      left: -300px;
      top: 285px;
      border: 1px solid rgba(255, 139, 54, .34);
      border-radius: 50%;
      box-shadow: 0 0 0 90px rgba(255, 139, 54, .025);
    }

    .screen-decoration::after {
      width: 390px;
      height: 390px;
      right: -260px;
      bottom: -70px;
      border: 1px solid rgba(255, 139, 54, .33);
      border-radius: 50%;
    }

    .page-shell {
      position: relative;
      width: min(1504px, calc(100% - 84px));
      min-height: 878px;
      margin: 24px auto 36px;
      overflow: hidden;
      border: 1px solid #f0e2d8;
      border-radius: 35px;
      background: rgba(255,255,255,.94);
      box-shadow: 0 24px 70px rgba(102, 66, 37, .08);
    }

    .page-shell::before {
      content: "";
      position: absolute;
      z-index: 0;
      width: 180px;
      height: 180px;
      top: 55px;
      left: 49%;
      transform: translateX(-50%);
      border-radius: 0 0 58% 58%;
      background: linear-gradient(145deg, rgba(255, 215, 184, .35), rgba(255, 242, 231, .18));
      clip-path: ellipse(60% 72% at 50% 0%);
      pointer-events: none;
    }

    .topbar {
      position: relative;
      z-index: 5;
      height: 92px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 57px;
      border-bottom: 1px solid #e9e5e1;
      background: rgba(255,255,255,.96);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand-logo {
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      display: grid;
      place-items: center;
    }

    .brand-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .brand-copy strong {
      display: block;
      font-size: 23px;
      line-height: 1;
      letter-spacing: -.65px;
      font-weight: 900;
    }

    .brand-copy strong span { color: var(--orange); }

    .brand-copy small {
      display: block;
      margin-top: 6px;
      color: #9a9b9c;
      font-size: 8px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: 2.3px;
      text-transform: uppercase;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 36px;
      color: #33373d;
      font-size: 14px;
      font-weight: 500;
    }

    .nav a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .nav a:hover { color: var(--orange); }

    .nav svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sales-link {
      min-height: 42px;
      padding: 0 19px;
      border: 1px solid #e8e4df;
      border-radius: 15px;
      background: #fff;
      box-shadow: 0 3px 10px rgba(0,0,0,.02);
    }

    .main {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.56fr) minmax(520px, .96fr);
      gap: 52px;
      min-height: 785px;
      padding: 32px 45px 0 56px;
      background:
        radial-gradient(circle at -2% 29%, rgba(255, 220, 194, .32) 0 122px, transparent 123px),
        radial-gradient(circle at 63% 20%, rgba(255, 239, 228, .52) 0 185px, transparent 186px),
        linear-gradient(180deg, rgba(255,255,255,.78), rgba(255,253,250,.9));
    }

    .main::after {
      content: "";
      position: absolute;
      z-index: 0;
      top: 88px;
      right: -30px;
      width: 108px;
      height: 86px;
      opacity: .55;
      background-image:
        radial-gradient(circle, rgba(255, 145, 65, .85) 0 2px, transparent 2.5px);
      background-size: 22px 22px;
      pointer-events: none;
    }

    .hero {
      position: relative;
      z-index: 2;
      min-width: 0;
      min-height: 740px;
      padding-top: 4px;
    }

    .eyebrow {
      width: fit-content;
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 7px 17px;
      border: 1px solid #ffd4b7;
      border-radius: 999px;
      background: rgba(255,255,255,.84);
      color: #4f5358;
      font-size: 13px;
      font-weight: 500;
    }

    .eyebrow svg {
      width: 17px;
      height: 17px;
      fill: var(--orange);
    }

    .hero h1 {
      max-width: 760px;
      margin-top: 16px;
      color: #151b24;
      font-size: clamp(45px, 3.35vw, 58px);
      line-height: 1.08;
      letter-spacing: -2.7px;
      font-weight: 900;
    }

    .hero h1 span { color: var(--orange); }

    .hero-subtitle {
      max-width: 560px;
      margin-top: 17px;
      color: #5f6368;
      font-size: 16px;
      line-height: 1.55;
      font-weight: 400;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 21px;
    }

    .hero-btn {
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .hero-btn:hover { transform: translateY(-1px); }

    .hero-btn.primary {
      min-width: 210px;
      padding: 0 22px;
      color: #fff;
      background: linear-gradient(105deg, #f64b0b, #ff7a08);
      box-shadow: 0 10px 24px rgba(255, 91, 0, .22);
    }

    .hero-btn.secondary {
      min-width: 221px;
      padding: 0 22px;
      color: #242a31;
      border: 1px solid #e2ddd8;
      background: #fff;
    }

    .hero-btn svg { width: 19px; height: 19px; }
    .hero-btn.primary svg { stroke: #fff; fill: none; }
    .hero-btn.secondary svg { stroke: #20262d; fill: none; }

    .visual-stage {
      position: absolute;
      left: -12px;
      right: -6px;
      top: 345px;
      bottom: 12px;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      min-width: 0;
      pointer-events: none;
    }

    .hero-reference-image {
      width: min(100%, 890px);
      height: auto;
      max-height: calc(100% - 4px);
      object-fit: contain;
      object-position: left bottom;
      flex: 0 1 auto;
      filter: drop-shadow(0 10px 15px rgba(87, 53, 27, .06));
    }

    .auth-wrap {
      position: relative;
      z-index: 3;
      min-width: 0;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 2px;
    }

    .auth-card {
      width: 100%;
      min-height: 675px;
      max-height: 675px;
      padding: 46px 37px 32px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: #ded8d2 transparent;
      border: 1px solid #ecdccf;
      border-radius: 34px;
      background: rgba(255,255,255,.93);
      box-shadow: 0 16px 45px rgba(88, 54, 27, .08);
      backdrop-filter: blur(15px);
    }

    .auth-card::-webkit-scrollbar { width: 6px; }
    .auth-card::-webkit-scrollbar-thumb { background: #ded8d2; border-radius: 999px; }

    .auth-header { text-align: center; }

    .auth-header h2 {
      color: #1b212a;
      font-size: 39px;
      line-height: 1.08;
      letter-spacing: -1.8px;
      font-weight: 900;
    }

    .auth-header p {
      margin-top: 13px;
      color: #6f7276;
      font-size: 15px;
      line-height: 1.4;
    }

    .auth-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-top: 38px;
      padding: 3px;
      border-radius: 14px;
      background: #f7f4f1;
    }

    .tab {
      min-height: 48px;
      border-radius: 12px;
      background: transparent;
      color: #5d6165;
      font-size: 14px;
      font-weight: 650;
      cursor: pointer;
    }

    .tab.ativo {
      color: var(--orange);
      background: #fff;
      border: 1px solid #efdfd4;
      box-shadow: 0 4px 13px rgba(77, 51, 31, .07);
    }

    .mensagens {
      display: grid;
      gap: 8px;
      margin-top: 16px;
    }

    .mensagem {
      padding: 10px 12px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 650;
      line-height: 1.4;
    }

    .mensagem.erro { color: var(--error); background: var(--error-bg); border: 1px solid #f3c7c7; }
    .mensagem.sucesso { color: var(--success); background: var(--success-bg); border: 1px solid #bde7c9; }

    .formulario { display: none; margin-top: 34px; }
    .formulario.ativo { display: block; }

    .campo { margin-bottom: 19px; }

    .campo label {
      display: block;
      margin-bottom: 9px;
      color: #383d43;
      font-size: 13px;
      font-weight: 600;
    }

    .campo-input {
      position: relative;
      min-height: 60px;
      display: flex;
      align-items: center;
      overflow: hidden;
      border: 1px solid #dedad6;
      border-radius: 11px;
      background: rgba(255,255,255,.92);
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .campo-input:focus-within {
      border-color: #ff9a60;
      box-shadow: 0 0 0 3px rgba(255, 90, 0, .08);
    }

    .campo-icon {
      width: 49px;
      flex: 0 0 49px;
      display: grid;
      place-items: center;
      color: #9a9b9d;
    }

    .campo-icon img {
      width: 19px;
      height: 19px;
      object-fit: contain;
      opacity: .70;
    }

    .campo-input input {
      width: 100%;
      min-width: 0;
      height: 58px;
      padding: 0 12px 0 0;
      border: 0;
      outline: 0;
      color: #20262d;
      background: transparent;
      font-size: 14px;
    }

    .campo-input input::placeholder { color: #b0b1b3; }

    .mostrar-senha {
      width: 50px;
      height: 58px;
      flex: 0 0 50px;
      display: grid;
      place-items: center;
      color: #8c8f92;
      background: transparent;
      cursor: pointer;
    }

    .mostrar-senha svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .login-options {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 5px 0 27px;
    }

    .lembrar,
    .termos {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      color: #6f7276;
      font-size: 12.5px;
      line-height: 1.45;
      cursor: pointer;
    }

    .lembrar { align-items: center; }

    .lembrar input,
    .termos input {
      width: 17px;
      height: 17px;
      flex: 0 0 17px;
      margin-top: 1px;
      accent-color: var(--orange);
    }

    .forgot-link {
      color: var(--orange);
      font-size: 12.5px;
      font-weight: 650;
      white-space: nowrap;
    }

    .termos { margin: 5px 0 21px; }
    .termos a { color: var(--orange); font-weight: 700; }

    .btn-principal {
      width: 100%;
      min-height: 62px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 0 22px;
      border-radius: 11px;
      color: #fff;
      background: linear-gradient(102deg, #f54b0c 0%, #ff7909 100%);
      box-shadow: 0 14px 28px rgba(255, 88, 0, .22);
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-principal svg {
      width: 20px;
      height: 20px;
      stroke: #fff;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .auth-rodape {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 35px;
      color: #8a8c8f;
      font-size: 12px;
      line-height: 1.4;
      text-align: center;
    }

    .auth-rodape svg {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      stroke: #9ea0a2;
      fill: none;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .duas-colunas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    #formCadastro { margin-top: 24px; }
    #formCadastro .campo { margin-bottom: 14px; }
    #formCadastro .campo-input { min-height: 50px; }
    #formCadastro .campo-input input { height: 48px; font-size: 13px; }
    #formCadastro .mostrar-senha { height: 48px; }

    .login-site-footer {
      position: relative;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 88px;
      padding: 20px 56px;
      border-top: 1px solid #eee7e1;
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(253,250,247,.98));
      color: #6f7276;
      font-size: 12.5px;
      line-height: 1.55;
    }

    .login-site-footer__legal {
      min-width: 0;
    }

    .login-site-footer__legal strong {
      color: #30343a;
      font-weight: 800;
    }

    .login-site-footer__company {
      display: block;
    }

    .login-site-footer__meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 10px;
      margin-top: 2px;
      color: #8a8c90;
    }

    .login-site-footer__meta span + span::before {
      content: "•";
      margin-right: 10px;
      color: #d7c8bd;
    }

    .login-site-footer__links {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
    }

    .login-site-footer__links a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 38px;
      padding: 0 14px;
      border: 1px solid #eadfd7;
      border-radius: 11px;
      background: #fff;
      color: #5d6065;
      font-weight: 750;
      transition: border-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease;
    }

    .login-site-footer__links a:hover {
      color: var(--orange);
      border-color: #ffc69f;
      box-shadow: 0 7px 18px rgba(255, 90, 0, .08);
      transform: translateY(-1px);
    }

    .login-site-footer__links svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    @media (max-width: 1260px) {
      .page-shell { width: min(1180px, calc(100% - 28px)); }
      .topbar { padding-inline: 34px; }
      .nav { gap: 21px; }
      .main { grid-template-columns: minmax(0, 1.35fr) minmax(465px, .9fr); gap: 30px; padding-left: 38px; padding-right: 30px; }
      .hero { min-height: 720px; }
      .hero h1 { font-size: clamp(42px, 4.5vw, 56px); }
      .visual-stage { left: -12px; right: -10px; top: 360px; }
    }

    @media (max-width: 1020px) {
      .page-shell { width: min(920px, calc(100% - 24px)); margin: 12px auto 24px; border-radius: 26px; }
      .topbar { height: 78px; padding-inline: 22px; }
      .nav a:not(.sales-link) { display: none; }
      .main { display: block; min-height: 0; padding: 34px 30px 42px; }
      .hero { min-height: 780px; text-align: center; }
      .eyebrow { margin-inline: auto; }
      .hero h1, .hero-subtitle { margin-left: auto; margin-right: auto; }
      .hero-actions { justify-content: center; }
      .visual-stage { top: 340px; left: 0; right: 0; bottom: 0; justify-content: center; }
      .hero-reference-image { width: min(860px, 100%); object-position: center bottom; }
      .auth-wrap { padding-top: 22px; }
      .auth-card { width: min(590px, 100%); }
      .login-site-footer { padding-inline: 30px; }
    }

    @media (max-width: 720px) {
      .page-shell { width: 100%; margin: 0; border: 0; border-radius: 0; }
      .topbar { height: 72px; padding-inline: 14px; }
      .brand-logo { width: 42px; height: 42px; flex-basis: 42px; }
      .brand-copy strong { font-size: 19px; }
      .brand-copy small { display: none; }
      .sales-link { display: none !important; }
      .main { padding: 23px 14px 30px; }
      .hero { min-height: 680px; }
      .hero h1 { font-size: clamp(34px, 9.5vw, 45px); letter-spacing: -1.8px; }
      .hero-subtitle { font-size: 14px; }
      .hero-actions { flex-direction: column; width: 100%; }
      .hero-btn { width: 100%; }
      .visual-stage { top: 360px; }
      .auth-card { min-height: 0; max-height: none; padding: 32px 19px 28px; border-radius: 24px; }
      .auth-header h2 { font-size: 32px; letter-spacing: -1.2px; }
      .duas-colunas { grid-template-columns: 1fr; gap: 0; }
      .login-options { align-items: flex-start; }
      .login-site-footer {
        min-height: 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        padding: 22px 18px 26px;
        font-size: 12px;
      }
      .login-site-footer__links { width: 100%; }
      .login-site-footer__links a { justify-content: center; width: 100%; }
      .login-site-footer__meta { display: block; }
      .login-site-footer__meta span { display: block; }
      .login-site-footer__meta span + span::before { display: none; }
    }

    @media (max-width: 420px) {
      .hero { min-height: 630px; }
      .visual-stage { top: 385px; }
      .hero h1 { font-size: 34px; }
      .auth-card { padding-inline: 14px; }
      .auth-header h2 { font-size: 29px; }
      .login-options { flex-direction: column; gap: 12px; }
    }
  </style>
</head>

<body data-form-cadastro="<%= typeof formData !== 'undefined' && formData && Object.keys(formData).length > 0 ? 'true' : 'false' %>">
  <div class="screen-decoration" aria-hidden="true"></div>

  <div class="page-shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="ComandaFacíl">
        <span class="brand-logo"><img src="/assets/imgs/comanda.png" alt="Logo ComandaFacíl"></span>
        <span class="brand-copy">
          <strong>Comanda<span>Facíl</span></strong>
          <small>Gestão Food Service</small>
        </span>
      </a>

      <nav class="nav" aria-label="Navegação principal">
  <a href="#recursos">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="4" y="4" width="6" height="6" rx="1"></rect>
      <rect x="14" y="4" width="6" height="6" rx="1"></rect>
      <rect x="4" y="14" width="6" height="6" rx="1"></rect>
      <rect x="14" y="14" width="6" height="6" rx="1"></rect>
    </svg>
    Recursos
  </a>

  <a
    href="https://wa.me/55SEUNUMERO?text=Olá%2C%20preciso%20de%20suporte%20sobre%20o%20ComandaFácil."
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 13v-2a8 8 0 0 1 16 0v2"></path>
      <path d="M4 13a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2ZM20 13a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2ZM17 17c-.7 1.5-2.1 2.3-4 2.3"></path>
    </svg>
    Suporte
  </a>

  <a
    class="sales-link"
    href="https://wa.me/55SEUNUMERO?text=Olá%2C%20quero%20conhecer%20melhor%20o%20ComandaFácil."
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 13v-2a8 8 0 0 1 16 0v2"></path>
      <path d="M4 13a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2ZM20 13a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2Z"></path>
    </svg>
    Falar com vendas
  </a>
</nav>
    </header>

    <main class="main">
      <section class="hero" id="recursos">
        <div class="eyebrow">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8c.5 3.2 2.1 4.9 5.3 5.4-3.2.5-4.8 2.2-5.3 5.4-.5-3.2-2.1-4.9-5.3-5.4 3.2-.5 4.8-2.2 5.3-5.4ZM18.8 13.8c.3 1.8 1.2 2.8 3 3.1-1.8.3-2.7 1.3-3 3.1-.3-1.8-1.2-2.8-3-3.1 1.8-.3 2.7-1.3 3-3.1ZM5.3 14.5c.2 1.3.9 2 2.2 2.2-1.3.2-2 .9-2.2 2.2-.2-1.3-.9-2-2.2-2.2 1.3-.2 2-.9 2.2-2.2Z"></path></svg>
          Tudo que seu restaurante precisa, em um só sistema
        </div>

        <h1>
          Gerencie seu food service<br>
          com mais <span>controle</span> e <span>agilidade</span>
        </h1>

        <p class="hero-subtitle">
          Pedidos, mesas, estoque, equipe e vendas integrados<br>
          para você tomar melhores decisões todos os dias.
        </p>

        <div class="hero-actions">
          <a class="hero-btn primary" href="#acesso">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5c2.6-2.6 5.8-2.6 5.8-2.6s0 3.2-2.6 5.8l-4.9 4.9-3.2.4.4-3.2 4.5-5.3Z"></path><path d="m9.7 10.7-3.1-.4-2.9 2.9 4.1 1.1M13.3 14.3l.4 3.1-2.9 2.9-1.1-4.1M7.4 16.6l-2 2"></path></svg>
            Começar agora
          </a>
          <a class="hero-btn secondary" href="#demonstracao">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m10 8 6 4-6 4V8Z"></path></svg>
            Ver como funciona
          </a>
        </div>

        <div class="visual-stage" id="demonstracao">
          <img class="hero-reference-image" src="/assets/imgs/login-hero-referencia.png" alt="Demonstração do painel ComandaFacíl com pedidos, mesas, estoque e vendas">
        </div>
      </section>

      <section class="auth-wrap" id="acesso">
        <div class="auth-card">
          <div class="auth-header">
            <h2 id="tituloFormulario">Acesse sua conta</h2>
            <p id="subtituloFormulario">Entre com suas credenciais para continuar</p>
          </div>

          <div class="auth-tabs">
            <button type="button" class="tab ativo" id="btnLogin">Entrar</button>
            <button type="button" class="tab" id="btnCadastro">Criar conta</button>
          </div>

          <div class="mensagens">
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
              <% errors.forEach(erro => { %><p class="mensagem erro"><%= erro %></p><% }) %>
            <% } %>
            <% if (typeof success !== 'undefined' && success.length > 0) { %>
              <% success.forEach(mensagem => { %><p class="mensagem sucesso"><%= mensagem %></p><% }) %>
            <% } %>
          </div>

          <form action="/login/admin" method="POST" class="formulario ativo" id="formLogin">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="campo">
              <label for="loginEmail">E-mail</label>
              <div class="campo-input">
                <span class="campo-icon"><img src="/assets/imgs/mail.svg" alt=""></span>
                <input type="email" id="loginEmail" name="email" placeholder="seuemail@exemplo.com" autocomplete="email" required>
              </div>
            </div>

            <div class="campo">
              <label for="loginSenha">Senha</label>
              <div class="campo-input">
                <span class="campo-icon"><img src="/assets/imgs/lock.svg" alt=""></span>
                <input type="password" id="loginSenha" name="senha" placeholder="Digite sua senha" autocomplete="current-password" required>
                <button type="button" class="mostrar-senha" data-input="loginSenha" aria-label="Mostrar ou ocultar senha">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                </button>
              </div>
            </div>

            <div class="login-options">
              <label class="lembrar">
                <input type="checkbox" id="lembrarAcesso" name="lembrar" value="on">
                <span>Lembrar meu acesso</span>
              </label>
              <a class="forgot-link" href="/login/recuperar-senha">Esqueci minha senha</a>
            </div>

            <button type="submit" class="btn-principal">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10"></path></svg>
              Entrar no sistema
            </button>
          </form>

          <form action="/cadastro/login" method="POST" class="formulario" id="formCadastro">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="duas-colunas">
              <div class="campo">
                <label for="nome">Nome completo</label>
                <div class="campo-input"><span class="campo-icon">👤</span><input type="text" id="nome" name="nome" placeholder="Seu nome" value="<%= typeof formData !== 'undefined' && formData.nome ? formData.nome : '' %>" autocomplete="name" required></div>
              </div>
              <div class="campo">
                <label for="nomeEstabelecimento">Nome do estabelecimento</label>
                <div class="campo-input"><span class="campo-icon">🏪</span><input type="text" id="nomeEstabelecimento" name="nomeEstabelecimento" placeholder="Nome da lanchonete" value="<%= typeof formData !== 'undefined' && formData.nomeEstabelecimento ? formData.nomeEstabelecimento : '' %>" required></div>
              </div>
            </div>

            <div class="campo">
              <label for="cadastroEmail">E-mail</label>
              <div class="campo-input"><span class="campo-icon"><img src="/assets/imgs/mail.svg" alt=""></span><input type="email" id="cadastroEmail" name="email" placeholder="seuemail@exemplo.com" value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" autocomplete="email" required></div>
            </div>

            <div class="duas-colunas">
              <div class="campo">
                <label for="telefone">Telefone</label>
                <div class="campo-input"><span class="campo-icon"><img src="/assets/imgs/phone.svg" alt=""></span><input type="tel" id="telefone" name="telefone" placeholder="(99) 99999-9999" value="<%= typeof formData !== 'undefined' && formData.telefone ? formData.telefone : '' %>" autocomplete="tel" maxlength="15" required></div>
              </div>
              <div class="campo">
                <label for="cpfCnpj">CPF ou CNPJ</label>
                <div class="campo-input"><span class="campo-icon"><img src="/assets/imgs/id-card.svg" alt=""></span><input type="text" id="cpfCnpj" name="cpfCnpj" placeholder="Digite seu CPF ou CNPJ" value="<%= typeof formData !== 'undefined' && formData.cpfCnpj ? formData.cpfCnpj : '' %>" maxlength="18" inputmode="numeric" required></div>
              </div>
            </div>

            <div class="duas-colunas">
              <div class="campo">
                <label for="cadastroSenha">Senha</label>
                <div class="campo-input"><span class="campo-icon"><img src="/assets/imgs/lock.svg" alt=""></span><input type="password" id="cadastroSenha" name="senha" placeholder="Crie uma senha forte" minlength="12" maxlength="64" autocomplete="new-password" required><button type="button" class="mostrar-senha" data-input="cadastroSenha" aria-label="Mostrar ou ocultar senha"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg></button></div>
              </div>
              <div class="campo">
                <label for="confirmarSenha">Confirmar senha</label>
                <div class="campo-input"><span class="campo-icon"><img src="/assets/imgs/lock.svg" alt=""></span><input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Repita a senha" minlength="12" maxlength="64" autocomplete="new-password" required><button type="button" class="mostrar-senha" data-input="confirmarSenha" aria-label="Mostrar ou ocultar senha"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg></button></div>
              </div>
            </div>

            <label class="termos">
              <input type="checkbox" id="aceitarTermos" name="aceitarTermos" value="on" <%= typeof formData !== 'undefined' && formData.aceitarTermos ? 'checked' : '' %> required>
              <span>Li e concordo com a <a href="/privacidade" target="_blank">Política de Privacidade</a>.</span>
            </label>

            <button type="submit" class="btn-principal">Criar minha conta</button>
          </form>

          <p class="auth-rodape">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 7.9 7 10 4.2-2.1 7-5.4 7-10V6l-7-3Z"></path><path d="m9.4 12 1.7 1.7 3.8-4"></path></svg>
            Sistema 100% seguro para a gestão do seu estabelecimento.
          </p>
        </div>
      </section>
    </main>

    <footer class="login-site-footer" aria-label="Informações legais do ComandaFácil">
      <div class="login-site-footer__legal">
        <span class="login-site-footer__company">
          <strong>ComandaFácil</strong> é operado por 68.827.755 WALTER CARLOS OLIVEIRA RODRIGUES
        </span>
        <div class="login-site-footer__meta">
          <span>CNPJ: 68.827.755/0001-06</span>
          <span>Bela Vista do Maranhão - MA</span>
        </div>
      </div>

      <nav class="login-site-footer__links" aria-label="Links legais">
        <a href="/privacidade" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 5 6v5c0 4.6 2.8 7.9 7 10 4.2-2.1 7-5.4 7-10V6l-7-3Z"></path>
            <path d="M9.5 12.2 11.2 14l3.6-4"></path>
          </svg>
          Política de Privacidade
        </a>
      </nav>
    </footer>
  </div>

  <script nonce="<%= cspNonce %>">
    const btnLogin = document.querySelector('#btnLogin');
    const btnCadastro = document.querySelector('#btnCadastro');
    const formLogin = document.querySelector('#formLogin');
    const formCadastro = document.querySelector('#formCadastro');
    const lembrarAcesso = document.querySelector('#lembrarAcesso');
    const loginEmail = document.querySelector('#loginEmail');
    const tituloFormulario = document.querySelector('#tituloFormulario');
    const subtituloFormulario = document.querySelector('#subtituloFormulario');
    const CHAVE_EMAIL_LEMBRADO = 'comandaFacilLoginEmail';

    try {
      const emailLembrado = localStorage.getItem(CHAVE_EMAIL_LEMBRADO);
      if (emailLembrado) {
        loginEmail.value = emailLembrado;
        lembrarAcesso.checked = true;
      }
    } catch (erro) {
      console.warn('Não foi possível recuperar o e-mail lembrado.', erro);
    }

    formLogin.addEventListener('submit', () => {
      try {
        if (lembrarAcesso.checked) {
          localStorage.setItem(CHAVE_EMAIL_LEMBRADO, loginEmail.value.trim().toLowerCase());
        } else {
          localStorage.removeItem(CHAVE_EMAIL_LEMBRADO);
        }
      } catch (erro) {
        console.warn('Não foi possível salvar a preferência de acesso.', erro);
      }
    });

    function abrirLogin() {
      btnLogin.classList.add('ativo');
      btnCadastro.classList.remove('ativo');
      formLogin.classList.add('ativo');
      formCadastro.classList.remove('ativo');
      tituloFormulario.textContent = 'Acesse sua conta';
      subtituloFormulario.textContent = 'Entre com suas credenciais para continuar';
      document.querySelector('.auth-card')?.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function abrirCadastro() {
      btnCadastro.classList.add('ativo');
      btnLogin.classList.remove('ativo');
      formCadastro.classList.add('ativo');
      formLogin.classList.remove('ativo');
      tituloFormulario.textContent = 'Crie sua conta';
      subtituloFormulario.textContent = 'Cadastre seu estabelecimento e comece seu teste grátis.';
      document.querySelector('.auth-card')?.scrollTo({ top: 0, behavior: 'smooth' });
    }

    btnLogin.addEventListener('click', abrirLogin);
    btnCadastro.addEventListener('click', abrirCadastro);

    document.querySelectorAll('.mostrar-senha').forEach(botao => {
      botao.addEventListener('click', () => {
        const input = document.getElementById(botao.dataset.input);
        const mostrar = input.type === 'password';
        input.type = mostrar ? 'text' : 'password';
        botao.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
      });
    });

    formCadastro.addEventListener('submit', event => {
      const aceitarTermos = document.querySelector('#aceitarTermos');
      if (!aceitarTermos.checked) {
        event.preventDefault();
        alert('Para criar a conta, aceite a Política de Privacidade.');
        aceitarTermos.focus();
        return;
      }

      const senha = document.querySelector('#cadastroSenha').value;
      const confirmarSenha = document.querySelector('#confirmarSenha').value;
      if (senha !== confirmarSenha) {
        event.preventDefault();
        alert('As senhas não são iguais.');
        document.querySelector('#confirmarSenha').focus();
      }
    });

    const telefone = document.querySelector('#telefone');
    telefone.addEventListener('input', event => {
      let valor = event.target.value.replace(/\D/g, '').slice(0, 11);
      if (valor.length > 10) {
        valor = valor.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
      } else if (valor.length > 6) {
        valor = valor.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
      } else if (valor.length > 2) {
        valor = valor.replace(/^(\d{2})(\d+)/, '($1) $2');
      } else if (valor.length > 0) {
        valor = valor.replace(/^(\d{0,2})/, '($1');
      }
      event.target.value = valor;
    });

    const cpfCnpj = document.querySelector('#cpfCnpj');
    cpfCnpj.addEventListener('input', event => {
      let valor = event.target.value.replace(/\D/g, '').slice(0, 14);
      if (valor.length <= 11) {
        valor = valor
          .replace(/^(\d{3})(\d)/, '$1.$2')
          .replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3')
          .replace(/^(\d{3})\.(\d{3})\.(\d{3})(\d)/, '$1.$2.$3-$4');
      } else {
        valor = valor
          .replace(/^(\d{2})(\d)/, '$1.$2')
          .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
          .replace(/^(\d{2})\.(\d{3})\.(\d{3})(\d)/, '$1.$2.$3/$4')
          .replace(/^(\d{2})\.(\d{3})\.(\d{3})\/(\d{4})(\d)/, '$1.$2.$3/$4-$5');
      }
      event.target.value = valor;
    });

    const possuiDadosCadastro = document.body.dataset.formCadastro === 'true';
    const rotaCadastro = window.location.pathname.includes('/cadastro');
    if (possuiDadosCadastro || rotaCadastro) abrirCadastro();

    const rotaLogin = window.location.pathname.includes('/login');
    if (rotaLogin) abrirLogin();
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <title>Login e cadastro | ComandaFacíl</title>

  <link
    rel="icon"
    href="/assets/imgs/comanda.png"
    type="image/png"
  >

  <style nonce="<%= cspNonce %>">
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --vermelho-900: #651111;
      --vermelho-800: #821717;
      --vermelho-700: #a51f1f;
      --vermelho-600: #c62828;
      --laranja-600: #e96b13;
      --laranja-500: #f58618;
      --amarelo-500: #f6b817;
      --marrom-950: #160b08;
      --marrom-900: #24100c;
      --marrom-800: #35150e;
      --cinza-950: #171717;
      --cinza-900: #222222;
      --cinza-700: #4c4c4c;
      --cinza-600: #666666;
      --cinza-500: #818181;
      --cinza-400: #a7a7a7;
      --cinza-300: #d4d4d4;
      --cinza-200: #e8e8e8;
      --cinza-100: #f5f5f5;
      --cinza-50: #fafafa;
      --branco: #ffffff;
      --erro: #b42323;
      --erro-fundo: #fde8e8;
      --sucesso: #177544;
      --sucesso-fundo: #e1f7e9;
    }

    html {
      min-height: 100%;
    }

    body {
      min-height: 100vh;
      background: #f8f5f2;
      color: var(--cinza-900);
      font-family: Inter, Arial, Helvetica, sans-serif;
    }

    button,
    input {
      font: inherit;
    }

    button {
      border: 0;
    }

    a {
      color: inherit;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .auth {
      display: grid;
      grid-template-columns: minmax(360px, 54%) minmax(0, 56%);
      min-height: 100vh;
    }

    .auth-imagem {
      position: relative;
      min-height: 100vh;
      overflow: hidden;
      padding: 46px;
      color: var(--branco);
      background:
        radial-gradient(
          circle at top left,
          rgba(246, 184, 23, 0.28),
          transparent 30%
        ),
        linear-gradient(
          145deg,
          rgba(36, 16, 12, 0.174),
          rgba(101, 17, 17, 0.72)
        );
    }

    .auth-imagem::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(
          180deg,
          rgba(18, 8, 5, 0.12),
          rgba(18, 8, 5, 0.269)
        );
      pointer-events: none;
    }

    .auth-overlay {
      position: absolute;
      inset: 0;
    }

    .auth-overlay img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .auth-marca {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: 480px;
    }

    .marca-topo {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logo-icon {
      display: grid;
      place-items: center;
      width: 66px;
      height: 66px;
      flex: 0 0 66px;
      overflow: hidden;
      border-radius: 20px;
      background:
        linear-gradient( white);
      box-shadow:
        0 18px 45px rgba(198, 40, 40, 0.38);
    }

    .facil {
      color: var(--laranja-600);
    }

    .logo-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .marca-nome strong {
      display: flex;
      font-size: 27px;
      letter-spacing: -0.7px;
    }

    .marca-nome span {
      display: block;
      margin-top: 5px;
      color: #f3c9b7;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .auth-marca h1 {
      max-width: 560px;
      margin-top: 70px;
      font-size: clamp(38px, 5vw, 66px);
      line-height: 1.03;
      letter-spacing: -2.5px;
    }

    .auth-marca > p {
      max-width: 510px;
      margin-top: 23px;
      color: rgba(255, 255, 255, 0.8);
      font-size: 17px;
      line-height: 1.75;
    }

    .auth-beneficios {
      position: absolute;
      left: 46px;
      bottom: 46px;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .auth-beneficios span {
      display: inline-flex;
      align-items: center;
      min-height: 39px;
      padding: 9px 14px;
      border: 1px solid rgba(255, 255, 255, 0.17);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.09);
      backdrop-filter: blur(12px);
      color: #f9e9e1;
      font-size: 13px;
      font-weight: 700;
    }

    .auth-conteudo {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
      padding: 38px;
      background:
        radial-gradient(
          circle at top right,
          rgba(245, 134, 24, 0.1),
          transparent 30%
        ),
        #f8f5f2;
    }

    .auth-box {
      width: min(100%, 650px);
      padding: 42px;
      border: 1px solid #eadfd7;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.97);
      box-shadow:
        0 28px 70px rgba(73, 34, 16, 0.11);
    }

    .auth-topo {
      margin-bottom: 25px;
      text-align: center;
    }

    .logo-mobile {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 22px;
      color: var(--vermelho-700);
      font-size: 20px;
    }

    .logo-mobile img {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      object-fit: cover;
    }

    .auth-topo h2 {
      color: var(--cinza-950);
      font-size: clamp(28px, 4vw, 38px);
      letter-spacing: -1.2px;
    }

    .auth-topo p {
      margin-top: 10px;
      color: var(--cinza-600);
      font-size: 15px;
      line-height: 1.6;
    }

    .auth-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      margin-bottom: 25px;
      padding: 5px;
      border-radius: 14px;
      background: #f1ece8;
    }

    .tab {
      min-height: 46px;
      padding: 10px;
      border-radius: 10px;
      background: transparent;
      color: var(--cinza-600);
      font-weight: 800;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .tab:hover {
      color: var(--vermelho-700);
    }

    .tab.ativo {
      background: var(--branco);
      color: var(--vermelho-700);
      box-shadow:
        0 8px 20px rgba(63, 30, 13, 0.09);
    }

    .formulario {
      display: none;
      animation: aparecer 0.22s ease;
    }

    .formulario.ativo {
      display: block;
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(7px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .mensagens {
      display: grid;
      gap: 9px;
      margin-bottom: 18px;
    }

    .mensagem {
      padding: 12px 14px;
      border: 1px solid transparent;
      border-radius: 11px;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.5;
    }

    .mensagem.erro {
      border-color: #f4c4c4;
      background: var(--erro-fundo);
      color: var(--erro);
    }

    .mensagem.sucesso {
      border-color: #bce8cc;
      background: var(--sucesso-fundo);
      color: var(--sucesso);
    }

    .duas-colunas {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .campo {
      margin-bottom: 16px;
    }

    .campo label {
      display: block;
      margin-bottom: 7px;
      color: var(--cinza-700);
      font-size: 12px;
      font-weight: 800;
    }

    .campo-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .campo-label a {
      margin-bottom: 7px;
      color: var(--vermelho-700);
      font-size: 12px;
      font-weight: 800;
      text-decoration: none;
    }

    .campo-label a:hover {
      text-decoration: underline;
    }

    .campo-input {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 50px;
      overflow: hidden;
      border: 1px solid var(--cinza-300);
      border-radius: 12px;
      background: var(--branco);
      transition: 0.2s ease;
    }

    .campo-input:focus-within {
      border-color: var(--laranja-500);
      box-shadow:
        0 0 0 4px rgba(245, 134, 24, 0.12);
    }

    .campo-input > span {
      display: grid;
      place-items: center;
      width: 47px;
      flex: 0 0 47px;
      color: var(--cinza-500);
      font-size: 18px;
    }

    .campo-input > span img {
      width: 19px;
      height: 19px;
      object-fit: contain;
      opacity: 0.72;
    }

    .campo-input input {
      width: 100%;
      min-width: 0;
      min-height: 48px;
      padding: 11px 12px 11px 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--cinza-900);
    }

    .campo-input input::placeholder {
      color: var(--cinza-400);
    }

    .mostrar-senha {
      display: grid;
      place-items: center;
      width: 46px;
      height: 48px;
      flex: 0 0 46px;
      background: transparent;
      color: var(--cinza-600);
      cursor: pointer;
    }

    .mostrar-senha:hover {
      background: var(--cinza-100);
    }

    .lembrar,
    .termos {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      margin: 5px 0 19px;
      color: var(--cinza-600);
      font-size: 13px;
      line-height: 1.5;
      cursor: pointer;
    }

    .lembrar input,
    .termos input {
      width: 16px;
      height: 16px;
      margin-top: 2px;
      accent-color: var(--vermelho-600);
    }

    .termos a {
      color: var(--vermelho-700);
      font-weight: 700;
      text-decoration: none;
    }

    .termos a:hover {
      text-decoration: underline;
    }

    .btn-principal {
      width: 100%;
      min-height: 52px;
      padding: 12px 20px;
      border-radius: 12px;
      background:
        linear-gradient(
          135deg,
          var(--vermelho-600),
          var(--laranja-500)
        );
      color: var(--branco);
      font-weight: 900;
      cursor: pointer;
      box-shadow:
        0 14px 30px rgba(198, 40, 40, 0.24);
      transition: 0.2s ease;
    }

    .btn-principal:hover {
      transform: translateY(-2px);
      box-shadow:
        0 18px 35px rgba(198, 40, 40, 0.3);
    }

    .btn-principal:active {
      transform: translateY(0);
    }

    .auth-rodape {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 24px;
      color: var(--cinza-500);
      font-size: 12px;
      line-height: 1.5;
      text-align: center;
      gap: 5px;
    }

    .auth-rodape img {
      width: 16px;
      height: 16px;
    }

    @media (max-width: 1050px) {
      .auth {
        grid-template-columns: minmax(310px, 39%) minmax(0, 61%);
      }

      .auth-imagem {
        padding: 32px;
      }

      .auth-beneficios {
        left: 32px;
        bottom: 32px;
      }

      .auth-conteudo {
        padding: 28px;
      }

      .auth-box {
        padding: 34px;
      }
    }

    @media (max-width: 820px) {
      .auth {
        display: block;
      }

      .auth-imagem {
        display: none;
      }

      .auth-conteudo {
        min-height: 100vh;
        padding: 24px;
      }

      .logo-mobile {
        display: flex;
      }
    }

    @media (max-width: 620px) {
      .auth-conteudo {
        align-items: flex-start;
        padding: 14px;
      }

      .auth-box {
        margin: 12px 0;
        padding: 27px 20px;
        border-radius: 20px;
      }

      .duas-colunas {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .auth-topo h2 {
        font-size: 28px;
      }
    }

    @media (max-width: 390px) {
      .auth-box {
        padding: 24px 15px;
      }

      .auth-tabs {
        margin-bottom: 20px;
      }

      .campo-label {
        align-items: flex-start;
        flex-direction: column;
        gap: 0;
      }
    }
  </style>
</head>

<body data-form-cadastro="<%= typeof formData !== 'undefined' && formData && Object.keys(formData).length > 0 ? 'true' : 'false' %>">
  <main class="auth">
    <section class="auth-imagem">
      <div class="auth-overlay">
        <img
          src="/assets/imgs/template2.png"
          alt="Sistema ComandaMix para restaurantes"
        >
      </div>

      <div class="auth-marca">
        <div class="marca-topo">
          <div class="logo-icon">
            <img
              src="/assets/imgs/comanda.png"
              alt="Logomarca ComandaMix"
            >
          </div>

          <div class="marca-nome">
            <strong>Comanda<div class="facil">Facíl</div></strong>
            <span>Gestão Food Service</span>
          </div>
        </div>

        <h1>
          Gestão completa para o seu estabelecimento.
        </h1>

        <p>
          Controle pedidos, mesas, produtos, estoque, funcionários
          e vendas em um só lugar.
        </p>
      </div>

      <div class="auth-beneficios">
        <span>✓ Hamburguerias</span>
        <span>✓ Pizzarias</span>
        <span>✓ Lanchonetes</span>
      </div>
    </section>

    <section class="auth-conteudo">
      <div class="auth-box">
        <div class="auth-topo">
          <div class="logo-mobile">
            <img
              src="/assets/imgs/comanda.png"
              alt="ComandaMix"
            >

            <strong>ComandaFacíl</strong>
          </div>

          <h2 id="tituloFormulario">
            Bem-vindo de volta
          </h2>

          <p id="subtituloFormulario">
            Entre com seus dados para acessar o sistema.
          </p>
        </div>

        <div class="auth-tabs">
          <button
            type="button"
            class="tab ativo"
            id="btnLogin"
          >
            Entrar
          </button>

          <button
            type="button"
            class="tab"
            id="btnCadastro"
          >
            Criar conta
          </button>
        </div>

        <div class="mensagens">
          <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <% errors.forEach(erro => { %>
              <p class="mensagem erro">
                <%= erro %>
              </p>
            <% }) %>
          <% } %>

          <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <% success.forEach(mensagem => { %>
              <p class="mensagem sucesso">
                <%= mensagem %>
              </p>
            <% }) %>
          <% } %>
        </div>

        <form
          action="/login/admin"
          method="POST"
          class="formulario ativo"
          id="formLogin"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="campo">
            <label for="loginEmail">
              E-mail
            </label>

            <div class="campo-input">
              <span>
                <img
                  src="/assets/imgs/mail.svg"
                  alt=""
                >
              </span>

              <input
                type="email"
                id="loginEmail"
                name="email"
                placeholder="seuemail@exemplo.com"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="campo">
            <div class="campo-label">
              <label for="loginSenha">
                Senha
              </label>

              <a href="/login/recuperar-senha">
                Esqueci minha senha
              </a>
            </div>

            <div class="campo-input">
              <span>
                <img
                  src="/assets/imgs/lock.svg"
                  alt=""
                >
              </span>

              <input
                type="password"
                id="loginSenha"
                name="senha"
                placeholder="Digite sua senha"
                autocomplete="current-password"
                required
              >

              <button
                type="button"
                class="mostrar-senha"
                data-input="loginSenha"
                aria-label="Mostrar ou ocultar senha"
              >
                👁
              </button>
            </div>
          </div>

          <label class="lembrar">
            <input
              type="checkbox"
              id="lembrarAcesso"
              name="lembrar"
              value="on"
            >

            <span>
              Lembrar meu acesso
            </span>
          </label>

          <button
            type="submit"
            class="btn-principal"
          >
            Entrar no sistema
          </button>
        </form>

        <form
          action="/cadastro/login"
          method="POST"
          class="formulario"
          id="formCadastro"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="duas-colunas">
            <div class="campo">
              <label for="nome">
                Nome completo
              </label>

              <div class="campo-input">
                <span>👤</span>

                <input
                  type="text"
                  id="nome"
                  name="nome"
                  placeholder="Seu nome"
                  value="<%= typeof formData !== 'undefined' && formData.nome ? formData.nome : '' %>"
                  autocomplete="name"
                  required
                >
              </div>
            </div>

            <div class="campo">
              <label for="nomeEstabelecimento">
                Nome do estabelecimento
              </label>

              <div class="campo-input">
                <span>🏪</span>

                <input
                  type="text"
                  id="nomeEstabelecimento"
                  name="nomeEstabelecimento"
                  placeholder="Nome da lanchonete"
                  value="<%= typeof formData !== 'undefined' && formData.nomeEstabelecimento ? formData.nomeEstabelecimento : '' %>"
                  required
                >
              </div>
            </div>
          </div>

          <div class="campo">
            <label for="cadastroEmail">
              E-mail
            </label>

            <div class="campo-input">
              <span>
                <img
                  src="/assets/imgs/mail.svg"
                  alt=""
                >
              </span>

              <input
                type="email"
                id="cadastroEmail"
                name="email"
                placeholder="seuemail@exemplo.com"
                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="duas-colunas">
            <div class="campo">
              <label for="telefone">
                Telefone
              </label>

              <div class="campo-input">
                <span>
                  <img
                    src="/assets/imgs/phone.svg"
                    alt=""
                  >
                </span>

                <input
                  type="tel"
                  id="telefone"
                  name="telefone"
                  placeholder="(99) 99999-9999"
                  value="<%= typeof formData !== 'undefined' && formData.telefone ? formData.telefone : '' %>"
                  autocomplete="tel"
                  maxlength="15"
                  required
                >
              </div>
            </div>

            <div class="campo">
              <label for="cpfCnpj">
                CPF ou CNPJ
              </label>

              <div class="campo-input">
                <span>
                  <img
                    src="/assets/imgs/id-card.svg"
                    alt=""
                  >
                </span>

                <input
                  type="text"
                  id="cpfCnpj"
                  name="cpfCnpj"
                  placeholder="Digite seu CPF ou CNPJ"
                  value="<%= typeof formData !== 'undefined' && formData.cpfCnpj ? formData.cpfCnpj : '' %>"
                  maxlength="18"
                  inputmode="numeric"
                  required
                >
              </div>
            </div>
          </div>

          <div class="duas-colunas">
            <div class="campo">
              <label for="cadastroSenha">
                Senha
              </label>

              <div class="campo-input">
                <span>
                  <img
                    src="/assets/imgs/lock.svg"
                    alt=""
                  >
                </span>

                <input
                  type="password"
                  id="cadastroSenha"
                  name="senha"
                  placeholder="Crie uma senha forte"
                  minlength="12"
                  maxlength="64"
                  autocomplete="new-password"
                  required
                >

                <button
                  type="button"
                  class="mostrar-senha"
                  data-input="cadastroSenha"
                  aria-label="Mostrar ou ocultar senha"
                >
                  👁
                </button>
              </div>
            </div>

            <div class="campo">
              <label for="confirmarSenha">
                Confirmar senha
              </label>

              <div class="campo-input">
                <span>
                  <img
                    src="/assets/imgs/lock.svg"
                    alt=""
                  >
                </span>

                <input
                  type="password"
                  id="confirmarSenha"
                  name="confirmarSenha"
                  placeholder="Repita a senha"
                  minlength="12"
                  maxlength="64"
                  autocomplete="new-password"
                  required
                >

                <button
                  type="button"
                  class="mostrar-senha"
                  data-input="confirmarSenha"
                  aria-label="Mostrar ou ocultar senha"
                >
                  👁
                </button>
              </div>
            </div>
          </div>

          <label class="termos">
            <input
              type="checkbox"
              id="aceitarTermos"
              name="aceitarTermos"
              value="on"
              <%= typeof formData !== 'undefined' && formData.aceitarTermos ? 'checked' : '' %>
              required
            >

            <span>
              Concordo com os
              <a href="/termos" target="_blank">
                Termos de Uso
              </a>
              e com a
              <a href="/privacidade" target="_blank">
                Política de Privacidade
              </a>.
            </span>
          </label>

          <button
            type="submit"
            class="btn-principal"
          >
            Criar minha conta
          </button>
        </form>

        <p class="auth-rodape">
         <img src="./assets/imgs/lock.svg"> Sistema online seguro para a gestão do seu estabelecimento.
        </p>
      </div>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    const btnLogin = document.querySelector('#btnLogin');
    const btnCadastro = document.querySelector('#btnCadastro');

    const formLogin = document.querySelector('#formLogin');
    const formCadastro = document.querySelector('#formCadastro');
    const lembrarAcesso = document.querySelector('#lembrarAcesso');
    const loginEmail = document.querySelector('#loginEmail');
    const CHAVE_EMAIL_LEMBRADO = 'comandaFacilLoginEmail';

    try {
      const emailLembrado = localStorage.getItem(CHAVE_EMAIL_LEMBRADO);

      if (emailLembrado) {
        loginEmail.value = emailLembrado;
        lembrarAcesso.checked = true;
      }
    } catch (erro) {
      console.warn('Não foi possível recuperar o e-mail lembrado.', erro);
    }

    formLogin.addEventListener('submit', () => {
      try {
        if (lembrarAcesso.checked) {
          localStorage.setItem(
            CHAVE_EMAIL_LEMBRADO,
            loginEmail.value.trim().toLowerCase()
          );
        } else {
          localStorage.removeItem(CHAVE_EMAIL_LEMBRADO);
        }
      } catch (erro) {
        console.warn('Não foi possível salvar a preferência de acesso.', erro);
      }
    });

    const tituloFormulario = document.querySelector(
      '#tituloFormulario'
    );

    const subtituloFormulario = document.querySelector(
      '#subtituloFormulario'
    );

    function abrirLogin() {
      btnLogin.classList.add('ativo');
      btnCadastro.classList.remove('ativo');

      formLogin.classList.add('ativo');
      formCadastro.classList.remove('ativo');

      tituloFormulario.textContent = 'Bem-vindo de volta';

      subtituloFormulario.textContent =
        'Entre com seus dados para acessar o sistema.';
    }

    function abrirCadastro() {
      btnCadastro.classList.add('ativo');
      btnLogin.classList.remove('ativo');

      formCadastro.classList.add('ativo');
      formLogin.classList.remove('ativo');

      tituloFormulario.textContent = 'Crie sua conta';

      subtituloFormulario.textContent =
        'Cadastre seu estabelecimento e comece seu teste grátis.';
    }

    btnLogin.addEventListener('click', abrirLogin);
    btnCadastro.addEventListener('click', abrirCadastro);

    document
      .querySelectorAll('.mostrar-senha')
      .forEach(botao => {
        botao.addEventListener('click', () => {
          const input = document.getElementById(
            botao.dataset.input
          );

          const mostrar = input.type === 'password';

          input.type = mostrar ? 'text' : 'password';
          botao.textContent = mostrar ? '🙈' : '👁';
        });
      });

    formCadastro.addEventListener('submit', event => {
      const aceitarTermos = document.querySelector('#aceitarTermos');

      if (!aceitarTermos.checked) {
        event.preventDefault();
        alert('Para criar a conta, aceite os Termos de Uso e a Política de Privacidade.');
        aceitarTermos.focus();
        return;
      }

      const senha = document.querySelector(
        '#cadastroSenha'
      ).value;

      const confirmarSenha = document.querySelector(
        '#confirmarSenha'
      ).value;

      if (senha !== confirmarSenha) {
        event.preventDefault();

        alert('As senhas não são iguais.');

        document
          .querySelector('#confirmarSenha')
          .focus();
      }
    });

    const telefone = document.querySelector('#telefone');

    telefone.addEventListener('input', event => {
      let valor = event.target.value.replace(/\D/g, '');

      valor = valor.slice(0, 11);

      if (valor.length > 10) {
        valor = valor.replace(
          /^(\d{2})(\d{5})(\d{4})$/,
          '($1) $2-$3'
        );
      } else if (valor.length > 6) {
        valor = valor.replace(
          /^(\d{2})(\d{4})(\d{0,4})$/,
          '($1) $2-$3'
        );
      } else if (valor.length > 2) {
        valor = valor.replace(
          /^(\d{2})(\d+)/,
          '($1) $2'
        );
      } else if (valor.length > 0) {
        valor = valor.replace(
          /^(\d{0,2})/,
          '($1'
        );
      }

      event.target.value = valor;
    });

    const cpfCnpj = document.querySelector('#cpfCnpj');

    cpfCnpj.addEventListener('input', event => {
      let valor = event.target.value.replace(/\D/g, '');

      valor = valor.slice(0, 14);

      if (valor.length <= 11) {
        valor = valor
          .replace(/^(\d{3})(\d)/, '$1.$2')
          .replace(
            /^(\d{3})\.(\d{3})(\d)/,
            '$1.$2.$3'
          )
          .replace(
            /^(\d{3})\.(\d{3})\.(\d{3})(\d)/,
            '$1.$2.$3-$4'
          );
      } else {
        valor = valor
          .replace(/^(\d{2})(\d)/, '$1.$2')
          .replace(
            /^(\d{2})\.(\d{3})(\d)/,
            '$1.$2.$3'
          )
          .replace(
            /^(\d{2})\.(\d{3})\.(\d{3})(\d)/,
            '$1.$2.$3/$4'
          )
          .replace(
            /^(\d{2})\.(\d{3})\.(\d{3})\/(\d{4})(\d)/,
            '$1.$2.$3/$4-$5'
          );
      }

      event.target.value = valor;
    });

    const possuiDadosCadastro =
      document.body.dataset.formCadastro === 'true';

    const rotaCadastro =
      window.location.pathname.includes('/cadastro');

    if (possuiDadosCadastro || rotaCadastro) {
      abrirCadastro();
    }

    const rotaLogin =
      window.location.pathname.includes('/login');

    if (rotaLogin) {
      abrirLogin();
    }
  </script>
</body>
</html>

  <script nonce="<%= cspNonce %>">
    const cart = [];
    let lojaDisponivelPublica =
      <%- safeJsonForHtml(lojaDisponivel !== false) %>;

    const PUBLIC_ORDER_LIMITS = Object.freeze({
      maxItems: 50,
      maxTotalQuantity: 200,
      maxQuantityPerItem: 99,
      maxAdditionsPerItem: 20,
    });

    const cartElement =
      document.querySelector('#cart');

    const cartOverlay =
      document.querySelector('#cartOverlay');

    const cartItems =
      document.querySelector('#cartItems');

    const cartCount =
      document.querySelector('#cartCount');

    const cartTotal =
      document.querySelector('#cartTotal');

    const cartTotalButton =
      document.querySelector('#cartTotalButton');

    const ratingModal =
      document.querySelector('#ratingModal');

    const ratingProducts =
      document.querySelector('#ratingProducts');

    const ratingOrderNumber =
      document.querySelector('#ratingOrderNumber');

    let currentPedidoId = null;
    let currentRatingItems = [];

    function escaparHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function urlImagemSegura(value) {
      const text = String(value ?? '').trim();
      if (/[\u0000-\u001F\u007F]/.test(text)) return '';
      if (text.startsWith('/') && !text.startsWith('//')) return text;
      if (/^data:image\/(?:png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=\s]+$/i.test(text)) {
        return text;
      }
      try {
        const url = new URL(text);
        return url.protocol === 'https:' ? url.href : '';
      } catch {
        return '';
      }
    }

    function money(value) {
      return Number(value || 0).toLocaleString(
        'pt-BR',
        {
          style: 'currency',
          currency: 'BRL'
        }
      );
    }

    function showToast(message) {
      const toast =
        document.querySelector('#successToast');

      toast.textContent = message;
      toast.classList.add('show');

      window.setTimeout(() => {
        toast.classList.remove('show');
      }, 3500);
    }

    function openCart() {
      cartElement.classList.add('open');
      cartOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeCart() {
      cartElement.classList.remove('open');
      cartOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    document
      .querySelector('#openCart')
      .addEventListener('click', openCart);

    document
      .querySelector('#closeCart')
      .addEventListener('click', closeCart);

    cartOverlay.addEventListener('click', closeCart);

    const addonModal =
      document.querySelector('#addonModal');

    const addonOptions =
      document.querySelector('#addonOptions');

    const variationModal = document.querySelector('#variationModal');
    const variationSelect = document.querySelector('#variationSelect');
    const variationPricePreview = document.querySelector('#variationPricePreview');
    const variationProductName = document.querySelector('#variationProductName');

    const pizzaModal = document.querySelector('#pizzaModal');
    const pizzaTamanho = document.querySelector('#pizzaTamanho');
    const pizzaTamanhoField = document.querySelector('#pizzaTamanhoField');
    const pizzaMeioAMeioOption = document.querySelector('#pizzaMeioAMeioOption');
    const pizzaTresSaboresOption = document.querySelector('#pizzaTresSaboresOption');
    const pizzaSabor1 = document.querySelector('#pizzaSabor1');
    const pizzaSabor2 = document.querySelector('#pizzaSabor2');
    const pizzaSabor3 = document.querySelector('#pizzaSabor3');
    const pizzaSabor2Field = document.querySelector('#pizzaSabor2Field');
    const pizzaSabor3Field = document.querySelector('#pizzaSabor3Field');
    const pizzaPricePreview = document.querySelector('#pizzaPricePreview');
    const pizzaRuleNote = document.querySelector('#pizzaRuleNote');

    let pendingProductToAdd = null;
    let pendingVariationMesa = null;
    let pendingPizzaMesa = null;

    function jsonArrayDataset(element, key) {
      try {
        const value = JSON.parse(element?.dataset?.[key] || '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function produtoMesaDoBotao(button) {
      if (!button) return null;
      return {
        produtoId: String(button.dataset.id || ''),
        nome: String(button.dataset.name || ''),
        preco: Number(button.dataset.price || 0),
        imagem: String(button.dataset.image || ''),
        adicionais: jsonArrayDataset(button, 'additionals'),
        precosPizza: jsonArrayDataset(button, 'productPizzaPrices').map(item => ({
          tamanhoId: String(item.tamanhoId || ''),
          tamanhoNome: String(item.tamanhoNome || ''),
          preco: Number(item.preco || 0),
        })),
        categoria: {
          id: String(button.dataset.categoryId || ''),
          tipoProduto: String(button.dataset.categoryType || 'normal'),
          permiteMeioAMeio: button.dataset.pizzaHalfEnabled === 'true',
          regraPrecoMeioAMeio: String(button.dataset.pizzaPriceRule || 'maior_sabor_escolhido'),
          categoriasMeioAMeio: jsonArrayDataset(button, 'pizzaCompatibleCategories')
            .map(item => String(item?.id || item?._id || item || ''))
            .filter(Boolean),
          tamanhos: jsonArrayDataset(button, 'pizzaSizes').map(item => ({
            id: String(item.id || item._id || ''),
            nome: String(item.nome || ''),
            maxSabores: Math.max(1, Math.min(3, Number(item.maxSabores || 2))),
          })),
        },
      };
    }

    const produtosMesaMap = new Map(
      [...document.querySelectorAll('.add-button')]
        .map(produtoMesaDoBotao)
        .filter(Boolean)
        .map(produto => [produto.produtoId, produto])
    );

    function totalCartQuantity() {
      return cart.reduce(
        (sum, item) => sum + Number(item.quantidade || 0),
        0
      );
    }

    function addProductToCart(product, additionals = []) {
      if (additionals.length > PUBLIC_ORDER_LIMITS.maxAdditionsPerItem) {
        alert(`Escolha no máximo ${PUBLIC_ORDER_LIMITS.maxAdditionsPerItem} adicionais por item.`);
        return false;
      }

      const additionsKey =
        additionals
          .map(adicional => adicional._id)
          .sort()
          .join(',');

      const variationKey = String(product.variacao?.id || '');
      const tamanhoKey = String(product.tamanhoPizza?.id || '');
      const pizzaKey = product.pizzaMeioAMeio
        ? (product.saboresPizza || [])
            .map(sabor => String(sabor.produtoId || ''))
            .sort()
            .join('+')
        : '';
      const cartKey = [
        String(product.produtoId || ''),
        `pizza:${pizzaKey}`,
        `regra:${String(product.regraPrecoPizza || '')}`,
        `tamanho:${tamanhoKey}`,
        `variacao:${variationKey}`,
        `adicionais:${additionsKey}`,
      ].join('|');
      const existing = cart.find(item => item.cartKey === cartKey);

      if (totalCartQuantity() >= PUBLIC_ORDER_LIMITS.maxTotalQuantity) {
        alert(`O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxTotalQuantity} unidades.`);
        return false;
      }

      if (existing && Number(existing.quantidade || 0) >= PUBLIC_ORDER_LIMITS.maxQuantityPerItem) {
        alert(`Cada item pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxQuantityPerItem} unidades.`);
        return false;
      }

      if (!existing && cart.length >= PUBLIC_ORDER_LIMITS.maxItems) {
        alert(`O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxItems} itens diferentes.`);
        return false;
      }

      if (existing) {
        existing.quantidade += 1;
      } else {
        cart.push({
          ...product,
          adicionais: additionals,
          additionsKey,
          cartKey,
          quantidade: 1,
          observacao: '',
        });
      }

      renderCart();
      openCart();
      return true;
    }

    function closeAddonModal() {
      addonModal.classList.remove('open');
      pendingProductToAdd = null;
      document.body.style.overflow = '';
    }

    function abrirAdicionaisMesa(product, additionals) {
      if (!additionals.length) {
        addProductToCart(product, []);
        return;
      }

      pendingProductToAdd = { product, additionals };
      document.querySelector('#addonProductName').textContent =
        `Adicionais de ${product.nome}`;
      addonOptions.replaceChildren();
      additionals.forEach(adicional => {
        const option = document.createElement('div');
        option.className = 'addon-option';
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = String(adicional._id || '');
        label.append(input, document.createTextNode(` ${String(adicional.nome || '')}`));
        const price = document.createElement('strong');
        price.textContent = `+ ${money(adicional.preco)}`;
        option.append(label, price);
        addonOptions.appendChild(option);
      });
      addonModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function produtosDaCategoriaMesa(categoriaId) {
      return [...produtosMesaMap.values()]
        .filter(produto => produto.categoria?.id === String(categoriaId || ''))
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
    }

    function idsCategoriasPizzaMesaPermitidas(categoria = {}) {
      return new Set([
        String(categoria?.id || ''),
        ...(categoria?.categoriasMeioAMeio || []).map(id => String(id || '')),
      ].filter(Boolean));
    }

    function produtosCategoriasPizzaMesaPermitidas(categoria = {}) {
      const idsPermitidos = idsCategoriasPizzaMesaPermitidas(categoria);
      return [...produtosMesaMap.values()]
        .filter(produto =>
          produto.categoria?.tipoProduto === 'pizza'
          && idsPermitidos.has(String(produto.categoria?.id || ''))
        )
        .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
    }

    function normalizarNomeTamanhoPizzaMesa(value) {
      return String(value || '')
        .trim()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLocaleLowerCase('pt-BR');
    }

    function modoPizzaMesaSelecionado() {
      return document.querySelector('input[name="pizzaModoMesa"]:checked')?.value
        || 'inteira';
    }

    function quantidadeSaboresModoPizzaMesa() {
      const modo = modoPizzaMesaSelecionado();
      if (modo === 'tres_sabores') return 3;
      if (modo === 'meio_a_meio') return 2;
      return 1;
    }

    function precoProdutoPizzaMesaNoTamanho(produto, tamanhoId = '', tamanhoNome = '') {
      const tamanhos = produto?.categoria?.tamanhos || [];
      if (!tamanhos.length) {
        return tamanhoId || tamanhoNome ? Number.NaN : Number(produto?.preco || 0);
      }
      let tamanhoProduto = tamanhos.find(tamanho =>
        String(tamanho.id || '') === String(tamanhoId || '')
      );
      if (!tamanhoProduto && tamanhoNome) {
        const nomeNormalizado = normalizarNomeTamanhoPizzaMesa(tamanhoNome);
        tamanhoProduto = tamanhos.find(tamanho =>
          normalizarNomeTamanhoPizzaMesa(tamanho.nome) === nomeNormalizado
        );
      }
      if (!tamanhoProduto) return Number.NaN;
      const item = (produto?.precosPizza || []).find(preco =>
        String(preco.tamanhoId || '') === String(tamanhoProduto.id || '')
      );
      return item ? Number(item.preco) : Number.NaN;
    }

    function tamanhosPizzaMesaDisponiveis(produto) {
      const tamanhos = produto?.categoria?.tamanhos || [];
      if (!tamanhos.length) return [];
      return tamanhos.filter(tamanho =>
        Number.isFinite(precoProdutoPizzaMesaNoTamanho(produto, tamanho.id, tamanho.nome))
      );
    }

    function tamanhoPizzaMesaSelecionado() {
      if (!pendingPizzaMesa?.tamanhos?.length) return null;
      return pendingPizzaMesa.tamanhos.find(
        item => item.id === String(pizzaTamanho.value || '')
      ) || null;
    }

    function maxSaboresTamanhoPizzaMesaSelecionado() {
      if (!pendingPizzaMesa?.permiteMeioAMeio) return 1;
      const tamanho = tamanhoPizzaMesaSelecionado();
      if (!pendingPizzaMesa?.tamanhos?.length) return 2;
      const maximo = Number(tamanho?.maxSabores || 2);
      return Number.isInteger(maximo) ? Math.max(1, Math.min(3, maximo)) : 2;
    }

    function calcularPrecoPizzaMesa({
      sabores = [],
      regra,
      tamanhoId = '',
      tamanhoNome = '',
    }) {
      const selecionados = (sabores || []).filter(Boolean);
      if (!selecionados.length) return Number.NaN;
      const precosSabores = selecionados.map(sabor =>
        precoProdutoPizzaMesaNoTamanho(sabor, tamanhoId, tamanhoNome)
      );
      if (precosSabores.some(preco => !Number.isFinite(preco))) return Number.NaN;
      if (selecionados.length === 1) return precosSabores[0];
      if (regra === 'maior_preco_categoria') {
        const precos = produtosCategoriasPizzaMesaPermitidas(selecionados[0]?.categoria)
          .map(produto => precoProdutoPizzaMesaNoTamanho(produto, tamanhoId, tamanhoNome))
          .filter(Number.isFinite);
        return precos.length ? Math.max(...precos) : Number.NaN;
      }
      return Math.max(...precosSabores);
    }

    function preencherTamanhosPizzaMesa(produto) {
      const tamanhos = tamanhosPizzaMesaDisponiveis(produto);
      pizzaTamanho.replaceChildren();
      pizzaTamanhoField.classList.toggle('hidden', !tamanhos.length);
      pizzaTamanho.disabled = !tamanhos.length;
      pizzaTamanho.required = tamanhos.length > 0;
      tamanhos.forEach(tamanho => {
        const option = document.createElement('option');
        option.value = tamanho.id;
        option.textContent = tamanho.nome;
        pizzaTamanho.appendChild(option);
      });
    }

    function preencherSaboresPizzaMesa(select, produtos, selectedId = '', tamanhoId = '', tamanhoNome = '') {
      select.replaceChildren();
      produtos.forEach(produto => {
        const option = document.createElement('option');
        const preco = precoProdutoPizzaMesaNoTamanho(produto, tamanhoId, tamanhoNome);
        option.value = produto.produtoId;
        option.disabled = !Number.isFinite(preco);
        option.textContent = Number.isFinite(preco)
          ? `${produto.nome} — ${money(preco)}`
          : `${produto.nome} — indisponível neste tamanho`;
        option.selected = produto.produtoId === selectedId && !option.disabled;
        select.appendChild(option);
      });
      if (!select.value || select.selectedOptions[0]?.disabled) {
        const primeiro = [...select.options].find(option => !option.disabled);
        if (primeiro) select.value = primeiro.value;
      }
    }

    function selecionarSaborMesaDiferente(select, idsUsados = []) {
      if (!select) return;
      const usados = new Set(idsUsados.map(String));
      if (select.value && !usados.has(String(select.value))) return;
      const opcao = [...select.options].find(option =>
        !option.disabled && !usados.has(String(option.value || ''))
      );
      if (opcao) select.value = opcao.value;
    }

    function atualizarModalPizzaMesa({ atualizarSabores = false } = {}) {
      if (!pendingPizzaMesa) return;
      const maxSabores = maxSaboresTamanhoPizzaMesaSelecionado();
      let quantidadeSabores = quantidadeSaboresModoPizzaMesa();
      if (quantidadeSabores > maxSabores) {
        document.querySelector('input[name="pizzaModoMesa"][value="inteira"]').checked = true;
        quantidadeSabores = 1;
      }

      pizzaMeioAMeioOption.classList.toggle('hidden', maxSabores < 2);
      pizzaTresSaboresOption.classList.toggle('hidden', maxSabores < 3);
      document.querySelector('input[name="pizzaModoMesa"][value="meio_a_meio"]').disabled = maxSabores < 2;
      document.querySelector('input[name="pizzaModoMesa"][value="tres_sabores"]').disabled = maxSabores < 3;
      pizzaSabor2Field.classList.toggle('hidden', quantidadeSabores < 2);
      pizzaSabor3Field.classList.toggle('hidden', quantidadeSabores < 3);
      pizzaSabor2.disabled = quantidadeSabores < 2;
      pizzaSabor3.disabled = quantidadeSabores < 3;

      const tamanho = tamanhoPizzaMesaSelecionado();
      const tamanhoId = tamanho?.id || '';
      const tamanhoNome = tamanho?.nome || '';
      if (atualizarSabores) {
        const categoriaBase = produtosMesaMap.get(pendingPizzaMesa.produtoInicialId)?.categoria || {};
        const produtosCategoria = produtosDaCategoriaMesa(pendingPizzaMesa.categoriaId);
        const produtosCompativeis = produtosCategoriasPizzaMesaPermitidas(categoriaBase);
        preencherSaboresPizzaMesa(
          pizzaSabor1,
          produtosCategoria,
          String(pizzaSabor1.value || pendingPizzaMesa.produtoInicialId || ''),
          tamanhoId,
          tamanhoNome,
        );
        preencherSaboresPizzaMesa(
          pizzaSabor2,
          produtosCompativeis,
          String(pizzaSabor2.value || ''),
          tamanhoId,
          tamanhoNome,
        );
        preencherSaboresPizzaMesa(
          pizzaSabor3,
          produtosCompativeis,
          String(pizzaSabor3.value || ''),
          tamanhoId,
          tamanhoNome,
        );
      }

      selecionarSaborMesaDiferente(pizzaSabor2, [pizzaSabor1.value]);
      selecionarSaborMesaDiferente(pizzaSabor3, [pizzaSabor1.value, pizzaSabor2.value]);

      const sabores = [
        produtosMesaMap.get(String(pizzaSabor1.value || '')),
        produtosMesaMap.get(String(pizzaSabor2.value || '')),
        produtosMesaMap.get(String(pizzaSabor3.value || '')),
      ].slice(0, quantidadeSabores);
      const ids = sabores.map(sabor => String(sabor?.produtoId || '')).filter(Boolean);
      const repetidos = ids.length !== new Set(ids).size;
      const preco = calcularPrecoPizzaMesa({
        sabores,
        regra: pendingPizzaMesa.regra,
        tamanhoId,
        tamanhoNome,
      });
      const tamanhoPendente = pendingPizzaMesa.tamanhos.length > 0 && !tamanho;
      const precoInvalido = !Number.isFinite(preco);
      const mensagemRepetido = repetidos ? 'Escolha sabores diferentes.' : '';

      pizzaPricePreview.textContent = precoInvalido ? 'Indisponível' : money(preco);
      pizzaSabor2.setCustomValidity(mensagemRepetido);
      pizzaSabor3.setCustomValidity(mensagemRepetido);
      document.querySelector('#confirmPizza').disabled = Boolean(
        tamanhoPendente
        || precoInvalido
        || sabores.length !== quantidadeSabores
        || sabores.some(sabor => !sabor)
        || repetidos
      );

      const tamanhoTexto = tamanho ? ` no tamanho ${tamanho.nome}` : '';
      if (quantidadeSabores === 1) {
        pizzaRuleNote.textContent = `O sabor inteiro usa o preço cadastrado${tamanhoTexto}.`;
      } else if (pendingPizzaMesa.regra === 'maior_preco_categoria') {
        pizzaRuleNote.textContent = `Regra da loja: será cobrado o maior preço das pizzas das categorias permitidas${tamanhoTexto}.`;
      } else {
        pizzaRuleNote.textContent = `Regra da loja: será cobrado o maior preço entre os ${quantidadeSabores} sabores escolhidos${tamanhoTexto}.`;
      }
    }

    function fecharPizzaMesa() {
      pizzaModal.classList.remove('open');
      pendingPizzaMesa = null;
      document.body.style.overflow = '';
    }

    function abrirPizzaMesa(produto) {
      const produtosCategoria = produtosDaCategoriaMesa(produto.categoria.id);
      const produtosCompativeis = produtosCategoriasPizzaMesaPermitidas(produto.categoria);
      pendingPizzaMesa = {
        categoriaId: produto.categoria.id,
        produtoInicialId: produto.produtoId,
        regra: produto.categoria.regraPrecoMeioAMeio,
        permiteMeioAMeio: produto.categoria.permiteMeioAMeio === true,
        tamanhos: tamanhosPizzaMesaDisponiveis(produto),
      };

      document.querySelector('input[name="pizzaModoMesa"][value="inteira"]').checked = true;
      preencherTamanhosPizzaMesa(produto);
      const tamanhoId = pendingPizzaMesa.tamanhos[0]?.id || '';
      if (tamanhoId) pizzaTamanho.value = tamanhoId;
      const tamanhoNome = pendingPizzaMesa.tamanhos[0]?.nome || '';
      preencherSaboresPizzaMesa(pizzaSabor1, produtosCategoria, produto.produtoId, tamanhoId, tamanhoNome);
      const segundo = produtosCompativeis.find(item => item.produtoId !== produto.produtoId)?.produtoId
        || produto.produtoId;
      preencherSaboresPizzaMesa(pizzaSabor2, produtosCompativeis, segundo, tamanhoId, tamanhoNome);
      const terceiro = produtosCompativeis.find(item =>
        item.produtoId !== produto.produtoId && item.produtoId !== segundo
      )?.produtoId || segundo;
      preencherSaboresPizzaMesa(pizzaSabor3, produtosCompativeis, terceiro, tamanhoId, tamanhoNome);
      atualizarModalPizzaMesa();
      pizzaModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function precoVariacaoMesa(precos, variacaoId) {
      const item = (precos || []).find(preco =>
        String(preco.variacaoId || '') === String(variacaoId || '')
      );
      return item ? Number(item.preco) : Number.NaN;
    }

    function fecharVariacaoMesa() {
      variationModal.classList.remove('open');
      pendingVariationMesa = null;
      document.body.style.overflow = '';
    }

    function abrirVariacaoMesa(product, additionals, variacoes, precos) {
      const disponiveis = variacoes.filter(opcao =>
        Number.isFinite(precoVariacaoMesa(precos, opcao.id))
      );
      if (!disponiveis.length) return;
      pendingVariationMesa = { product, additionals, variacoes: disponiveis, precos };
      variationProductName.textContent = `Escolha uma opção para ${product.nome}`;
      variationSelect.replaceChildren();
      disponiveis.forEach(opcao => {
        const option = document.createElement('option');
        option.value = opcao.id;
        option.textContent = `${opcao.nome} — ${money(precoVariacaoMesa(precos, opcao.id))}`;
        variationSelect.appendChild(option);
      });
      const atualizar = () => {
        const opcao = disponiveis.find(item => item.id === String(variationSelect.value || ''));
        const preco = opcao ? precoVariacaoMesa(precos, opcao.id) : Number.NaN;
        variationPricePreview.textContent = Number.isFinite(preco) ? money(preco) : 'Indisponível';
        document.querySelector('#confirmVariation').disabled = !opcao || !Number.isFinite(preco);
      };
      variationSelect.onchange = atualizar;
      atualizar();
      variationModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    document
      .querySelectorAll('.add-button')
      .forEach(button => {
        button.addEventListener('click', () => {
          const product = produtosMesaMap.get(String(button.dataset.id || ''))
            || produtoMesaDoBotao(button);
          if (!product) return;

          const additionals = product.adicionais || [];
          const variacoes = jsonArrayDataset(button, 'categoryVariations');
          const precosVariacoes = jsonArrayDataset(button, 'productVariationPrices');

          if (
            product.categoria?.tipoProduto === 'pizza'
            && (
              product.categoria?.permiteMeioAMeio === true
              || (product.categoria?.tamanhos || []).length > 0
            )
          ) {
            abrirPizzaMesa(product);
            return;
          }

          if (button.dataset.variationsEnabled === 'true' && variacoes.length) {
            abrirVariacaoMesa(product, additionals, variacoes, precosVariacoes);
            return;
          }

          abrirAdicionaisMesa(product, additionals);
        });
      });

    document.querySelectorAll('input[name="pizzaModoMesa"]').forEach(input => {
      input.addEventListener('change', atualizarModalPizzaMesa);
    });
    pizzaTamanho.addEventListener('change', () =>
      atualizarModalPizzaMesa({ atualizarSabores: true })
    );
    pizzaSabor1.addEventListener('change', atualizarModalPizzaMesa);
    pizzaSabor2.addEventListener('change', atualizarModalPizzaMesa);
    pizzaSabor3.addEventListener('change', atualizarModalPizzaMesa);
    document.querySelector('#closePizzaModal').addEventListener('click', fecharPizzaMesa);
    document.querySelector('#cancelPizza').addEventListener('click', fecharPizzaMesa);
    pizzaModal.addEventListener('click', event => {
      if (event.target === pizzaModal) fecharPizzaMesa();
    });
    document.querySelector('#confirmPizza').addEventListener('click', () => {
      if (!pendingPizzaMesa) return;
      const tamanho = tamanhoPizzaMesaSelecionado();
      const tamanhoId = tamanho?.id || '';
      const tamanhoNome = tamanho?.nome || '';
      if (pendingPizzaMesa.tamanhos.length && !tamanho) {
        pizzaTamanho.setCustomValidity('Escolha o tamanho da pizza.');
        pizzaTamanho.reportValidity();
        return;
      }
      pizzaTamanho.setCustomValidity('');

      const quantidadeSabores = quantidadeSaboresModoPizzaMesa();
      const maxSabores = maxSaboresTamanhoPizzaMesaSelecionado();
      if (quantidadeSabores > maxSabores) {
        atualizarModalPizzaMesa();
        return;
      }
      const sabores = [
        produtosMesaMap.get(String(pizzaSabor1.value || '')),
        produtosMesaMap.get(String(pizzaSabor2.value || '')),
        produtosMesaMap.get(String(pizzaSabor3.value || '')),
      ].slice(0, quantidadeSabores);
      if (sabores.some(sabor => !sabor)) return;
      const idsSabores = sabores.map(sabor => String(sabor.produtoId || ''));
      if (new Set(idsSabores).size !== idsSabores.length) {
        const campo = quantidadeSabores === 3 ? pizzaSabor3 : pizzaSabor2;
        campo.setCustomValidity('Escolha sabores diferentes.');
        campo.reportValidity();
        return;
      }
      pizzaSabor2.setCustomValidity('');
      pizzaSabor3.setCustomValidity('');

      const preco = calcularPrecoPizzaMesa({
        sabores,
        regra: pendingPizzaMesa.regra,
        tamanhoId,
        tamanhoNome,
      });
      if (!Number.isFinite(preco)) return;

      if (quantidadeSabores === 1) {
        const sabor1 = sabores[0];
        const pizzaInteira = {
          ...sabor1,
          preco,
          tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
        };
        fecharPizzaMesa();
        abrirAdicionaisMesa(pizzaInteira, sabor1.adicionais || []);
        return;
      }

      const fracao = 1 / quantidadeSabores;
      const rotuloFracao = quantidadeSabores === 3 ? '1/3' : '1/2';
      const sabor1 = sabores[0];
      const pizza = {
        produtoId: sabor1.produtoId,
        nome: `Pizza ${sabores.map(sabor => `${rotuloFracao} ${sabor.nome}`).join(' + ')}`,
        preco,
        imagem: sabores.find(sabor => sabor.imagem)?.imagem || '',
        categoria: sabor1.categoria,
        tamanhoPizza: tamanho ? { id: tamanho.id, nome: tamanho.nome } : null,
        pizzaMeioAMeio: true,
        saboresPizza: sabores.map(sabor => ({
          produtoId: sabor.produtoId,
          nome: sabor.nome,
          preco: precoProdutoPizzaMesaNoTamanho(sabor, tamanhoId, tamanhoNome),
          fracao,
        })),
        regraPrecoPizza: pendingPizzaMesa.regra,
      };

      fecharPizzaMesa();
      abrirAdicionaisMesa(pizza, sabor1.adicionais || []);
    });

    document.querySelector('#closeVariationModal').addEventListener('click', fecharVariacaoMesa);
    document.querySelector('#cancelVariation').addEventListener('click', fecharVariacaoMesa);
    variationModal.addEventListener('click', event => {
      if (event.target === variationModal) fecharVariacaoMesa();
    });
    document.querySelector('#confirmVariation').addEventListener('click', () => {
      if (!pendingVariationMesa) return;
      const opcao = pendingVariationMesa.variacoes.find(item =>
        item.id === String(variationSelect.value || '')
      );
      if (!opcao) return;
      const preco = precoVariacaoMesa(pendingVariationMesa.precos, opcao.id);
      if (!Number.isFinite(preco)) return;
      const product = {
        ...pendingVariationMesa.product,
        preco,
        variacao: { id: opcao.id, nome: opcao.nome },
      };
      const additionals = pendingVariationMesa.additionals;
      fecharVariacaoMesa();
      abrirAdicionaisMesa(product, additionals);
    });

    document
      .querySelector('#closeAddonModal')
      .addEventListener('click', closeAddonModal);

    document
      .querySelector('#cancelAddon')
      .addEventListener('click', closeAddonModal);

    document
      .querySelector('#confirmAddon')
      .addEventListener('click', () => {
        if (!pendingProductToAdd) {
          return;
        }

        const selectedIds = Array.from(
          addonOptions.querySelectorAll(
            'input:checked'
          )
        ).map(input => input.value);

        if (selectedIds.length > PUBLIC_ORDER_LIMITS.maxAdditionsPerItem) {
          alert(`Escolha no máximo ${PUBLIC_ORDER_LIMITS.maxAdditionsPerItem} adicionais por item.`);
          return;
        }

        const selected = pendingProductToAdd
          .additionals
          .filter(adicional =>
            selectedIds.includes(adicional._id)
          );

        if (addProductToCart(
          pendingProductToAdd.product,
          selected
        )) {
          closeAddonModal();
        }
      });

    function changeQuantity(index, value) {
      const item = cart[index];
      if (!item) return;

      if (value > 0) {
        if (totalCartQuantity() >= PUBLIC_ORDER_LIMITS.maxTotalQuantity) {
          alert(`O pedido pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxTotalQuantity} unidades.`);
          return;
        }
        if (Number(item.quantidade || 0) >= PUBLIC_ORDER_LIMITS.maxQuantityPerItem) {
          alert(`Cada item pode ter no máximo ${PUBLIC_ORDER_LIMITS.maxQuantityPerItem} unidades.`);
          return;
        }
      }

      item.quantidade += value;

      if (item.quantidade <= 0) {
        cart.splice(index, 1);
      }

      renderCart();
    }

    function renderCart() {
      cartItems.replaceChildren();

      if (!cart.length) {
        const empty = document.createElement('div');
        empty.className = 'empty';
        empty.textContent = 'Seu carrinho está vazio.';
        cartItems.appendChild(empty);
      }

      cart.forEach((item, index) => {
        const element =
          document.createElement('div');

        element.className = 'cart-item';

        element.innerHTML = '<div class="cart-item-image"></div><div><div class="cart-item-top"><div><strong class="cart-item-name"></strong><small class="cart-item-addons" style="display:block;margin-top:4px;color:#756a65"></small></div><strong class="cart-item-price"></strong></div><div class="quantity"><button type="button" data-action="minus">−</button><span></span><button type="button" data-action="plus">+</button></div><input class="item-note" placeholder="Observação deste item" maxlength="300"></div>';
        const imageBox = element.querySelector('.cart-item-image');
        const imageUrl = urlImagemSegura(item.imagem);
        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = String(item.nome || '');
          imageBox.appendChild(image);
        } else {
          imageBox.textContent = '🍽️';
        }
        element.querySelector('.cart-item-name').textContent =
          String(item.nome || '');
        const addons = element.querySelector('.cart-item-addons');
        const detalhesItem = [];
        if (item.tamanhoPizza?.nome) detalhesItem.push(`📏 ${item.tamanhoPizza.nome}`);
        if (item.variacao?.nome) detalhesItem.push(`📏 ${item.variacao.nome}`);
        if (item.pizzaMeioAMeio) {
          const rotuloFracaoPizza = (item.saboresPizza || []).length === 3 ? '1/3' : '1/2';
          detalhesItem.push(...(item.saboresPizza || []).map(sabor => `🍕 ${rotuloFracaoPizza} ${sabor.nome}`));
        }
        detalhesItem.push(...(item.adicionais || [])
          .map(adicional => `+ ${adicional.nome} (${money(adicional.preco)})`));
        addons.textContent = detalhesItem.join('\n');
        element.querySelector('.cart-item-price').textContent = money(
          (
            Number(item.preco || 0) +
            (item.adicionais || []).reduce(
              (sum, adicional) => sum + Number(adicional.preco || 0),
              0
            )
          ) * Number(item.quantidade || 0)
        );
        element.querySelector('.quantity span').textContent =
          String(item.quantidade);
        element.querySelector('.item-note').value =
          String(item.observacao || '');

        element
          .querySelector('[data-action="minus"]')
          .addEventListener('click', () => {
            changeQuantity(index, -1);
          });

        element
          .querySelector('[data-action="plus"]')
          .addEventListener('click', () => {
            changeQuantity(index, 1);
          });

        element
          .querySelector('.item-note')
          .addEventListener(
            'input',
            event => {
              item.observacao =
                event.target.value;
            }
          );

        cartItems.appendChild(element);
      });

      const total = cart.reduce(
        (sum, item) =>
          sum +
          (
            item.preco +
            (item.adicionais || []).reduce(
              (subtotal, adicional) =>
                subtotal + Number(adicional.preco || 0),
              0
            )
          ) *
          item.quantidade,
        0
      );

      const count = cart.reduce(
        (sum, item) =>
          sum + item.quantidade,
        0
      );

      cartCount.textContent = count;
      cartTotal.textContent = money(total);
      cartTotalButton.textContent =
        money(total);
    }

    document
      .querySelectorAll('[data-rate-product]')
      .forEach(button => {
        button.addEventListener('click', () => {
          const pedidoId =
            button.dataset.rateOrder;

          if (!pedidoId) {
            return;
          }

          currentPedidoId = pedidoId;

          currentRatingItems = [{
            produtoId:
              button.dataset.rateProduct,
            nome:
              button.dataset.rateName,
            nota: 0,
            comentario: ''
          }];

          ratingOrderNumber.textContent =
            `Avalie ${button.dataset.rateName}`;

          renderRatingProducts();
          ratingModal.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });

    function openRating(result) {
      currentPedidoId = result.pedidoId;

      currentRatingItems =
        (result.itens || []).map(item => ({
          produtoId: item.produtoId,
          nome: item.nome,
          nota: 0,
          comentario: ''
        }));

      ratingOrderNumber.textContent =
        `Pedido #${result.numeroPedido || ''} enviado${result.codigoPublico ? ` · Código: ${result.codigoPublico}` : ''}. Avalie os itens abaixo.`;

      renderRatingProducts();
      ratingModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeRating() {
      ratingModal.classList.remove('open');
      document.body.style.overflow = '';
      window.location.reload();
    }

    function renderRatingProducts() {
      ratingProducts.replaceChildren();

      currentRatingItems.forEach(
        (item, itemIndex) => {
          const wrapper =
            document.createElement('div');

          wrapper.className =
            'rating-product';

          const title = document.createElement('strong');
          title.textContent = String(item.nome || '');
          const stars = document.createElement('div');
          stars.className = 'stars';
          [1, 2, 3, 4, 5].forEach(value => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `star-button ${value <= item.nota ? 'active' : ''}`;
            button.dataset.value = String(value);
            button.textContent = '★';
            stars.appendChild(button);
          });
          const comment = document.createElement('textarea');
          comment.className = 'rating-comment';
          comment.placeholder = 'Conte o que achou (opcional)';
          comment.maxLength = 500;
          comment.value = String(item.comentario || '');
          wrapper.append(title, stars, comment);

          wrapper
            .querySelectorAll('.star-button')
            .forEach(button => {
              button.addEventListener(
                'click',
                () => {
                  item.nota = Number(
                    button.dataset.value
                  );

                  renderRatingProducts();
                }
              );
            });

          wrapper
            .querySelector('.rating-comment')
            .addEventListener(
              'input',
              event => {
                currentRatingItems[
                  itemIndex
                ].comentario =
                  event.target.value;
              }
            );

          ratingProducts.appendChild(
            wrapper
          );
        }
      );
    }

    const csrfTokenPublico = <%- safeJsonForHtml(csrfToken) %>;

    async function atualizarPedidosMesaSemReload() {
      try {
        const response = await fetch(window.location.href, {
          method: 'GET',
          cache: 'no-store',
          headers: { Accept: 'text/html' },
        });
        if (!response.ok) return false;

        const html = await response.text();
        const pagina = new DOMParser().parseFromString(html, 'text/html');

        for (const selector of ['.pending-orders', '.account-card']) {
          const atual = document.querySelector(selector);
          const novo = pagina.querySelector(selector);
          if (atual && novo) {
            atual.replaceWith(document.importNode(novo, true));
          }
        }
        return true;
      } catch (error) {
        console.error('Não foi possível atualizar os pedidos da mesa:', error);
        return false;
      }
    }

    document.addEventListener('click', async event => {
      const button = event.target.closest('[data-remove-mesa-order]');
      if (!button || button.dataset.busy === 'true') return;

      const pedidoId = String(button.dataset.removeMesaOrder || '').trim();
      if (!pedidoId) return;

      const confirmado = window.confirm(
        'Remover este pedido da mesa?\n\nIsso só é permitido enquanto o pagamento estiver pendente. Se este envio tiver mais de um item, todos os itens enviados juntos serão removidos.'
      );
      if (!confirmado) return;

      const botoesDoPedido = Array.from(document.querySelectorAll('[data-remove-mesa-order]'))
        .filter(item => String(item.dataset.removeMesaOrder || '') === pedidoId);
      botoesDoPedido.forEach(item => {
        item.dataset.busy = 'true';
        item.disabled = true;
        item.textContent = 'Removendo...';
      });

      try {
        const response = await fetch(
          `/mesa/<%= mesa.token %>/pedidos/${encodeURIComponent(pedidoId)}/remover`,
          {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfTokenPublico,
            },
            body: '{}',
          },
        );

        const result = await response.json();
        if (!response.ok) {
          throw new Error(result.message || 'Não foi possível remover o pedido.');
        }

        await atualizarPedidosMesaSemReload();
        showToast(result.message || 'Pedido removido.');
      } catch (error) {
        alert(error.message || 'Não foi possível remover o pedido.');
        botoesDoPedido.forEach(item => {
          item.dataset.busy = '';
          item.disabled = false;
          item.textContent = 'Remover pedido';
        });
      }
    });
    let pedidoIdempotencyKeyAtual = null;
    let pedidoEnvioEmAndamento = false;

    function criarIdempotencyKey() {
      if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
      return "10000000-1000-4000-8000-100000000000".replace(/[018]/g, caractere =>
        (Number(caractere) ^ (globalThis.crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (Number(caractere) / 4))))
          .toString(16));
    }

    document
      .querySelector('#finishOrder')
      .addEventListener(
        'click',
        async () => {
          if (!lojaDisponivelPublica) {
            alert('Esta loja está temporariamente indisponível para novos pedidos.');
            return;
          }
          if (!cart.length) {
            alert(
              'Adicione produtos ao carrinho.'
            );
            return;
          }

          const button =
            document.querySelector(
              '#finishOrder'
            );

          if (pedidoEnvioEmAndamento) return;
          pedidoEnvioEmAndamento = true;
          button.disabled = true;
          button.textContent =
            'Enviando pedido...';

          try {
            const response = await fetch(
              '/mesa/<%= mesa.token %>/pedidos',
              {
                method: 'POST',
                headers: {
                  'Content-Type':
                    'application/json',
                  'X-CSRF-Token': csrfTokenPublico,
                },
                body: JSON.stringify({
                  cliente:
                    document.querySelector(
                      '#clientName'
                    ).value,
                  observacao:
                    document.querySelector(
                      '#orderNote'
                    ).value,
                  idempotencyKey:
                    pedidoIdempotencyKeyAtual ||= criarIdempotencyKey(),
                  itens: cart,
                }),
              }
            );

            const result =
              await response.json();

            if (!response.ok) {
              if (response.status < 500) pedidoIdempotencyKeyAtual = null;
              if (result.code === 'LOJA_INDISPONIVEL') {
                lojaDisponivelPublica = false;
                button.disabled = true;
                button.textContent = 'Loja indisponível';
              }
              throw new Error(
                result.message
              );
            }

            pedidoIdempotencyKeyAtual = null;
            cart.splice(0, cart.length);
            renderCart();
            closeCart();
            await atualizarPedidosMesaSemReload();
            showToast(result.message);
            openRating(result);
          } catch (error) {
            alert(
              error.message ||
              'Não foi possível enviar o pedido.'
            );
          } finally {
            pedidoEnvioEmAndamento = false;
            if (lojaDisponivelPublica) {
              button.disabled = false;
              button.textContent =
                'Finalizar pedido';
            }
          }
        }
      );

    document
      .querySelector('#sendRating')
      .addEventListener(
        'click',
        async () => {
          const avaliacoes =
            currentRatingItems.filter(
              item => item.nota >= 1
            );

          if (!avaliacoes.length) {
            alert(
              'Selecione pelo menos uma nota.'
            );
            return;
          }

          const button =
            document.querySelector(
              '#sendRating'
            );

          button.disabled = true;
          button.textContent =
            'Salvando...';

          try {
            const response = await fetch(
              `/mesa/<%= mesa.token %>/pedidos/${currentPedidoId}/avaliacoes`,
              {
                method: 'POST',
                headers: {
                  'Content-Type':
                    'application/json',
                },
                body: JSON.stringify({
                  avaliacoes
                }),
              }
            );

            const result =
              await response.json();

            if (!response.ok) {
              throw new Error(
                result.message
              );
            }

            showToast(result.message);
            closeRating();
          } catch (error) {
            alert(
              error.message ||
              'Não foi possível salvar a avaliação.'
            );
          } finally {
            button.disabled = false;
            button.textContent =
              'Enviar avaliação';
          }
        }
      );

    document
      .querySelector('#closeRating')
      .addEventListener(
        'click',
        closeRating
      );

    document
      .querySelector('#skipRating')
      .addEventListener(
        'click',
        closeRating
      );

    const search =
      document.querySelector('#search');

    let currentCategory = 'todos';

    function filterProducts() {
      const term =
        search.value
          .trim()
          .toLowerCase();

      document
        .querySelectorAll('.product')
        .forEach(product => {
          const matchName =
            product.dataset.name
              .includes(term);

          const matchCategory =
            currentCategory === 'todos' ||
            product.dataset.category ===
              currentCategory;

          const shouldShow =
            matchName &&
            matchCategory;

          product.classList.toggle(
            'is-hidden',
            !shouldShow
          );
        });
    }

    search.addEventListener(
      'input',
      filterProducts
    );

    document
      .querySelectorAll(
        '.category-button'
      )
      .forEach(button => {
        button.addEventListener(
          'click',
          () => {
            document
              .querySelectorAll(
                '.category-button'
              )
              .forEach(item => {
                item.classList.remove(
                  'active'
                );
              });

            button.classList.add(
              'active'
            );

            currentCategory =
              button.dataset.category;

            filterProducts();
          }
        );
      });


    renderCart();
  </script>
</body>
</html>
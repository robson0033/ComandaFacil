<body>
  <header class="hero">
    <div class="hero-inner">
      <div class="brand-logo">
        <% if (configuracao?.fotoPerfil) { %>
          <img
            src="<%= safePublicUrl(configuracao.fotoPerfil, { allowDataImage: true }) %>"
            alt="<%= configuracao.nomeEstabelecimento %>"
          >
        <% } else { %>
          🔥
        <% } %>
      </div>

      <div class="brand-copy">
        <h1>
          <%= configuracao?.nomeEstabelecimento ||
              'Nosso cardápio'
          %>
        </h1>

        <p>
          <%= configuracao?.descricao ||
              'Sabores especiais preparados para a sua mesa.'
          %>
        </p>

        <span class="table-pill">
          🪑 Mesa <%= mesa.numero %>
        </span>

        <div class="brand-message">
          Feito com ingredientes selecionados e muito amor.
        </div>
      </div>

      <div class="service-badges">
        <div class="service-badge">
          <div class="service-badge-icon">⏱</div>
          <div>
            <strong>Feito na hora</strong>
            <span>Fresco e saboroso</span>
          </div>
        </div>

        <div class="service-badge">
          <div class="service-badge-icon">🛎</div>
          <div>
            <strong>Atendimento</strong>
            <span>Direto na sua mesa</span>
          </div>
        </div>

        <div class="service-badge">
          <div class="service-badge-icon">🛡</div>
          <div>
            <strong>Pedido seguro</strong>
            <span>Dados protegidos</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="page">
    <% if (lojaDisponivel === false) { %>
      <div
        role="status"
        style="margin-bottom:20px;padding:20px;border:1px solid #eadfd7;border-radius:16px;background:#fff;color:#431712;text-align:center;font-weight:800;"
      >
        Esta loja está temporariamente indisponível para novos pedidos.
      </div>
    <% } %>
    <section class="toolbar" <%- lojaDisponivel === false ? 'style="display:none"' : '' %>>
      <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input
          type="search"
          class="search"
          id="search"
          placeholder="Buscar hambúrguer, pizza, bebida..."
          autocomplete="off"
        >
      </div>

      <button
        class="cart-button"
        id="openCart"
        <%- lojaDisponivel === false ? 'style="display:none" disabled' : '' %>
      >
        🛒 Meu pedido
        <span id="cartTotalButton">R$ 0,00</span>
        <span class="cart-badge" id="cartCount">0</span>
      </button>
    </section>

    <div class="categories" id="categories">
      <button
        class="category-button active"
        data-category="todos"
      >
        ▦ Todos
      </button>

      <% const categorias = [
        ...new Set(
          produtos
            .map(produto => produto.categoriaId?.nome)
            .filter(Boolean)
        )
      ]; %>

      <% categorias.forEach(categoria => { %>
        <button
          class="category-button"
          data-category="<%= categoria %>"
        >
          🍽 <%= categoria %>
        </button>
      <% }) %>
    </div>

    <div class="section-head">
      <div>
        <h2>🔥 Destaques da casa</h2>
        <p>Escolha seus favoritos e envie o pedido direto para a cozinha.</p>
      </div>
    </div>

    <section class="products" id="products">
      <% if (!produtos.length) { %>
        <div class="empty">
          Nenhum produto disponível no momento.
        </div>
      <% } %>

      <% produtos.forEach((produto, index) => { %>
        <% const avaliacao =
          avaliacoesPorProduto?.[String(produto._id)] ||
          { media: 0, quantidade: 0 };
          const tamanhosCategoriaPizzaAtivos =
            produto.categoriaId?.tipoProduto === 'pizza'
              ? (produto.categoriaId?.configuracaoPizza?.tamanhos || [])
                  .filter(tamanho => tamanho.ativo !== false)
                  .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
              : [];
          const precosPizzaExibicao = (produto.precosPizza || [])
            .map(item => Number(item.preco))
            .filter(Number.isFinite);
          const idsTamanhosComPreco = new Set(
            (produto.precosPizza || []).map(item => String(item.tamanhoId || ''))
          );
          const tamanhosPizzaProduto = tamanhosCategoriaPizzaAtivos
            .filter(tamanho => idsTamanhosComPreco.has(String(tamanho._id)));
          const pizzaPrecificacaoPendente =
            produto.categoriaId?.tipoProduto === 'pizza'
            && tamanhosCategoriaPizzaAtivos.length > 0
            && precosPizzaExibicao.length === 0;
          const variacoesCategoriaAtivas =
            produto.categoriaId?.tipoProduto !== 'pizza'
            && produto.categoriaId?.configuracaoVariacoes?.habilitado === true
              ? (produto.categoriaId?.configuracaoVariacoes?.opcoes || [])
                  .filter(opcao => opcao.ativo !== false)
                  .sort((a, b) => Number(a.ordem || 0) - Number(b.ordem || 0))
              : [];
          const precosVariacoesExibicao = (produto.precosVariacoes || [])
            .map(item => Number(item.preco))
            .filter(Number.isFinite);
          const variacaoPrecificacaoPendente =
            variacoesCategoriaAtivas.length > 0
            && precosVariacoesExibicao.length === 0;
        %>

        <article
          class="product"
          data-name="<%= produto.nome.toLowerCase() %>"
          data-category="<%= produto.categoriaId?.nome || '' %>"
        >
          <div class="product-image">

            <% if (index === 0) { %>
              <span class="product-badge">
                Mais pedido
              </span>
            <% } else if (index === 1) { %>
              <span class="product-badge">
                Destaque
              </span>
            <% } %>

            <% if (produto.imagem) { %>
              <img
                src="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                alt="<%= produto.nome %>"
              >
            <% } else { %>
              🍽️
            <% } %>
          </div>

          <div class="product-body">
            <span class="product-category">
              <%= produto.categoriaId?.nome || 'Especial' %>
            </span>

            <h3><%= produto.nome %></h3>

            <p class="product-description">
              <%= produto.descricao ||
                  'Produto preparado especialmente para você.'
              %>
            </p>

            <% if (produto.categoriaId?.tipoProduto === 'pizza') { %>
              <% if (produto.categoriaId?.configuracaoPizza?.permiteMeioAMeio === true) { %>
                <div class="pizza-half-badge">🍕 Meio a meio disponível</div>
              <% } %>
              <% if (tamanhosPizzaProduto.length) { %>
                <div class="pizza-half-badge">📏 <%= tamanhosPizzaProduto.map(t => t.nome).join(' • ') %></div>
              <% } %>
            <% } %>

            <div class="rating-row">
              <span class="rating-star">★</span>

              <% if (avaliacao.quantidade) { %>
                <strong>
                  <%= Number(avaliacao.media).toLocaleString(
                    'pt-BR',
                    {
                      minimumFractionDigits: 1,
                      maximumFractionDigits: 1
                    }
                  ) %>
                </strong>

                <span>
                  (<%= avaliacao.quantidade %>
                  avaliação<%= avaliacao.quantidade === 1 ? '' : 'ões' %>)
                </span>
              <% } else { %>
                <span>Ainda sem avaliações</span>
              <% } %>
            </div>

            <div class="product-footer">
              <strong class="price">
                <% if (produto.categoriaId?.tipoProduto === 'pizza' && precosPizzaExibicao.length) { %>
                  <small style="display:block;font-size:10px;">A partir de</small>
                  <%= Math.min(...precosPizzaExibicao).toLocaleString(
                    'pt-BR',
                    { style: 'currency', currency: 'BRL' }
                  ) %>
                <% } else if (precosVariacoesExibicao.length) { %>
                  <small style="display:block;font-size:10px;">A partir de</small>
                  <%= Math.min(...precosVariacoesExibicao).toLocaleString(
                    'pt-BR',
                    { style: 'currency', currency: 'BRL' }
                  ) %>
                <% } else if (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente) { %>
                  Indisponível
                <% } else { %>
                  <%= Number(produto.preco).toLocaleString(
                    'pt-BR',
                    { style: 'currency', currency: 'BRL' }
                  ) %>
                <% } %>
              </strong>

              <div class="product-actions">
                <button
                  class="rate-button"
                  data-rate-product="<%= produto._id %>"
                  data-rate-name="<%= produto.nome %>"
                  data-rate-order="<%= pedidoAvaliavelPorProduto?.[String(produto._id)] || '' %>"
                  <%= pedidoAvaliavelPorProduto?.[String(produto._id)]
                    ? ''
                    : 'disabled'
                  %>
                  title="<%= pedidoAvaliavelPorProduto?.[String(produto._id)]
                    ? 'Avaliar produto pedido nesta mesa'
                    : 'Faça um pedido deste produto para poder avaliar'
                  %>"
                >
                  ★ Avaliar
                </button>

                <button
                  class="add-button"
                  data-id="<%= produto._id %>"
                  data-name="<%= produto.nome %>"
                  data-price="<%= produto.preco %>"
                  data-image="<%= safePublicUrl(produto.imagem, { allowDataImage: true }) %>"
                  data-category-id="<%= produto.categoriaId?._id || '' %>"
                  data-category-type="<%= produto.categoriaId?.tipoProduto || 'normal' %>"
                  data-pizza-half-enabled="<%= produto.categoriaId?.tipoProduto === 'pizza' && produto.categoriaId?.configuracaoPizza?.permiteMeioAMeio === true ? 'true' : 'false' %>"
                  data-pizza-price-rule="<%= produto.categoriaId?.configuracaoPizza?.regraPrecoMeioAMeio || 'maior_sabor_escolhido' %>"
                  data-pizza-compatible-categories='<%= safeJsonForHtml(
                    (produto.categoriaId?.configuracaoPizza?.categoriasMeioAMeio || [])
                      .map(categoriaId => String(categoriaId?._id || categoriaId || ''))
                      .filter(Boolean)
                  ) %>'
                  data-pizza-sizes='<%= safeJsonForHtml(
                    (produto.categoriaId?.configuracaoPizza?.tamanhos || [])
                      .filter(tamanho => tamanho.ativo !== false)
                      .map(tamanho => ({
                        id: String(tamanho._id),
                        nome: String(tamanho.nome || ''),
                        maxSabores: Math.max(1, Math.min(3, Number(tamanho.maxSabores || 2)))
                      }))
                  ) %>'
                  data-product-pizza-prices='<%= safeJsonForHtml(
                    (produto.precosPizza || []).map(item => ({
                      tamanhoId: String(item.tamanhoId || ''),
                      tamanhoNome: String(item.tamanhoNome || ''),
                      preco: Number(item.preco || 0)
                    }))
                  ) %>'
                  data-variations-enabled="<%= variacoesCategoriaAtivas.length ? 'true' : 'false' %>"
                  data-category-variations='<%= safeJsonForHtml(variacoesCategoriaAtivas.map(opcao => ({
                    id: String(opcao._id),
                    nome: String(opcao.nome || '')
                  }))) %>'
                  data-product-variation-prices='<%= safeJsonForHtml((produto.precosVariacoes || []).map(item => ({
                    variacaoId: String(item.variacaoId || ''),
                    variacaoNome: String(item.variacaoNome || ''),
                    preco: Number(item.preco || 0)
                  }))) %>'
                  data-additionals='<%= safeJsonForHtml(
                    (produto.adicionais || [])
                      .filter(adicional => adicional.ativo !== false)
                      .map(adicional => ({
                        _id: String(adicional._id),
                        nome: adicional.nome,
                        preco: adicional.preco
                      }))
                  ) %>'
                  <%= (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente) ? 'disabled title="Preços por opção ainda não configurados"' : '' %>
                >
                  <%= (pizzaPrecificacaoPendente || variacaoPrecificacaoPendente)
                    ? 'Indisponível'
                    : ((produto.categoriaId?.tipoProduto === 'pizza'
                        && (produto.categoriaId?.configuracaoPizza?.permiteMeioAMeio === true || tamanhosCategoriaPizzaAtivos.length))
                      || variacoesCategoriaAtivas.length
                        ? 'Escolher'
                        : '+ Adicionar') %>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>

    <section class="pending-orders">
      <div class="section-head">
        <div>
          <h2>Pedidos desta mesa</h2>
          <p>
            Estes itens permanecem pendentes até o pagamento da conta.
          </p>
        </div>
      </div>

      <div class="pending-order-list">
        <% if (!itensPendentesMesa.length) { %>
          <div class="empty">
            A mesa não possui pedidos pendentes.
          </div>
        <% } %>

        <% itensPendentesMesa.forEach(item => { %>
          <div class="pending-order-item" data-pedido-id="<%= item.pedidoId %>">
            <strong><%= item.quantidade %>x</strong>

            <div>
              <strong><%= item.nome %></strong>

              <% if (item.tamanhoPizzaNome) { %>
                <small>Tamanho: <%= item.tamanhoPizzaNome %></small>
              <% } %>
              <% if (item.pizzaMeioAMeio && item.saboresPizza?.length) { %>
                <small>Sabores: <%= item.saboresPizza.map(sabor => `${item.saboresPizza.length === 3 ? '1/3' : '1/2'} ${sabor.nome}`).join(' + ') %></small>
              <% } else if (item.variacaoNome) { %>
                <small>Opção: <%= item.variacaoNome %></small>
              <% } %>

              <% if (item.adicionais?.length) { %>
                <small>
                  Adicionais:
                  <%= item.adicionais
                    .map(adicional =>
                      `${adicional.nome} (+${Number(adicional.preco).toLocaleString(
                        'pt-BR',
                        {
                          style: 'currency',
                          currency: 'BRL'
                        }
                      )})`
                    )
                    .join(', ')
                  %>
                </small>
              <% } %>

              <small>
                Status:
                <%= String(item.status || 'novo').replaceAll('_', ' ') %>
              </small>
            </div>

            <div class="pending-order-actions">
              <strong>
                <%= Number(item.subtotal || 0).toLocaleString(
                  'pt-BR',

# Modelo de testes automatizados. Os testes devem injetar valores próprios e falsos.
# Não copie credenciais de desenvolvimento ou produção para este arquivo.
NODE_ENV=test
PORT=3001
APP_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:3001
TZ=America/Sao_Paulo
WEB_CONCURRENCY=1

# Banco descartável e exclusivo de teste, quando um teste de integração realmente precisar.
CONNECTIONSTRING=

# Valores de teste devem ser gerados no processo e nunca ser credenciais reais.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
AVALIACAO_AUDIT_SALT=

STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLATFORM_USER_ID=
MERCADO_PAGO_PIX_PAYER_EMAIL=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://127.0.0.1:3001/pagamento/mercado-pago/callback
PLANO_MENSAL=39.90
PLATFORM_PIX_FEE_ENABLED=false
PLATFORM_PIX_FEE_PERCENT=1.5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Nunca envie alertas reais durante npm test.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_SERVICE_NAME=ComandaFacil-Test
ALERT_ENVIRONMENT=test

ALLOW_INDEX_MIGRATION=false
ALLOW_MP_DIAGNOSTIC=false
ALLOW_OPERATIONAL_ALERT_TEST=false
ALLOW_READONLY_AUDIT=false
RATE_LIMIT_STORE=memory

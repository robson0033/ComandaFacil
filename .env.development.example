# Modelo de desenvolvimento local. Copie somente para .env no seu computador.
# Nunca use aqui as credenciais configuradas no Render.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TZ=America/Sao_Paulo
WEB_CONCURRENCY=1

# Banco exclusivo de desenvolvimento. Use usuário e senha diferentes da produção.
CONNECTIONSTRING=

# Gere valores exclusivos para desenvolvimento.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
AVALIACAO_AUDIT_SALT=

# Desenvolvimento local pode usar armazenamento local.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago: use somente credenciais de teste/sandbox próprias deste ambiente.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLATFORM_USER_ID=
MERCADO_PAGO_PIX_PAYER_EMAIL=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/pagamento/mercado-pago/callback
PLANO_MENSAL=39.90
PLATFORM_PIX_FEE_ENABLED=false
PLATFORM_PIX_FEE_PERCENT=1.5

# SMTP de desenvolvimento ou provedor de captura; nunca reutilize a senha de produção.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Webhook de desenvolvimento separado. Deixe vazio quando não for necessário.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_SERVICE_NAME=ComandaFacil
ALERT_ENVIRONMENT=development

# Controles operacionais: permanecem desligados por padrão.
ALLOW_INDEX_MIGRATION=false
ALLOW_MP_DIAGNOSTIC=false
ALLOW_OPERATIONAL_ALERT_TEST=false
ALLOW_READONLY_AUDIT=false
RATE_LIMIT_STORE=memory
